  "newFindings": [
    {
      "id": "R-018",
      "priority": "P2",
      "title": "同产品换账号后，旧管理目录刷新能覆盖新身份的显隐与插件目录",
      "locations": [
        {
          "path": "src/Momoka.Shell/ViewModels/SettingsViewModel.cs",
          "member": "RefreshServerAdministrationAsync",
          "start": 723,
          "end": 744
        },
        {
          "path": "src/Momoka.Core/Services/ServerCapabilities.cs",
          "member": "GetAdminMenuPagesAsync",
          "start": 136,
          "end": 152
        },
        {
          "path": "src/Momoka.Shell/ViewModels/SettingsViewModel.cs",
          "member": "ApplyServerAdministration",
          "start": 935,
          "end": 944
        },
        {
          "path": "src/Momoka.Shell/Views/SettingsPage.xaml.cs",
          "member": "RefreshServerAdministrationAsync/OnSourceListChanged",
          "start": 431,
          "end": 449
        },
        {
          "path": "src/Momoka.Shell/Views/SettingsPage.xaml.cs",
          "member": "OnSourceListChanged",
          "start": 728,
          "end": 729
        },
        {
          "path": "src/Momoka.Core/Emby/EmbySession.cs",
          "member": "SelectSource",
          "start": 91,
          "end": 103
        }
      ],
      "trigger": "同一在线 Jellyfin 服务器的管理员 A 正在等待插件目录；切换到同产品普通账号 B，B 的新刷新先完成隐藏，随后 A 的旧请求结束。",
      "expected": "管理目录只能由仍属当前身份、当前来源集合和本次有效刷新的结果提交；已经隐藏的 B 目录不能被旧调用重新打开。",
      "causalChain": [
        "VM 在插件请求之前保存 visible 和 kind，单服务器分支等待 GetAdminMenuPagesAsync。",
        "能力服务能识别捕获 Scope 已非当前并返回空表，异常/取消也返回空表；空表不代表旧刷新仍有效。",
        "等待后的 VM 仅比较产品 kind；A/B 同为 Jellyfin，旧调用仍用空表构建固定目录。",
        "ApplyServerAdministration 使用等待前的 visible=true，重新生成五组管理目录；也可能清掉新管理员已加载的插件项。"
      ],
      "actualImpact": "普通账号可重新看到不适用的管理目录，或新目录被旧空表覆盖；点击入口仍有当前权限守卫，不声称实际越权写入。",
      "upstreamGuards": [
        "CanOpenServerCategory 会重新检查当前权限，因此“目录出现”不是服务器授权绕过。",
        "多服务器分支核来源键集合，能力 ProbeAsync 有代次守卫；缺口限定单服务器 VM 目录结果提交。",
        "不需要同身份重登或旧权限缓存，独立于 R-011；同服务器的多个在线账号不改变单服务器 InterfaceFlavor。"
      ],
      "notVerified": [
        "没有新增或运行可控制完成顺序的 VM/WinUI 回归；未访问真实账号，未测实际出现概率。"
      ],
      "minimalFix": "为目录刷新结果加必要的刷新/身份与来源集合门槛，等待后重核有效活动期和权限；旧空表不能覆盖新目录。",
      "acceptance": [
        "假传输挂起 A 插件请求→切普通 B→B 隐藏→放行 A，目录持续隐藏。",
        "新管理员 B 的插件先完成后不被 A 旧空表清掉；单服→多服、不同产品、离页、恢复权限和正常刷新保留。"
      ],
      "status": "已确认；未修复",
      "discoveryPhase": 8,
      "sourceCommit": "c34a5e545333ea4c9f12ca2573bc6034029ecc04",
      "evidenceTypes": [
        "管理子代理提出、主线程逐行复核的固定源码静态因果链；没有新产品故障执行"
      ],
      "repairAuthorized": false
    },
    {
      "id": "R-019",
      "priority": "P2",
      "title": "旧整页导航的取消失败回调能持续遮住随后成功的控制台页面",
      "locations": [
        {
          "path": "src/Momoka.Shell/Views/SettingsPage.xaml.cs",
          "member": "ShowHosted",
          "start": 623,
          "end": 640
        },
        {
          "path": "src/Momoka.Shell/Views/DashboardPage.xaml.cs",
          "member": "TryShowRoute/NavigateToRoute",
          "start": 156,
          "end": 196
        },
        {
          "path": "src/Momoka.Shell/Views/DashboardPage.xaml.cs",
          "member": "OnNavigationCompleted",
          "start": 444,
          "end": 462
        },
        {
          "path": "src/Momoka.Shell/Views/DashboardPage.xaml.cs",
          "member": "Show",
          "start": 577,
          "end": 583
        },
        {
          "path": "src/Momoka.Shell/Views/DashboardPage.xaml.cs",
          "member": "SampleAsync",
          "start": 484,
          "end": 524
        },
        {
          "path": "src/Momoka.Shell/Views/DashboardPage.xaml",
          "member": "Web/NoticePanel",
          "start": 66,
          "end": 75
        },
        {
          "path": "src/Momoka.Shell/Views/DashboardPage.xaml.cs",
          "member": "OnRefresh/Release",
          "start": 542,
          "end": 615
        }
      ],
      "trigger": "首次控制台整页导航 A 已发出、首文档尚未提交；切到同在线来源另一管理路由 B，B 的整页导航顶掉 A，A 的取消失败晚到而 B 随后成功。",
      "expected": "旧 NavigationId 的完成结果不改新导航状态；当前导航成功时错误面板收起、Web 内容恢复可见。",
      "causalChain": [
        "SettingsPage 在同 SourceKey 下复用 DashboardPage，不等待首次文档启动；_booted=false 时 B 再调用 core.Navigate。",
        "导航 B 开始先更新 _generation/_url 并显示 Web，但 NavigationCompleted 只检查 _released，不匹配 NavigationId 或代次。",
        "A 的取消失败用已经是 B 的 _url 调用 Show，令 NoticePanel=Visible、Web=Collapsed。",
        "B 成功仅置 _booted、Say 并 Sample；取样也只改读数/终结状态，没有清旧错误或恢复显隐。XAML/外层只控制 HostedFrame，不补写子 Web.Visibility。"
      ],
      "actualImpact": "右侧可一直保留“打不开 B（OperationCanceled）”错误提示，成功网页内容仍被折叠，需再切路由或重开恢复；不泛化为任意哈希切页必错。",
      "upstreamGuards": [
