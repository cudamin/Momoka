  "newFindings": [
    {
      "id": "R-003",
      "priority": "P1",
      "status": "已确认",
      "title": "自动恢复密码回退未核对最终服务器身份，可能接受不一致服务器绑定",
      "sourceCommit": "c34a5e545333ea4c9f12ca2573bc6034029ecc04",
      "discoveryPhase": 3,
      "locations": [
        {
          "path": "src/Momoka.Core/Emby/EmbySession.cs",
          "member": "RestoreAttemptAsync",
          "start": 395,
          "end": 404
        },
        {
          "path": "src/Momoka.Core/Emby/EmbyServerGateway.cs",
          "member": "AuthenticateAsync",
          "start": 124,
          "end": 151
        },
        {
          "path": "src/Momoka.Core/Emby/EmbySession.cs",
          "member": "Adopt",
          "start": 601,
          "end": 608
        }
      ],
      "trigger": "初步匿名探测确认服务器A后，保存令牌401或仅有保存密码，密码登录/后续公开信息返回不同服务器ID（例如反代后端切换/克隆用户ID的不同实例），但UserId仍等于保存用户；配置URL和登录代次未改变",
      "expected": "最终自动恢复结果只能属于已确认的服务器、产品、API基址和用户；身份不同不得作为原保存来源采用/持久化",
      "actualCausalChain": "ResolveRestoreConnectionAsync先确认原服务器；随后同一connection变量被Gateway.AuthenticateAsync结果覆盖。最终if只检查CanCommit/原配置HasAddress/用户ID；Gateway会选择result.ServerId或新公开info.Id而未与传入serverId比较，Adopt将新ServerId写入原ServerProfile并创建可用来源",
      "actualImpact": "在上述条件下可以把不同服务器身份默默绑定到同一保存来源，覆盖服务器ID并保存新凭据；后续条目操作会指向采用的新绑定。没有证明真实服务器曾发生、没有证明用户记录被写错或凭据已泄露；身份切换必须显式重新确认",
      "evidenceTypes": [
        "本仓库完整静态因果链与提交使用方",
        "官方AuthenticationResult/ServerId结构；未作为真实触发复现"
      ],
      "upstreamGuards": "事前knownId核对、UserId一致、URL/代次和调用者取消仍在；都不能约束新认证结果ServerId。正常在线TryReauthenticateAsync有IsSameIdentityAs，但不是这条恢复分支。显式用户登录是另一授权，不应机械套用自动恢复限制",
      "notVerified": "未新增身份错配回归/临时插桩，未访问真实Jellyfin/Emby，未重放真实保存密码。现有server-id用例只错配事前探测，401回退只返回匹配ID",
      "minimalFix": "保存经过产品纠正的预期连接，在密码回退成功后比对完整身份（已确认ServerId、产品、基址、用户）再落盘/Adopt；保持原配置并发守卫，不比较旧误标Emby状态去破坏合法Jellyfin纠正",
      "acceptance": "假传输中事前公开信息A/UsersMe401、登录返回B但用户相同（包括后登录公开信息B）应拒绝并保留原服务器ID、不存新token/不创建来源；匹配A换token成功、用户/产品/基址错配拒绝、旧Emby到Jellyfin的合法纠正和403/503不回退仍通过",
      "repairAuthorized": false
    }
  ],
