<?xml version="1.0" encoding="utf-8"?>
<!-- MoviePilot 媒体卡保持 2:3 海报比例，卡内动作常驻，键盘与指针都能直接访问。 -->
<UserControl
    x:Class="Momoka.Shell.Views.MoviePilotSearchPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:local="using:Momoka.Shell.Views"
    xmlns:vm="using:Momoka.Shell.ViewModels">
    <Grid>
        <!-- 资源层打开时整块收起，包括来源选择和空态，避免键盘落进被遮住的内容。 -->
        <Grid x:Name="SearchContent" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ProgressBar Height="2" IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
            <InfoBar Grid.Row="1" IsClosable="True" IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
            <Grid Grid.Row="2" ColumnSpacing="16" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}"
                        Style="{StaticResource EgSubheadStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.ResultCount, Mode=OneWay}"
                        Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextDimBrush}" />
                </StackPanel>
                <ComboBox x:Name="SourceFilter" Grid.Column="1" Header="来源" Width="150"
                    HorizontalAlignment="Right" DisplayMemberPath="Name"
                    ItemsSource="{x:Bind ViewModel.SourceChoices, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedSource, Mode=TwoWay}"
                    SelectionChanged="OnSourceChanged" />
            </Grid>
            <ItemsView x:Name="Results" Grid.Row="3" IsItemInvokedEnabled="False"
                ItemTransitionProvider="{x:Null}" ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                SelectionMode="None">
                <ItemsView.Layout>
                    <UniformGridLayout MinItemWidth="152" MinItemHeight="228" MinColumnSpacing="14"
                        MinRowSpacing="16" ItemsJustification="Start" ItemsStretch="None" />
                </ItemsView.Layout>
                <ItemsView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MoviePilotResult">
                        <ItemContainer Width="152" Height="228" automation:AutomationProperties.Name="{x:Bind Title}">
                            <Grid x:Name="MediaPoster" Background="{ThemeResource EgSurfaceAltBrush}"
                                CornerRadius="{StaticResource EgPosterCornerRadius}" ToolTipService.ToolTip="{x:Bind Title}">
                                <!-- ImageBrush 的边界就是海报框；图片加载失败后恢复占位。 -->
                                <Grid Visibility="{x:Bind PosterVisibility, Mode=OneWay}" CornerRadius="{StaticResource EgPosterCornerRadius}">
                                    <Grid.Background>
                                        <ImageBrush ImageSource="{x:Bind Poster}" Stretch="UniformToFill" />
                                    </Grid.Background>
                                </Grid>
                                <FontIcon Style="{StaticResource EgArtworkEmptyGlyphStyle}" Glyph="&#xE714;"
                                    Margin="0,0,0,48" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                                <Grid VerticalAlignment="Bottom" Height="126" IsHitTestVisible="False"
                                    CornerRadius="0,0,12,12">
                                    <Grid.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="{x:Bind local:MoviePilotSearchPanel.FadeStart(), Mode=OneTime}" Offset="0" />
                                            <GradientStop Color="{x:Bind local:MoviePilotSearchPanel.FadeMiddle(), Mode=OneTime}" Offset="0.35" />
                                            <GradientStop Color="{x:Bind local:MoviePilotSearchPanel.FadeEnd(), Mode=OneTime}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Grid.Background>
                                </Grid>
                                <Grid Margin="8" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border HorizontalAlignment="Left" Padding="7,3" CornerRadius="10"
                                        Background="{ThemeResource EgAccentBrush}" Visibility="{x:Bind TypeVisibility}">
                                        <TextBlock Text="{x:Bind TypeLabel}" Style="{StaticResource EgCaptionStyle}"
                                            FontWeight="SemiBold" Foreground="{ThemeResource EgTextOnAccentBrush}" />
                                    </Border>
                                    <Border Grid.Column="1" Padding="7,3" CornerRadius="10"
                                        Background="{ThemeResource EgScrimBrush}" Visibility="{x:Bind RatingVisibility}">
                                        <TextBlock Text="{x:Bind RatingText}" Style="{StaticResource EgCaptionStyle}"
                                            FontWeight="SemiBold" Foreground="{ThemeResource EgOnScrimBrush}" />
                                    </Border>
                                </Grid>
                                <StackPanel VerticalAlignment="Bottom" Margin="8,0,8,7" Spacing="4">
                                    <TextBlock Text="{x:Bind PosterTitle}" Style="{StaticResource EgBodyStyle}"
                                        Foreground="{ThemeResource EgOnScrimBrush}" FontWeight="SemiBold"
                                        MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                    <Border Padding="6,3" CornerRadius="5" Background="{ThemeResource EgScrimBrush}"
                                        Visibility="{x:Bind SubscribeStatusVisibility, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="{x:Bind SubscribeGlyph, Mode=OneWay}" FontSize="{StaticResource EgCaptionFontSize}"
                                                Foreground="{ThemeResource EgOnScrimBrush}" />
                                            <TextBlock Text="{x:Bind SubscribeLabel, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}"
                                                Foreground="{ThemeResource EgOnScrimBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="SearchResources" Width="30" Height="30" MinWidth="0" MinHeight="0"
                                            Command="{x:Bind SearchResourcesCommand}" Style="{StaticResource EgIconButtonStyle}"
                                            Foreground="{ThemeResource EgOnScrimBrush}" Visibility="{x:Bind ActionsVisibility}"
                                            automation:AutomationProperties.Name="{x:Bind SearchResourcesAutomationName}"
                                            ToolTipService.ToolTip="{x:Bind SearchResourcesAutomationName}">
                                            <FontIcon Glyph="&#xE721;" FontSize="{StaticResource EgBodyFontSize}" />
                                        </Button>
                                        <Button x:Name="Subscribe" Grid.Column="1" Width="30" Height="30" MinWidth="0" MinHeight="0"
                                            Command="{x:Bind SubscribeCommand}" Style="{StaticResource EgIconButtonStyle}"
                                            Foreground="{ThemeResource EgOnScrimBrush}" Visibility="{x:Bind SubscribeActionVisibility, Mode=OneWay}"
                                            automation:AutomationProperties.Name="{x:Bind SubscribeAutomationName}"
                                            ToolTipService.ToolTip="{x:Bind SubscribeLabel, Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind SubscribeGlyph, Mode=OneWay}" FontSize="{StaticResource EgBodyFontSize}" />
                                        </Button>
                                        <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Padding="5,2" CornerRadius="4" Background="{ThemeResource EgScrimBrush}"
                                            Visibility="{x:Bind SourceVisibility}">
                                            <TextBlock Text="{x:Bind SourceLabel}" Style="{StaticResource EgCaptionStyle}"
                                                TextTrimming="CharacterEllipsis" Foreground="{ThemeResource EgOnScrimDimBrush}" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </ItemsView.ItemTemplate>
            </ItemsView>
            <StackPanel Grid.Row="3" Margin="24,72,24,0" HorizontalAlignment="Center"
                VerticalAlignment="Top" Spacing="20" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                <Border Width="72" Height="72" Background="{ThemeResource EgSurfaceAltBrush}" CornerRadius="24">
                    <FontIcon FontSize="28" Foreground="{ThemeResource EgAccentBrush}" Glyph="&#xE721;" />
                </Border>
                <TextBlock Foreground="{ThemeResource EgTextDimBrush}" Style="{StaticResource EgBodyStyle}"
                    Text="{x:Bind ViewModel.EmptyNotice, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <local:MoviePilotResourcePanel x:Name="ResourceOverlay" Closed="OnResourceClosed" Visibility="Collapsed" />
    </Grid>
</UserControl>
