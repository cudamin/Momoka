        <Style x:Key="MusicGlyphStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="{StaticResource EgSubheadFontSize}" />
        </Style>
        <Style x:Key="MusicTransportGlyphStyle" TargetType="FontIcon" BasedOn="{StaticResource MusicGlyphStyle}">
            <Setter Property="FontSize" Value="{StaticResource EgTitleFontSize}" />
        </Style>
        <Style x:Key="MusicPlayGlyphStyle" TargetType="FontIcon" BasedOn="{StaticResource MusicGlyphStyle}">
            <Setter Property="FontSize" Value="{StaticResource EgHeaderFontSize}" />
        </Style>
        <Style x:Key="MusicCoverGlyphStyle" TargetType="FontIcon" BasedOn="{StaticResource MusicGlyphStyle}">
            <Setter Property="FontSize" Value="{StaticResource EgDisplayFontSize}" />
        </Style>
        <Style x:Key="MusicEmptyGlyphStyle" TargetType="FontIcon" BasedOn="{StaticResource MusicGlyphStyle}">
            <Setter Property="FontSize" Value="{StaticResource EgHeaderFontSize}" />
        </Style>

        <Style x:Key="MusicPageGlassButtonStyle" TargetType="Button" BasedOn="{StaticResource EgIconButtonStyle}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <!-- 44 DIP 圆形按键，圆角为高度的一半。 -->
            <Setter Property="CornerRadius" Value="{StaticResource EgPrimaryActionCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource EgActionGlassBrush}" />
        </Style>
        <Style x:Key="MusicTransportButtonStyle" TargetType="Button" BasedOn="{StaticResource EgIconButtonStyle}">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <!-- 播放与换曲按钮是直径 56 DIP 的圆。 -->
            <Setter Property="CornerRadius" Value="{StaticResource EgMusicTransportCornerRadius}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="MusicPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource MusicTransportButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource EgActionGlassBrush}" />
        </Style>
        <Style x:Key="MusicSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource EgIconButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="{StaticResource EgIconButtonCornerRadius}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- 歌词：与播放页的标题簇同一支正文族，字号取项目 20 的刻度，不另造一档。 -->
        <Style x:Key="MusicLyricStyle" TargetType="TextBlock" BasedOn="{StaticResource EgBodyStyle}">
            <Setter Property="FontSize" Value="{StaticResource EgTitleFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="38" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextLineBounds" Value="Tight" />
        </Style>
        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <SolidColorBrush x:Key="MusicPageTransparentBrush" Color="Transparent" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid Background="{ThemeResource MusicPageBaseBrush}" />

        <!-- 氛围图与封面是两张不同宽度的解码结果，见 MusicPlaybackViewModel 的 ART 常量。 -->
        <Image
            x:Name="Ambient"
            local:CardArtwork.Item="{x:Bind ViewModel.AmbientArtwork, Mode=OneWay}"
            Stretch="UniformToFill" />
        <Border Background="{ThemeResource MusicPageGlassBrush}" />
        <Border Background="{ThemeResource MusicPageScrimBrush}" />

        <Grid Padding="28,48,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Button x:Uid="MusicPlayerPage_CollapseButton"
                    x:Name="CollapseButton"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="收起播放页"
                    Click="OnCollapse"
                    Style="{StaticResource MusicPageGlassButtonStyle}"
                    ToolTipService.ToolTip="收起播放页（Esc）">
                    <FontIcon Style="{StaticResource MusicGlyphStyle}" Glyph="&#xE70E;" />
                </Button>
                <Button x:Uid="MusicPlayerPage_FullscreenButton"
                    x:Name="FullscreenButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="全屏显示"
                    Click="OnFullscreen"
                    Style="{StaticResource MusicPageGlassButtonStyle}"
                    ToolTipService.ToolTip="全屏显示">
                    <FontIcon x:Name="FullscreenIcon" Style="{StaticResource MusicGlyphStyle}" Glyph="&#xE740;" />
                </Button>
            </Grid>

            <Grid x:Name="Stage" Grid.Row="1" MaxWidth="1120" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="NowPlaying" Grid.Column="0" Spacing="22" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Border
                        x:Name="CoverFrame"
                        Background="{ThemeResource EgSurfaceAltBrush}"
                        CornerRadius="{StaticResource EgLargeArtworkCornerRadius}">
                        <Grid>
                            <FontIcon Style="{StaticResource MusicCoverGlyphStyle}" Foreground="{ThemeResource EgTextFaintBrush}" Glyph="&#xE8D6;" />
                            <Image local:CardArtwork.Item="{x:Bind ViewModel.CoverArtwork, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="TrackTitle"
                                Style="{StaticResource EgPageTitleStyle}"
                                MaxLines="1"
                                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Title, Mode=OneWay}"
                                VerticalAlignment="Center" />
                            <Button
                                x:Name="FavoriteButton"
                                Grid.Column="1"
                                AutomationProperties.Name="{x:Bind local:MusicPlayerPage.FavoriteLabel(ViewModel.Favorite), Mode=OneWay}"
                                Click="OnFavorite"
                                Style="{StaticResource MusicSmallButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind local:MusicPlayerPage.FavoriteLabel(ViewModel.Favorite), Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.FavoriteVisibility, Mode=OneWay}">
                                <PathIcon x:Name="FavoriteIcon" Data="{x:Bind FavoriteGeometry(ViewModel.Favorite), Mode=OneWay}" />
                            </Button>
                            <Button x:Uid="MusicPlayerPage_MoreButton"
                                x:Name="MoreButton"
                                Grid.Column="2"
                                AutomationProperties.Name="更多操作"
                                Style="{StaticResource MusicSmallButtonStyle}"
                                ToolTipService.ToolTip="更多操作">
                                <FontIcon Style="{StaticResource MusicGlyphStyle}" Glyph="&#xE712;" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Uid="MusicPlayerPage_PauseMenuItem" x:Name="PauseMenuItem" Click="OnTogglePause" Text="播放 / 暂停" />
                                        <MenuFlyoutItem x:Name="RepeatMenuItem" Click="OnRepeat" Text="{x:Bind local:MusicPlayerPage.RepeatMenuLabel(ViewModel.RepeatLabel), Mode=OneWay}" />
                                        <MenuFlyoutItem x:Uid="MusicPlayerPage_QueueMenuItem" x:Name="QueueMenuItem" Click="OnQueue" Text="播放队列" />
                                        <MenuFlyoutItem x:Uid="MusicPlayerPage_StopMenuItem" x:Name="StopMenuItem" Click="OnStop" Text="停止播放" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <TextBlock
                            x:Name="TrackSubtitle"
                            Style="{StaticResource EgCaptionStyle}"
                            MaxLines="1"
                            Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />

                        <Grid RowSpacing="2" Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Slider x:Uid="MusicPlayerPage_SeekSlider"
                                x:Name="SeekSlider"
                                Minimum="0"
                                Maximum="{x:Bind ViewModel.Duration, Mode=OneWay}"
                                Value="{x:Bind ViewModel.Position, Mode=OneWay}"
                                ValueChanged="OnSeek"
                                AutomationProperties.Name="音乐进度"
                                HorizontalAlignment="Stretch">
                                <Slider.Resources>
                                    <x:Double x:Key="SliderHorizontalHeight">32</x:Double>
                                    <x:Double x:Key="SliderPreContentMargin">4</x:Double>
                                    <x:Double x:Key="SliderPostContentMargin">4</x:Double>
                                    <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
                                    <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
                                    <x:Double x:Key="SliderInnerThumbWidth">8</x:Double>
                                    <x:Double x:Key="SliderInnerThumbHeight">8</x:Double>
                                    <StaticResource x:Key="SliderThumbCornerRadius" ResourceKey="EgMusicSliderThumbCornerRadius" />
                                </Slider.Resources>
                            </Slider>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource EgDataStyle}" Text="{x:Bind ViewModel.PositionClock, Mode=OneWay}" />
                                <Border
                                    Grid.Column="1"
                                    Background="{ThemeResource EgSurfaceAltBrush}"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    HorizontalAlignment="Center"
                                    Padding="6,0"
                                    Visibility="{x:Bind ViewModel.FormatVisibility, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource EgDataStyle}" Text="{x:Bind ViewModel.FormatLabel, Mode=OneWay}" />
                                </Border>
                                <TextBlock Grid.Column="2" Style="{StaticResource EgDataStyle}" Text="{x:Bind ViewModel.DurationClock, Mode=OneWay}" />
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <Grid x:Name="TransportRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Uid="MusicPlayerPage_ShuffleButton"
                            x:Name="ShuffleButton"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="随机播放"
                            Click="OnShuffle"
                            Style="{StaticResource MusicSmallButtonStyle}"
                            ToolTipService.ToolTip="随机播放">
                            <PathIcon Data="{x:Bind ShuffleGeometry}" />
                        </Button>
                        <Button x:Uid="MusicPlayerPage_PreviousButton"
                            x:Name="PreviousButton"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="上一曲"
                            Click="OnPrevious"
                            Style="{StaticResource MusicTransportButtonStyle}"
                            ToolTipService.ToolTip="上一曲">
                            <FontIcon Style="{StaticResource MusicTransportGlyphStyle}" Glyph="&#xE892;" />
                        </Button>
                        <Button
                            x:Name="PlayButton"
                            Grid.Column="2"
                            AutomationProperties.Name="{x:Bind ViewModel.PlayLabel, Mode=OneWay}"
                            Click="OnPlay"
                            Style="{StaticResource MusicPlayButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.PlayLabel, Mode=OneWay}">
                            <FontIcon Style="{StaticResource MusicPlayGlyphStyle}" Glyph="{x:Bind ViewModel.PlayGlyph, Mode=OneWay}" />
                        </Button>
                        <Button x:Uid="MusicPlayerPage_NextButton"
                            x:Name="NextButton"
                            Grid.Column="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="下一曲"
                            Click="OnNext"
                            Style="{StaticResource MusicTransportButtonStyle}"
                            ToolTipService.ToolTip="下一曲">
                            <FontIcon Style="{StaticResource MusicTransportGlyphStyle}" Glyph="&#xE893;" />
                        </Button>
                        <Button x:Uid="MusicPlayerPage_VolumeButton"
                            x:Name="VolumeButton"
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="音量"
                            Style="{StaticResource MusicSmallButtonStyle}"
                            ToolTipService.ToolTip="音量">
                            <FontIcon Style="{StaticResource MusicTransportGlyphStyle}" Glyph="{x:Bind local:MusicPlayerPage.VolumeGlyph(ViewModel.Muted), Mode=OneWay}" />
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <StackPanel Width="190" Spacing="8">
                                        <TextBlock x:Uid="MusicPlayerPage_Localization1" Style="{StaticResource EgBodyStyle}" Text="音量" />
                                        <Slider x:Uid="MusicPlayerPage_VolumeSlider"
                                            x:Name="VolumeSlider"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="{x:Bind ViewModel.Volume, Mode=OneWay}"
                                            ValueChanged="OnVolume"
                                            AutomationProperties.Name="音乐音量" />
                                        <Button x:Uid="MusicPlayerPage_MuteButton" x:Name="MuteButton" Click="OnMute" Content="静音 / 取消静音" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </StackPanel>

                <Grid x:Name="LyricsHost" Grid.Column="2" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="MusicPlayerPage_LyricsNote"
                        x:Name="LyricsNote"
                        Margin="0,0,0,10"
                        Style="{StaticResource EgCaptionStyle}"
                        Text="纯文本歌词不支持自动滚动"
                        Visibility="{x:Bind ViewModel.LyricsNoteVisibility, Mode=OneWay}" />
                    <Grid Grid.Row="1">
                        <ListView x:Uid="MusicPlayerPage_LyricsList"
                            x:Name="LyricsList"
                            AutomationProperties.Name="歌词"
                            IsItemClickEnabled="False"
                            IsTabStop="False"
                            ItemsSource="{x:Bind ViewModel.Lyrics, Mode=OneWay}"
                            Padding="0,24,16,160"
                            SelectionMode="None"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden"
                            Visibility="{x:Bind ViewModel.LyricsListVisibility, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="music:MusicLyricLine">
                                    <TextBlock
                                        Margin="0,6"
                                        Opacity="{x:Bind ActiveOpacity, Mode=OneWay}"
                                        Style="{StaticResource MusicLyricStyle}"
                                        Text="{x:Bind Text}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <!-- 底部渐隐：WinUI 3 没有 UIElement.OpacityMask，用一层不吃指针的渐变盖住末几行。 -->
                        <Border
                            Height="120"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource MusicPageLyricsFadeBrush}"
                            IsHitTestVisible="False"
                            Visibility="{x:Bind ViewModel.LyricsListVisibility, Mode=OneWay}" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.LyricsEmptyVisibility, Mode=OneWay}">
                            <FontIcon Style="{StaticResource MusicEmptyGlyphStyle}" Foreground="{ThemeResource EgTextFaintBrush}" Glyph="&#xE8D6;" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource EgSubheadStyle}" Text="{x:Bind ViewModel.LyricsEmptyText, Mode=OneWay}" HorizontalAlignment="Center" />
                            <TextBlock x:Uid="MusicPlayerPage_Localization2" Style="{StaticResource EgCaptionStyle}" Text="音频文件与服务端都没有找到歌词" HorizontalAlignment="Center" />
                        </StackPanel>
                        <ProgressBar
                            Height="2"
                            IsIndeterminate="True"
                            VerticalAlignment="Top"
                            Visibility="{x:Bind ViewModel.LyricsLoadingVisibility, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="2">
                <Button x:Uid="MusicPlayerPage_QueueButton"
                    x:Name="QueueButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="播放队列"
                    Style="{StaticResource MusicPageGlassButtonStyle}"
                    ToolTipService.ToolTip="播放队列">
                    <FontIcon Style="{StaticResource MusicTransportGlyphStyle}" Glyph="&#xE8FD;" />
                    <Button.Flyout>
                        <Flyout Placement="Top">
                            <StackPanel Width="360" Spacing="12">
                                <TextBlock x:Uid="MusicPlayerPage_Localization3" Style="{StaticResource EgBodyStyle}" Text="播放队列" />
                                <ListView
                                    x:Name="QueueList"
                                    MaxHeight="420"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnQueueItem"
                                    ItemsSource="{x:Bind ViewModel.Queue, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.QueueIndex, Mode=OneWay}"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="emby:EmbyItem">
                                            <Grid ColumnSpacing="12" Padding="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource EgBodyStyle}" Text="{x:Bind Name, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource EgDataStyle}" Text="{x:Bind local:MusicPlayerPage.QueueDuration(RunTimeTicks), Mode=OneTime}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
