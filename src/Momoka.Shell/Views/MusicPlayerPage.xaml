<?xml version="1.0" encoding="utf-8"?>
<!--
  音乐播放页（2026-11-17）。参考飞牛音乐网页版的全屏播放页，落在 WinUI 的原生控件与主题角色上：

    · 左栏是这张唱片本身：大封面、曲名、艺术家/专辑、进度、上一首/播放/下一首与随机、循环、音量。
    · 右栏是歌词。歌词来自音频文件自己的标签（mpv 的 metadata/by-key），带时间轴时随播放高亮；
      纯文本按原文静态列出，没有歌词时停在一句空态。
    · 背景是同一张封面的一张极小解码图，铺满整窗后压一层应用内亚克力与暗罩；换曲换图，
      不靠取色算法另拼一套色板。

  固定 Dark 与播放器同一档：这是压在媒体上的沉浸表面，浅色主题下也让封面颜色自己说话。
  入口在底部播放栏的封面与歌名上；收起键与 Escape 回到播放栏，窗口本身的最小化/关闭仍归标题栏。
-->
<UserControl
    x:Class="Momoka.Shell.Views.MusicPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:emby="using:Momoka.Emby"
    xmlns:local="using:Momoka.Shell.Views"
    xmlns:music="using:Momoka.Music"
    xmlns:vm="using:Momoka.Shell.ViewModels"
    RequestedTheme="Dark"
    FontFamily="{StaticResource EgUiFontFamily}"
    FontSize="{StaticResource EgBodyFontSize}"
    IsTabStop="True"
    Visibility="Collapsed"
    SizeChanged="OnPageSizeChanged">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
    </UserControl.KeyboardAccelerators>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="MusicPageBaseBrush" Color="{ThemeResource EgWindowColor}" />
                    <!-- 铺满整窗的一层应用内亚克力：它压在氛围图上，把极小解码图放大后的块感抹平；
                         关掉透明效果时回退成同一支窗口实底。 -->
                    <AcrylicBrush x:Key="MusicPageGlassBrush"
                                  FallbackColor="{ThemeResource EgWindowColor}"
                                  TintColor="{ThemeResource EgWindowColor}"
                                  TintLuminosityOpacity="0.45"
                                  TintOpacity="0.55" />
                    <LinearGradientBrush x:Key="MusicPageScrimBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="{ThemeResource EgScrimColor}" Offset="0.55" />
                        <GradientStop Color="{ThemeResource EgWindowColor}" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="MusicPageLyricsFadeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="{ThemeResource EgScrimColor}" Offset="0.55" />
                        <GradientStop Color="{ThemeResource EgWindowColor}" Offset="1" />
                    </LinearGradientBrush>
                    <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="MusicPageTransparentBrush" />
                    <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="MusicPageTransparentBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="MusicPageBaseBrush" Color="{ThemeResource EgWindowColor}" />
                    <AcrylicBrush x:Key="MusicPageGlassBrush"
                                  FallbackColor="{ThemeResource EgWindowColor}"
                                  TintColor="{ThemeResource EgWindowColor}"
                                  TintLuminosityOpacity="0.45"
                                  TintOpacity="0.55" />
                    <LinearGradientBrush x:Key="MusicPageScrimBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="{ThemeResource EgScrimColor}" Offset="0.55" />
                        <GradientStop Color="{ThemeResource EgWindowColor}" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="MusicPageLyricsFadeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="{ThemeResource EgScrimColor}" Offset="0.55" />
                        <GradientStop Color="{ThemeResource EgWindowColor}" Offset="1" />
                    </LinearGradientBrush>
                    <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="MusicPageTransparentBrush" />
                    <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="MusicPageTransparentBrush" />
                </ResourceDictionary>
                <!-- 高对比度彻底取消氛围图透明玻璃与遮罩渐变，改用系统不透明窗口色保障对比度。 -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="MusicPageBaseBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="MusicPageGlassBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="MusicPageScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="MusicPageLyricsFadeBrush" Color="Transparent" />
                    <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="MusicPageTransparentBrush" />
                    <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="MusicPageTransparentBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 与播放栏同一组 Fluent 图标（见 MusicPlayerBar.xaml 的来源说明）；每个控件独占几何。 -->
