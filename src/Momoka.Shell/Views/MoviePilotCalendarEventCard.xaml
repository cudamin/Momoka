<UserControl
    x:Class="Momoka.Shell.Views.MoviePilotCalendarEventCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- Adapted from MoviePilot-Frontend e6a30ad4, FullCalendarView.vue (MIT, jxxghp).
         The shared card stays inside its date; it never initiates playback or subscription writes. -->
    <Border Background="{ThemeResource EgSurfaceBrush}" CornerRadius="8" Padding="6">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Top">
                <Border Width="56" Height="84" CornerRadius="6" Background="{ThemeResource EgSurfaceAltBrush}">
                    <Grid>
                        <FontIcon x:Name="PosterPlaceholder" Glyph="&#xE8B2;" Foreground="{ThemeResource EgTextDimBrush}" />
                        <Image x:Name="PosterImage" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </Border>
                <Border x:Name="LibraryBadge" Background="{ThemeResource EgAccentBrush}" CornerRadius="10"
                    Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource EgCaptionFontSize}" Foreground="{ThemeResource EgTextOnAccentBrush}" />
                </Border>
            </Grid>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Top">
                <TextBlock x:Name="EventTitle" Style="{StaticResource EgBodyStyle}" FontWeight="Bold"
                    TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <Grid ColumnSpacing="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE787;" FontSize="{StaticResource EgCaptionFontSize}" Foreground="{ThemeResource EgTextDimBrush}" />
                    <TextBlock x:Name="EpisodeText" Grid.Column="1" Style="{StaticResource EgCaptionStyle}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <Grid x:Name="LibraryRow" ColumnSpacing="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon x:Name="LibraryIcon" Glyph="&#xE73E;" FontSize="{StaticResource EgCaptionFontSize}" Foreground="{ThemeResource EgTextDimBrush}" />
                    <FontIcon x:Name="CompleteIcon" Glyph="&#xE73E;" FontSize="{StaticResource EgCaptionFontSize}" Foreground="{ThemeResource EgAccentBrush}" Visibility="Collapsed" />
                    <FontIcon x:Name="PartialIcon" Glyph="&#xE7BA;" FontSize="{StaticResource EgCaptionFontSize}" Foreground="{ThemeResource EgWarningBrush}" Visibility="Collapsed" />
                    <TextBlock x:Name="LibraryText" Grid.Column="1" Style="{StaticResource EgCaptionStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CompleteText" Grid.Column="1" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    <TextBlock x:Name="PartialText" Grid.Column="1" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgWarningBrush}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                </Grid>
                <Grid x:Name="UpdatedRow" ColumnSpacing="3" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE823;" FontSize="{StaticResource EgCaptionFontSize}" Foreground="{ThemeResource EgTextDimBrush}" />
                    <TextBlock x:Name="UpdatedText" Grid.Column="1" Style="{StaticResource EgCaptionStyle}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock x:Name="RuntimeText" Style="{StaticResource EgCaptionStyle}" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
