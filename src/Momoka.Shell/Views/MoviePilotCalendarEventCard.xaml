<UserControl
    x:Class="Momoka.Shell.Views.MoviePilotCalendarEventCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <UserControl.Resources>
        <Style x:Key="CalendarLibraryStyle" TargetType="TextBlock" BasedOn="{StaticResource EgCaptionStyle}" />
        <Style x:Key="CalendarLibraryCompleteStyle" TargetType="TextBlock" BasedOn="{StaticResource EgCaptionStyle}">
            <Setter Property="Foreground" Value="{ThemeResource EgAccentBrush}" />
        </Style>
        <Style x:Key="CalendarLibraryPartialStyle" TargetType="TextBlock" BasedOn="{StaticResource EgCaptionStyle}">
            <Setter Property="Foreground" Value="{ThemeResource EgWarningBrush}" />
        </Style>
    </UserControl.Resources>
    <!-- Adapted from MoviePilot-Frontend e6a30ad4, FullCalendarView.vue (MIT, jxxghp). -->
    <Border x:Name="CardSurface" Background="{ThemeResource EgSurfaceBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="1" CornerRadius="{StaticResource EgCornerBadgeCornerRadius}" Padding="6" MinWidth="0">
        <Grid x:Name="CardLayout" ColumnSpacing="6" RowSpacing="4" MinWidth="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PosterColumn" Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="PosterFrame" Width="56" Height="84" VerticalAlignment="Top" HorizontalAlignment="Left"
                CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource EgSurfaceAltBrush}">
                <Grid>
                    <FontIcon x:Name="PosterPlaceholder" Glyph="&#xE8B2;" FontSize="{StaticResource EgBodyFontSize}"
                        Foreground="{ThemeResource EgTextDimBrush}" AutomationProperties.AccessibilityView="Raw" />
                    <Image x:Name="PosterImage" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </Border>
            <StackPanel x:Name="TextPanel" Grid.Column="1" Spacing="2" VerticalAlignment="Top" MinWidth="0">
                <TextBlock x:Name="EventTitle" Style="{StaticResource EgBodyStyle}" FontWeight="SemiBold" AutomationProperties.AccessibilityView="Raw"
                    TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="EpisodeText" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="LibraryText" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="UpdatedText" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="RuntimeText" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
