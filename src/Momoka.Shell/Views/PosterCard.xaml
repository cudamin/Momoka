<?xml version="1.0" encoding="utf-8"?>
<!-- 共用的影院海报卡：圆角封面、清晰的标题层级，以及轻按压、图片推近和渐显操作层。 -->
<UserControl
    x:Class="Momoka.Shell.Views.PosterCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="FolderFrameStyle" TargetType="Border" BasedOn="{StaticResource EgFrameStyle}">
            <Setter Property="Background" Value="{ThemeResource EgTextFaintBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- 搜索结果的单集：比其余卡片多一圈强调色粗框。别处的单集（季里的集页）不经过这一档。 -->
        <Style x:Key="EpisodeFrameStyle" TargetType="Border" BasedOn="{StaticResource EgFrameStyle}">
            <Setter Property="BorderThickness" Value="{StaticResource EgOutlineThickness}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EgAccentBrush}" />
        </Style>
        <!-- 保留平台模板与焦点反馈，右下操作仅画图标，遮罩负责照片上的对比度。 -->
        <Style x:Key="EgCardActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource EgOnScrimBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- 中央播放键恢复原中性底色和悬停强调色；封面按钮不使用亚克力。 -->
        <Style x:Key="EgCardPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{ThemeResource EgSurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource EgTextBrush}" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EgTextBrush}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource EgSurfaceBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- 宽度和海报比例继续由页面的 CardSize 决定，动画只改变绘制，不改变测量。 -->
    <Grid
        x:Name="Root"
        Width="{x:Bind CardWidth, Mode=OneWay}"
        Background="Transparent"
        HorizontalAlignment="Center"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited"
        RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="CardMotion" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Jellyfin's PosterCard / ThumbCard layouts put the picture and its text on a card surface.
             The surface spans both rows; the picture and text carry their own insets (CardItem.ArtMargin /
             TextMargin) so the surface's corners stay visible. Collapsed for every other view. -->
        <Border
            Grid.RowSpan="2"
            Background="{ThemeResource EgSurfaceBrush}"
            BorderBrush="{ThemeResource EgBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource EgCardCornerRadius}"
            Visibility="{x:Bind Card.CardLayoutVisibility, Mode=OneWay}" />

        <Viewbox Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"
            IsHitTestVisible="False" Visibility="{x:Bind Card.FolderFrameVisibility, Mode=OneWay}">
            <Path Fill="{ThemeResource EgTextFaintBrush}" Data="M 0,14 L 0,6 Q 0,0 6,0 L 30,0 L 44,10 L 70,10 L 70,14 Z" />
        </Viewbox>
        <Border
            x:Name="Art"
            Height="{x:Bind PosterHeight, Mode=OneWay}"
            Margin="{x:Bind Card.ArtMargin, Mode=OneWay}"
            Padding="{x:Bind Card.ArtworkPadding, Mode=OneWay}"
            Style="{StaticResource EgFrameStyle}">
            <Grid>
                <FontIcon
                    FontSize="32"
                    Foreground="{ThemeResource EgTextFaintBrush}"
                    Glyph="{x:Bind Card.Glyph, Mode=OneWay}" />
                <!-- 飞牛横卡的底：同一张海报放大、压暗，竖版封面摆在正中（见 CardItem.FnNasWide）。 -->
                <Grid Visibility="{x:Bind Card.FnNasWideVisibility, Mode=OneWay}">
                    <Image
                        Opacity="0.55"
                        RenderTransformOrigin="0.5,0.5"
                        Source="{x:Bind Card.Poster, Mode=OneWay}"
                        Stretch="UniformToFill">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1.15" ScaleY="1.15" />
                        </Image.RenderTransform>
                    </Image>
                    <Border Background="{ThemeResource EgScrimBrush}" Opacity="0.4" />
                </Grid>
                <Image
                    x:Name="Poster"
                    ImageOpened="OnPosterOpened"
                    RenderTransformOrigin="0.5,0.5"
                    Source="{x:Bind Card.Poster, Mode=OneWay}"
                    Stretch="{x:Bind Card.PosterStretch, Mode=OneWay}">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="PosterMotion" />
                    </Image.RenderTransform>
                </Image>
                <!-- 飞牛文件夹的封面墙：官方前端读 poster_list，1～4 张按张数排版（见 CardItem.FolderTileSlot）。
                     格子先留着透明，图陆续到达；一张也没有时仍透出下面的字形占位。 -->
                <Grid
                    ColumnSpacing="4"
                    RowSpacing="4"
                    Visibility="{x:Bind Card.FolderCollageVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Row="{x:Bind Card.FolderTile0Row, Mode=OneWay}"
                        Grid.Column="{x:Bind Card.FolderTile0Column, Mode=OneWay}"
                        Grid.RowSpan="{x:Bind Card.FolderTile0RowSpan, Mode=OneWay}"
                        Grid.ColumnSpan="{x:Bind Card.FolderTile0ColumnSpan, Mode=OneWay}"
                        Background="Transparent"
                        CornerRadius="4"
                        Visibility="{x:Bind Card.FolderTile0Visibility, Mode=OneWay}">
                        <Image Source="{x:Bind Card.FolderTile0, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                    <Border
                        Grid.Row="{x:Bind Card.FolderTile1Row, Mode=OneWay}"
                        Grid.Column="{x:Bind Card.FolderTile1Column, Mode=OneWay}"
                        Grid.RowSpan="{x:Bind Card.FolderTile1RowSpan, Mode=OneWay}"
                        Grid.ColumnSpan="{x:Bind Card.FolderTile1ColumnSpan, Mode=OneWay}"
                        Background="Transparent"
                        CornerRadius="4"
                        Visibility="{x:Bind Card.FolderTile1Visibility, Mode=OneWay}">
                        <Image Source="{x:Bind Card.FolderTile1, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                    <Border
                        Grid.Row="{x:Bind Card.FolderTile2Row, Mode=OneWay}"
                        Grid.Column="{x:Bind Card.FolderTile2Column, Mode=OneWay}"
                        Grid.RowSpan="{x:Bind Card.FolderTile2RowSpan, Mode=OneWay}"
                        Grid.ColumnSpan="{x:Bind Card.FolderTile2ColumnSpan, Mode=OneWay}"
                        Background="Transparent"
                        CornerRadius="4"
                        Visibility="{x:Bind Card.FolderTile2Visibility, Mode=OneWay}">
                        <Image Source="{x:Bind Card.FolderTile2, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                    <Border
                        Grid.Row="{x:Bind Card.FolderTile3Row, Mode=OneWay}"
                        Grid.Column="{x:Bind Card.FolderTile3Column, Mode=OneWay}"
                        Grid.RowSpan="{x:Bind Card.FolderTile3RowSpan, Mode=OneWay}"
                        Grid.ColumnSpan="{x:Bind Card.FolderTile3ColumnSpan, Mode=OneWay}"
                        Background="Transparent"
                        CornerRadius="4"
                        Visibility="{x:Bind Card.FolderTile3Visibility, Mode=OneWay}">
                        <Image Source="{x:Bind Card.FolderTile3, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                </Grid>
                <!-- 飞牛媒体库的封面墙：官方库卡在 poster_type=Multiple 时把 posters 去重后最多三张并排，
                     每张铺满三分之一、之间留 1 px。单张封皮的库走上面那张海报，不画这一层。 -->
                <Grid ColumnSpacing="1" Visibility="{x:Bind Card.LibraryWallVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Visibility="{x:Bind Card.LibraryTile0Visibility, Mode=OneWay}">
                        <Image Source="{x:Bind Card.LibraryTile0, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                    <Border Grid.Column="1" Visibility="{x:Bind Card.LibraryTile1Visibility, Mode=OneWay}">
                        <Image Source="{x:Bind Card.LibraryTile1, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                    <Border Grid.Column="2" Visibility="{x:Bind Card.LibraryTile2Visibility, Mode=OneWay}">
                        <Image Source="{x:Bind Card.LibraryTile2, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                </Grid>
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="4"
                    Margin="4" Padding="4,1" Background="{ThemeResource EgScrimBrush}"
                    Visibility="{x:Bind Card.DurationVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Card.DurationText, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}"
                        Foreground="{ThemeResource EgOnScrimBrush}" />
                </Border>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="5"
                    Margin="8" Padding="7,1" Background="{ThemeResource EgScrimBrush}"
                    Visibility="{x:Bind Card.RatingVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Card.RatingText, Mode=OneWay}" FontWeight="SemiBold"
                        FontSize="{StaticResource EgCaptionFontSize}"
                        Foreground="{ThemeResource EgWarningBrush}" />
                </Border>
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="5"
                    Margin="8" Padding="7,1" Background="{ThemeResource EgScrimBrush}"
                    Visibility="{x:Bind Card.ResolutionVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Card.ResolutionText, Mode=OneWay}" FontWeight="SemiBold"
                        FontSize="{StaticResource EgCaptionFontSize}"
                        Foreground="{ThemeResource EgOnScrimBrush}" />
                </Border>
                <Border
                    x:Name="HoverShade"
                    Background="{ThemeResource EgScrimBrush}"
                    IsHitTestVisible="False"
                    Opacity="0" />

                <Border
                    Style="{StaticResource EgCornerBadgeStyle}"
                    Visibility="{x:Bind Card.WatchedBadgeVisibility, Mode=OneWay}">
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource EgTextOnAccentBrush}"
                        Glyph="&#xE73E;" />
                </Border>
                <Border
                    Style="{StaticResource EgCornerBadgeStyle}"
                    Visibility="{x:Bind Card.UnplayedVisibility, Mode=OneWay}">
                    <TextBlock
                        Style="{StaticResource EgCornerBadgeTextStyle}"
                        Text="{x:Bind Card.UnplayedText, Mode=OneWay}" />
                </Border>
                <!-- 同一个角上的另一种说法：飞牛不给未看集数，于是这里写这部剧库里有多少集（「14 集」）。
                     两颗互斥 —— 见 CardItem.EpisodeCountVisibility。 -->
                <Border
                    Style="{StaticResource EgCornerBadgeStyle}"
                    Visibility="{x:Bind Card.EpisodeCountVisibility, Mode=OneWay}">
                    <TextBlock
                        Style="{StaticResource EgCornerBadgeTextStyle}"
                        Text="{x:Bind Card.EpisodeCountText, Mode=OneWay}" />
                </Border>
                <FontIcon
                    Margin="8"
                    FontSize="14"
                    Foreground="{ThemeResource EgDangerBrush}"
                    Glyph="&#xEB52;"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Visibility="{x:Bind Card.FavoriteBadgeVisibility, Mode=OneWay}" />

                <Grid
                    Height="{StaticResource EgProgressThickness}"
                    VerticalAlignment="Bottom"
                    Visibility="{x:Bind Card.ProgressVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Bind Card.ProgressDone, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind Card.ProgressLeft, Mode=OneWay}" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" Background="{ThemeResource EgOnScrimDimBrush}" Opacity="0.24" />
                    <Border Background="{ThemeResource EgAccentBrush}" />
                </Grid>

                <!-- 整层共同渐显，离开后立即停止命中，淡出完成再收起；键盘仍可从 Shift+F10 进入全部操作。
                     操作层上的 Tapped 一律吃掉：媒体库的 ItemContainer 和主页那层 Button 都在外面等
                     「这一下算不算点卡片」，而按钮自己按下去只该做按钮那一件事。 -->
                <Grid x:Name="Hover" Opacity="0" Visibility="Collapsed" Tapped="OnActionTapped">
                    <Button
                        x:Name="PlayButton"
                        AutomationProperties.Name="{x:Bind Card.PlayActionTip, Mode=OneWay}"
                        Click="OnPlayClicked"
                        HorizontalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5"
                        Style="{StaticResource EgCardPlayButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind Card.PlayActionTip, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind Card.PlayVisibility, Mode=OneWay}">
                        <Button.Resources>
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="EgAccentBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="EgAccentPressedBrush" />
                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="EgTextOnAccentBrush" />
                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="EgTextOnAccentBrush" />
                        </Button.Resources>
                        <Button.RenderTransform>
                            <ScaleTransform x:Name="PlayMotion" ScaleX="0.92" ScaleY="0.92" />
                        </Button.RenderTransform>
                        <FontIcon Margin="2,0,0,0" FontSize="20" Glyph="&#xE768;" />
                    </Button>
                    <StackPanel
                        x:Name="Actions"
                        Margin="0,0,6,4"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Bottom">
                        <StackPanel.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="EgOnScrimBrush" />
                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="EgOnScrimDimBrush" />
                        </StackPanel.Resources>
                        <Button
                            x:Name="WatchedButton"
                            AutomationProperties.Name="{x:Bind Card.WatchedActionTip, Mode=OneWay}"
                            Click="OnWatchedClicked"
                            Style="{StaticResource EgCardActionButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind Card.WatchedActionTip, Mode=OneWay}"
                            Visibility="{x:Bind Card.UserStateVisibility, Mode=OneWay}">
                            <Grid>
                                <FontIcon FontSize="20" Glyph="&#xEC61;" Visibility="{x:Bind Card.NotWatchedVisibility, Mode=OneWay}" />
                                <FontIcon FontSize="20" Foreground="{ThemeResource EgAccentBrush}" Glyph="&#xEC61;" Visibility="{x:Bind Card.WatchedVisibility, Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="FavoriteButton"
                            AutomationProperties.Name="{x:Bind Card.FavoriteActionTip, Mode=OneWay}"
                            Click="OnFavoriteClicked"
                            Style="{StaticResource EgCardActionButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind Card.FavoriteActionTip, Mode=OneWay}"
                            Visibility="{x:Bind Card.FavoriteActionVisibility, Mode=OneWay}">
                            <Grid>
                                <FontIcon FontSize="20" Glyph="&#xEB52;" Visibility="{x:Bind Card.NotFavoriteVisibility, Mode=OneWay}" />
                                <FontIcon FontSize="20" Foreground="{ThemeResource EgDangerBrush}" Glyph="&#xEB52;" Visibility="{x:Bind Card.FavoriteVisibility, Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="MoreButton"
                            x:Uid="PosterCard_MoreButton"
                            Click="OnMoreClicked"
                            Style="{StaticResource EgCardActionButtonStyle}">
                            <FontIcon FontSize="20" Glyph="&#xE712;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="{x:Bind Card.TextMargin, Mode=OneWay}">
            <TextBlock
                x:Name="TitleLine"
                Foreground="{ThemeResource EgOnScrimBrush}"
                FontWeight="SemiBold"
                MaxLines="1"
                Style="{StaticResource EgBodyStyle}"
                Text="{x:Bind Card.Title, Mode=OneWay}"
                Visibility="{x:Bind Card.TitleVisibility, Mode=OneWay}"
                TextAlignment="{x:Bind Card.TitleAlignment, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind Card.Title, Mode=OneWay}" />
            <TextBlock
                x:Name="SubLine"
                Foreground="{ThemeResource EgOnScrimBrush}"
                MaxLines="1"
                Style="{StaticResource EgDataStyle}"
                Text="{x:Bind Card.Subtitle, Mode=OneWay}"
                Visibility="{x:Bind Card.SubtitleVisibility, Mode=OneWay}"
                TextAlignment="{x:Bind Card.TitleAlignment, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Card.Subtitle, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <!-- 第三行：多账号主页的继续观看卡在季集下面写服务器名；别的卡片整行收起。 -->
            <TextBlock
                x:Name="SourceLine"
                MaxLines="1"
                Style="{StaticResource EgCaptionStyle}"
                Foreground="{ThemeResource EgOnScrimBrush}"
                Text="{x:Bind Card.SourceLine, Mode=OneWay}"
                Visibility="{x:Bind Card.SourceLineVisibility, Mode=OneWay}"
                TextAlignment="{x:Bind Card.TitleAlignment, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <!-- 第三行：宣传语或概要。媒体库设置里勾了才有，没勾时整行收起（一个像素都不占）。 -->
            <TextBlock
                x:Name="NoteLine"
                MaxLines="1"
                Style="{StaticResource EgCaptionStyle}"
                Foreground="{ThemeResource EgOnScrimBrush}"
                Text="{x:Bind Card.Note, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind Card.NoteVisibility, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
