<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Momoka.Shell.Views.AniBtResourceBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momoka.Shell.Views" xmlns:vm="using:Momoka.Shell.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="ReleaseTemplate" x:DataType="vm:AniBtResourceRow">
            <Grid Padding="0,12" BorderBrush="{ThemeResource EgBorderBrush}" BorderThickness="0,1,0,0" RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{x:Bind Title}" Style="{StaticResource EgBodyStyle}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3"
                    TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                <local:WrapRow Grid.Row="1" Spacing="8" RowSpacing="8">
                    <TextBlock Text="{x:Bind EpisodeText}" Style="{StaticResource EgCaptionStyle}" VerticalAlignment="Center" />
                    <Border Padding="5,2" CornerRadius="4" Background="{ThemeResource EgAccentSoftBrush}" Visibility="{x:Bind ResolutionVisibility}">
                        <TextBlock Text="{x:Bind ResolutionText}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}" />
                    </Border>
                    <Border Padding="5,2" CornerRadius="4" Background="{ThemeResource EgSurfaceAltBrush}" Visibility="{x:Bind LanguageVisibility}">
                        <TextBlock Text="{x:Bind LanguageText}" Style="{StaticResource EgCaptionStyle}" />
                    </Border>
                    <TextBlock Text="{x:Bind TechnicalText}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextDimBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource EgDataStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind PublishedText}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextFaintBrush}" VerticalAlignment="Center" />
                    <Button x:Name="OpenTorrentPage" Content="发布页" Command="{x:Bind OpenDetailsCommand}" Style="{StaticResource EgSecondaryButtonStyle}"
                        Padding="10,4" AutomationProperties.Name="{x:Bind DetailsAutomationName}" />
                    <Button x:Name="DownloadResource" Content="{x:Bind DownloadLabel, Mode=OneWay}" Command="{x:Bind DownloadCommand}"
                        Style="{StaticResource EgPrimaryButtonStyle}" Padding="12,4" AutomationProperties.Name="{x:Bind DownloadAutomationName}"
                        Visibility="{x:Bind DownloadVisibility}" />
                </local:WrapRow>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Spacing="12">
        <toolkit:Segmented x:Name="ReleaseTabs" SelectedIndex="{x:Bind ViewModel.ViewIndex, Mode=TwoWay}"
            HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.TabsVisibility, Mode=OneWay}">
            <toolkit:SegmentedItem Content="{x:Bind ViewModel.ProgressTabText, Mode=OneWay}" />
            <toolkit:SegmentedItem Content="{x:Bind ViewModel.ResourcesTabText, Mode=OneWay}" />
        </toolkit:Segmented>
        <ItemsRepeater x:Name="ProgressList" ItemsSource="{x:Bind ViewModel.ProgressGroups, Mode=OneWay}" Visibility="{x:Bind ViewModel.ProgressVisibility, Mode=OneWay}">
            <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:AniBtResourceGroup">
                    <Border Padding="16" Background="{ThemeResource EgSurfaceBrush}" CornerRadius="{StaticResource EgCardCornerRadius}">
                        <StackPanel Spacing="10">
                            <local:WrapRow Spacing="14" RowSpacing="8">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource EgSubheadStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind PublishedText}" Style="{StaticResource EgDataStyle}" VerticalAlignment="Center" />
                                <Button x:Name="CopyGroupProgressRss" Content="复制 RSS 链接" Click="OnCopyGroupRss" Tag="{x:Bind}"
                                    Style="{StaticResource EgSecondaryButtonStyle}" Visibility="{x:Bind RssVisibility}" />
                            </local:WrapRow>
                            <ItemsRepeater ItemsSource="{x:Bind Cells}">
                                <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="30" MinItemHeight="30" MinColumnSpacing="4" MinRowSpacing="4" ItemsStretch="Fill" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AniBtProgressCell">
                                        <Grid ToolTipService.ToolTip="{x:Bind Description}" AutomationProperties.Name="{x:Bind Description}">
                                            <Border Height="5" VerticalAlignment="Bottom" Background="{ThemeResource EgAccentBrush}" Opacity="{x:Bind FillOpacity}" CornerRadius="2" />
                                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextDimBrush}"
                                                HorizontalAlignment="Center" Margin="0,0,0,9" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
        <StackPanel x:Name="ResourcesContent" Spacing="10" Visibility="{x:Bind ViewModel.ResourcesVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.FiltersVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="ReleaseFilter" PlaceholderText="筛选资源标题、字幕组或清晰度" MinWidth="0"
                    Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="筛选 AniBT 发布" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" Style="{StaticResource EgDataStyle}" VerticalAlignment="Center" />
            </Grid>
            <local:WrapRow Spacing="8" RowSpacing="8" Visibility="{x:Bind ViewModel.FiltersVisibility, Mode=OneWay}">
                <local:EgPicker x:Name="EpisodeFilter" MinWidth="112" AutomationProperties.Name="按集筛选"
                    ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedEpisode, Mode=TwoWay}" />
                <local:EgPicker x:Name="GroupFilter" MinWidth="136" AutomationProperties.Name="按字幕组筛选"
                    ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}" />
                <local:EgPicker x:Name="ResolutionFilter" MinWidth="120" AutomationProperties.Name="按清晰度筛选"
                    ItemsSource="{x:Bind ViewModel.Resolutions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedResolution, Mode=TwoWay}" />
                <local:EgPicker x:Name="SortOrder" MinWidth="128" AutomationProperties.Name="发布排序" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                    <x:String>最新发布</x:String><x:String>最早发布</x:String><x:String>体积最大</x:String><x:String>体积最小</x:String>
                </local:EgPicker>
                <Button x:Name="ResetFilters" Content="清除筛选" Command="{x:Bind ViewModel.ResetFiltersCommand}"
                    Style="{StaticResource EgSecondaryButtonStyle}" Visibility="{x:Bind ViewModel.ResetVisibility, Mode=OneWay}" />
            </local:WrapRow>
            <ItemsRepeater x:Name="ReleaseList" ItemsSource="{x:Bind ViewModel.ResourceGroups, Mode=OneWay}">
                <ItemsRepeater.Layout><StackLayout Spacing="10" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:AniBtResourceGroup">
                        <Expander x:Name="ReleaseGroup" IsExpanded="{x:Bind IsOpen, Mode=TwoWay}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Bind Name}">
                            <Expander.Header>
                                <local:WrapRow Spacing="10" RowSpacing="8">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource EgSubheadStyle}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind CountText}" Style="{StaticResource EgCaptionStyle}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Metadata}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextDimBrush}" VerticalAlignment="Center" />
                                </local:WrapRow>
                            </Expander.Header>
                            <StackPanel Spacing="6">
                                <local:WrapRow Spacing="12" RowSpacing="6">
                                    <Button x:Name="CopyGroupRss" Content="复制本组 RSS" Click="OnCopyGroupRss" Tag="{x:Bind}"
                                        Style="{StaticResource EgSecondaryButtonStyle}" Visibility="{x:Bind RssVisibility}" />
                                    <TextBlock Text="{x:Bind ScopeText}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextDimBrush}"
                                        VerticalAlignment="Center" Visibility="{x:Bind ScopeVisibility}" />
                                </local:WrapRow>
                                <ItemsRepeater ItemsSource="{x:Bind VisibleRows}" ItemTemplate="{StaticResource ReleaseTemplate}" />
                                <Button x:Name="ExpandGroupResources" Content="{x:Bind MoreText, Mode=OneWay}" Command="{x:Bind ToggleMoreCommand}"
                                    HorizontalAlignment="Center" Style="{StaticResource EgSecondaryButtonStyle}" Visibility="{x:Bind MoreVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <StackPanel x:Name="NoMatches" Margin="16,24" Spacing="8" Visibility="{x:Bind ViewModel.NoMatchesVisibility, Mode=OneWay}">
                <TextBlock Text="没有符合筛选条件的发布" Style="{StaticResource EgSubheadStyle}" TextWrapping="Wrap" />
                <TextBlock Text="可清除筛选后查看全部发布。" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextDimBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock x:Name="NoReleases" Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" Style="{StaticResource EgBodyStyle}" Margin="16,24"
                TextWrapping="Wrap" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />
        </StackPanel>
        <InfoBar x:Name="RssNotice" IsOpen="False" IsClosable="True" />
    </StackPanel>
</UserControl>
