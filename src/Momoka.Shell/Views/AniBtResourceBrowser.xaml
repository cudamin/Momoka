<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Momoka.Shell.Views.AniBtResourceBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momoka.Shell.Views" xmlns:vm="using:Momoka.Shell.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.Segmented/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ReleaseActionButtonStyle" TargetType="Button" BasedOn="{StaticResource EgResourceButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <DataTemplate x:Key="ReleaseTemplate" x:DataType="vm:AniBtResourceRow">
                <Grid x:Name="ReleaseRow" Padding="0,6" BorderBrush="{ThemeResource EgBorderBrush}" BorderThickness="0,1,0,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel x:Name="ReleaseText" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource EgBodyStyle}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3"
                            TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                        <local:WrapRow Spacing="8" RowSpacing="6">
                            <TextBlock Text="{x:Bind EpisodeText}" Style="{StaticResource EgCaptionStyle}" VerticalAlignment="Center" />
                            <Border Padding="5,2" CornerRadius="3" Background="{ThemeResource EgSurfaceAltBrush}" Visibility="{x:Bind ResolutionVisibility}">
                                <TextBlock Text="{x:Bind ResolutionText}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgInfoBrush}" />
                            </Border>
                            <Border Padding="5,2" CornerRadius="3" Background="{ThemeResource EgSurfaceAltBrush}" Visibility="{x:Bind LanguageVisibility}">
                                <TextBlock Text="{x:Bind LanguageText}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}" />
                            </Border>
                            <TextBlock Text="{x:Bind TechnicalText}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextDimBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind PublishedText}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextFaintBrush}" VerticalAlignment="Center" />
                        </local:WrapRow>
                    </StackPanel>
                    <StackPanel x:Name="ReleaseActions" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="OpenTorrentPage" Command="{x:Bind OpenDetailsCommand}" Style="{StaticResource ReleaseActionButtonStyle}"
                            ToolTipService.ToolTip="打开发布页" AutomationProperties.Name="{x:Bind DetailsAutomationName}">
                            <FontIcon Glyph="&#xE71B;" FontSize="{StaticResource EgBodyFontSize}" />
                        </Button>
                        <Button x:Name="DownloadResource" Command="{x:Bind DownloadCommand}" Style="{StaticResource ReleaseActionButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind DownloadLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind DownloadAutomationName, Mode=OneWay}"
                            Visibility="{x:Bind DownloadVisibility}">
                            <FontIcon Glyph="{x:Bind DownloadGlyph, Mode=OneWay}" FontSize="{StaticResource EgBodyFontSize}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel x:Name="ReleaseContent" Spacing="8">
        <toolkit:Segmented x:Name="ReleaseTabs" Style="{StaticResource PivotSegmentedStyle}"
            SelectedIndex="{x:Bind ViewModel.ViewIndex, Mode=TwoWay}"
            HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.TabsVisibility, Mode=OneWay}">
            <toolkit:Segmented.Resources>
                <StaticResource x:Key="PivotItemPillBackground" ResourceKey="EgAccentBrush" />
                <StaticResource x:Key="PivotItemPillBackgroundPointerOver" ResourceKey="EgAccentHoverBrush" />
                <StaticResource x:Key="PivotItemPillBackgroundPressed" ResourceKey="EgAccentPressedBrush" />
                <StaticResource x:Key="PivotItemPillBackgroundDisabled" ResourceKey="EgTextFaintBrush" />
            </toolkit:Segmented.Resources>
            <toolkit:SegmentedItem x:Name="ProgressTab" Style="{StaticResource PivotSegmentedItemStyle}" Content="{x:Bind ViewModel.ProgressTabText, Mode=OneWay}" />
            <toolkit:SegmentedItem x:Name="ResourcesTab" Style="{StaticResource PivotSegmentedItemStyle}" Content="{x:Bind ViewModel.ResourcesTabText, Mode=OneWay}" />
        </toolkit:Segmented>
        <ItemsRepeater x:Name="ProgressList" ItemsSource="{x:Bind ViewModel.ProgressGroups, Mode=OneWay}" Visibility="{x:Bind ViewModel.ProgressVisibility, Mode=OneWay}">
            <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:AniBtResourceGroup">
                    <!-- 进度卡与资源折叠组都复用设置卡片的低透明度亚克力；格子、标签和长标题的层级不变。 -->
                    <Border x:Name="ProgressCard" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{StaticResource EgCardCornerRadius}">
                        <StackPanel Spacing="6">
                            <local:WrapRow Spacing="14" RowSpacing="8">
                                <Border x:Name="GroupLogoSurface" Width="24" Height="24" CornerRadius="{StaticResource EgCornerBadgeCornerRadius}"
                                    VerticalAlignment="Center" Visibility="{x:Bind LogoVisibility, Mode=OneWay}">
                                    <Image x:Name="GroupLogo" Source="{x:Bind local:AniBtResourceBrowser.CreateGroupLogo(LogoUrl), Mode=OneWay}" Stretch="UniformToFill" Tag="{x:Bind}"
                                        ImageFailed="OnGroupLogoFailed" AutomationProperties.AccessibilityView="Raw" />
                                </Border>
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource EgSubheadStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind PublishedText}" Style="{StaticResource EgDataStyle}" VerticalAlignment="Center" />

                            </local:WrapRow>
                            <ItemsRepeater ItemsSource="{x:Bind Cells}">
                                <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="30" MinItemHeight="30" MinColumnSpacing="4" MinRowSpacing="4" ItemsStretch="Fill" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AniBtProgressCell">
                                        <Grid ToolTipService.ToolTip="{x:Bind Description}" AutomationProperties.Name="{x:Bind Description}">
                                            <Border Height="5" VerticalAlignment="Bottom" Background="{ThemeResource EgAccentBrush}" Opacity="{x:Bind FillOpacity}" CornerRadius="2" />
                                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextDimBrush}"
                                                HorizontalAlignment="Center" Margin="0,0,0,9" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
        <StackPanel x:Name="ResourcesContent" Spacing="8" Visibility="{x:Bind ViewModel.ResourcesVisibility, Mode=OneWay}">
            <ItemsRepeater x:Name="ReleaseList" ItemsSource="{x:Bind ViewModel.ResourceGroups, Mode=OneWay}">
                <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:AniBtResourceGroup">
                        <Expander x:Name="ReleaseGroup" IsExpanded="{x:Bind IsOpen, Mode=TwoWay}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource EgBorderBrush}"
                            AutomationProperties.Name="{x:Bind Name}">
                            <Expander.Header>
                                <local:WrapRow Spacing="10" RowSpacing="8">
                                    <Border x:Name="GroupLogoSurface" Width="24" Height="24" CornerRadius="{StaticResource EgCornerBadgeCornerRadius}"
                                        VerticalAlignment="Center" Visibility="{x:Bind LogoVisibility, Mode=OneWay}">
                                        <Image x:Name="GroupLogo" Source="{x:Bind local:AniBtResourceBrowser.CreateGroupLogo(LogoUrl), Mode=OneWay}" Stretch="UniformToFill" Tag="{x:Bind}"
                                            ImageFailed="OnGroupLogoFailed" AutomationProperties.AccessibilityView="Raw" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource EgSubheadStyle}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind CountText}" Style="{StaticResource EgCaptionStyle}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Metadata}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextDimBrush}" VerticalAlignment="Center" />
                                </local:WrapRow>
                            </Expander.Header>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind ScopeText}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextDimBrush}"
                                    Visibility="{x:Bind ScopeVisibility}" />
                                <ItemsRepeater ItemsSource="{x:Bind VisibleRows}" ItemTemplate="{StaticResource ReleaseTemplate}" />
                                <Button x:Name="ExpandGroupResources" Content="{x:Bind MoreText, Mode=OneWay}" Command="{x:Bind ToggleMoreCommand}"
                                    HorizontalAlignment="Center" Style="{StaticResource EgResourceButtonStyle}" Visibility="{x:Bind MoreVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <TextBlock x:Name="NoReleases" Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" Style="{StaticResource EgBodyStyle}" Margin="16,24"
                TextWrapping="Wrap" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />
        </StackPanel>
    </StackPanel>
</UserControl>
