<?xml version="1.0" encoding="utf-8"?>
<!--
  AniBT 自己的发布列表。MoviePilot 那份资源浏览器围绕站点、优惠、季集和 HR 组织，
  这一页只有 AniBT RSS 给的几件事：字幕组、集号、清晰度、体积与发布时间。所以不复用它，
  也不把 MoviePilot 的筛选概念搬过来。
-->
<UserControl
    x:Class="Momoka.Shell.Views.AniBtResourceBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momoka.Shell.Views"
    xmlns:vm="using:Momoka.Shell.ViewModels">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.FiltersVisibility, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ReleaseFilter" PlaceholderText="筛选标题、字幕组或清晰度"
                MinWidth="0" Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="筛选 AniBT 发布" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" Style="{StaticResource EgDataStyle}"
                VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis" />
        </Grid>
        <local:WrapRow Grid.Row="1" Spacing="8" RowSpacing="8"
            Visibility="{x:Bind ViewModel.FiltersVisibility, Mode=OneWay}">
            <!-- 不给每颗下拉写 Header：360 宽上四个 Header 会各占一行，把发布列表挤到首屏之外。
                 选中项本身就是说明（全部集数／全部字幕组／全部清晰度／最新发布），读屏名另给。 -->
            <local:EgPicker x:Name="EpisodeFilter" MinWidth="112" AutomationProperties.Name="按集筛选"
                ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedEpisode, Mode=TwoWay}" />
            <local:EgPicker x:Name="GroupFilter" MinWidth="136" AutomationProperties.Name="按字幕组筛选"
                ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}" />
            <local:EgPicker x:Name="ResolutionFilter" MinWidth="120" AutomationProperties.Name="按清晰度筛选"
                ItemsSource="{x:Bind ViewModel.Resolutions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedResolution, Mode=TwoWay}" />
            <local:EgPicker x:Name="SortOrder" MinWidth="128" AutomationProperties.Name="发布排序"
                SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                <x:String>最新发布</x:String>
                <x:String>最早发布</x:String>
                <x:String>体积最大</x:String>
                <x:String>体积最小</x:String>
            </local:EgPicker>
            <Button x:Name="ResetFilters" Content="清除筛选" Command="{x:Bind ViewModel.ResetFiltersCommand}"
                Style="{StaticResource EgSecondaryButtonStyle}" VerticalAlignment="Bottom"
                Visibility="{x:Bind ViewModel.ResetVisibility, Mode=OneWay}" />
        </local:WrapRow>
        <ListView x:Name="ReleaseList" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
            SelectionMode="None" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch">
            <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:AniBtResourceRow">
                    <Grid Padding="14,12" ColumnSpacing="12" RowSpacing="6" Background="{ThemeResource EgSurfaceBrush}"
                        BorderBrush="{ThemeResource EgBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource EgPosterCornerRadius}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 集号那一格：数字集号两位，合集与未标集号就写“合集”。
                             按钮另起一行，窄窗里标题不必给两颗键让出大半条宽度。 -->
                        <Border Grid.RowSpan="2" Width="44" Height="44" CornerRadius="10"
                            Background="{ThemeResource EgAccentSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Text="{x:Bind EpisodeBadge}" Style="{StaticResource EgDataStrongStyle}"
                                FontSize="{StaticResource EgSubheadFontSize}" Foreground="{ThemeResource EgAccentBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="5">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource EgBodyStyle}"
                                    TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Title}" />
                                <Border Grid.Column="1" Background="{ThemeResource EgAccentBrush}"
                                    CornerRadius="{StaticResource EgCornerBadgeCornerRadius}" Padding="6,1"
                                    VerticalAlignment="Top" Visibility="{x:Bind RecentVisibility}">
                                    <TextBlock Text="新" Style="{StaticResource EgCornerBadgeTextStyle}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{x:Bind MetaLine}" Style="{StaticResource EgCaptionStyle}"
                                Foreground="{ThemeResource EgTextDimBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" Spacing="8">
                            <Button x:Name="OpenTorrentPage" Content="种子页" Command="{x:Bind OpenDetailsCommand}"
                                Style="{StaticResource EgSecondaryButtonStyle}" Padding="12,6"
                                AutomationProperties.Name="{x:Bind DetailsAutomationName}"
                                ToolTipService.ToolTip="在浏览器打开 AniBT 发布页，不会开始下载" />
                            <Button x:Name="DownloadResource" Content="{x:Bind DownloadLabel, Mode=OneWay}"
                                Command="{x:Bind DownloadCommand}" Style="{StaticResource EgPrimaryButtonStyle}"
                                MinWidth="96" Padding="16,8" AutomationProperties.Name="{x:Bind DownloadAutomationName}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="NoMatches" Grid.Row="2" Margin="24,40" HorizontalAlignment="Center" VerticalAlignment="Top"
            Spacing="8" Visibility="{x:Bind ViewModel.NoMatchesVisibility, Mode=OneWay}">
            <FontIcon Glyph="&#xE721;" FontSize="{StaticResource EgTitleFontSize}"
                Foreground="{ThemeResource EgTextFaintBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="没有符合筛选条件的发布" Style="{StaticResource EgSubheadStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="可清除筛选后查看全部发布。" Style="{StaticResource EgCaptionStyle}"
                Foreground="{ThemeResource EgTextDimBrush}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="NoReleases" Grid.Row="2" Margin="24,40" HorizontalAlignment="Center" VerticalAlignment="Top"
            Spacing="8" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
            <FontIcon Glyph="&#xE896;" FontSize="{StaticResource EgTitleFontSize}"
                Foreground="{ThemeResource EgTextFaintBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" Style="{StaticResource EgBodyStyle}"
                TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
        </StackPanel>
    </Grid>
</UserControl>
