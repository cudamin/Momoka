<?xml version="1.0" encoding="utf-8"?>
<!--
  飞牛的「管理版本」：列出 media/itemfile 交回来的文件。官方页面在这张表上还能改季集号、重新匹配；
  保留原删除入口，并提供仅移出且保留文件；两种操作都在下一步单独确认。
-->
<ContentDialog x:Class="Momoka.Shell.Views.FnNasVersionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fn="using:Momoka.FnNas"
    Title="管理版本"
    PrimaryButtonText="删除所选版本"
    SecondaryButtonText=""
    CloseButtonText="关闭"
    IsPrimaryButtonEnabled="False">

    <ContentDialog.Resources>
        <!-- The framework adds a top-only overlay; keep the complete library window on the sidebar color. -->
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="LayerFillColorDefaultBrush" />
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="12">
        <TextBlock
            Foreground="{ThemeResource EgTextDimBrush}"
            Style="{StaticResource EgCaptionStyle}"
            Text="选择一个版本。删除会删除磁盘文件；移出仅从媒体库移除并保留文件，可在“已移除文件”中恢复。下一步会单独确认。"
            TextWrapping="Wrap" />

        <ListView
            x:Name="Files"
            AutomationProperties.Name="版本列表"
            Padding="{StaticResource EgScrollBarLane}"
            MaxHeight="320"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="44" />
                    <Setter Property="Padding" Value="10,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="fn:FnNasVersion">
                    <StackPanel Spacing="2">
                        <TextBlock
                            Style="{StaticResource EgBodyStyle}"
                            Text="{x:Bind Path}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Path}" />
                        <TextBlock
                            Foreground="{ThemeResource EgTextDimBrush}"
                            Style="{StaticResource EgCaptionStyle}"
                            Text="{x:Bind Detail}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
