<?xml version="1.0" encoding="utf-8"?>
<!--
  飞牛的「管理版本」：列出 media/itemfile 交回来的文件。官方页面在这张表上还能改季集号、重新匹配；
  这里只做这个客户端说得清的一件事 —— 看清单，选一个删掉，删除前再问一次。
-->
<ContentDialog x:Class="Momoka.Shell.Views.FnNasVersionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fn="using:Momoka.FnNas"
    Title="管理版本"
    PrimaryButtonText="删除所选版本"
    CloseButtonText="关闭"
    IsPrimaryButtonEnabled="False">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="12">
        <TextBlock
            Foreground="{ThemeResource EgTextDimBrush}"
            Style="{StaticResource EgCaptionStyle}"
            Text="这是服务器上属于这个条目的文件。删除版本会同时删除磁盘上的文件，下一步还会再确认一次。"
            TextWrapping="Wrap" />

        <ListView
            x:Name="Files"
            AutomationProperties.Name="版本列表"
            MaxHeight="320"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="44" />
                    <Setter Property="Padding" Value="10,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="fn:FnNasVersion">
                    <StackPanel Spacing="2">
                        <TextBlock
                            Style="{StaticResource EgBodyStyle}"
                            Text="{x:Bind Path}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Path}" />
                        <TextBlock
                            Foreground="{ThemeResource EgTextDimBrush}"
                            Style="{StaticResource EgCaptionStyle}"
                            Text="{x:Bind Detail}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
