<?xml version="1.0" encoding="utf-8"?>
<!--
  筛选面板：网页端 modules/filtermenu 那一块（4.10.1.0）。

  每一行是「标签在上、控件在下」，开关行是「标签在左、开关在右」；功能 / 元数据 / 缺少元数据 三组各有一行标题，
  标题只出现在该组第一行前面（见 FilterPanelViewModel.Build）。行与顺序都是 EmbyFilterBy.Fields 的事，
  这里只有三种形状：下拉、开关、可勾选的下拉。

  面板自己铺一层实底：它盖在卡片墙上，浮层默认是亚克力的，底下的海报会透上来。网页端这块也是个模态框。
-->
<UserControl
    x:Class="Momoka.Shell.Views.FilterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momoka.Shell.Views"
    xmlns:vm="using:Momoka.Shell.ViewModels"
    Width="440">

    <UserControl.Resources>
        <!-- 一行控件的标签。比正文小一档、比背景亮一档：它是控件的名字，不是一段话。 -->
        <Style x:Key="EgFilterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource EgCaptionFontSize}" />
            <Setter Property="Foreground" Value="{ThemeResource EgTextDimBrush}" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>

        <!-- 功能 / 元数据 / 缺少元数据。比行标签重一档、大一点，上面留出比行距更宽的一段空白，
             读起来是「下一组从这里开始」，而不是「又一行」。 -->
        <Style x:Key="EgFilterHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource EgSubheadStyle}">
            <Setter Property="Margin" Value="2,16,0,2" />
        </Style>

        <!-- 可勾选的下拉：合起来是一颗和 ComboBox 同高同宽的键，右边一个向下的小箭头。 -->
        <Style x:Key="EgFilterPickerStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource EgSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="{StaticResource EgCaptionFontSize}" />
        </Style>

        <local:FilterSectionTemplates x:Key="EgFilterRows">

            <!-- 下拉：标签在上，控件占满一行。 -->
            <local:FilterSectionTemplates.Select>
                <DataTemplate x:DataType="vm:FilterSelectRow">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EgFilterHeadingStyle}" Text="{x:Bind Heading}" Visibility="{x:Bind HeadingVisibility}" />
                        <TextBlock Style="{StaticResource EgFilterLabelStyle}" Text="{x:Bind Label}" />
                        <ComboBox
                            AutomationProperties.Name="{x:Bind Label}"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind Choices}"
                            SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}" />
                    </StackPanel>
                </DataTemplate>
            </local:FilterSectionTemplates.Select>

            <!-- 开关：标签在左，开关在右。 -->
            <local:FilterSectionTemplates.Switch>
                <DataTemplate x:DataType="vm:FilterSwitchRow">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EgFilterHeadingStyle}" Text="{x:Bind Heading}" Visibility="{x:Bind HeadingVisibility}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource EgFilterLabelStyle}" Margin="2,0,0,0" Text="{x:Bind Label}" VerticalAlignment="Center" />
                            <ToggleSwitch
                                Grid.Column="1"
                                AutomationProperties.Name="{x:Bind Label}"
                                IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                MinWidth="0"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </local:FilterSectionTemplates.Switch>

            <!-- 可勾选的下拉：合起来写着「全部」或「已选 N 项」，点开是一列复选框。 -->
            <local:FilterSectionTemplates.Values>
                <DataTemplate x:DataType="vm:FilterValuesRow">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EgFilterLabelStyle}" Text="{x:Bind Label}" />
                        <Button
                            AutomationProperties.Name="{x:Bind Label}"
                            Click="OnValuesClicked"
                            Style="{StaticResource EgFilterPickerStyle}"
                            ToolTipService.ToolTip="{x:Bind Summary, Mode=OneWay}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{x:Bind Summary, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />
                                <FontIcon
                                    Grid.Column="1"
                                    FontSize="{StaticResource EgEyebrowFontSize}"
                                    Glyph="&#xE70D;"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <Button.Flyout>
                                <!-- 第一次打开才去问服务器（见 FilterValuesRow.OnIsOpenChanged）。 -->
                                <Flyout
                                    Placement="BottomEdgeAlignedLeft"
                                    Closed="OnValuesClosed">
                                    <ScrollViewer MaxHeight="320" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Width="240" Spacing="4">
                                            <TextBlock
                                                Style="{StaticResource EgFilterLabelStyle}"
                                                Text="{x:Bind Note, Mode=OneWay}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                                            <ItemsControl ItemsSource="{x:Bind Values, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:FilterCheck">
                                                        <CheckBox
                                                            Content="{x:Bind Label}"
                                                            IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                            MinWidth="0"
                                                            Padding="8,4,0,4" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </DataTemplate>
            </local:FilterSectionTemplates.Values>
        </local:FilterSectionTemplates>
    </UserControl.Resources>

    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource EgBorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="16,12,12,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="FilterCloseButton"
                    AutomationProperties.Name="关闭筛选"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCloseClicked"
                    Padding="8"
                    ToolTipService.ToolTip="关闭">
                    <FontIcon FontSize="{StaticResource EgBodyFontSize}" Glyph="&#xE711;" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource EgSubheadStyle}"
                    Text="筛选" />
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                MaxHeight="560"
                Padding="16,0,16,16"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">
                    <ItemsControl
                        x:Name="FilterRows"
                        x:FieldModifier="internal"
                        ItemTemplateSelector="{StaticResource EgFilterRows}"
                        ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- 一次清空。网页端把它放在对话框头上；这里放在最下面一行 —— 它不是一条筛选，不该抢在
                         第一屏最显眼的位置，而滚到底的人正是一路点下来、想找它的那个人。 -->
                    <HyperlinkButton
                        x:Name="FilterClearButton"
                        x:FieldModifier="internal"
                        x:Uid="FilterPanel_HyperlinkButton1"
                        AutomationProperties.AutomationId="FilterClearButton"
                        Command="{x:Bind ViewModel.ClearCommand}"
                        Margin="0,4,0,0"
                        Padding="4,2,4,2" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
