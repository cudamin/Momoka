<Page
    x:Class="Momoka.Shell.Views.MoviePilotCalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momoka.Shell.Views"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Background="Transparent">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.Segmented/SegmentedItem/SegmentedItem.xaml" />
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.Segmented/Segmented/Segmented.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="ButtonItemBackgroundSelected" ResourceKey="EgAccentSoftBrush" />
                    <StaticResource x:Key="ButtonItemBackgroundSelectedPointerOver" ResourceKey="EgAccentSoftBrush" />
                    <StaticResource x:Key="ButtonItemBackgroundSelectedPressed" ResourceKey="EgAccentSoftBrush" />
                    <StaticResource x:Key="ButtonItemForegroundSelected" ResourceKey="AccentTextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ButtonItemForegroundSelectedPointerOver" ResourceKey="AccentTextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ButtonItemForegroundSelectedPressed" ResourceKey="AccentTextFillColorPrimaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="ButtonItemBackgroundSelected" ResourceKey="EgAccentSoftBrush" />
                    <StaticResource x:Key="ButtonItemBackgroundSelectedPointerOver" ResourceKey="EgAccentSoftBrush" />
                    <StaticResource x:Key="ButtonItemBackgroundSelectedPressed" ResourceKey="EgAccentSoftBrush" />
                    <StaticResource x:Key="ButtonItemForegroundSelected" ResourceKey="AccentTextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ButtonItemForegroundSelectedPointerOver" ResourceKey="AccentTextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ButtonItemForegroundSelectedPressed" ResourceKey="AccentTextFillColorPrimaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast" />
            </ResourceDictionary.ThemeDictionaries>
            <!-- 2026-11-27 用户令「参考图一原码修改图二」：日历页的来源与类型两排跟搜索来源栏同一套几何 ——
                 整条 32 DIP、16 圆角、不描边、用同一块卡片材质；胶囊 24 DIP、12 圆角、12 号半粗字。 -->
            <Style x:Key="CalendarSegmentedStyle" TargetType="local:SearchSourceTabs" BasedOn="{StaticResource ButtonSegmentedStyle}">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource EgSegmentedTrackCornerRadius}" />
                <Setter Property="Padding" Value="4" />
            </Style>
            <Style x:Key="CalendarSegmentedItemStyle" TargetType="toolkit:SegmentedItem" BasedOn="{StaticResource ButtonSegmentedItemStyle}">
                <Setter Property="CornerRadius" Value="{StaticResource EgSegmentedItemCornerRadius}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="FontSize" Value="{StaticResource EgCaptionFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CalendarWeekdayStyle" TargetType="TextBlock" BasedOn="{StaticResource EgCaptionStyle}" />
            <Style x:Key="CalendarDateStyle" TargetType="TextBlock" BasedOn="{StaticResource EgBodyStyle}">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CalendarAdjacentDateStyle" TargetType="TextBlock" BasedOn="{StaticResource CalendarDateStyle}">
                <Setter Property="Foreground" Value="{ThemeResource EgTextDimBrush}" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style x:Key="CalendarTodayDateStyle" TargetType="TextBlock" BasedOn="{StaticResource CalendarDateStyle}">
                <Setter Property="Foreground" Value="{ThemeResource EgTextOnAccentBrush}" />
            </Style>
            <Style x:Key="CalendarTodayBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource EgAccentBrush}" />
            </Style>
            <Style x:Key="CalendarDayCellStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    <Grid x:Name="CalendarLayout" Padding="24,16,24,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="CalendarToolbar" ColumnSpacing="8" RowSpacing="4" SizeChanged="OnToolbarSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="MonthTitle" Style="{StaticResource EgSubpageTitleStyle}" VerticalAlignment="Center"
                TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" AutomationProperties.LiveSetting="Polite" />
            <StackPanel x:Name="MonthActions" Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Uid="MoviePilotCalendarPage_CurrentMonth" x:Name="CurrentMonth" Content="今天" Click="OnToday" />
                <Button x:Uid="MoviePilotCalendarPage_PreviousMonth" x:Name="PreviousMonth" Click="OnPreviousMonth" Style="{StaticResource EgIconButtonStyle}" AutomationProperties.Name="上个月" ToolTipService.ToolTip="上个月">
                    <FontIcon Glyph="&#xE76B;" />
                </Button>
                <Button x:Uid="MoviePilotCalendarPage_NextMonth" x:Name="NextMonth" Click="OnNextMonth" Style="{StaticResource EgIconButtonStyle}" AutomationProperties.Name="下个月" ToolTipService.ToolTip="下个月">
                    <FontIcon Glyph="&#xE76C;" />
                </Button>
                <Button x:Uid="MoviePilotCalendarPage_RefreshCalendar" x:Name="RefreshCalendar" Click="OnRefresh" Style="{StaticResource EgIconButtonStyle}" AutomationProperties.Name="刷新日历" ToolTipService.ToolTip="刷新">
                    <FontIcon Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </Grid>
        <local:WrapRow Grid.Row="1" Spacing="16" RowSpacing="8">
            <TextBlock x:Name="SingleCalendarSource" Style="{StaticResource EgBodyStyle}" VerticalAlignment="Center"
                Margin="0,7" Visibility="Collapsed" />
            <local:SearchSourceTabs x:Uid="MoviePilotCalendarPage_CalendarSources" x:Name="CalendarSources"
                Style="{StaticResource CalendarSegmentedStyle}" ItemContainerStyle="{StaticResource CalendarSegmentedItemStyle}"
                SelectionChanged="OnSourceChanged" AutomationProperties.Name="日历来源" Visibility="Collapsed">
                <toolkit:SegmentedItem x:Uid="MoviePilotCalendarPage_MoviePilotSource" x:Name="MoviePilotCalendarSource" Content="MoviePilot 订阅" />
                <toolkit:SegmentedItem x:Uid="MoviePilotCalendarPage_AniBtSource" x:Name="AniBtCalendarSource" Content="AniBT 番剧" />
            </local:SearchSourceTabs>
            <local:SearchSourceTabs x:Uid="MoviePilotCalendarPage_MediaType" x:Name="MediaType"
                Style="{StaticResource CalendarSegmentedStyle}" ItemContainerStyle="{StaticResource CalendarSegmentedItemStyle}"
                SelectionChanged="OnMediaTypeChanged" AutomationProperties.Name="媒体类型">
                <toolkit:SegmentedItem x:Uid="MoviePilotCalendarPage_AllMedia" x:Name="AllMedia" Content="全部" />
                <toolkit:SegmentedItem x:Uid="MoviePilotCalendarPage_MovieMedia" x:Name="MovieMedia" Content="电影" />
                <toolkit:SegmentedItem x:Uid="MoviePilotCalendarPage_SeriesMedia" x:Name="SeriesMedia" Content="电视剧" />
            </local:SearchSourceTabs>
        </local:WrapRow>
        <StackPanel Grid.Row="2" Spacing="6">
            <Grid Height="4">
                <ProgressBar IsIndeterminate="{x:Bind ViewModel.Busy, Mode=OneWay}" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
            </Grid>
            <InfoBar x:Name="CalendarNotice" IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=OneWay}" IsClosable="False"
                Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}" Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button x:Name="RetryCalendar" Content="{x:Bind ViewModel.NoticeActionLabel, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.NoticeActionVisibility, Mode=OneWay}" Click="OnRetry" />
                </InfoBar.ActionButton>
            </InfoBar>
            <TextBlock x:Name="MonthSummary" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <ScrollViewer x:Name="CalendarScroll" Grid.Row="3" Margin="0,0,-24,0"
            HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
            VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="MonthGrid" Margin="{StaticResource EgScrollBarLane}" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,1,0,0"
                CornerRadius="{StaticResource EgCornerBadgeCornerRadius}" />
        </ScrollViewer>
    </Grid>
</Page>
