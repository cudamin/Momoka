<Page
    x:Class="Momoka.Shell.Views.MoviePilotCalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Padding="{StaticResource EgPageMargin}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="CalendarToolbar" ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="MediaType" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="AllMedia" Content="全部" Tag="0" Click="OnMediaTypeChanged" Style="{StaticResource EgSecondaryButtonStyle}" />
                <Button x:Name="MovieMedia" Content="电影" Tag="1" Click="OnMediaTypeChanged" Style="{StaticResource EgSecondaryButtonStyle}" />
                <Button x:Name="SeriesMedia" Content="电视剧" Tag="2" Click="OnMediaTypeChanged" Style="{StaticResource EgSecondaryButtonStyle}" />
            </StackPanel>
            <TextBlock x:Name="MonthTitle" Grid.Column="1" Style="{StaticResource EgSectionTitleStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <StackPanel x:Name="MonthActions" Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="CurrentMonth" Content="今天" Click="OnToday" Style="{StaticResource EgSecondaryButtonStyle}" />
                <Button x:Name="RefreshCalendar" Click="OnRefresh" Style="{StaticResource EgIconButtonStyle}" AutomationProperties.Name="刷新日历" ToolTipService.ToolTip="刷新">
                    <FontIcon Glyph="&#xE72C;" />
                </Button>
                <Button x:Name="PreviousMonth" Click="OnPreviousMonth" Style="{StaticResource EgIconButtonStyle}" AutomationProperties.Name="上个月" ToolTipService.ToolTip="上个月">
                    <FontIcon Glyph="&#xE76B;" />
                </Button>
                <Button x:Name="NextMonth" Click="OnNextMonth" Style="{StaticResource EgIconButtonStyle}" AutomationProperties.Name="下个月" ToolTipService.ToolTip="下个月">
                    <FontIcon Glyph="&#xE76C;" />
                </Button>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar IsIndeterminate="{x:Bind ViewModel.Busy, Mode=OneWay}" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=OneWay}" IsClosable="False" Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
            <TextBlock x:Name="MonthSummary" Style="{StaticResource EgCaptionStyle}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <ScrollViewer x:Name="CalendarScroll" Grid.Row="2" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
            VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="MonthGrid" HorizontalAlignment="Stretch" />
        </ScrollViewer>
    </Grid>
</Page>
