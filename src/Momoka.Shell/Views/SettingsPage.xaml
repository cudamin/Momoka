<?xml version="1.0" encoding="utf-8"?>
<!--
  The settings page. Categories on the left, cards on the right, around sixty rows in total.

  The rows are data, not markup: the view model builds a list of typed row objects and a
  DataTemplateSelector picks the shape for each. Writing sixty rows out by hand would mean the labels,
  ranges and notes live here while the settings they touch live in the view model, and the two drift.

  x:Bind with x:DataType on every template, so a renamed row property fails the build instead of drawing a
  blank control. The colours and metrics are theme resources rather than the literals the procedural version
  used, which is the same palette by value and now follows the theme.
-->
<Page
    x:Class="Momoka.Shell.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:local="using:Momoka.Shell.Views"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:vm="using:Momoka.Shell.ViewModels"
    Background="{ThemeResource LayerFillColorDefaultBrush}">

    <Page.Resources>
        <CollectionViewSource x:Name="CategoryGroupsSource" IsSourceGrouped="True" />
        <Style x:Key="SettingsSearchTextBox" TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
            <Setter Property="Padding" Value="32,6,8,6" />
        </Style>
        <!-- 分组头：默认的 ListViewHeaderItem 会垫一层底、留一段内边距；多服务器折叠头要的是一行小标题。 -->
        <Style x:Key="SettingsGroupHeader" TargetType="ListViewHeaderItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- 默认 HeaderItem 模板自带 Rectangle 分隔线；局部模板仅保留分组文字与折叠按钮。 -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewHeaderItem">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsGroupToggle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,4,8,4" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <!-- 左边分类那一列的图标：分类名 → 一个 Segoe 字形，见 SettingsCategoryGlyphConverter。 -->
        <local:SettingsCategoryGlyphConverter x:Key="CategoryGlyph" />
        <!-- MoviePilot 那一行换官方图标的白色重绘版：这个转换器回答「这一行是不是 MoviePilot」——
             直接给 Visible/Collapsed，传 ConverterParameter=hide 时反过来（给字形用）。 -->
        <local:SettingsCategoryMarkConverter x:Key="MoviePilotMark" />

        <!--
          控件那一列有多宽。一个数写在一处，六种行（开关、下拉、数字、滑块、输入、字体）共用：这几行的控件
          必须落在同一条竖线上，各写一遍的下场是它们各自跟着自己那点内容飘。
          左边那一列是 *，所以标签和说明拿的是剩下的全部 —— 说明原来被挤在 190 宽里折两行，而右边空着
          四百多像素。
        -->
        <GridLength x:Key="EgSettingControlWidth">320</GridLength>

        <!--
          The label and its optional second line, shared by every row shape that has a label column.
          正文字和小字两档都从词表里来（Theme/Styles.xaml）—— 这两个样式以前只写了字号和颜色，没写字体，
          于是整页六十行标签落回框架默认那支字，比界面里别处的正文大一点也不是同一种字。
        -->
        <Style x:Key="EgSettingLabel" TargetType="TextBlock" BasedOn="{StaticResource EgBodyStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="EgSettingNote" TargetType="TextBlock" BasedOn="{StaticResource EgCaptionStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 设置行共用整组卡片的底色，留白区分选项，不再铺底色制造分隔线。 -->
        <Style x:Key="EgSettingRowStyle" TargetType="Grid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="20,11,20,11" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="ColumnSpacing" Value="24" />
        </Style>

        <!-- 主题色板、语言和规则列表等较高的行也使用同一张无分隔线的卡片。 -->
        <Style x:Key="EgSettingBlockStyle" TargetType="StackPanel">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="20,12,20,12" />
            <Setter Property="Spacing" Value="8" />
        </Style>

        <!--
          色板那一块。整块的底色、强调条和字都是那一套主题自己的颜色（在 ThemeSwatch 里做成固定画刷），
          所以按钮自己在四个状态下都必须是透明的 —— 视觉状态里的画刷会盖过本地值，指针一压上去就把那套
          主题的底色刷成框架的悬停灰。状态改这一圈线：胶片格的规矩，指针或焦点上来整圈变强调色。
          封面改圆角之后这六块留方（EgBleedCornerRadius）：里面那块底色是按钮的内容，按钮的圆角剪不动它，
          圆角一上就是底色的直角戳在框线外面。
        -->
        <Style x:Key="EgSwatchStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
            <Setter Property="BorderThickness" Value="{StaticResource EgHairline}" />
            <Setter Property="CornerRadius" Value="{StaticResource EgBleedCornerRadius}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <!-- 定死的一块，而不是按内容撑开：色板是拿来比颜色的，六块一样大才好比；名字长一个字宽一截的话，
                 那点差别看着就像是颜色以外还差了别的什么。同样的道理，一格 224×100 也就写在这里一处。 -->
            <Setter Property="Width" Value="224" />
            <Setter Property="Height" Value="100" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <!--
          换次序那两颗箭头。小、透明、只占一个字符宽：它们要塞进一行 40 像素里，还不能把标题那一列挤窄
          （行高写在 SettingHomeLayoutRow.RowHeight）。按钮默认样式在这个尺寸上是一块灰底方砖，一行里并排两块
          比那一行的字还抢眼，所以底色和边框都撤掉 —— 指针压上去那点反馈还在，视觉状态刷的是模板里那一块，盖得过
          这里的透明（同上头色板那一段，只是那儿要的正好相反）。
        -->
        <Style x:Key="EgHomeShiftStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- 墨走角色表，不吃按钮自己那档：框架那档在 daylight 下是白底上的一层浅灰，两颗箭头几乎看不出在那儿。
                 置灰那一档不受影响 —— 「不可用」是视觉状态刷的，盖得过这里的设定（同上头色板那一段）。 -->
            <Setter Property="Foreground" Value="{ThemeResource EgTextBrush}" />
            <Setter Property="Padding" Value="6,1,6,1" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
          QQ 式下拉的条目（2026-09-25「复刻 QQ 的选择框」）。框架默认的 ComboBoxItem 在选中项左边画一粒
          药丸（Pill）；QQ 那张图是「圆角高亮 ＋ 选中项右侧一颗勾」，所以模板自己画：悬停/按下/选中沿用
          框架自己的那组 ComboBoxItem* 画刷键（跟着主题走），Pill 换成右边的勾（E73E，强调色，读屏是
          Raw —— 勾只是选中态的回声，条目本体已经念过一遍了）。

          浮层本身的底色不在这里：Popup 树里解析不到页面资源，浮层底走 Palette.xaml 那支应用级的
          ComboBoxDropDownBackground（亚克力）。闭合框的皮也没动 —— 要复刻的是弹出来的那张单子。
          状态名单跟框架默认模板对齐（Normal / PointerOver / Pressed / Disabled ＋ Selected 四个变体），
          少写一个状态的那一格就会停在错误的高亮上。
        -->
        <Style x:Key="EgComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{ThemeResource ComboBoxItemForeground}" />
            <Setter Property="Background" Value="{ThemeResource ComboBoxItemBackground}" />
            <Setter Property="Padding" Value="{ThemeResource ComboBoxItemThemePadding}" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="-3" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <!-- 外圈 6,2 的缩进：高亮是一颗不贴浮层边的圆角药丸，QQ 那张图就是这个站法。 -->
                        <Grid
                            x:Name="LayoutRoot"
                            Margin="6,2"
                            Background="{TemplateBinding Background}"
                            Control.IsTemplateFocusTarget="True"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="CheckGlyph"
                                Grid.Column="1"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="{StaticResource EgBodyFontSize}"
                                Foreground="{ThemeResource EgAccentBrush}"
                                Text="&#xE73E;"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ComboBoxItemBackgroundPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ComboBoxItemForegroundPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ComboBoxItemBackgroundPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ComboBoxItemForegroundPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ComboBoxItemBackgroundDisabled}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ComboBoxItemForegroundDisabled}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Opacity">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ComboBoxItemBackgroundSelected}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ComboBoxItemForegroundSelected}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="SelectedUnfocused">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Opacity">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ComboBoxItemBackgroundSelectedUnfocused}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ComboBoxItemForegroundSelectedUnfocused}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="SelectedDisabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Opacity">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ComboBoxItemBackgroundSelectedDisabled}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ComboBoxItemForegroundSelectedDisabled}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Opacity">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ComboBoxItemBackgroundSelectedPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ComboBoxItemForegroundSelectedPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph" Storyboard.TargetProperty="Opacity">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ComboBoxItemBackgroundSelectedPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ComboBoxItemForegroundSelectedPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 本页所有下拉（选择行、字幕标题筛选那几颗小的、紧凑模式那颗分类框）都吃这一条：
             只换容器样式，闭合框本身不吃自定义皮。 -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource EgComboItemStyle}" />
        </Style>

        <!--
          Keyed rather than inlined into the selector below, because the passthrough group renders the same
          shape for each of its own toggles and a DataTemplate can be used by both.
          <para>
          This is the group's shape only, where a switch sits under a heading among its siblings and carries
          its own label above itself. A switch that is a row on its own uses EgSettingToggleRow instead.
          </para>
        -->
        <DataTemplate x:Key="EgSettingToggle" x:DataType="vm:SettingToggleRow">
            <ToggleSwitch x:Uid="SettingsPage_ToggleSwitch1"
                Margin="0,3,0,3"
                Header="{x:Bind Label}"
                HorizontalAlignment="Left"
                IsOn="{x:Bind IsOn, Mode=TwoWay}"
                ToolTipService.ToolTip="{x:Bind Note}" />
        </DataTemplate>

        <!--
          一行一个开关：标签和说明占左边那一整片，控件在右边那条固定宽的控件列里 —— 跟同一张卡片上的下拉框、
          数字框、输入框一样，所有控件因此落在同一条竖线上。ToggleSwitch 自带的 Header 会把标签摆到开关上头
          去，那一行于是成了整张卡片上唯一一行标签不在同一条竖线上的，所以这里的标签不走 Header，而是和别的
          行共用 EgSettingLabel。
          标签列是 * 而不是写死的 190：说明那一行原来被挤在 190 里折两行，而右边空着四百多像素 —— 该宽的地方
          窄、该窄的地方宽是同一件事的两头。
        -->
        <DataTemplate x:Key="EgSettingToggleRow" x:DataType="vm:SettingToggleRow">
            <Grid Style="{StaticResource EgSettingRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource EgSettingControlWidth}" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                    <TextBlock
                        Style="{StaticResource EgSettingNote}"
                        Text="{x:Bind Note}"
                        Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                </StackPanel>
                <ToggleSwitch x:Uid="SettingsPage_ToggleSwitch2"
                    AutomationProperties.Name="{x:Bind Label}"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    IsOn="{x:Bind IsOn, Mode=TwoWay}"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <local:SettingRowTemplates x:Key="EgSettingRows" Toggle="{StaticResource EgSettingToggleRow}">

            <local:SettingRowTemplates.Choice>
                <DataTemplate x:DataType="vm:SettingChoiceRow">
                    <Grid Style="{StaticResource EgSettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource EgSettingControlWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                            <!--
                              OneWay 而不是默认的 OneTime：视频同步那一行的说明写的是「此刻真正生效的值」，
                              而它会随两行之下的「启用插值」变。别的下拉行的说明构造完就再也不动，OneWay 对它们
                              只是多一个不会触发的监听。
                            -->
                            <TextBlock
                                Style="{StaticResource EgSettingNote}"
                                Text="{x:Bind Note, Mode=OneWay}"
                                Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                        </StackPanel>
                        <ComboBox
                            AutomationProperties.Name="{x:Bind Label}"
                            Grid.Column="1"
                            DisplayMemberPath="Label"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind Choices, Mode=OneWay}"
                            MinWidth="260"
                            SelectedItem="{x:Bind Selected, Mode=TwoWay}" />
                    </Grid>
                </DataTemplate>
            </local:SettingRowTemplates.Choice>

            <!--
              A heading and a tighter stack, for switches that are one setting each but read as one
              question. The outer spacing matches the card's so the heading sits away from the group the
              way it did when the two were separate children of the card.
            -->
            <local:SettingRowTemplates.ToggleGroup>
                <DataTemplate x:DataType="vm:SettingToggleGroupRow">
                    <StackPanel Style="{StaticResource EgSettingBlockStyle}">
                        <!-- 词表里的小标题（Theme/Styles.xaml 的 EgSubheadStyle）：以前这里只写了 SemiBold，
                             没写字体也没写字号，一组开关的标题于是比同一张卡片上的别的字都大一点。 -->
                        <TextBlock Style="{StaticResource EgSubheadStyle}" Text="{x:Bind Label}" />
                        <ItemsControl
                            ItemTemplate="{StaticResource EgSettingToggle}"
                            ItemsSource="{x:Bind Toggles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </local:SettingRowTemplates.ToggleGroup>

            <!--
              主题那一行：几块色板，点哪块是哪块 —— 一套配色该让人看见它的颜色，而不是读它的名字。
              每一块都是那一套主题的一个缩影：顶上一条它的「面」色好比标题栏，底下一整片它的「窗」色，
              左边一道它的强调色，名字和深浅两行字用它自己的墨。看到的是「选了它整个界面会是什么样」，
              而不是六个方块。
              右上角那颗角标沿用胶片格那一颗（和海报上「全看完」同一颗）。它跟着当前主题走，而这里正好对得上：
              带角标的永远只有正在用的那一套，那一套的强调色就是角标的底色。
            -->
            <local:SettingRowTemplates.Theme>
                <DataTemplate x:DataType="vm:SettingThemeRow">
                    <StackPanel Style="{StaticResource EgSettingBlockStyle}">
                        <TextBlock Style="{StaticResource EgSubheadStyle}" Text="{x:Bind Label}" />
                        <TextBlock
                            Style="{StaticResource EgSettingNote}"
                            Text="{x:Bind Note}"
                            Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                        <ItemsControl ItemsSource="{x:Bind Swatches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- 一格 236×112，块本身 224×100（见 EgSwatchStyle），差出来的就是块与块之间
                                         那道缝。卡片里放得下三块，所以六套是整齐的两行三列；窗口窄了就折成两块
                                         一行，因为它到底还是个折行的网格。 -->
                                    <VariableSizedWrapGrid
                                        ItemHeight="112"
                                        ItemWidth="236"
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThemeSwatch">
                                    <Button
                                        automation:AutomationProperties.Name="{x:Bind Name}"
                                        Command="{x:Bind PickCommand}"
                                        Style="{StaticResource EgSwatchStyle}"
                                        ToolTipService.ToolTip="{x:Bind Note}">
                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="EgAccentBrush" />
                                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="EgAccentBrush" />
                                        </Button.Resources>
                                        <Grid Background="{x:Bind Window}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="28" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <!-- 上面一条是这套主题的「面」色，下面一大片是它的「窗」色：跟这套
                                                 主题真画出来的窗口一个关系 —— 标题栏一条，底下一整片。 -->
                                            <Border Background="{x:Bind Surface}" />
                                            <StackPanel
                                                Grid.Row="1"
                                                Margin="16,0,12,0"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontFamily="{StaticResource EgUiFontFamily}"
                                                    FontSize="{StaticResource EgSubheadFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{x:Bind Ink}"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontFamily="{StaticResource EgDataFontFamily}"
                                                    FontSize="{StaticResource EgEyebrowFontSize}"
                                                    Foreground="{x:Bind InkDim}"
                                                    Text="{x:Bind Kind}" />
                                            </StackPanel>
                                            <Border
                                                Background="{x:Bind Accent}"
                                                Grid.RowSpan="2"
                                                HorizontalAlignment="Left"
                                                Width="6" />
                                            <Border
                                                Grid.RowSpan="2"
                                                Style="{StaticResource EgCornerBadgeStyle}"
                                                Visibility="{x:Bind CheckVisibility, Mode=OneWay}">
                                                <FontIcon
                                                    FontSize="12"
                                                    Foreground="{ThemeResource EgTextOnAccentBrush}"
                                                    Glyph="&#xE73E;" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </local:SettingRowTemplates.Theme>

            <local:SettingRowTemplates.Number>
                <DataTemplate x:DataType="vm:SettingNumberRow">
                    <Grid Style="{StaticResource EgSettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource EgSettingControlWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                            <TextBlock
                                Style="{StaticResource EgSettingNote}"
                                Text="{x:Bind Note}"
                                Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                        </StackPanel>
                        <!--
                          AutomationProperties.Name：这一页的数字框从前只被定位成「两个没有名字的输入框」——
                          延迟那行的 UIA 读数就是这样（2026-09-30 审查实测）。屏幕阅读器与 UIA 都靠它认行。
                          PlaceholderText：清空输入框时灰字里仍显示当前生效的值 —— 清空不等于归零，设置还留着
                          （SettingNumberRow.Placeholder）。
                        -->
                        <NumberBox
                            Grid.Column="1"
                            AutomationProperties.Name="{x:Bind Label}"
                            HorizontalAlignment="Left"
                            Maximum="{x:Bind Maximum}"
                            Minimum="{x:Bind Minimum}"
                            PlaceholderText="{x:Bind Placeholder, Mode=OneWay}"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind Value, Mode=TwoWay}"
                            Width="160" />
                    </Grid>
                </DataTemplate>
            </local:SettingRowTemplates.Number>

            <local:SettingRowTemplates.OptionalNumber>
                <DataTemplate x:DataType="vm:SettingOptionalNumberRow">
                    <Grid Style="{StaticResource EgSettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource EgSettingControlWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                            <TextBlock
                                Style="{StaticResource EgSettingNote}"
                                Text="{x:Bind Note}"
                                Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <CheckBox
                                x:Name="UseAutomaticValue"
                                AutomationProperties.Name="{x:Bind Label}"
                                Content="自动"
                                IsChecked="{x:Bind Automatic, Mode=TwoWay}" />
                            <NumberBox
                                x:Name="ManualValue"
                                AutomationProperties.Name="{x:Bind Label}"
                                IsEnabled="{x:Bind InputEnabled, Mode=OneWay}"
                                Minimum="{x:Bind Minimum}"
                                Maximum="{x:Bind Maximum}"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind Value, Mode=TwoWay}"
                                Width="160" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </local:SettingRowTemplates.OptionalNumber>

            <local:SettingRowTemplates.Slider>
                <DataTemplate x:DataType="vm:SettingSliderRow">
                    <Grid Style="{StaticResource EgSettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource EgSettingControlWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                            <TextBlock
                                Style="{StaticResource EgSettingNote}"
                                Text="{x:Bind Note}"
                                Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                        </StackPanel>
                        <!--
                          数值读数跟着滑块走（SettingSliderRow.ValueLabel）。滑块自己不显示数字，而这一页的
                          滑块里有描边大小这种 0.05 一格的细档 —— 拖完不知道落在哪个数上，等于没调。
                        -->
                        <Grid Grid.Column="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                x:Uid="SettingsPage_SliderA1"
                                HorizontalAlignment="Stretch"
                                Maximum="{x:Bind Maximum}"
                                Minimum="{x:Bind Minimum}"
                                MinWidth="240"
                                SnapsTo="StepValues"
                                StepFrequency="{x:Bind Step}"
                                TickFrequency="{x:Bind Step}"
                                TickPlacement="None"
                                Value="{x:Bind Value, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="1"
                                MinWidth="48"
                                Style="{StaticResource EgSettingLabel}"
                                Text="{x:Bind ValueLabel, Mode=OneWay}"
                                TextAlignment="Right" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </local:SettingRowTemplates.Slider>

            <!--
              No UpdateSourceTrigger here on purpose: x:Bind commits TextBox.Text on lost focus unless told
              otherwise, which is what these want. A path saved per keystroke would rewrite the settings file
              a dozen times while it is being typed, and would hand mpv half a font name.
            -->
            <local:SettingRowTemplates.Text>
                <DataTemplate x:DataType="vm:SettingTextRow">
                    <Grid Style="{StaticResource EgSettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource EgSettingControlWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                            <TextBlock
                                Style="{StaticResource EgSettingNote}"
                                Text="{x:Bind Note}"
                                Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                        </StackPanel>
                        <TextBox
                            x:Name="SettingTextInput"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            MinWidth="260"
                            AutomationProperties.Name="{x:Bind Label}"
                            PlaceholderText="{x:Bind Placeholder}"
                            Text="{x:Bind Text, Mode=TwoWay}" />
                    </Grid>
                </DataTemplate>
            </local:SettingRowTemplates.Text>

            <local:SettingRowTemplates.Secret>
                <DataTemplate x:DataType="vm:SettingSecretRow">
                    <Grid Style="{StaticResource EgSettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource EgSettingControlWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                            <TextBlock Style="{StaticResource EgSettingNote}" Text="{x:Bind Note, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <PasswordBox x:Name="SecretInput" Password="{x:Bind Draft, Mode=TwoWay}" PlaceholderText="输入新密钥" AutomationProperties.Name="{x:Bind Label}" />
                            <TextBlock Style="{StaticResource EgSettingNote}" Text="{x:Bind Status, Mode=OneWay}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SaveSecret" Command="{x:Bind CommitCommand}" Content="保存密钥" AutomationProperties.Name="{x:Bind SaveAutomationName}" />
                                <Button x:Name="ClearSecret" Command="{x:Bind ClearCommand}" Content="清除密钥" AutomationProperties.Name="{x:Bind ClearAutomationName}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </local:SettingRowTemplates.Secret>

            <!--
              MoviePilot 接入卡（用户的话，2026-09-14：「放设置页」）：一个开关、地址、用户名、密码，加一颗测试按钮，
              底下是上一次测试的结论。和别的行不同，它是整幅宽的一张卡而不是「左边标签 + 右边控件」—— 这一件事有四个
              输入和一个动作，塞进 320 宽的控件列会挤成一条。行为什么是一个而不是四个，见 SettingMoviePilotRow 的类注释。
            -->
            <local:SettingRowTemplates.MoviePilot>
                <DataTemplate x:DataType="vm:SettingMoviePilotRow">
                    <!--
                      外面这一层必须是 Grid 而不是 StackPanel：EgSettingRowStyle 的 TargetType 是 Grid，而 XAML
                      的 Style 不允许跨类型套用 —— 套错的后果不是构建报错，是模板实例化那一刻抛 COMException
                      （2026-09-14 自检在「界面 → MoviePilot」这一步就是这么倒的）。所以卡片外观由 Grid 承载，
                      竖排交给里面那个 StackPanel。MinHeight 的 40 是给一行的下限，这张卡比它高得多，不冲突。
                    -->
                    <Grid Style="{StaticResource EgSettingRowStyle}">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                                <TextBlock
                                    Style="{StaticResource EgSettingNote}"
                                    Text="{x:Bind Note}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                            </StackPanel>

                            <ToggleSwitch
                                AutomationProperties.Name="{x:Bind Label}"
                                Header="启用"
                                IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                OffContent="关闭"
                                OnContent="开启" />

                            <!--
                              服务地址拆成「协议 + 地址 + API 端口」三格（用户令）：协议是个 http/https 的下拉（SelectedIndex
                              对着 SchemeIndex，0=http、1=https），地址只填主机，端口是 MoviePilot 的 API 端口（默认 3001，
                              不是网页界面那个），留空就用默认。三格合回一条存进设置里那一个字符串，拆/合都在 Core 的
                              MoviePilotAddress，见 SettingMoviePilotRow.Url。
                              横排、各自定宽、靠左摆（用户令「地址框别弄那么长」）：地址一个 IP 或主机名 240 够宽，
                              不跟着卡面拉满；下面用户名/密码才是整幅宽的框。
                            -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox
                                    MinWidth="88"
                                    AutomationProperties.Name="MoviePilot 协议"
                                    Header="协议"
                                    SelectedIndex="{x:Bind SchemeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="http" />
                                    <ComboBoxItem Content="https" />
                                </ComboBox>
                                <TextBox
                                    Width="240"
                                    AutomationProperties.Name="MoviePilot 地址"
                                    Header="地址"
                                    PlaceholderText="192.0.2.10"
                                    Text="{x:Bind Host, Mode=TwoWay}" />
                                <TextBox
                                    Width="110"
                                    AutomationProperties.Name="MoviePilot API 端口"
                                    Header="API 端口"
                                    InputScope="Number"
                                    PlaceholderText="3001"
                                    Text="{x:Bind Port, Mode=TwoWay}" />
                            </StackPanel>

                            <TextBox
                                AutomationProperties.Name="MoviePilot 用户名"
                                Header="用户名"
                                PlaceholderText="MoviePilot 的登录名"
                                Text="{x:Bind Username, Mode=TwoWay}" />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox
                                    AutomationProperties.Name="MoviePilot 密码"
                                    Header="密码"
                                    Password="{x:Bind Password, Mode=TwoWay}"
                                    PlaceholderText="留空则用已保存的那个" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,6"
                                    Style="{StaticResource EgSettingNote}"
                                    Text="已保存一个密码"
                                    Visibility="{x:Bind SavedPasswordVisibility, Mode=OneWay}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button
                                    AutomationProperties.Name="测试 MoviePilot 连接"
                                    Command="{x:Bind TestCommand}"
                                    Content="{x:Bind TestLabel, Mode=OneWay}"
                                    IsEnabled="{x:Bind CanTest, Mode=OneWay}" />
                            </StackPanel>

                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource EgSettingNote}"
                                Foreground="{x:Bind ResultBrush, Mode=OneWay}"
                                Text="{x:Bind Result, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ResultVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </local:SettingRowTemplates.MoviePilot>

            <!--
              The font picker. The box above the list searches; it is not the value, so unlike every other
              text row here it does commit per keystroke — filtering per keystroke is the whole point, and
              since the setting is written by picking a family out of the list, a half-typed name can never
              reach the settings file. Each line is drawn in the font it offers, which is why a font list
              beats a text box in the first place.

              「默认收起来不要展开」「输入栏要显示当前正在使用的字体」（2026-09-06）：静止时列表收着、
              输入栏里是当前字体；点进框里清空成搜索（整张名单都在），选中一个就收起并把新字体放回
              输入栏，走开没挑也收回（LostFocus → CloseList，它自己会看焦点是不是落进了名单 ——
              点名单那一行是先夺焦点后选中，收早了那一行就再也点不中了）。
            -->
            <local:SettingRowTemplates.Font>
                <DataTemplate x:DataType="vm:SettingFontRow">
                    <Grid Style="{StaticResource EgSettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource EgSettingControlWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                            <TextBlock
                                Style="{StaticResource EgSettingNote}"
                                Text="{x:Bind Note}"
                                Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" MinWidth="260" Spacing="6">
                            <TextBox
                                x:Uid="SettingsPage_TextBox3"
                                GotFocus="{x:Bind OpenList}"
                                HorizontalAlignment="Stretch"
                                LostFocus="{x:Bind CloseList}"
                                Text="{x:Bind BoxText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ListView
                                Height="252"
                                ItemsSource="{x:Bind Matches}"
                                SelectedItem="{x:Bind Selected, Mode=TwoWay}"
                                SelectionMode="Single"
                                Visibility="{x:Bind ListVisibility, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FontOption">
                                        <StackPanel Padding="0,2,0,2">
                                            <TextBlock
                                                FontFamily="{x:Bind Preview}"
                                                FontSize="15"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontFamily="{x:Bind Preview}"
                                                FontSize="12"
                                                Foreground="{ThemeResource EgTextDimBrush}"
                                                Text="{x:Bind Localized}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{x:Bind LocalizedVisibility}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                Style="{StaticResource EgSettingNote}"
                                Text="{x:Bind Status, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </local:SettingRowTemplates.Font>

            <!--
              A colour row: a swatch and its code on the right, and the HTML 颜色选择器 in a flyout behind
              the swatch. The picker two-way-binds the row's own Color, so everything a pick means — write
              the setting, save, live-push to a film that is playing — stays in the row; the template has no
              code-behind and needs none.
            -->
            <local:SettingRowTemplates.Color>
                <DataTemplate x:DataType="vm:SettingColorRow">
                    <Grid Style="{StaticResource EgSettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource EgSettingControlWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                            <TextBlock
                                Style="{StaticResource EgSettingNote}"
                                Text="{x:Bind Note, Mode=OneWay}"
                                Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                            <Button
                                x:Uid="SettingsPage_ColorSwatch"
                                Background="{x:Bind Swatch, Mode=OneWay}"
                                BorderBrush="{StaticResource EgBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Height="30"
                                Padding="0"
                                Width="56">
                                <Button.Flyout>
                                    <Flyout>
                                        <!-- Flyout 站在内容上不留出滚动，拾色器整体比色块宽得多，给它的
                                             呈现层把边距和滚动条去掉，不然四周一大圈白。 -->
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <local:HtmlColorPicker
                                            Margin="16"
                                            Color="{x:Bind Color, Mode=TwoWay}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource EgDataStyle}"
                                Text="{x:Bind HexLabel, Mode=OneWay}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </local:SettingRowTemplates.Color>

            <!--
              「字幕示例」预览（「参考图2新增字幕外观功能」，2026-09-06）：卡顶一条按当前外观画出的样字。
              这一行只画不写；改设置的行写完喊 SettingSubtitlePreviewRow.Refresh，这里所有绑定都是 OneWay
              跟着新模型走。描边和阴影没有「画字加边」可用，就是 Layers 里那几份同样文字的拷贝叠出来的 ——
              层次就是清单的次序（阴影在最下、正文在最上），所以整条只有一个 ItemsControl，底板是垫在
              它下面的那块 Border。层的文字对读屏是 Raw（十份拷贝念十遍不是读屏该念的），整条的名字
              从 x:Uid 来。
            -->
            <local:SettingRowTemplates.Preview>
                <DataTemplate x:DataType="vm:SettingSubtitlePreviewRow">
                    <Grid Style="{StaticResource EgSettingRowStyle}">
                        <StackPanel Spacing="8">
                            <Grid
                                Height="{x:Bind StripHeight, Mode=OneWay}"
                                x:Uid="SettingsPage_SubtitlePreview"
                                HorizontalAlignment="Stretch">
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled">
                                    <Border
                                        Background="{x:Bind PlateBrush, Mode=OneWay}"
                                        HorizontalAlignment="Center"
                                        Padding="{x:Bind PlatePadding, Mode=OneWay}"
                                        VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{x:Bind Lines, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SubtitlePreviewLine">
                                                    <ItemsControl ItemsSource="{x:Bind Layers}" HorizontalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Grid />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:PreviewLayer">
                                                                <Border
                                                                    Background="{x:Bind Background}"
                                                                    Padding="{x:Bind BoxPadding}"
                                                                    Margin="{x:Bind BoxMargin}"
                                                                    HorizontalAlignment="Center"
                                                                    IsHitTestVisible="False">
                                                                    <Border.RenderTransform>
                                                                        <TranslateTransform X="{x:Bind X}" Y="{x:Bind Y}" />
                                                                    </Border.RenderTransform>
                                                                    <TextBlock
                                                                        AutomationProperties.AccessibilityView="Raw"
                                                                        FontFamily="{x:Bind Family}"
                                                                        FontSize="{x:Bind Size}"
                                                                        FontWeight="{x:Bind Weight}"
                                                                        Foreground="{x:Bind Brush}"
                                                                        Opacity="{x:Bind GlyphOpacity}"
                                                                        Text="{x:Bind Text}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </ScrollViewer>
                            </Grid>
                            <TextBlock
                                Style="{StaticResource EgSettingNote}"
                                Text="{x:Bind Note}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </local:SettingRowTemplates.Preview>

            <!--
              主页版面那张表：一行一排，勾选决定显不显示，按住往上下拖、或者按右边那两颗箭头决定次序（「新增页里
              拖拽决定这些列表的顺序，勾选显示或者不勾选取消显示」）。

              ListView 而不是 ItemsRepeater：拖拽换位是 ListView 自带的（CanReorderItems ＋ AllowDrop 是鼠标
              拖得动的那两位，ReorderMode 管触摸那条路），它改的就是绑上来那个 ObservableCollection 自己的次序，
              所以「屏上的次序」和「要存的次序」是同一件东西。SelectionMode 关掉：这张表没有「选中」这个概念，点一行
              只有一个意思，就是那个勾。高度由行数算（ListHeight）而不是让它自己滚：设置页本来就是一整页滚动条，套
              一个内层滚动条之后，拖到边上时两个滚动条互相抢，一项都拖不到看不见的地方去。

              CanDragItems 留着是为了「把一项当数据拖出去」那条路和 DragItemsStarting 那两个事件；换位不经过它，
              每个容器上的 CanDrag 也只是它的回声 —— 别拿那一位判断这张表拖不拖得动（自检那一行只把它当读数报）。

              那两颗箭头不是拖拽的备胎，是这件事唯一验得到的形式：这台机器上注不进鼠标事件，拖那一下没法自动做一遍，
              而一张拖不动的表拍出来和拖得动的一模一样（见 SettingHomeLayoutRow 上那段说明）。顺带，不使指针的人也
              有了一条路。
            -->
            <local:SettingRowTemplates.HomeLayout>
                <DataTemplate x:DataType="vm:SettingHomeLayoutRow">
                    <StackPanel Style="{StaticResource EgSettingBlockStyle}">
                        <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                        <TextBlock
                            Style="{StaticResource EgSettingNote}"
                            Text="{x:Bind Note}"
                            Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />

                        <ListView
                            AllowDrop="True"
                            CanDragItems="True"
                            CanReorderItems="True"
                            Height="{x:Bind ListHeight, Mode=OneWay}"
                            ItemsSource="{x:Bind Rows}"
                            ReorderMode="Enabled"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:HomeRowChoice">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox
                                            AutomationProperties.Name="{x:Bind Title}"
                                            IsChecked="{x:Bind Visible, Mode=TwoWay}"
                                            MinWidth="0" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind Title}"
                                            VerticalAlignment="Center" />

                                        <!-- 换次序那两颗。到顶的「上移」和到底的「下移」置灰（CanUp/CanDown）：
                                             按下去也不动的按钮亮着，第一次按的人只会以为这张表是坏的。 -->
                                        <Button x:Uid="SettingsPage_ButtonA2"
                                            Grid.Column="2"
                                            Command="{x:Bind UpCommand}"
                                            IsEnabled="{x:Bind CanUp, Mode=OneWay}"
                                            Style="{StaticResource EgHomeShiftStyle}">
                                            <FontIcon
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="12"
                                                Glyph="&#xE70E;" />
                                        </Button>

                                        <Button x:Uid="SettingsPage_ButtonA3"
                                            Grid.Column="3"
                                            Command="{x:Bind DownCommand}"
                                            IsEnabled="{x:Bind CanDown, Mode=OneWay}"
                                            Style="{StaticResource EgHomeShiftStyle}">
                                            <FontIcon
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="12"
                                                Glyph="&#xE70D;" />
                                        </Button>

                                        <!-- 把手：这一行拖得动的那句话。图标是 Segoe 的「重新排序」，和框架自己
                                             的拖拽列表用的是同一个。 -->
                                        <FontIcon
                                            Grid.Column="4"
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            FontSize="14"
                                            Foreground="{ThemeResource EgTextFaintBrush}"
                                            Glyph="&#xE76F;"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </DataTemplate>
            </local:SettingRowTemplates.HomeLayout>

            <!--
              字幕语言优先级（「参考上图改成复选下拉」，2026-09-22）：右边一颗下拉按钮显示当前挑好的语言，点开
              是一张带勾选、按住能拖、也能用箭头换次序的语言表 —— 换掉了原先那个手打逗号分隔的输入框。表和主页
              版面那张（上面 HomeLayout）是同一套：勾选决定进不进优先级列表，次序决定谁先匹配。

              两处不同：表放在下拉的浮层里，所以给它一个 MaxHeight 自己滚就行 —— 浮层本身是个独立弹窗，不像整
              页那样会和外层滚动条互抢（HomeLayout 摊在页面上才必须按行数给死高度）。存的是「勾了的那些名字，
              照屏上次序」，那句连起来的话就是下拉按钮上显示的 Summary。

              那两颗上下箭头和主页那张表一样不是拖拽的备胎，是这件事唯一验得到的形式：这台机器上注不进鼠标
              事件，拖和勾没法自动做一遍，而一张勾不动、换不了次序的下拉在屏上和好用的长得一模一样
              （见 SettingLanguagesRow.Probe 与自检「字幕语言优先级换得了次序」）。
            -->
            <local:SettingRowTemplates.Languages>
                <DataTemplate x:DataType="vm:SettingLanguagesRow">
                    <Grid Style="{StaticResource EgSettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource EgSettingControlWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                            <TextBlock
                                Style="{StaticResource EgSettingNote}"
                                Text="{x:Bind Note}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                        </StackPanel>
                        <DropDownButton
                            AutomationProperties.Name="{x:Bind Label}"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            MinWidth="260">
                            <TextBlock
                                Text="{x:Bind Summary, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <DropDownButton.Flyout>
                                <Flyout Placement="Bottom">
                                    <!-- 浮层自带 padding，这里再收窄一点，让表贴着按钮的宽度。 -->
                                    <ListView
                                        AllowDrop="True"
                                        CanDragItems="True"
                                        CanReorderItems="True"
                                        ItemsSource="{x:Bind Choices}"
                                        MaxHeight="420"
                                        MinWidth="280"
                                        ReorderMode="Enabled"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LanguageChoice">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox
                                                        AutomationProperties.Name="{x:Bind Name}"
                                                        IsChecked="{x:Bind Checked, Mode=TwoWay}"
                                                        MinWidth="0" />

                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{x:Bind Name}"
                                                        VerticalAlignment="Center" />

                                                    <!-- 换次序那两颗。到顶的「上移」和到底的「下移」置灰
                                                         （CanUp/CanDown）：按下去也不动的按钮亮着，第一次按的
                                                         人只会以为这张表是坏的。 -->
                                                    <Button x:Uid="SettingsPage_ButtonL1"
                                                        Grid.Column="2"
                                                        Command="{x:Bind UpCommand}"
                                                        IsEnabled="{x:Bind CanUp, Mode=OneWay}"
                                                        Style="{StaticResource EgHomeShiftStyle}">
                                                        <FontIcon
                                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                            FontSize="12"
                                                            Glyph="&#xE70E;" />
                                                    </Button>

                                                    <Button x:Uid="SettingsPage_ButtonL2"
                                                        Grid.Column="3"
                                                        Command="{x:Bind DownCommand}"
                                                        IsEnabled="{x:Bind CanDown, Mode=OneWay}"
                                                        Style="{StaticResource EgHomeShiftStyle}">
                                                        <FontIcon
                                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                            FontSize="12"
                                                            Glyph="&#xE70D;" />
                                                    </Button>

                                                    <!-- 把手：这一行拖得动的那句话，和框架自己的拖拽列表同一个字形。 -->
                                                    <FontIcon
                                                        Grid.Column="4"
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                        FontSize="14"
                                                        Foreground="{ThemeResource EgTextFaintBrush}"
                                                        Glyph="&#xE76F;"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                </DataTemplate>
            </local:SettingRowTemplates.Languages>

            <!-- 字幕标题、音轨格式与视频文件名共用有序关键词表。顺序既是屏上排名，也是实际筛选优先级。 -->
            <local:SettingRowTemplates.TitleRules>
                <DataTemplate x:DataType="vm:SettingTitleRulesRow">
                    <StackPanel Style="{StaticResource EgSettingBlockStyle}">
                        <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                        <TextBlock Style="{StaticResource EgSettingNote}" Text="{x:Bind Note}"
                            TextWrapping="Wrap" Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource EgSettingNote}" Text="{x:Bind PriorityHint}" TextWrapping="Wrap" />

                        <ListView x:Name="PriorityRulesList" Tag="{x:Bind}"
                            ItemsSource="{x:Bind Rules}" MaxHeight="420"
                            SelectionMode="Single" CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                            IsSwipeEnabled="False"
                            ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            Loaded="OnPriorityListLoaded" Unloaded="OnPriorityListUnloaded"
                            DragItemsStarting="OnPriorityDragStarting" DragItemsCompleted="OnPriorityDragCompleted"
                            AutomationProperties.Name="{x:Bind Label}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="6,4" />
                                    <Setter Property="MinHeight" Value="44" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TitleRuleChoice">
                                    <Grid x:Name="PriorityRuleRoot" ColumnSpacing="6">
                                        <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="≡" VerticalAlignment="Center" Opacity="0.55"
                                            ToolTipService.ToolTip="按住拖动调整优先级" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Position, Mode=OneWay}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.65" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Term}" TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Term}" />
                                        <ComboBox x:Name="PriorityRuleState" Grid.Column="3" MinWidth="88"
                                            AutomationProperties.Name="{x:Bind Term}"
                                            ItemsSource="{x:Bind StateLabels}" SelectedItem="{x:Bind SelectedState, Mode=TwoWay}" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2">
                                            <Button x:Name="PriorityRuleUp" Content="↑" MinWidth="28" Padding="4"
                                                Command="{x:Bind UpCommand}" IsEnabled="{x:Bind CanUp, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind UpName}" ToolTipService.ToolTip="提高优先级" />
                                            <Button x:Name="PriorityRuleDown" Content="↓" MinWidth="28" Padding="4"
                                                Command="{x:Bind DownCommand}" IsEnabled="{x:Bind CanDown, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind DownName}" ToolTipService.ToolTip="降低优先级" />
                                            <Button x:Name="PriorityRuleDelete" Content="✕" MinWidth="28" Padding="4"
                                                Command="{x:Bind RemoveSelfCommand}"
                                                AutomationProperties.Name="{x:Bind RemoveName}" ToolTipService.ToolTip="删除这个关键词" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid ColumnSpacing="10" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PriorityNewTerm" AutomationProperties.Name="{x:Bind NewTermName}"
                                PlaceholderText="{x:Bind NewTermPlaceholder}"
                                Text="{x:Bind NewTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button x:Name="PriorityAddTerm" Grid.Column="1" AutomationProperties.Name="{x:Bind AddName}"
                                Command="{x:Bind AddCommand}" Content="添加" />
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </local:SettingRowTemplates.TitleRules>

            <!--
              一行读数：左边标签、底下一行值（等宽，多半是个路径，所以要能折行），右边一颗可有可无的按钮。
              值不摆进控件列 —— 那一列只有 320 宽，一个路径在里面要折三行；标签列本来就宽，值跟着标签走。
              <para>
              值和它的可见性都要 OneWay：这一行的 Value 是**会变的**，而且不重建卡片就变 —— 关于卡上「截图目录」
              跟着「播放行为」那一行的目录走（SettingsViewModel.AnnounceScreenshotDirectory），「检查新版本」那一行
              按下去先写「正在检查…」再写结果。x:Bind 在 DataTemplate 里默认 OneTime，写的时候屏上不会动一下，
              而 SettingFactRow 的 Value setter 是照 OneWay 写的（它连 ValueVisibility 的通知一起喊）。
              </para>
            -->
            <local:SettingRowTemplates.Fact>
                <DataTemplate x:DataType="vm:SettingFactRow">
                    <Grid Style="{StaticResource EgSettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource EgSettingControlWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource EgDataStyle}"
                                Text="{x:Bind Value, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ValueVisibility, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource EgSettingNote}"
                                Text="{x:Bind Note}"
                                Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind RunCommand}"
                            Content="{x:Bind ActionLabel}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Visibility="{x:Bind ActionVisibility}" />
                    </Grid>
                </DataTemplate>
            </local:SettingRowTemplates.Fact>

            <!--
              一行一个可重绑的播放器快捷键（「参考上图在设置中新增快捷键功能」，2026-09-08）：左边动作名，右边一个
              抓键的方框加一颗 ×（local:ShortcutCaptureBox）。方框把「敲定了一个组合键」经 Committed 抛给行的
              OnCommitted 转交回 VM，成不成（冲不冲突）由 VM 判；ComboText 是 VM 用 ShortcutCatalog.Format 算好的
              显示串，OneWay 绑进方框。框在 DataTemplate 里，按规矩不给 AutomationId、但给一个读屏用的 Name。
            -->
            <local:SettingRowTemplates.Shortcut>
                <DataTemplate x:DataType="vm:SettingShortcutRow">
                    <Grid Style="{StaticResource EgSettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource EgSettingControlWidth}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" TextWrapping="Wrap" />
                        <local:ShortcutCaptureBox
                            Grid.Column="1"
                            AutomationProperties.Name="{x:Bind Label}"
                            Combo="{x:Bind ComboText, Mode=OneWay}"
                            Committed="{x:Bind OnCommitted}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </local:SettingRowTemplates.Shortcut>
        </local:SettingRowTemplates>
    </Page.Resources>

    <Grid x:Name="SettingsLayout" Margin="16,8,16,16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SettingsWidthStates">
                <VisualState x:Name="CompactSettings">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsLayout.Margin" Value="16,16,16,16" />
                        <Setter Target="SettingsNavColumn.Width" Value="0" />
                        <Setter Target="SettingsBody.ColumnSpacing" Value="0" />
                        <Setter Target="SettingsBody.RowSpacing" Value="16" />
                        <Setter Target="SettingsNavigation.(Grid.RowSpan)" Value="1" />
                        <Setter Target="SettingsNavigation.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="CategoryNavigation.Visibility" Value="Collapsed" />
                        <Setter Target="CompactCategoryNavigation.Visibility" Value="Visible" />
                        <Setter Target="SettingsContent.(Grid.Row)" Value="1" />
                        <Setter Target="SettingsContent.(Grid.RowSpan)" Value="1" />
                        <Setter Target="SettingsContent.(Grid.Column)" Value="0" />
                        <Setter Target="SettingsContent.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideSettings">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="860" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          **页头整个没有了**（用户的话，2026-09-13：「把设置页面左上角的标题栏的图标和设置字样去掉」「删除
          设置页面左上角的打造你的观影方式……这些字」）。那一格 2026-09-11 删过一次场面（PageSlate 场记板），
          剩下「打造你的观影方式」加一行小字站在左上角；这一次连字带格子全删 —— 分类那一列之外的什么都不剩，
          内容直接顶到最上面。窗口标题栏（SettingsWindow）同日也摘了图标和字样，左上角
          从外到里都是空的。
        -->
        <StackPanel Grid.Row="0" Spacing="8">
            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
            <InfoBar
                x:Name="UnsavedSettingsNotice"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasUnsavedChanges, Mode=OneWay}"
                Severity="Warning"
                Title="设置尚未保存"
                Message="修改仍在本次运行中生效，但关闭程序后可能丢失。请检查磁盘空间和目录权限后重试。"
                Visibility="{x:Bind ViewModel.UnsavedVisibility, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button x:Name="RetrySaveSettingsButton" Content="重试保存" Command="{x:Bind ViewModel.RetrySaveCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <Grid x:Name="SettingsBody" Grid.Row="1" ColumnSpacing="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SettingsNavColumn" Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 搜索和分类共用这一列；窄窗只换分类选择器，不增删或过滤侧栏分区。 -->
            <Grid x:Name="SettingsNavigation" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="SettingsSearchField" Margin="0,0,0,12"
                    Background="{ThemeResource EgSurfaceAltBrush}" CornerRadius="8">
                    <AutoSuggestBox
                        x:Name="SettingsSearchBox"
                        Background="Transparent" BorderThickness="0" CornerRadius="8"
                        TextBoxStyle="{StaticResource SettingsSearchTextBox}"
                        PlaceholderText="搜索设置项"
                        AutomationProperties.Name="搜索设置项"
                        Text="{x:Bind ViewModel.SettingsSearchQuery, Mode=TwoWay}"
                        ItemsSource="{x:Bind ViewModel.SettingsSearchResults, Mode=OneWay}"
                        TextMemberPath="Label"
                        UpdateTextOnSelect="False"
                        MaxSuggestionListHeight="420"
                        QuerySubmitted="OnSettingsSearchSubmitted">
                        <AutoSuggestBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        </AutoSuggestBox.Resources>
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingsSearchResult">
                                <StackPanel Spacing="2" Padding="0,4">
                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource EgBodyStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Location}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                    <Button x:Name="SettingsSearchButton" Width="32" Height="32" MinWidth="0" MinHeight="0"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Padding="0" CornerRadius="8"
                        Background="Transparent" BorderThickness="0" AutomationProperties.Name="搜索设置项"
                        Click="OnSettingsSearchClick">
                        <FontIcon Glyph="&#xE721;" FontSize="{StaticResource EgBodyFontSize}"
                            Foreground="{ThemeResource EgTextDimBrush}" />
                    </Button>
                </Grid>
                <TextBlock x:Name="SettingsSearchEmpty" Grid.Row="1" Margin="4,0,4,12"
                    Text="未找到匹配的设置项" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap"
                    automation:AutomationProperties.LiveSetting="Polite"
                    Visibility="{x:Bind ViewModel.SettingsSearchEmptyVisibility, Mode=OneWay}" />
                <ComboBox
                    x:Name="CompactCategoryNavigation"
                    x:Uid="SettingsPage_CategoryPicker"
                    AutomationProperties.AutomationId="SettingsCategoryPicker"
                    Grid.Row="2"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    MinWidth="0"
                    ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                    DisplayMemberPath="PickerLabel"
                    SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=TwoWay}"
                    Visibility="Collapsed" />

            <ListView
                x:Name="CategoryNavigation"
                AutomationProperties.AutomationId="SettingsCategoryList"
                Grid.Row="3"
                Background="Transparent"
                Padding="0"
                IsItemClickEnabled="False"
                ItemsSource="{x:Bind CategoryGroupsSource.View, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=TwoWay}"
                ContainerContentChanging="OnCategoryContainerContentChanging">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel AreStickyGroupHeadersEnabled="False" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.GroupStyle>
                    <GroupStyle HeaderContainerStyle="{StaticResource SettingsGroupHeader}">
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="vm:SettingsCategoryGroup">
                                <Grid Margin="4,12,4,4">
                                    <TextBlock Text="{x:Bind Name}" Margin="12,4,0,4"
                                        Style="{StaticResource EgCaptionStyle}" FontWeight="SemiBold"
                                        AutomationProperties.HeadingLevel="Level2"
                                        Visibility="{x:Bind CollapsedHeaderVisibility}" />
                                    <Button
                                        x:Name="SettingsServerGroupToggle"
                                        Tag="{x:Bind}"
                                        Click="OnServerGroupToggle"
                                        Style="{StaticResource SettingsGroupToggle}"
                                        Visibility="{x:Bind CollapsibleHeaderVisibility}"
                                        AutomationProperties.Name="{x:Bind Name}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource EgCaptionStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <FontIcon
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="{StaticResource EgCaptionFontSize}"
                                                Glyph="{x:Bind ChevronGlyph, Mode=OneWay}"
                                                Foreground="{ThemeResource EgTextDimBrush}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <!--
                  参考图那样每个分类左边一个图标。分类项带 key（多服务器时同名的「控制台」「媒体库」各有各的来源），
                  字形与标题都读 Label。图标和标题都不写 Foreground，跟着 ListViewItem 选中态的前景走 ——
                  选中那一项连图标一起点亮。
                -->
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingsCategoryEntry">
                        <Grid Visibility="{x:Bind Visibility, Mode=OneWay}">
                            <!--
                              原生目录的分区标题：Emby 的「Emby Server／设备／高级」、Jellyfin 的五段、
                              飞牛的两段。只画一行小标题，不参与选择（容器在 ContainerContentChanging 里
                              关掉命中与 Tab）。
                            -->
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.HeadingLevel="Level3"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource EgTextDimBrush}"
                                Style="{StaticResource EgCaptionStyle}"
                                Text="{x:Bind Label}"
                                Visibility="{x:Bind SectionVisibility}" />
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="12"
                                Visibility="{x:Bind EntryVisibility}">
                                <!--
                                  图标槽二选一：MoviePilot 这一行走官方图标的白色重绘版（2026-09-18 从 v3 仓库根的
                                  app.ico 描摹，等距立方体两截轨 + 播放三角；单色版不描折角阴影），其余分类走
                                  Segoe 字形。白是用户点的名（2026-09-18：「把图标弄成白色的替换侧边栏的这个齿轮」）。
                                  Jellyfin 的分类已全部进字形表；认不出的分类给一页通用纸，不再拿齿轮兜底
                                  （2026-10-19 用户当场指出左栏齿轮太多）。
                                -->
                                <Grid>
                                    <FontIcon
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="16"
                                        Glyph="{x:Bind Label, Converter={StaticResource CategoryGlyph}}"
                                        Visibility="{x:Bind Label, Converter={StaticResource MoviePilotMark}, ConverterParameter=hide}" />
                                    <Viewbox
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind Label, Converter={StaticResource MoviePilotMark}}">
                                        <Canvas Width="256" Height="256">
                                            <Path
                                                Data="M48,191 L32,181 L32,86 L34,80 L43,72 L120,24 L126,22 L135,24 L159,39 L159,54 L149,69 L129,56 L126,56 L63,96 L63,191 Z"
                                                Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Path
                                                Data="M96,221 L96,200 L101,190 L103,190 L128,201 L192,173 L192,58 L197,58 L223,72 L223,186 L220,193 L217,196 L209,200 L202,202 L197,205 L195,205 L190,208 L188,208 L183,211 L181,211 L176,214 L174,214 L169,217 L162,219 L130,233 L125,233 L119,231 Z"
                                                Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Path
                                                Data="M107,165 L102,162 L102,92 L106,89 L115,93 L149,113 L165,121 L170,125 L170,129 L167,132 L158,136 L124,156 Z"
                                                Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            </Grid>

            <!--
              需求 2 的后半句：「诊断和服务器移动到设置里」. The left-hand list also holds entries that are not
              cards — 服务器, 诊断, 通知, 网页控制台 and 飞牛影视's four management pages are whole pages, with a
              server list that talks to the network, a log view that tails a file and an embedded browser, and
              none is expressible as a stack of setting rows. Which one is visible follows the selected category,
              decided in the view model rather than here so the page and the self-check read the same flag.
              （「恢复默认」曾是这份名单末尾的第四项，2026-09-24 搬进了「关于」卡，见 SettingsViewModel.AboutCard。）
            -->
            <Grid x:Name="SettingsContent" Grid.Column="1" Grid.RowSpan="2">
                <!--
                  Every card is built and kept, and picking a category only changes which one is shown — the
                  same as before. There is no server data on this page, so building all of them costs nothing
                  measurable, and a card that stays alive keeps half-typed text across a trip through the
                  category list.
                -->
                <ScrollViewer
                    x:Name="SettingsScroll"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{x:Bind ViewModel.CardsVisibility, Mode=OneWay}">
                    <!-- 右侧 20 DIP 是滚动条的独立槽位；卡片不伸进滚动指示器区域。 -->
                    <StackPanel x:Name="SettingsCardsContent" Margin="0,0,20,0">
                        <StackPanel Spacing="8" Margin="0,0,0,20" MaxWidth="900"
                            Visibility="{x:Bind ViewModel.ShortcutSearchVisibility, Mode=OneWay}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <AutoSuggestBox x:Name="ShortcutSearchBox" PlaceholderText="搜索快捷键名称或按键，如：字幕、Ctrl + ↑"
                                    AutomationProperties.Name="搜索快捷键" QueryIcon="Find"
                                    Text="{x:Bind ViewModel.ShortcutSearchQuery, Mode=TwoWay}" />
                                <Button x:Name="ClearShortcutSearchButton" Grid.Column="1" Content="清空搜索"
                                    Command="{x:Bind ViewModel.ClearShortcutSearchCommand}"
                                    Visibility="{x:Bind ViewModel.ClearShortcutSearchVisibility, Mode=OneWay}" />
                            </Grid>
                            <TextBlock x:Name="ShortcutSearchSummary" Style="{StaticResource EgSettingNote}"
                                Text="{x:Bind ViewModel.ShortcutSearchSummary, Mode=OneWay}" />
                        </StackPanel>
                        <ItemsControl x:Name="SettingsSections" ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}" MaxWidth="900" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!--
                                      外层面板的间距必须是 0。分类切换把没选中的卡折进 Visibility.Collapsed，但
                                      ItemsControl 给每项包的占位容器（ContentPresenter）不跟着折叠 —— 零高、可见，
                                      StackPanel 的 Spacing 照样在它前面垫一次：36 × 隐藏卡张数的空白就是这么来的
                                      （「关于」第九张 = 8 × 36 = 288px，2026-09-06 截图实量 y=416 对上）。分组之间
                                      的 36 由模板根上的下外边距承担 —— 折叠时边距跟着内容一起归零，才是真不占位。
                                    -->
                                    <StackPanel Spacing="0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingSection">
                                    <!-- 整组卡片保留，重复标题与选项分隔线取消。 -->
                                    <StackPanel x:Name="SettingsSection" Spacing="0" Margin="0,0,0,16" Visibility="{x:Bind SectionVisibility, Mode=OneWay}">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform />
                                        </StackPanel.RenderTransform>
                                        <!-- 仅取消与侧栏重复的分类标题和数量，真正的子分组标题继续显示。 -->
                                        <TextBlock x:Name="SettingsSectionTitle" Margin="8,0,0,12"
                                            Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource EgSubheadStyle}"
                                            AutomationProperties.HeadingLevel="Level2"
                                            Visibility="{x:Bind HeadingVisibility, Mode=OneWay}" />
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0"
                                            CornerRadius="12"
                                            Padding="6">
                                            <ItemsControl x:Name="SettingsRowsList" Tag="{x:Bind}"
                                                Loaded="OnSettingsRowsLoaded" Unloaded="OnSettingsRowsUnloaded"
                                                ItemTemplateSelector="{StaticResource EgSettingRows}"
                                                ItemsSource="{x:Bind Rows}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="0" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--
                          「恢复默认」不住这一列。它一路搬过好几处（关于卡第八行 → 页头 → 卡片叠底 → 左边名单末尾），
                          2026-09-24 按「把恢复默认设置移动到关于中」落回「关于」卡 —— 和同轮新增的「备份配置文件」
                          「恢复配置」并作三颗动作按钮，见 SettingsViewModel.AboutCard。它不再是分类，所以这一列里
                          没有它。
                        -->
                    </StackPanel>
                </ScrollViewer>

                <!-- Transitions cleared for the same reason the shell's frame clears them (requirement 9). -->
                <Frame
                    x:Name="HostedFrame"
                    Transitions="{x:Null}"
                    Visibility="{x:Bind ViewModel.HostedVisibility, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
