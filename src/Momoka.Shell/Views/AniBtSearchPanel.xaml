<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Momoka.Shell.Views.AniBtSearchPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momoka.Shell.Views"
    xmlns:vm="using:Momoka.Shell.ViewModels">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <AutoSuggestBox x:Name="AnimeSearchInput" Header="搜索 AniBT 番剧"
            PlaceholderText="输入番剧名称或原名" QueryIcon="Find" QuerySubmitted="OnSearch" TextChanged="OnSearchTextChanged"
            Visibility="Collapsed" />
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar Height="2" IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
            <InfoBar Grid.Row="1" IsClosable="True" Margin="0,0,0,12"
                IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
            <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,12">
                <local:WrapRow Spacing="8" RowSpacing="8"
                    Visibility="{x:Bind ViewModel.ResourcesVisibility, Mode=OneWay}">
                    <Button x:Name="ReturnToAnime" Content="返回番剧" Command="{x:Bind ViewModel.ReturnToResultsCommand}" Click="OnReturnToAnime" />
                    <Button x:Name="ReloadAnimeResources" Content="重新读取资源" Command="{x:Bind ViewModel.ReloadResourcesCommand}" />
                </local:WrapRow>
                <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" Style="{StaticResource EgSectionTitleStyle}"
                    TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.ResourceScope, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}"
                    Foreground="{ThemeResource EgTextDimBrush}" TextWrapping="Wrap" />
                <Button x:Name="ShowAllAnimeEpisodes" Content="查看全部集数" HorizontalAlignment="Left"
                    Command="{x:Bind ViewModel.ShowAllEpisodesCommand}" Visibility="{x:Bind ViewModel.EpisodeScopeVisibility, Mode=OneWay}" />
            </StackPanel>
            <Grid Grid.Row="3">
                <ListView x:Name="AnimeResults" SelectionMode="None"
                    HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanChooseAnime, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AniBtAnimeRow">
                            <Button x:Name="OpenAnimeResources" Command="{x:Bind OpenCommand}"
                                AutomationProperties.Name="{x:Bind OpenAutomationName}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,12"
                                Background="{ThemeResource EgSurfaceBrush}" BorderBrush="{ThemeResource EgBorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource EgCardCornerRadius}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource EgSubheadStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind OriginalTitle}" Style="{StaticResource EgCaptionStyle}"
                                        Foreground="{ThemeResource EgTextDimBrush}" TextWrapping="Wrap" Visibility="{x:Bind OriginalVisibility}" />
                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource EgCaptionStyle}"
                                        Foreground="{ThemeResource EgTextDimBrush}" TextWrapping="Wrap" Visibility="{x:Bind DescriptionVisibility}" />
                                    <TextBlock Text="查看资源" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <local:MoviePilotResourceBrowser x:Name="ResourceBrowser"
                    Visibility="{x:Bind ViewModel.ResourcesVisibility, Mode=OneWay}" />
                <TextBlock Margin="24,48,24,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Text="{x:Bind ViewModel.EmptyNotice, Mode=OneWay}" Style="{StaticResource EgBodyStyle}"
                    Foreground="{ThemeResource EgTextDimBrush}" TextAlignment="Center" TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />
            </Grid>
            <Button x:Name="LoadMoreAnime" Grid.Row="4" Content="加载更多番剧" HorizontalAlignment="Center" Margin="0,12,0,0"
                Command="{x:Bind ViewModel.LoadMoreCommand}" Visibility="{x:Bind ViewModel.MoreVisibility, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
