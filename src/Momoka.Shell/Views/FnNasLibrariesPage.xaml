<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Momoka.Shell.Views.FnNasLibrariesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momoka.Shell.ViewModels"
    Background="{ThemeResource EgWindowBrush}">
    <Page.Resources>
        <Style x:Key="FnNasCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource EgSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
            <Setter Property="BorderThickness" Value="{StaticResource EgCardBorderThickness}" />
            <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <DataTemplate x:Key="FnNasChoiceTemplate" x:DataType="vm:FnNasChoice">
            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="FnNasPermissionTemplate" x:DataType="vm:FnNasChoice">
            <CheckBox x:Name="FnNasPermissionCheck" Content="{x:Bind Name}" IsChecked="{x:Bind Selected, Mode=TwoWay}" Margin="0,3" />
        </DataTemplate>
    </Page.Resources>
    <Grid x:Name="PageLayout" RowSpacing="12" Padding="0,0,4,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=OneWay}" IsClosable="False"
                Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}" Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
        </StackPanel>
        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
            <Grid RowSpacing="16" Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Spacing="12">
                    <TextBlock Text="媒体库" Style="{StaticResource EgSectionTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="FnNasLibrariesNew" Content="新增媒体库" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.NewLibraryCommand}" />
                        <Button x:Name="FnNasLibrariesSort" Content="排序" Command="{x:Bind ViewModel.SortCommand}" />
                        <Button x:Name="FnNasLibrariesScanAll" Content="扫描全部" Command="{x:Bind ViewModel.ScanAllCommand}" />
                        <Button x:Name="FnNasLibrariesRefresh" Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
                    </StackPanel>
                </StackPanel>
                <ListView x:Name="FnNasLibrariesList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Libraries, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnLibraryClick" IsEnabled="{x:Bind ViewModel.CanUse, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FnNasLibraryRow">
                            <Grid ColumnSpacing="16" Padding="8,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource EgSubheadStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind CategoryName}" Style="{StaticResource EgBodyStyle}" />
                                    <TextBlock Text="{x:Bind Directories}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Updated}" Style="{StaticResource EgCaptionStyle}" />
                                </StackPanel>
                                <Button x:Name="FnNasLibraryScan" Grid.Column="1" Content="扫描" Tag="{x:Bind}" Click="OnScan" Visibility="{x:Bind ScanVisibility}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Grid RowSpacing="16" Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="FnNasLibraryBack" Content="返回" Command="{x:Bind ViewModel.BackCommand}" />
                    <TextBlock Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}" Style="{StaticResource EgSectionTitleStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <ScrollView x:Name="FnNasLibraryEditorScroll" Grid.Row="1">
                    <StackPanel Spacing="16" Padding="0,0,0,16">
                        <Border Style="{StaticResource FnNasCard}">
                            <StackPanel Spacing="16">
                                <ComboBox x:Name="FnNasLibraryCategory" Header="媒体库类型" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}" ItemTemplate="{StaticResource FnNasChoiceTemplate}" SelectedValuePath="Id" SelectedValue="{x:Bind ViewModel.Category, Mode=TwoWay}" />
                                <TextBox x:Name="FnNasLibraryName" Header="媒体库名称" MaxLength="32" Text="{x:Bind ViewModel.LibraryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FnNasCard}" Visibility="{x:Bind ViewModel.FilesVisibility, Mode=OneWay}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="媒体库文件夹" Style="{StaticResource EgSubheadStyle}" />
                                <ItemsControl x:Name="FnNasLibraryFolders" ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FnNasChoice">
                                            <Grid ColumnSpacing="12" Margin="0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" Style="{StaticResource EgBodyStyle}" VerticalAlignment="Center" />
                                                <Button x:Name="FnNasRemoveFolder" Grid.Column="1" Content="移除" Tag="{x:Bind}" Click="OnRemoveFolder" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="FnNasBrowseFolders" Content="选择文件夹" Command="{x:Bind ViewModel.BrowseCommand}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FnNasCard}" Visibility="{x:Bind ViewModel.IptvVisibility, Mode=OneWay}">
                            <StackPanel Spacing="16">
                                <ToggleSwitch x:Name="FnNasReplacePlaylist" Header="更换当前播放列表" IsOn="{x:Bind ViewModel.ReplacePlaylist, Mode=TwoWay}" Visibility="{x:Bind ViewModel.KeepPlaylistVisibility, Mode=OneWay}" />
                                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.PlaylistEditorVisibility, Mode=OneWay}">
                                    <ComboBox x:Name="FnNasPlaylistMode" Header="播放列表来源" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.PlaylistMode, Mode=TwoWay}">
                                        <x:String>在线地址</x:String><x:String>粘贴内容</x:String><x:String>NAS 文件</x:String><x:String>本地上传</x:String>
                                    </ComboBox>
                                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.PlaylistUrlVisibility, Mode=OneWay}">
                                        <TextBox x:Name="FnNasPlaylistUrl" Header="播放列表地址" Text="{x:Bind ViewModel.PlaylistUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ComboBox x:Name="FnNasPlaylistRefresh" Header="自动更新间隔" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.PlaylistRefresh, Mode=TwoWay}">
                                            <x:String>不自动更新</x:String><x:String>每小时</x:String><x:String>每 3 小时</x:String><x:String>每 6 小时</x:String><x:String>每 12 小时</x:String>
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBox x:Name="FnNasPlaylistText" Header="播放列表内容" AcceptsReturn="True" Height="220" TextWrapping="Wrap" Text="{x:Bind ViewModel.PlaylistText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{x:Bind ViewModel.PlaylistTextVisibility, Mode=OneWay}" />
                                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.PlaylistNasVisibility, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind ViewModel.PlaylistPath, Mode=OneWay}" Style="{StaticResource EgBodyStyle}" TextWrapping="Wrap" />
                                        <Button x:Name="FnNasPlaylistBrowse" Content="选择 NAS 播放列表文件" Command="{x:Bind ViewModel.BrowseCommand}" />
                                    </StackPanel>
                                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.PlaylistUploadVisibility, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind ViewModel.PlaylistFileName, Mode=OneWay}" Style="{StaticResource EgBodyStyle}" TextWrapping="Wrap" />
                                        <Button x:Name="FnNasPlaylistPick" Content="选择本地播放列表文件" Command="{x:Bind ViewModel.PickPlaylistCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FnNasCard}" Visibility="{x:Bind ViewModel.DirectoryBrowserVisibility, Mode=OneWay}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="NAS 已授权的文件夹" Style="{StaticResource EgSubheadStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.DirectoryPath, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource EgCaptionStyle}" />
                                <ListView x:Name="FnNasDirectoryList" Height="220" ItemsSource="{x:Bind ViewModel.DirectoryItems, Mode=OneWay}" ItemTemplate="{StaticResource FnNasChoiceTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnDirectoryClick" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="FnNasDirectoryRoots" Content="授权根目录" Command="{x:Bind ViewModel.RootsCommand}" />
                                    <Button x:Name="FnNasDirectoryChoose" Content="使用此文件夹" Command="{x:Bind ViewModel.ChooseDirectoryCommand}" Visibility="{x:Bind ViewModel.FilesVisibility, Mode=OneWay}" />
                                    <Button x:Name="FnNasDirectoryClose" Content="关闭" Command="{x:Bind ViewModel.CloseDirectoriesCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FnNasCard}" Visibility="{x:Bind ViewModel.FilesVisibility, Mode=OneWay}">
                            <StackPanel Spacing="16">
                                <TextBlock Text="高级设置" Style="{StaticResource EgSubheadStyle}" />
                                <ToggleSwitch x:Name="FnNasPreferNfo" Header="优先使用本地 NFO 和图片" IsOn="{x:Bind ViewModel.PreferLocalNfo, Mode=TwoWay}" />
                                <ToggleSwitch x:Name="FnNasFilterSmall" Header="过滤较小的文件" IsOn="{x:Bind ViewModel.FilterSmallFiles, Mode=TwoWay}" />
                                <NumberBox x:Name="FnNasMinimumFileSize" Header="跳过小于此大小的文件（MB）" Minimum="1" Maximum="1024" SmallChange="1" Value="{x:Bind ViewModel.MinimumFileSize, Mode=TwoWay}" Visibility="{x:Bind ViewModel.MinimumSizeVisibility, Mode=OneWay}" />
                                <ComboBox x:Name="FnNasLibraryLanguage" Header="元数据语言" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}" ItemTemplate="{StaticResource FnNasChoiceTemplate}" SelectedValuePath="Id" SelectedValue="{x:Bind ViewModel.Language, Mode=TwoWay}" />
                                <ToggleSwitch x:Name="FnNasIncludeAdult" Header="包含成人内容" IsOn="{x:Bind ViewModel.IncludeAdult, Mode=TwoWay}" />
                                <ToggleSwitch x:Name="FnNasProgressThumb" Header="生成进度预览缩略图" IsOn="{x:Bind ViewModel.ProgressThumb, Mode=TwoWay}" />
                                <ComboBox x:Name="FnNasViewType" Header="显示方式" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.ViewType, Mode=TwoWay}" Visibility="{x:Bind ViewModel.ViewTypeVisibility, Mode=OneWay}">
                                    <x:String>按文件夹显示</x:String><x:String>平铺显示</x:String>
                                </ComboBox>
                                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.SubtitleVisibility, Mode=OneWay}">
                                    <ToggleSwitch x:Name="FnNasAutoSubtitle" Header="自动下载字幕" IsOn="{x:Bind ViewModel.AutoSubtitle, Mode=TwoWay}" />
                                    <ComboBox x:Name="FnNasSubtitleLanguage" Header="首选字幕语言" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}" ItemTemplate="{StaticResource FnNasChoiceTemplate}" SelectedValuePath="Id" SelectedValue="{x:Bind ViewModel.SubtitleLanguage, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button x:Name="FnNasLibraryDelete" Content="移除媒体库" Command="{x:Bind ViewModel.DeleteCommand}" Visibility="{x:Bind ViewModel.DeleteVisibility, Mode=OneWay}" />
                    </StackPanel>
                </ScrollView>
                <Button x:Name="FnNasLibrarySave" Grid.Row="2" Content="保存媒体库" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
