<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Momoka.Shell.Views.FnNasSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momoka.Shell.ViewModels"
    Background="{ThemeResource EgWindowBrush}">
    <Page.Resources>
        <Style x:Key="FnNasCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource EgSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <DataTemplate x:Key="FnNasChoiceTemplate" x:DataType="vm:FnNasChoice">
            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="FnNasPermissionTemplate" x:DataType="vm:FnNasChoice">
            <CheckBox x:Name="FnNasPermissionCheck" Content="{x:Bind Name}" IsChecked="{x:Bind Selected, Mode=TwoWay}" Margin="0,3" />
        </DataTemplate>
    </Page.Resources>
    <Grid x:Name="PageLayout" RowSpacing="12" Padding="0,0,4,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=OneWay}" IsClosable="False"
                Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}" Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
            <Button x:Name="FnNasSettingsRecovery" Content="重新检查权限" Command="{x:Bind ViewModel.RefreshCommand}" Visibility="{x:Bind ViewModel.RecoveryVisibility, Mode=OneWay}" />
        </StackPanel>
        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
            <ScrollView x:Name="FnNasSettingsScroll">
                <StackPanel Spacing="16" Padding="0,0,0,20">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="设置" Style="{StaticResource EgSectionTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
                        <Button x:Name="FnNasSettingsRefresh" Grid.Column="1" Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
                    </Grid>
                    <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"><StackPanel Spacing="16">
                        <Border Style="{StaticResource FnNasCard}">
                            <StackPanel Spacing="16">
                                <TextBox x:Name="FnNasServerName" Header="服务器名称" MaxLength="32" Text="{x:Bind ViewModel.ServerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox x:Name="FnNasServerLanguage" Header="首选语言" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}" ItemTemplate="{StaticResource FnNasChoiceTemplate}" SelectedValuePath="Id" SelectedValue="{x:Bind ViewModel.Language, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FnNasCard}">
                            <StackPanel Spacing="16">
                                <ComboBox x:Name="FnNasMetadataVolume" Header="元数据保存位置" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Volumes, Mode=OneWay}" ItemTemplate="{StaticResource FnNasChoiceTemplate}" SelectedValuePath="Id" SelectedValue="{x:Bind ViewModel.MetadataVolume, Mode=TwoWay}" />
                                <ComboBox x:Name="FnNasPlaybackCacheVolume" Header="播放临时文件缓存位置" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Volumes, Mode=OneWay}" ItemTemplate="{StaticResource FnNasChoiceTemplate}" SelectedValuePath="Id" SelectedValue="{x:Bind ViewModel.PlaybackCacheVolume, Mode=TwoWay}" />
                                <ToggleSwitch x:Name="FnNasFileMonitor" Header="实时监控文件更新" IsOn="{x:Bind ViewModel.FileMonitor, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel></ContentControl>
                    <Button x:Name="FnNasSettingsSave" Content="保存设置" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
                    <Border Style="{StaticResource FnNasCard}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="搜索索引" Style="{StaticResource EgSubheadStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.IndexStatus, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                            <Button x:Name="FnNasRebuildIndex" Content="重建索引" Command="{x:Bind ViewModel.RebuildCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollView>
        </Grid>
    </Grid>
</Page>
