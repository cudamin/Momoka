<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Momoka.Shell.Views.MoviePilotResourcePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momoka.Shell.ViewModels"
    xmlns:local="using:Momoka.Shell.Views"
    Background="{ThemeResource EgWindowBrush}">
    <Grid Background="{ThemeResource EgWindowBrush}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="CloseButton" Click="OnClose" Content="返回" Style="{StaticResource EgSecondaryButtonStyle}" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource EgSubheadStyle}"
                Text="{x:Bind ViewModel.Heading, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            <Button x:Name="RetrySearch" Grid.Column="2" Content="搜索资源" Click="OnRetry" Style="{StaticResource EgSecondaryButtonStyle}" />
        </Grid>
        <local:MoviePilotSitePicker x:Name="SearchSitePicker" Grid.Row="1" />
        <InfoBar Grid.Row="2" IsClosable="True" IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
        <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <local:MoviePilotSearchProgressView x:Name="SearchProgress" Margin="0,0,0,12"
                Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
            <local:MoviePilotResourceBrowser x:Name="ResourceList" Grid.Row="1" Visibility="{x:Bind ViewModel.TorrentsVisibility, Mode=OneWay}" />
            <ListView x:Name="SubtitleResults" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Subtitles, Mode=OneWay}" SelectionMode="None"
                Padding="{StaticResource EgScrollBarLane}"
                Visibility="{x:Bind ViewModel.SubtitlesVisibility, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MoviePilotSubtitleRow">
                        <StackPanel Spacing="8" Padding="8">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource EgBodyStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Meta}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                            <Button x:Name="DownloadMediaSubtitle" Content="{x:Bind DownloadLabel, Mode=OneWay}" Command="{x:Bind DownloadCommand}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Grid.Row="1" Margin="24,48,24,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                Foreground="{ThemeResource EgTextDimBrush}" Style="{StaticResource EgBodyStyle}" Text="{x:Bind ViewModel.EmptyNotice, Mode=OneWay}"
                TextAlignment="Center" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
