<UserControl
    x:Class="Momoka.Shell.Views.MoviePilotSubscriptionWallView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momoka.Shell.Views"
    xmlns:vm="using:Momoka.Shell.ViewModels">
    <!--
      MoviePilot「我的订阅」墙：工具栏（网页端那三个图标：筛选／拖拽排序／批量）＋各种横幅＋宽背景卡片网格＋空态。
      行为逐条对着网页端 SubscribeListView／subscribe-index 移植，状态与判断都在视图模型，这里只绑定与接事件。
      分类页（电影／电视剧）由宿主页面立起来并接同一份订阅数据；汇总库仍走原来的横排，不立墙。
    -->
    <UserControl.Resources>
        <!--
          网页端那颗筛选键弹出来的 VMenu → VCard：面板自己排内边距，不留框架那圈 12。
          浮层默认是亚克力的，底下的海报会透上来；这里给实底，和网页端那张卡片一致。
        -->
        <Style x:Key="WallMenuSurfaceStyle" TargetType="FlyoutPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="Infinity" />
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
        </Style>
        <!-- 面板里「状态」「排序」两个小标题（网页端 VListSubheader）。 -->
        <Style x:Key="WallMenuHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource EgCaptionStyle}">
            <Setter Property="Margin" Value="14,10,14,4" />
        </Style>
        <!-- 面板里的一条（网页端 VListItem）：平铺一行，悬停吃默认按钮底色，选中另有强调色底。 -->
        <Style x:Key="WallOptionRowStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="{StaticResource EgSmallActionCornerRadius}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="{StaticResource EgSpaceM}">
        <!--
          工具栏：网页端订阅页头部那三个图标（筛选／拖拽排序／批量），从左往右排在原来那排药丸的位置。
          筛选浮层里放的是网页端同一块面板：名称搜索＋状态列表＋排序列表；选状态收起面板，选排序不收起。
          维护与刷新是本地独有的管理入口（网页端没有），摆在同一行右端，不混进那三个图标里。
        -->
        <Grid ColumnSpacing="{StaticResource EgSpaceS}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource EgSpaceXS}" HorizontalAlignment="Left">
                <Button x:Uid="MoviePilotSubscriptionWallView_WallFilterButton" x:Name="WallFilterButton" Style="{StaticResource EgIconButtonStyle}"
                    AutomationProperties.Name="筛选订阅" ToolTipService.ToolTip="筛选订阅">
                    <FontIcon Glyph="&#xE71C;" FontSize="{StaticResource EgSubheadFontSize}"
                        Foreground="{x:Bind FilterTone(ViewModel.WallFilter, ViewModel.WallKeyword), Mode=OneWay}" />
                    <Button.Flyout>
                        <Flyout x:Name="WallFilterFlyout" Placement="BottomEdgeAlignedLeft"
                            FlyoutPresenterStyle="{StaticResource WallMenuSurfaceStyle}" Opening="OnFilterFlyoutOpening">
                            <StackPanel Width="264">
                                <!-- 名称：网页端那颗带放大镜、可清空的外框输入框。 -->
                                <Grid Margin="12,12,12,10">
                                    <TextBox x:Uid="MoviePilotSubscriptionWallView_WallKeywordBox" x:Name="WallKeywordBox" Style="{StaticResource EgTextBoxStyle}" Height="36"
                                        Padding="30,0,30,0" PlaceholderText="名称"
                                        Text="{x:Bind ViewModel.WallKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <FontIcon Glyph="&#xE721;" FontSize="{StaticResource EgCaptionFontSize}"
                                        Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        IsHitTestVisible="False" Foreground="{ThemeResource EgTextDimBrush}" />
                                    <Button x:Uid="MoviePilotSubscriptionWallView_WallKeywordClear" x:Name="WallKeywordClear" Style="{StaticResource EgIconButtonStyle}"
                                        Width="24" Height="24" HorizontalAlignment="Right" Margin="0,0,4,0"
                                        Click="OnClearKeyword" Visibility="{x:Bind KeywordClearVisibility(ViewModel.WallKeyword), Mode=OneWay}"
                                        AutomationProperties.Name="清除名称筛选" ToolTipService.ToolTip="清除">
                                        <FontIcon Glyph="&#xE711;" FontSize="{StaticResource EgCaptionFontSize}"
                                            Foreground="{ThemeResource EgTextDimBrush}" />
                                    </Button>
                                </Grid>
                                <Border Style="{StaticResource EgRuleStyle}" />
                                <TextBlock x:Uid="MoviePilotSubscriptionWallView_Localization1" Text="状态" Style="{StaticResource WallMenuHeadingStyle}" />
                                <StackPanel x:Name="WallFilterOptions" Margin="6,0,6,8" Spacing="2" />
                                <Border Style="{StaticResource EgRuleStyle}" />
                                <TextBlock x:Uid="MoviePilotSubscriptionWallView_Localization2" Text="排序" Style="{StaticResource WallMenuHeadingStyle}" />
                                <StackPanel x:Name="WallSortOptions" Margin="6,0,6,10" Spacing="2" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Uid="MoviePilotSubscriptionWallView_WallSortModeButton" x:Name="WallSortModeButton" Style="{StaticResource EgIconButtonStyle}" Click="OnToggleSortMode"
                    AutomationProperties.Name="拖拽排序" ToolTipService.ToolTip="拖拽排序">
                    <FontIcon Glyph="&#xE8CB;" FontSize="{StaticResource EgSubheadFontSize}"
                        Foreground="{x:Bind SortModeTone(ViewModel.WallSortMode), Mode=OneWay}" />
                </Button>
                <Button x:Uid="MoviePilotSubscriptionWallView_WallBatchButton" x:Name="WallBatchButton" Style="{StaticResource EgIconButtonStyle}" Click="OnToggleBatchMode"
                    AutomationProperties.Name="批量操作" ToolTipService.ToolTip="批量操作">
                    <FontIcon Glyph="&#xE762;" FontSize="{StaticResource EgSubheadFontSize}"
                        Foreground="{x:Bind BatchModeTone(ViewModel.WallBatchMode), Mode=OneWay}" />
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource EgSpaceXS}" HorizontalAlignment="Right">
                <Button x:Uid="MoviePilotSubscriptionWallView_WallRefresh" x:Name="WallRefresh" Style="{StaticResource EgIconButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand}"
                    AutomationProperties.Name="刷新订阅" ToolTipService.ToolTip="刷新订阅">
                    <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource EgSubheadFontSize}" Foreground="{ThemeResource EgTextBrush}" />
                </Button>
                <!-- 维护键用扳手（E90F）而不是「⋯」：卡片右上角那颗「⋯」是订阅管理，同屏两个 ⋯ 会混。 -->
                <Button x:Uid="MoviePilotSubscriptionWallView_WallMaintenanceButton" x:Name="WallMaintenanceButton" Style="{StaticResource EgIconButtonStyle}"
                    AutomationProperties.Name="订阅维护" ToolTipService.ToolTip="订阅维护">
                    <FontIcon Glyph="&#xE90F;" FontSize="{StaticResource EgSubheadFontSize}" Foreground="{ThemeResource EgTextBrush}" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="WallMaintenanceMenu">
                            <MenuFlyoutItem x:Uid="MoviePilotSubscriptionWallView_WallSearchAll" x:Name="WallSearchAll" Text="搜索当前媒体类型订阅" Click="OnSearchAll"
                                IsEnabled="{x:Bind NotBusy(ViewModel.WallSearchBusy), Mode=OneWay}">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="MoviePilotSubscriptionWallView_WallRefreshResources" x:Name="WallRefreshResources" Text="刷新订阅资源" Click="OnRefreshResources"
                                Visibility="{x:Bind VisibleWhen(ViewModel.CanWallAdmin), Mode=OneWay}"
                                IsEnabled="{x:Bind NotBusy(ViewModel.WallRefreshBusy), Mode=OneWay}">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="MoviePilotSubscriptionWallView_WallRefreshMetadata" x:Name="WallRefreshMetadata" Text="更新订阅元数据" Click="OnRefreshMetadata"
                                Visibility="{x:Bind VisibleWhen(ViewModel.CanWallAdmin), Mode=OneWay}"
                                IsEnabled="{x:Bind NotBusy(ViewModel.WallMetadataBusy), Mode=OneWay}">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 批量操作横幅：摘要＋提示＋选择全部／批量启用／暂停／删除＋退出。 -->
        <Border Visibility="{x:Bind ViewModel.WallBatchBannerVisibility, Mode=OneWay}"
            local:VisibilityReveal.IsEnabled="True"
            Background="{ThemeResource EgSurfaceAltBrush}" CornerRadius="{StaticResource EgCardCornerRadius}"
            Padding="12">
            <Grid ColumnSpacing="{StaticResource EgSpaceM}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="{StaticResource EgSpaceXS}" VerticalAlignment="Center">
                    <TextBlock x:Uid="MoviePilotSubscriptionWallView_Localization3" Text="批量操作" Style="{StaticResource EgSubheadStyle}" />
                    <TextBlock x:Name="WallBatchSummary" Text="{x:Bind ViewModel.WallBatchSummary, Mode=OneWay}"
                        Style="{StaticResource EgCaptionStyle}" />
                    <TextBlock x:Uid="MoviePilotSubscriptionWallView_Localization4" Text="点击卡片选择订阅，再使用右下角按钮操作。" Style="{StaticResource EgCaptionStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource EgSpaceS}"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="WallSelectAll" Style="{StaticResource EgSecondaryButtonStyle}"
                        Content="{x:Bind SelectAllLabel(ViewModel.IsWallAllSelected), Mode=OneWay}" Click="OnSelectAll" />
                    <Button x:Uid="MoviePilotSubscriptionWallView_WallBatchResume" x:Name="WallBatchResume" Style="{StaticResource EgSecondaryButtonStyle}" Content="批量启用"
                        Click="OnBatchResume" Visibility="{x:Bind VisibleWhen(ViewModel.CanWallBatchOperate), Mode=OneWay}" />
                    <Button x:Uid="MoviePilotSubscriptionWallView_WallBatchPause" x:Name="WallBatchPause" Style="{StaticResource EgSecondaryButtonStyle}" Content="批量暂停"
                        Click="OnBatchPause" Visibility="{x:Bind VisibleWhen(ViewModel.CanWallBatchOperate), Mode=OneWay}" />
                    <Button x:Uid="MoviePilotSubscriptionWallView_WallBatchDelete" x:Name="WallBatchDelete" Style="{StaticResource EgSecondaryButtonStyle}" Content="批量删除"
                        Click="OnBatchDelete" Foreground="{ThemeResource EgDangerBrush}"
                        Visibility="{x:Bind VisibleWhen(ViewModel.CanWallBatchOperate), Mode=OneWay}" />
                    <Button x:Uid="MoviePilotSubscriptionWallView_WallExitBatch" x:Name="WallExitBatch" Style="{StaticResource EgSecondaryButtonStyle}" Content="退出批量操作" Click="OnExitBatch" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 执行批次横幅：标签＋进度＋停止／关闭。色调按批次 tone 映射到角色笔刷。 -->
        <Border Visibility="{x:Bind ViewModel.WallBatchVisibility, Mode=OneWay}"
            local:VisibilityReveal.IsEnabled="True"
            Background="{ThemeResource EgSurfaceAltBrush}" CornerRadius="{StaticResource EgCardCornerRadius}"
            Padding="12" BorderThickness="1"
            BorderBrush="{x:Bind ToneBrush(ViewModel.WallBatchTone), Mode=OneWay}">
            <Grid ColumnSpacing="{StaticResource EgSpaceM}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="{StaticResource EgSpaceXS}" VerticalAlignment="Center">
                    <Grid ColumnSpacing="{StaticResource EgSpaceS}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="WallBatchLabel" Text="{x:Bind ViewModel.WallBatchLabel, Mode=OneWay}"
                            Style="{StaticResource EgBodyStyle}" TextTrimming="CharacterEllipsis"
                            Foreground="{x:Bind ToneBrush(ViewModel.WallBatchTone), Mode=OneWay}" />
                        <TextBlock x:Name="WallBatchProgressText" Grid.Column="1" Text="{x:Bind ViewModel.WallBatchProgressText, Mode=OneWay}"
                            Style="{StaticResource EgCaptionStyle}" VerticalAlignment="Center" />
                    </Grid>
                    <ProgressBar x:Name="WallBatchProgress" Maximum="100"
                        Value="{x:Bind ViewModel.WallBatchProgress, Mode=OneWay}"
                        IsIndeterminate="{x:Bind ViewModel.WallBatchIndeterminate, Mode=OneWay}"
                        Foreground="{x:Bind ToneBrush(ViewModel.WallBatchTone), Mode=OneWay}" />
                </StackPanel>
                <Button x:Uid="MoviePilotSubscriptionWallView_WallBatchCancel" x:Name="WallBatchCancel" Grid.Column="1" Style="{StaticResource EgSecondaryButtonStyle}" Content="停止"
                    Click="OnCancelBatch" VerticalAlignment="Center"
                    Visibility="{x:Bind VisibleWhen(ViewModel.WallBatchCanCancel), Mode=OneWay}" />
                <Button x:Uid="MoviePilotSubscriptionWallView_WallBatchDismiss" x:Name="WallBatchDismiss" Grid.Column="1" Style="{StaticResource EgSecondaryButtonStyle}" Content="关闭"
                    Click="OnDismissBatch" VerticalAlignment="Center"
                    Visibility="{x:Bind VisibleWhen(ViewModel.WallBatchCanDismiss), Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- 拖拽排序横幅 -->
        <Border Visibility="{x:Bind VisibleWhen(ViewModel.WallSortMode), Mode=OneWay}"
            Background="{ThemeResource EgSurfaceAltBrush}" CornerRadius="{StaticResource EgCardCornerRadius}"
            Padding="12">
            <Grid ColumnSpacing="{StaticResource EgSpaceM}">
                <TextBlock x:Uid="MoviePilotSubscriptionWallView_Localization5" Text="已进入拖拽排序模式" Style="{StaticResource EgBodyStyle}"
                    Foreground="{ThemeResource EgWarningBrush}" VerticalAlignment="Center" />
                <Button x:Uid="MoviePilotSubscriptionWallView_WallExitSort" x:Name="WallExitSort" Style="{StaticResource EgSecondaryButtonStyle}" Content="退出"
                    Click="OnExitSort" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- 列表错误条 -->
        <Border Visibility="{x:Bind ViewModel.WallListErrorVisibility, Mode=OneWay}"
            local:VisibilityReveal.IsEnabled="True"
            Background="{ThemeResource EgSurfaceAltBrush}" CornerRadius="{StaticResource EgCardCornerRadius}"
            Padding="12" BorderThickness="1" BorderBrush="{ThemeResource EgDangerBrush}">
            <TextBlock x:Uid="MoviePilotSubscriptionWallView_Localization6" Text="请求失败，请稍后重试" Style="{StaticResource EgBodyStyle}" Foreground="{ThemeResource EgDangerBrush}" />
        </Border>

        <!-- 业务提示条（复用 VM 的 Notice*） -->
        <InfoBar IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}" Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" />

        <!-- 卡片网格：拖拽排序语境下 CanReorderItems 立起，拖完落盘；其余语境就是一张普通换行网格。
             内层滚动关掉，整页由宿主 ScrollViewer 统一滚（避免两层滚动条抢拖拽）。 -->
        <ListView x:Name="WallGrid" ItemsSource="{x:Bind ViewModel.Wall, Mode=OneWay}"
            SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnWallItemClick"
            Loaded="OnWallGridLoaded" SizeChanged="OnWallGridSizeChanged"
            ContainerContentChanging="OnWallContainerChanging"
            CanReorderItems="{x:Bind ViewModel.CanWallDrag, Mode=OneWay}"
            CanDragItems="{x:Bind ViewModel.CanWallDrag, Mode=OneWay}"
            AllowDrop="{x:Bind ViewModel.CanWallDrag, Mode=OneWay}"
            ReorderMode="Enabled" DragItemsCompleted="OnWallDragCompleted"
            Visibility="{x:Bind ViewModel.WallVisibility, Mode=OneWay}"
            ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- ItemWidth 只是第一帧的起手值：量到这一页的可用宽度后由 ResizeWall 按
                         MoviePilotWallMetrics 换成「可用宽 ÷ 列数」（2026-11-16 用户令「跟媒体库一样自动
                         调整封面大小」）。ItemHeight 不跟着变 —— 卡片高度是 150 + 容器下边距 12。 -->
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="352" ItemHeight="162" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0,0,12,12" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:MoviePilotSubscriptionCard">
                    <local:MoviePilotSubscriptionWallCard Card="{x:Bind Mode=OneWay}"
                        MenuRequested="OnCardMenu" ImageRequested="OnCardImage" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 空态 -->
        <StackPanel Visibility="{x:Bind ViewModel.WallEmptyVisibility, Mode=OneWay}"
            HorizontalAlignment="Center" Spacing="{StaticResource EgSpaceS}">
            <FontIcon Glyph="&#xE8D6;" FontSize="{StaticResource EgHeaderFontSize}"
                Foreground="{ThemeResource EgTextFaintBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="WallEmptyTitle" Text="{x:Bind ViewModel.WallEmptyTitle, Mode=OneWay}"
                Style="{StaticResource EgSubheadStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Name="WallEmptyDescription" Text="{x:Bind ViewModel.WallEmptyDescription, Mode=OneWay}"
                Style="{StaticResource EgCaptionStyle}" HorizontalAlignment="Center" />
        </StackPanel>
    </StackPanel>
</UserControl>
