<ContentDialog
    x:Class="Momoka.Shell.Views.AniBtScrapeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momoka.Shell.ViewModels"
    xmlns:anibt="using:Momoka.AniBt"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}" CloseButtonText="关闭"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanAct, Mode=OneWay}"
    PrimaryButtonClick="OnSubmit">
    <ContentDialog.Resources>
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="LayerFillColorDefaultBrush" />
        <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="EgAccentHoverBrush" />
        <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="EgAccentPressedBrush" />
        <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="EgTextOnAccentBrush" />
        <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="EgTextOnAccentBrush" />
    </ContentDialog.Resources>
    <ContentDialog.PrimaryButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource EgAccentBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource EgTextOnAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </ContentDialog.PrimaryButtonStyle>
    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
        <ProgressBar Grid.Row="0" IsIndeterminate="True" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
        <ListView x:Name="ScrapeFiles" Grid.Row="1" MaxHeight="470" Padding="{StaticResource EgScrollBarLane}"
            ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:AniBtScrapeRowViewModel">
                    <StackPanel Spacing="16" Margin="0,4,0,12" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="源文件" Style="{StaticResource EgCaptionStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind MatchNote}" Style="{StaticResource EgCaptionStyle}" />
                            </Grid>
                            <TextBlock Text="{x:Bind SourceName}" TextWrapping="Wrap" Style="{StaticResource EgBodyStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="AnimeChoice" Header="识别结果" PlaceholderText="选择对应番剧" HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind CanSelect, Mode=OneWay}" Foreground="{ThemeResource EgAccentBrush}"
                            ItemsSource="{x:Bind Candidates}" SelectedItem="{x:Bind Selected, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="anibt:AniBtAnime">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" Style="{StaticResource EgBodyStyle}"
                                            Foreground="{ThemeResource EgAccentBrush}" />
                                        <TextBlock Text="{x:Bind OriginalTitle}" TextWrapping="Wrap" Style="{StaticResource EgCaptionStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel x:Name="PreparedPlan" Spacing="12" Visibility="{x:Bind PreviewVisibility, Mode=OneWay}">
                            <Border Background="{ThemeResource EgAccentSoftBrush}" CornerRadius="{StaticResource EgPickerCornerRadius}" Padding="14,12">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                                    <TextBlock x:Name="PreviewHeadingText" Text="{x:Bind DestinationTitle, Mode=OneWay}" TextWrapping="Wrap"
                                        Style="{StaticResource EgSubheadStyle}" Foreground="{ThemeResource EgAccentBrush}" />
                                    <TextBlock x:Name="EpisodeLabelText" Grid.Column="1" Text="{x:Bind EpisodeLabel, Mode=OneWay}"
                                        Style="{StaticResource EgDataStrongStyle}" Foreground="{ThemeResource EgAccentBrush}" VerticalAlignment="Center"
                                        Visibility="{x:Bind EpisodeVisibility, Mode=OneWay}" />
                                    <TextBlock x:Name="TransferMethodText" Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind TransferMethod, Mode=OneWay}"
                                        Style="{StaticResource EgCaptionStyle}" />
                                </Grid>
                            </Border>
                            <StackPanel Spacing="4" Visibility="{x:Bind SourceVisibility, Mode=OneWay}">
                                <TextBlock Text="源目录" Style="{StaticResource EgCaptionStyle}" />
                                <TextBlock x:Name="SourceDirectoryText" Text="{x:Bind SourceDirectory, Mode=OneWay}" TextWrapping="Wrap"
                                    Style="{StaticResource EgBodyStyle}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="目标位置" Style="{StaticResource EgCaptionStyle}" />
                                <TextBlock x:Name="DestinationDirectoryText" Text="{x:Bind DestinationDirectory, Mode=OneWay}" TextWrapping="Wrap"
                                    Style="{StaticResource EgCaptionStyle}" />
                                <TextBlock x:Name="DestinationFileText" Text="{x:Bind DestinationFile, Mode=OneWay}" TextWrapping="Wrap"
                                    Style="{StaticResource EgBodyStyle}" Foreground="{ThemeResource EgAccentBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="TargetWarningText" Text="{x:Bind TargetWarning, Mode=OneWay}" TextWrapping="Wrap"
                                Style="{StaticResource EgCaptionStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="ScrapeResultText" Text="{x:Bind DisplayResult, Mode=OneWay}" TextWrapping="Wrap"
                            Style="{StaticResource EgBodyStyle}" Foreground="{ThemeResource EgAccentBrush}"
                            Visibility="{x:Bind ResultVisibility, Mode=OneWay}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="2" Spacing="8">
            <Button x:Name="RetryPrepare" Content="重新读取整理目标" HorizontalAlignment="Left" Click="OnRetryPrepare"
                Visibility="{x:Bind ViewModel.RetryPrepareVisibility, Mode=OneWay}" />
            <InfoBar x:Name="ScrapeNotice" IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}"
                Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}" Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" IsClosable="False" />
        </StackPanel>
    </Grid>
</ContentDialog>
