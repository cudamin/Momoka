<UserControl x:Class="Momoka.Shell.Views.MoviePilotMediaSeasonsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momoka.Shell.ViewModels"
    xmlns:local="using:Momoka.Shell.Views">
    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.SeasonsVisibility, Mode=OneWay}">
        <TextBlock Text="季" Style="{StaticResource EgSectionTitleStyle}" />
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.GroupsVisibility, Mode=OneWay}">
            <TextBlock Text="选择剧集组" Style="{StaticResource EgCaptionStyle}" />
            <ItemsRepeater x:Name="EpisodeGroups" ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="160" MinItemHeight="64" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:MoviePilotEpisodeGroupRow">
                        <Button x:Name="SwitchEpisodeGroup" Command="{x:Bind SwitchCommand}" Style="{StaticResource EgArtworkTileStyle}"
                            AutomationProperties.Name="{x:Bind SwitchName}" ToolTipService.ToolTip="{x:Bind SwitchHelp}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Padding="12,8" Spacing="10">
                                    <FontIcon Glyph="&#xE8F1;" Foreground="{ThemeResource EgAccentBrush}" />
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource EgBodyStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Summary}" Style="{StaticResource EgCaptionStyle}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Style="{StaticResource EgFrameActiveStyle}" Background="Transparent" IsHitTestVisible="False" Visibility="{x:Bind CurrentVisibility}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <TextBlock Text="{x:Bind ViewModel.GroupSummary, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Text="{x:Bind ViewModel.SeasonNotice, Mode=OneWay}" Visibility="{x:Bind ViewModel.SeasonNoticeVisibility, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
        <ItemsRepeater x:Name="MediaSeasonList" ItemsSource="{x:Bind ViewModel.Seasons, Mode=OneWay}">
            <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:MoviePilotMediaSeasonRow">
                    <Expander x:Name="ExpandMediaSeason" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        IsExpanded="{x:Bind Expanded, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Title}">
                        <Expander.Header>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource EgBodyStyle}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Summary}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}" />
                                </StackPanel>
                                <Button x:Name="SubscribeMediaSeason" Grid.Column="1" Command="{x:Bind SubscribeCommand}" Style="{StaticResource EgIconButtonStyle}"
                                    IsEnabled="{x:Bind Editable, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind SubscribeLabel}" AutomationProperties.Name="{x:Bind SubscribeLabel}">
                                    <FontIcon Glyph="{x:Bind HeartGlyph}" Foreground="{ThemeResource EgAccentBrush}" />
                                </Button>
                            </Grid>
                        </Expander.Header>
                        <StackPanel Spacing="12">
                            <!-- 订阅季（row.Files 由视图挂到匹配季号的行上）：文件统计与逐集播放/搜索直接住进折叠栏，
                                 通用集列表给订阅季让位（用户令 2026-10-12）。数值与筛选由视图从订阅详情的视图模型推进来 ——
                                 不用嵌套 x:Bind（bind 基线只许减），也不用 ElementName。 -->
                            <StackPanel Spacing="8" Visibility="{x:Bind FilesHostVisibility, Mode=OneWay}">
                                <TextBlock Text="{x:Bind FilesSummary, Mode=OneWay}" Style="{StaticResource EgBodyStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind FilesPlaybackStatus, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}"
                                    TextWrapping="Wrap" Foreground="{ThemeResource EgTextFaintBrush}" />
                                <TextBlock Text="按 MoviePilot 关联的媒体库统计；已下载但未入库、尚未播出的集也会计入未入库。" Style="{StaticResource EgCaptionStyle}"
                                    TextWrapping="Wrap" Foreground="{ThemeResource EgTextFaintBrush}" />
                                <ComboBox x:Name="EpisodeFilter" Header="显示范围" SelectedIndex="{x:Bind FilesFilterIndex, Mode=OneWay}"
                                    MinWidth="180" SelectionChanged="OnFilesFilterChanged">
                                    <ComboBoxItem Content="全部" /><ComboBoxItem Content="已入库" /><ComboBoxItem Content="缺集 / 未入库" />
                                </ComboBox>
                                <ItemsRepeater x:Name="EpisodeStatistics" ItemsSource="{x:Bind FilesEpisodes, Mode=OneWay}">
                                    <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MoviePilotSubscriptionEpisodeRow">
                                            <Border Style="{StaticResource EgFrameStyle}" Padding="12">
                                                <Grid ColumnSpacing="16" Loaded="OnFilesEpisodeLoaded" SizeChanged="OnFilesEpisodeSizeChanged" Tag="{x:Bind}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <Border x:Name="EpisodeArtwork" Width="{x:Bind ArtworkWidth}" Height="{x:Bind ArtworkHeight}" HorizontalAlignment="Left" Style="{StaticResource EgFrameStyle}">
                                                        <Grid>
                                                            <Grid.Background><ImageBrush ImageSource="{x:Bind Artwork, Mode=OneWay}" Stretch="UniformToFill" /></Grid.Background>
                                                            <FontIcon Glyph="&#xE714;" Style="{StaticResource EgArtworkEmptyGlyphStyle}" Visibility="{x:Bind EmptyArtworkVisibility, Mode=OneWay}" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind RowTitle}" Style="{StaticResource EgBodyStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind AirDateLabel}" Style="{StaticResource EgCaptionStyle}"
                                                            Foreground="{ThemeResource EgTextFaintBrush}" Visibility="{x:Bind AirDateVisibility}" />
                                                        <TextBlock Text="{x:Bind Status}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}" />
                                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <!-- 右侧一列：播放键在上、已播出集的「搜索资源」键在下（用户令 2026-10-10）。 -->
                                                    <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                                                        <Button x:Name="PlaySubscriptionEpisode" Style="{StaticResource EgIconButtonStyle}"
                                                            Command="{x:Bind PlayCommand}" Visibility="{x:Bind PlayVisibility, Mode=OneWay}" AutomationProperties.Name="{x:Bind PlayName, Mode=OneWay}"
                                                            ToolTipService.ToolTip="{x:Bind PlayHelp, Mode=OneWay}">
                                                            <FontIcon Glyph="&#xE768;" />
                                                        </Button>
                                                        <Button x:Name="SearchSubscriptionEpisode" Style="{StaticResource EgIconButtonStyle}"
                                                            Command="{x:Bind SearchCommand}" Visibility="{x:Bind SearchVisibility}"
                                                            AutomationProperties.Name="{x:Bind SearchName, Mode=OneWay}"
                                                            ToolTipService.ToolTip="{x:Bind SearchHelp}">
                                                            <FontIcon Glyph="&#xE721;" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                            <TextBlock Text="{x:Bind EpisodeNotice, Mode=OneWay}" Visibility="{x:Bind MediaEpisodeNoticeVisibility, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                            <ItemsRepeater x:Name="MediaEpisodeList" ItemsSource="{x:Bind Episodes}" Visibility="{x:Bind MediaEpisodesVisibility, Mode=OneWay}">
                                <ItemsRepeater.Layout><StackLayout Spacing="12" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MoviePilotMediaEpisodeRow">
                                        <Border Style="{StaticResource EgFrameStyle}" Padding="12">
                                            <Grid ColumnSpacing="16" RowSpacing="8" SizeChanged="OnEpisodeSizeChanged">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Border Width="180" Height="102" CornerRadius="4" VerticalAlignment="Top">
                                                    <Border.Background><ImageBrush ImageSource="{x:Bind Artwork, Mode=OneWay}" Stretch="UniformToFill" /></Border.Background>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="8">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource EgBodyStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind Meta, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button x:Name="SearchMediaEpisode" Grid.Column="1" Command="{x:Bind SearchCommand}" Style="{StaticResource EgIconButtonStyle}"
                                                        AutomationProperties.Name="搜索这一集的资源" ToolTipService.ToolTip="搜索资源">
                                                        <FontIcon Glyph="&#xE721;" />
                                                    </Button>
                                                </Grid>
                                                <TextBlock Text="{x:Bind Overview}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Expander>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
