<UserControl x:Class="Momoka.Shell.Views.MoviePilotMediaSeasonsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momoka.Shell.ViewModels"
    xmlns:local="using:Momoka.Shell.Views">
    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.SeasonsVisibility, Mode=OneWay}">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="SeasonsHeading" Text="季" Style="{StaticResource EgSectionTitleStyle}" VerticalAlignment="Center" />
            <TextBlock x:Name="EpisodeGroupsHeading" Grid.Column="1" Text="选择剧集组" Style="{StaticResource EgCaptionStyle}"
                VerticalAlignment="Center" Visibility="{x:Bind ViewModel.GroupsVisibility, Mode=OneWay}" />
        </Grid>
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.GroupsVisibility, Mode=OneWay}">
            <ItemsRepeater x:Name="EpisodeGroups" ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="160" MinItemHeight="64" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:MoviePilotEpisodeGroupRow">
                        <Button x:Name="SwitchEpisodeGroup" Command="{x:Bind SwitchCommand}" Style="{StaticResource EgArtworkTileStyle}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            AutomationProperties.Name="{x:Bind SwitchName}" ToolTipService.ToolTip="{x:Bind SwitchHelp}">
                            <Button.Resources>
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="CardBackgroundFillColorSecondaryBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="CardBackgroundFillColorSecondaryBrush" />
                                <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="CardBackgroundFillColorDefaultBrush" />
                            </Button.Resources>
                            <Grid>
                                <StackPanel Orientation="Horizontal" Padding="12,8" Spacing="10">
                                    <FontIcon Glyph="&#xE8F1;" Foreground="{ThemeResource EgAccentBrush}" />
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource EgBodyStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Summary}" Style="{StaticResource EgCaptionStyle}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Style="{StaticResource EgFrameActiveStyle}" Background="Transparent" IsHitTestVisible="False" Visibility="{x:Bind CurrentVisibility}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <TextBlock Text="{x:Bind ViewModel.GroupSummary, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Text="{x:Bind ViewModel.SeasonNotice, Mode=OneWay}" Visibility="{x:Bind ViewModel.SeasonNoticeVisibility, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
        <ItemsRepeater x:Name="MediaSeasonList" ItemsSource="{x:Bind ViewModel.Seasons, Mode=OneWay}">
            <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:MoviePilotMediaSeasonRow">
                    <Expander x:Name="ExpandMediaSeason" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource EgBorderBrush}"
                        BorderThickness="{StaticResource EgCardBorderThickness}"
                        CornerRadius="{StaticResource EgCardCornerRadius}"
                        IsExpanded="{x:Bind Expanded, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Title}">
                        <!-- 框架的折叠栏画刷已提前解析，须在此覆盖它实际读取的键，避免默认半透明白叠在深色面板上。 -->
                        <Expander.Resources>
                            <StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="CardBackgroundFillColorDefaultBrush" />
                            <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="EgBorderBrush" />
                            <StaticResource x:Key="ExpanderHeaderBorderPointerOverBrush" ResourceKey="EgBorderStrongBrush" />
                            <StaticResource x:Key="ExpanderHeaderBorderPressedBrush" ResourceKey="EgBorderStrongBrush" />
                            <StaticResource x:Key="ExpanderHeaderDisabledBorderBrush" ResourceKey="EgBorderBrush" />
                            <StaticResource x:Key="ExpanderChevronPointerOverBackground" ResourceKey="EgSurfaceHoverBrush" />
                            <StaticResource x:Key="ExpanderChevronPressedBackground" ResourceKey="EgSurfaceElevatedBrush" />
                        </Expander.Resources>
                        <Expander.Header>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <local:WrapRow Spacing="8" RowSpacing="4">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource EgBodyStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border Background="{ThemeResource EgSurfaceElevatedBrush}" CornerRadius="8" Padding="8,2">
                                            <TextBlock Text="{x:Bind EpisodeCountLabel}" Style="{StaticResource EgDataStyle}" />
                                        </Border>
                                    </local:WrapRow>
                                </StackPanel>
                                <TextBlock x:Name="SeasonHeaderStatus" Grid.Column="1" Text="{x:Bind HeaderStatus, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}"
                                    Foreground="{ThemeResource EgAccentBrush}" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                                <Button x:Name="SubscribeMediaSeason" Grid.Column="2" Command="{x:Bind SubscribeCommand}" Style="{StaticResource EgIconButtonStyle}"
                                    IsEnabled="{x:Bind Editable, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind SubscribeLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind SubscribeLabel, Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind HeartGlyph, Mode=OneWay}" Foreground="{ThemeResource EgAccentBrush}" />
                                </Button>
                            </Grid>
                        </Expander.Header>
                        <StackPanel Spacing="12">
                            <!-- 订阅季（row.Files 由视图挂到匹配季号的行上）：文件统计与逐集播放/搜索直接住进折叠栏，
                                 通用集列表给订阅季让位（用户令 2026-10-12）。数值与筛选由视图从订阅详情的视图模型推进来 ——
                                 不用嵌套 x:Bind（bind 基线只许减），也不用 ElementName。 -->
                            <StackPanel Spacing="8" Visibility="{x:Bind FilesHostVisibility, Mode=OneWay}">
                                <TextBlock Text="{x:Bind FilesPlaybackStatus, Mode=OneWay}" Visibility="{x:Bind FilesPlaybackStatusVisibility, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}"
                                    TextWrapping="Wrap" Foreground="{ThemeResource EgTextFaintBrush}" />
                                <TextBlock Text="按 MoviePilot 关联的媒体库统计；已下载但未入库、尚未播出的集也会计入未入库。" Style="{StaticResource EgCaptionStyle}"
                                    TextWrapping="Wrap" Foreground="{ThemeResource EgTextFaintBrush}" />
                                <ComboBox x:Name="EpisodeFilter" Header="显示范围" SelectedIndex="{x:Bind FilesFilterIndex, Mode=OneWay}"
                                    MinWidth="180" SelectionChanged="OnFilesFilterChanged" Tag="{x:Bind}">
                                    <ComboBoxItem Content="全部" /><ComboBoxItem Content="已入库" /><ComboBoxItem Content="缺集 / 未入库" />
                                </ComboBox>
                                <TextBlock Text="{x:Bind FilesEmptyNotice, Mode=OneWay}" Visibility="{x:Bind FilesEmptyNoticeVisibility, Mode=OneWay}"
                                    Style="{StaticResource EgCaptionStyle}" Margin="0,8" TextWrapping="Wrap" />
                                <ItemsRepeater x:Name="EpisodeStatistics" ItemsSource="{x:Bind FilesEpisodes, Mode=OneWay}" ElementPrepared="OnFilesEpisodePrepared">
                                    <ItemsRepeater.Layout><StackLayout /></ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MoviePilotSubscriptionEpisodeRow">
                                            <Border BorderBrush="{ThemeResource EgBorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                                <Grid SizeChanged="OnFilesEpisodeSizeChanged" Tag="{x:Bind}" MinHeight="32">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <Border x:Name="EpisodeArtwork" Width="{x:Bind ArtworkWidth}" Height="{x:Bind ArtworkHeight}" Margin="0,0,16,0"
                                                        HorizontalAlignment="Left" Style="{StaticResource EgFrameStyle}" Visibility="{x:Bind ArtworkVisibility, Mode=OneWay}">
                                                        <Border.Background><ImageBrush ImageSource="{x:Bind Artwork, Mode=OneWay}" Stretch="UniformToFill" /></Border.Background>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                        <local:WrapRow Spacing="8" RowSpacing="4">
                                                            <TextBlock Text="{x:Bind RowTitle}" Style="{StaticResource EgBodyStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <Border Background="{ThemeResource EgSurfaceElevatedBrush}" CornerRadius="6" Padding="6,2" Visibility="{x:Bind AirDateVisibility}">
                                                                <TextBlock Text="{x:Bind AirDateLabel}" Style="{StaticResource EgDataStyle}" />
                                                            </Border>
                                                            <TextBlock Text="{x:Bind Status}" Style="{StaticResource EgCaptionStyle}" VerticalAlignment="Center" />
                                                        </local:WrapRow>
                                                        <TextBlock Text="{x:Bind Description}" Visibility="{x:Bind DescriptionVisibility}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <!-- 右侧一列：播放键在上、已播出集的「搜索资源」键在下（用户令 2026-10-10）。 -->
                                                    <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                                                        <Button x:Name="PlaySubscriptionEpisode" Style="{StaticResource EgIconButtonStyle}" Margin="12,0,0,0"
                                                            Command="{x:Bind PlayCommand}" Visibility="{x:Bind PlayVisibility, Mode=OneWay}" AutomationProperties.Name="{x:Bind PlayName, Mode=OneWay}"
                                                            ToolTipService.ToolTip="{x:Bind PlayHelp, Mode=OneWay}">
                                                            <FontIcon Glyph="&#xE768;" />
                                                        </Button>
                                                        <Button x:Name="SearchSubscriptionEpisode" Style="{StaticResource EgIconButtonStyle}" Margin="12,0,0,0"
                                                            Command="{x:Bind SearchCommand}" Visibility="{x:Bind SearchVisibility}"
                                                            AutomationProperties.Name="{x:Bind SearchName, Mode=OneWay}"
                                                            ToolTipService.ToolTip="{x:Bind SearchHelp}">
                                                            <FontIcon Glyph="&#xE721;" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                            <TextBlock Text="{x:Bind EpisodeNotice, Mode=OneWay}" Visibility="{x:Bind MediaEpisodeNoticeVisibility, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                            <ItemsRepeater x:Name="MediaEpisodeList" ItemsSource="{x:Bind Episodes}" Visibility="{x:Bind MediaEpisodesVisibility, Mode=OneWay}">
                                <ItemsRepeater.Layout><StackLayout /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MoviePilotMediaEpisodeRow">
                                        <Border BorderBrush="{ThemeResource EgBorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                            <Grid SizeChanged="OnEpisodeSizeChanged" MinHeight="32">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Border Width="144" Height="81" CornerRadius="4" Margin="0,0,16,0" VerticalAlignment="Top" Visibility="{x:Bind ArtworkVisibility, Mode=OneWay}">
                                                    <Border.Background><ImageBrush ImageSource="{x:Bind Artwork, Mode=OneWay}" Stretch="UniformToFill" /></Border.Background>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource EgBodyStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind Meta, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button x:Name="SearchMediaEpisode" Grid.Column="1" Command="{x:Bind SearchCommand}" Style="{StaticResource EgIconButtonStyle}"
                                                        AutomationProperties.Name="搜索这一集的资源" ToolTipService.ToolTip="搜索资源">
                                                        <FontIcon Glyph="&#xE721;" />
                                                    </Button>
                                                </Grid>
                                                <TextBlock Text="{x:Bind Overview}" Visibility="{x:Bind OverviewVisibility}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Expander>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
