<UserControl x:Class="Momoka.Shell.Views.MoviePilotSubscriptionEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momoka.Shell.ViewModels" xmlns:mp="using:Momoka.MoviePilot">
    <UserControl.Resources>
        <Style x:Key="EditorPicker" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="MinWidth" Value="0" />
        </Style>
        <Style x:Key="EditorHint" TargetType="TextBlock" BasedOn="{StaticResource EgCaptionStyle}">
            <Setter Property="Foreground" Value="{ThemeResource EgTextDimBrush}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="8,2,0,0" />
        </Style>
        <DataTemplate x:Key="EditorChoiceTemplate" x:DataType="mp:MoviePilotSubscriptionChoice"><TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" /></DataTemplate>
        <DataTemplate x:Key="EditorCheckTemplate" x:DataType="vm:MoviePilotSubscriptionEditorChoiceRow">
            <CheckBox x:Name="SelectEditorChoice" IsChecked="{x:Bind Selected, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Label}" HorizontalAlignment="Stretch"><TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" /></CheckBox>
        </DataTemplate>
    </UserControl.Resources>
    <Grid x:Name="EditorRoot" MinWidth="220" RowSpacing="4" SizeChanged="OnBodySizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <SelectorBar x:Name="EditorTabs" SelectionChanged="OnTabChanged" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
            <SelectorBarItem x:Name="BasicTab" Text="基础" IsSelected="True" /><SelectorBarItem x:Name="AdvancedTab" Text="进阶" />
        </SelectorBar>
        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}" IsClosable="True" Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}" Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
            <Button x:Name="RetryEditorChoices" Content="重新读取选项" Click="OnRetry" Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
        </StackPanel>
        <ScrollViewer x:Name="EditorScroll" Grid.Row="2" MaxHeight="570" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
            <Grid>
                <StackPanel x:Name="BasicFields" Spacing="8">
                    <Grid x:Name="EpisodeFields" ColumnSpacing="20" RowSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel x:Name="KeywordField" Spacing="4"><TextBox x:Name="KeywordInput" CornerRadius="{StaticResource EgSearchCornerRadius}" Header="搜索关键词" Text="{x:Bind ViewModel.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="指定搜索站点时使用的关键词" Style="{StaticResource EditorHint}" /></StackPanel>
                        <StackPanel x:Name="TotalField" Grid.Column="1" Spacing="4" Visibility="{x:Bind ViewModel.SeriesVisibility, Mode=OneWay}"><NumberBox x:Name="TotalInput" Header="总集数" Minimum="0" Maximum="10000" Value="{x:Bind ViewModel.TotalEpisodes, Mode=TwoWay}" SpinButtonPlacementMode="Compact" /><TextBlock Text="剧集总集数" Style="{StaticResource EditorHint}" /></StackPanel>
                        <StackPanel x:Name="StartField" Grid.Column="2" Spacing="4" Visibility="{x:Bind ViewModel.SeriesVisibility, Mode=OneWay}"><NumberBox x:Name="StartInput" Header="开始集数" Minimum="0" Maximum="10000" Value="{x:Bind ViewModel.StartEpisode, Mode=TwoWay}" SpinButtonPlacementMode="Compact" /><TextBlock Text="开始订阅集数" Style="{StaticResource EditorHint}" /></StackPanel>
                    </Grid>
                    <Grid x:Name="QualityFields" ColumnSpacing="20" RowSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel x:Name="QualityField" Spacing="4"><ComboBox x:Name="QualityInput" Header="质量" Style="{StaticResource EditorPicker}" ItemsSource="{x:Bind ViewModel.Qualities, Mode=OneWay}" ItemTemplate="{StaticResource EditorChoiceTemplate}" SelectedItem="{x:Bind ViewModel.Quality, Mode=TwoWay}" /><TextBlock Text="订阅资源质量" Style="{StaticResource EditorHint}" /></StackPanel>
                        <StackPanel x:Name="ResolutionField" Grid.Column="1" Spacing="4"><ComboBox x:Name="ResolutionInput" Header="分辨率" Style="{StaticResource EditorPicker}" ItemsSource="{x:Bind ViewModel.Resolutions, Mode=OneWay}" ItemTemplate="{StaticResource EditorChoiceTemplate}" SelectedItem="{x:Bind ViewModel.Resolution, Mode=TwoWay}" /><TextBlock Text="订阅资源分辨率" Style="{StaticResource EditorHint}" /></StackPanel>
                        <StackPanel x:Name="EffectField" Grid.Column="2" Spacing="4"><ComboBox x:Name="EffectInput" Header="特效" Style="{StaticResource EditorPicker}" ItemsSource="{x:Bind ViewModel.Effects, Mode=OneWay}" ItemTemplate="{StaticResource EditorChoiceTemplate}" SelectedItem="{x:Bind ViewModel.Effect, Mode=TwoWay}" /><TextBlock Text="订阅资源特效" Style="{StaticResource EditorHint}" /></StackPanel>
                    </Grid>
                    <StackPanel Spacing="4">
                        <TextBlock Text="订阅站点" Style="{StaticResource EgBodyStyle}" />
                        <DropDownButton x:Name="SubscriptionSitesInput" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="选择订阅站点">
                            <TextBlock Text="{x:Bind ViewModel.SitesSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <DropDownButton.Flyout><Flyout><StackPanel Spacing="8" Width="280"><TextBlock Text="订阅站点" Style="{StaticResource EgSubheadStyle}" /><ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{x:Bind ViewModel.Sites, Mode=OneWay}" ItemTemplate="{StaticResource EditorCheckTemplate}" /></ScrollViewer><Button x:Name="ClearEditorSites" Content="跟随系统" Click="OnClearSites" /></StackPanel></Flyout></DropDownButton.Flyout>
                        </DropDownButton>
                        <TextBlock Text="订阅的站点范围，不选使用系统设置" Style="{StaticResource EditorHint}" />
                    </StackPanel>
                    <Grid x:Name="IntervalFields" ColumnSpacing="20" RowSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel x:Name="IntervalModeField" Grid.ColumnSpan="2" Spacing="4"><ComboBox x:Name="SearchIntervalMode" Header="搜索周期" Style="{StaticResource EditorPicker}" SelectedIndex="{x:Bind ViewModel.IntervalMode, Mode=TwoWay}"><ComboBoxItem Content="跟随系统" /><ComboBoxItem Content="自定义" /></ComboBox><TextBlock Text="仅在开启订阅定时搜索时生效；手动搜索和 RSS 刷新不受影响。" Style="{StaticResource EditorHint}" /></StackPanel>
                        <StackPanel x:Name="IntervalHoursField" Grid.Column="1" Visibility="{x:Bind ViewModel.IntervalVisibility, Mode=OneWay}"><NumberBox x:Name="SearchIntervalHours" Header="间隔小时数" Minimum="1" Maximum="8760" Value="{x:Bind ViewModel.SearchInterval, Mode=TwoWay}" SpinButtonPlacementMode="Compact" /></StackPanel>
                    </Grid>
                    <Grid x:Name="DestinationFields" ColumnSpacing="20" RowSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel x:Name="DownloaderField" Spacing="4"><ComboBox x:Name="DownloaderInput" Header="下载器" Style="{StaticResource EditorPicker}" ItemsSource="{x:Bind ViewModel.Downloaders, Mode=OneWay}" ItemTemplate="{StaticResource EditorChoiceTemplate}" SelectedItem="{x:Bind ViewModel.Downloader, Mode=TwoWay}" /><TextBlock Text="指定该订阅使用的下载器" Style="{StaticResource EditorHint}" /></StackPanel>
                        <StackPanel x:Name="SavePathField" Grid.Column="1" Spacing="4"><ComboBox x:Name="SavePathInput" Header="保存路径" Style="{StaticResource EditorPicker}" IsEditable="True" PlaceholderText="自动" ItemsSource="{x:Bind ViewModel.Paths, Mode=OneWay}" ItemTemplate="{StaticResource EditorChoiceTemplate}" Text="{x:Bind ViewModel.SavePath, Mode=TwoWay}" SelectionChanged="OnPathSelected" /><TextBlock Text="选择或输入下载路径；留空自动使用设置的下载目录" Style="{StaticResource EditorHint}" /></StackPanel>
                    </Grid>
                    <Grid x:Name="UpgradeFields" ColumnSpacing="20" RowSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel x:Name="UpgradeField" Spacing="4"><StackPanel Orientation="Horizontal" Spacing="8"><ToggleSwitch x:Name="BestVersionInput" AutomationProperties.Name="洗版" IsOn="{x:Bind ViewModel.BestVersion, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" /><TextBlock Text="洗版" Style="{StaticResource EgBodyStyle}" VerticalAlignment="Center" /></StackPanel><TextBlock Text="根据洗版优先级提升订阅版本" Style="{StaticResource EditorHint}" /></StackPanel>
                        <StackPanel x:Name="FullUpgradeField" Grid.Column="1" Spacing="4" Visibility="{x:Bind ViewModel.FullUpgradeVisibility, Mode=OneWay}"><StackPanel Orientation="Horizontal" Spacing="8"><ToggleSwitch x:Name="BestVersionFullInput" AutomationProperties.Name="全集洗版" IsOn="{x:Bind ViewModel.BestVersionFull, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" /><TextBlock Text="全集洗版" Style="{StaticResource EgBodyStyle}" VerticalAlignment="Center" /></StackPanel><TextBlock Text="只选择覆盖订阅范围的整包" Style="{StaticResource EditorHint}" /></StackPanel>
                        <StackPanel x:Name="ImdbField" Grid.Column="2" Spacing="4"><StackPanel Orientation="Horizontal" Spacing="8"><ToggleSwitch x:Name="SearchImdbInput" AutomationProperties.Name="使用 IMDb ID 搜索" IsOn="{x:Bind ViewModel.SearchImdbId, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" /><TextBlock Text="使用 IMDb ID 搜索" Style="{StaticResource EgBodyStyle}" VerticalAlignment="Center" /></StackPanel><TextBlock Text="使用 IMDb ID 精确搜索资源" Style="{StaticResource EditorHint}" /></StackPanel>
                    </Grid>
                </StackPanel>
                <StackPanel x:Name="AdvancedFields" Spacing="20" Visibility="Collapsed">
                    <Grid x:Name="MatchFields" ColumnSpacing="20" RowSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel x:Name="IncludeField" Spacing="4"><TextBox x:Name="IncludeInput" Header="包含" Text="{x:Bind ViewModel.Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="匹配资源标题，支持正则表达式" Style="{StaticResource EditorHint}" /></StackPanel>
                        <StackPanel x:Name="ExcludeField" Grid.Column="1" Spacing="4"><TextBox x:Name="ExcludeInput" Header="排除" Text="{x:Bind ViewModel.Exclude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="排除资源标题，支持正则表达式" Style="{StaticResource EditorHint}" /></StackPanel>
                    </Grid>
                    <StackPanel Spacing="4"><TextBlock Text="优先级规则组" Style="{StaticResource EgBodyStyle}" />
                        <DropDownButton x:Name="FilterGroupsInput" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="选择优先级规则组"><TextBlock Text="{x:Bind ViewModel.FilterSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" /><DropDownButton.Flyout><Flyout><StackPanel Spacing="8" Width="280"><TextBlock Text="优先级规则组" Style="{StaticResource EgSubheadStyle}" /><ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{x:Bind ViewModel.FilterGroups, Mode=OneWay}" ItemTemplate="{StaticResource EditorCheckTemplate}" /></ScrollViewer><Button x:Name="ClearEditorFilters" Content="跟随系统" Click="OnClearFilters" /></StackPanel></Flyout></DropDownButton.Flyout></DropDownButton>
                        <TextBlock Text="不选时使用系统设置的优先级规则组" Style="{StaticResource EditorHint}" />
                    </StackPanel>
                    <Grid x:Name="GroupFields" ColumnSpacing="20" RowSpacing="16" Visibility="{x:Bind ViewModel.SeriesVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel x:Name="GroupField" Spacing="4" Visibility="{x:Bind ViewModel.GroupVisibility, Mode=OneWay}"><ComboBox x:Name="EpisodeGroupInput" Header="剧集组" Style="{StaticResource EditorPicker}" ItemsSource="{x:Bind ViewModel.EpisodeGroups, Mode=OneWay}" ItemTemplate="{StaticResource EditorChoiceTemplate}" SelectedItem="{x:Bind ViewModel.EpisodeGroup, Mode=TwoWay}" /><TextBlock Text="使用所选剧集组的季和集顺序" Style="{StaticResource EditorHint}" /></StackPanel>
                        <StackPanel x:Name="SeasonField" Grid.Column="1" Spacing="4"><NumberBox x:Name="SeasonInput" Header="季号" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Season, Mode=TwoWay}" SpinButtonPlacementMode="Compact" /><TextBlock Text="订阅的季，0 表示特别篇" Style="{StaticResource EditorHint}" /></StackPanel>
                    </Grid>
                    <StackPanel Spacing="4"><TextBox x:Name="MediaCategoryInput" Header="自定义类别" Text="{x:Bind ViewModel.MediaCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="留空使用自动分类" Style="{StaticResource EditorHint}" /></StackPanel>
                    <StackPanel Spacing="4"><TextBox x:Name="CustomWordsInput" Header="自定义识别词" Text="{x:Bind ViewModel.CustomWords, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="104" /><TextBlock Text="仅用于该订阅，每行一条识别规则" Style="{StaticResource EditorHint}" /></StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <StackPanel x:Name="RemoveConfirmation" Grid.Row="3" Spacing="8" Visibility="Collapsed"><TextBlock Text="确认取消这条订阅？已入库文件将保留。" Style="{StaticResource EgBodyStyle}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ConfirmRemoveSubscription" Content="确认取消订阅" Click="OnConfirmRemove" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" /><Button x:Name="KeepSubscription" Content="保留订阅" Click="OnKeepSubscription" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" /></StackPanel></StackPanel>
    </Grid>
</UserControl>
