<UserControl
    x:Class="Momoka.Shell.Views.MoviePilotSubscriptionWallCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momoka.Shell.Views"
    xmlns:vm="using:Momoka.Shell.ViewModels">
    <!--
      订阅墙的宽背景卡片，复刻网页端 SubscribeCard 的桌面档：背景图铺满整张卡（ImageBrush，不是 Image），
      左侧小海报、右侧年份／标题，底部一行左进度右状态。批量模式右上角画选择勾选、收起更多键；
      普通模式右上角是更多键。整张卡的点击（打开／选择）由宿主 ListView 的 ItemClick 统一接，
      这里只负责更多键与图片请求两件事，避免卡内按钮和列表点击互相抢那一下。
    -->
    <Grid x:Name="Root" Width="340" Height="150" Background="Transparent">
        <!-- 背景图铺满：缺图时退到卡片底色（EgSurfaceAltBrush），标题与操作照旧可读。 -->
        <Border CornerRadius="{StaticResource EgCardCornerRadius}" Background="{ThemeResource EgSurfaceAltBrush}">
            <Grid>
                <Grid.Background>
                    <ImageBrush ImageSource="{x:Bind Card.Backdrop, Mode=OneWay}" Stretch="UniformToFill" />
                </Grid.Background>
            </Grid>
        </Border>
        <!-- 暗罩压住背景图，让白字在浅色剧照上也读得清（同详情页头部那层）。 -->
        <Border CornerRadius="{StaticResource EgCardCornerRadius}" Background="{ThemeResource EgScrimBrush}" IsHitTestVisible="False" />
        <!-- 选中描边：只在批量模式且已选时立起来。 -->
        <Border x:Name="SelectionRing" CornerRadius="{StaticResource EgCardCornerRadius}"
            BorderBrush="{ThemeResource EgAccentBrush}" BorderThickness="2" IsHitTestVisible="False"
            Visibility="{x:Bind SelectedVisible(Card.IsSelected, Card.BatchMode), Mode=OneWay}" />

        <Grid Padding="{StaticResource EgSpaceM}" ColumnSpacing="{StaticResource EgSpaceM}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- 左侧小海报（2:3）。 -->
            <Border Width="72" Height="108" VerticalAlignment="Center" Style="{StaticResource EgFrameStyle}">
                <Grid>
                    <Grid.Background>
                        <ImageBrush ImageSource="{x:Bind Card.Poster, Mode=OneWay}" Stretch="UniformToFill" />
                    </Grid.Background>
                    <FontIcon Glyph="{x:Bind Card.Glyph, Mode=OneWay}" Style="{StaticResource EgArtworkEmptyGlyphStyle}"
                        Visibility="{x:Bind Card.EmptyPosterVisibility, Mode=OneWay}" />
                </Grid>
            </Border>
            <!-- 右侧：标题在上，底部一行左进度右状态。 -->
            <Grid Grid.Column="1" RowSpacing="{StaticResource EgSpaceXS}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="CardTitle" Text="{x:Bind Card.Title, Mode=OneWay}"
                    Style="{StaticResource EgSubheadStyle}" Foreground="{ThemeResource EgOnScrimBrush}"
                    TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Card.Title, Mode=OneWay}" />
                <Grid Grid.Row="2" ColumnSpacing="{StaticResource EgSpaceS}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- 左：集数进度。 -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource EgSpaceXS}" VerticalAlignment="Center"
                        Visibility="{x:Bind Card.ProgressVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE896;" FontSize="{StaticResource EgCaptionFontSize}" Foreground="{ThemeResource EgOnScrimBrush}" />
                        <TextBlock x:Name="CardProgress" Text="{x:Bind Card.ProgressCount, Mode=OneWay}"
                            Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgOnScrimBrush}" />
                    </StackPanel>
                    <!-- 右：执行态优先，其次暂停／待定；都没有时退到更新时间（网页端 rightBottomStateDisplay）。 -->
                    <TextBlock x:Name="CardState" Grid.Column="2" Text="{x:Bind Card.WallStateText, Mode=OneWay}"
                        Style="{StaticResource EgCaptionStyle}" VerticalAlignment="Center"
                        Foreground="{x:Bind ToneBrush(Card.WallStateTone), Mode=OneWay}"
                        Visibility="{x:Bind Card.WallStateVisibility, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Card.WallStateText, Mode=OneWay}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource EgSpaceXS}" VerticalAlignment="Center"
                        Visibility="{x:Bind UpdatedVisible(Card.WallStateVisibility, Card.UpdatedVisibility), Mode=OneWay}">
                        <FontIcon Glyph="&#xE896;" FontSize="{StaticResource EgCaptionFontSize}" Foreground="{ThemeResource EgOnScrimDimBrush}" />
                        <TextBlock x:Name="CardUpdated" Text="{x:Bind Card.UpdatedText, Mode=OneWay}"
                            Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgOnScrimDimBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- 洗版标识（左上角）。 -->
        <Border x:Name="BestVersionBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{StaticResource EgSpaceS}"
            Background="{ThemeResource EgWarningBrush}" CornerRadius="{StaticResource EgCornerBadgeCornerRadius}"
            Padding="4,2" IsHitTestVisible="False"
            Visibility="{x:Bind BestVersionVisible(Card.Subscription.BestVersion), Mode=OneWay}">
            <FontIcon Glyph="&#xE945;" FontSize="{StaticResource EgEyebrowFontSize}" Foreground="{ThemeResource EgOnScrimBrush}" />
        </Border>
        <!-- 批量模式右上角的选择勾选（非交互，整卡点击切换）。 -->
        <Border x:Name="SelectionCheck" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{StaticResource EgSpaceS}"
            Width="{StaticResource EgCornerBadgeSize}" Height="{StaticResource EgCornerBadgeSize}"
            Background="{ThemeResource EgAccentBrush}" CornerRadius="{StaticResource EgCornerBadgeCornerRadius}" IsHitTestVisible="False"
            Visibility="{x:Bind VisibleWhen(Card.BatchMode), Mode=OneWay}">
            <FontIcon Glyph="{x:Bind SelectionGlyph(Card.IsSelected), Mode=OneWay}"
                FontSize="{StaticResource EgCaptionFontSize}" Foreground="{ThemeResource EgTextOnAccentBrush}" />
        </Border>
        <!-- 普通模式右上角的更多键。 -->
        <Button x:Name="CardMore" Style="{StaticResource EgIconButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
            Width="32" Height="32" MinWidth="0" Margin="4" Background="Transparent" Foreground="{ThemeResource EgOnScrimBrush}"
            Click="OnMore" Visibility="{x:Bind MoreVisible(Card.BatchMode), Mode=OneWay}"
            AutomationProperties.Name="订阅管理" ToolTipService.ToolTip="订阅管理">
            <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="EgOnScrimBrush" />
                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="EgOnScrimDimBrush" />
            </Button.Resources>
            <FontIcon Glyph="&#xE712;" />
        </Button>
    </Grid>
</UserControl>