<ContentDialog x:Class="Momoka.Shell.Views.MoviePilotSeasonPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momoka.Shell.ViewModels" xmlns:local="using:Momoka.Shell.Views"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    PrimaryButtonText="{x:Bind ViewModel.SubmitButtonText, Mode=OneWay}" CloseButtonText="取消" DefaultButton="Close"
    HorizontalContentAlignment="Stretch" SizeChanged="OnPickerSizeChanged" Closing="OnPickerClosing"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}" PrimaryButtonClick="OnSubmit">
    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.Segmented/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
            <Thickness x:Key="ContentDialogPadding">20</Thickness>
            <Thickness x:Key="ContentDialogTitleMargin">0,0,0,16</Thickness>
            <Style x:Key="SeasonModeItemStyle" TargetType="toolkit:SegmentedItem" BasedOn="{StaticResource ButtonSegmentedItemStyle}">
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="FontSize" Value="{StaticResource EgCaptionFontSize}" />
            </Style>
        </ResourceDictionary>
    </ContentDialog.Resources>
    <ContentDialog.Title>
        <Grid x:Name="PickerTitleBar" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8F1;" Foreground="{ThemeResource EgTextDimBrush}" FontSize="{StaticResource EgSubheadFontSize}" />
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="请选择订阅季" Style="{StaticResource EgSectionTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
            <Button x:Name="DismissSeasonPicker" Grid.Column="2" Style="{StaticResource EgIconButtonStyle}" Click="OnDismissPicker"
                AutomationProperties.Name="关闭订阅季选择" ToolTipService.ToolTip="关闭">
                <FontIcon Glyph="&#xE8BB;" FontSize="{StaticResource EgBodyFontSize}" />
            </Button>
        </Grid>
    </ContentDialog.Title>
    <ScrollViewer x:Name="PickerScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PickerBody" Spacing="16" Padding="0,0,4,0">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.SubscribeProgressVisibility, Mode=OneWay}" />
            <InfoBar Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}" Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" />
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.GroupsVisibility, Mode=OneWay}">
                <TextBlock Text="选择剧集组" Style="{StaticResource EgCaptionStyle}" />
                <Grid>
                    <ScrollViewer x:Name="EpisodeGroupRail" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                        HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                        ViewChanged="OnGroupRailChanged" SizeChanged="OnGroupRailSizeChanged">
                        <ItemsRepeater x:Name="PickerEpisodeGroups" ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                            <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="8" /></ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:MoviePilotEpisodeGroupRow">
                                    <Button x:Name="PickEpisodeGroup" Width="184" Padding="0" Command="{x:Bind SwitchCommand}"
                                        Style="{StaticResource EgArtworkTileStyle}" AutomationProperties.Name="{x:Bind SwitchName}">
                                        <Grid MinHeight="48">
                                            <Border Background="{ThemeResource EgAccentMutedBrush}" CornerRadius="8" IsHitTestVisible="False" Visibility="{x:Bind CurrentVisibility}" />
                                            <StackPanel Orientation="Horizontal" Padding="12,8" Spacing="10">
                                                <FontIcon Glyph="{x:Bind PickerGlyph}" FontSize="{StaticResource EgBodyFontSize}" Foreground="{x:Bind PickerBrush}" />
                                                <StackPanel Width="132" Spacing="2">
                                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource EgBodyStyle}" Foreground="{x:Bind PickerBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind PickerSummary}" Style="{StaticResource EgCaptionStyle}" Foreground="{x:Bind PickerBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Style="{StaticResource EgFrameActiveStyle}" CornerRadius="8" Background="Transparent" IsHitTestVisible="False" Visibility="{x:Bind CurrentVisibility}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <Button x:Name="PreviousEpisodeGroups" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource EgIconButtonStyle}"
                        Visibility="Collapsed" Click="OnPreviousGroups" AutomationProperties.Name="向前查看剧集组"><FontIcon Glyph="&#xE76B;" /></Button>
                    <Button x:Name="NextEpisodeGroups" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource EgIconButtonStyle}"
                        Visibility="Collapsed" Click="OnNextGroups" AutomationProperties.Name="向后查看剧集组"><FontIcon Glyph="&#xE76C;" /></Button>
                </Grid>
            </StackPanel>
            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.SeasonNoticeVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.SeasonNotice, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button x:Name="RetrySeasonStates" Grid.Column="1" Content="重试入库状态" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.SeasonStateRetryVisibility, Mode=OneWay}" Click="OnRetrySeasonStates" />
            </Grid>
            <ItemsRepeater x:Name="SubscribeSeasons" ItemsSource="{x:Bind ViewModel.Seasons, Mode=OneWay}">
                <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:MoviePilotMediaSeasonRow">
                        <Border Style="{StaticResource EgFrameStyle}">
                            <Grid>
                                <Border Background="{ThemeResource EgAccentMutedBrush}" CornerRadius="{StaticResource EgPosterCornerRadius}"
                                    Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" IsHitTestVisible="False" />
                                <Grid Padding="14" ColumnSpacing="12" RowSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Button x:Name="ToggleSeasonCard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" Padding="0" Tag="{x:Bind}" Click="OnToggleSeasonCard"
                                        IsEnabled="{x:Bind Editable, Mode=OneWay}" AutomationProperties.Name="{x:Bind PickerTitle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Width="54" Height="81" CornerRadius="4" VerticalAlignment="Top" Background="{ThemeResource EgSurfaceAltBrush}">
                                                <Image Source="{x:Bind Poster, Mode=OneWay}" Stretch="UniformToFill" AutomationProperties.Name="{x:Bind PickerTitle}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock Text="{x:Bind PickerTitle}" Style="{StaticResource EgBodyStyle}" Foreground="{x:Bind PickerTitleBrush, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <local:WrapRow Spacing="10" RowSpacing="6">
                                                    <Border Padding="6,2" CornerRadius="10" Background="{ThemeResource EgAccentMutedBrush}" Visibility="{x:Bind RatingVisibility}">
                                                        <TextBlock Text="{x:Bind RatingText}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}" />
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="{x:Bind AirDateVisibility}">
                                                        <FontIcon Glyph="&#xE787;" FontSize="{StaticResource EgCaptionFontSize}" Foreground="{ThemeResource EgTextDimBrush}" />
                                                        <TextBlock Text="{x:Bind AirDateText}" Style="{StaticResource EgCaptionStyle}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE714;" FontSize="{StaticResource EgCaptionFontSize}" Foreground="{ThemeResource EgTextDimBrush}" />
                                                        <TextBlock Text="{x:Bind EpisodeCountText}" Style="{StaticResource EgCaptionStyle}" />
                                                    </StackPanel>
                                                </local:WrapRow>
                                                <local:WrapRow Spacing="6" RowSpacing="4">
                                                    <Border Padding="7,3" CornerRadius="12" Background="{ThemeResource EgSurfaceAltBrush}">
                                                        <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" Foreground="{x:Bind StatusBrush, Mode=OneWay}" />
                                                    </Border>
                                                    <Border Padding="7,3" CornerRadius="12" Background="{ThemeResource EgSurfaceAltBrush}" Visibility="{x:Bind SubscriptionVisibility, Mode=OneWay}">
                                                        <TextBlock Text="已订阅" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgDangerBrush}" />
                                                    </Border>
                                                </local:WrapRow>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <ToggleSwitch x:Name="SelectSubscribeSeason" Grid.Column="1" VerticalAlignment="Top"
                                        IsOn="{x:Bind Selected, Mode=TwoWay}" MinWidth="0" OnContent="" OffContent="" IsEnabled="{x:Bind Editable, Mode=OneWay}" AutomationProperties.Name="{x:Bind PickerTitle}"
                                        AutomationProperties.HelpText="开启订阅此季；关闭后提交会取消该季订阅，保留已入库文件" />
                                    <toolkit:Segmented x:Name="SeasonModes" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Right"
                                        Style="{StaticResource ButtonSegmentedStyle}" SelectedIndex="{x:Bind ModeIndex, Mode=TwoWay}"
                                        Tag="{x:Bind}" KeyDown="OnSeasonModeKeyDown" IsEnabled="{x:Bind Editable, Mode=OneWay}"
                                        Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" AutomationProperties.Name="订阅方式">
                                        <toolkit:SegmentedItem x:Name="NormalSubscribeMode" Style="{StaticResource SeasonModeItemStyle}" Content="普通订阅" Tapped="OnSeasonModeTapped" Tag="{x:Bind}" />
                                        <toolkit:SegmentedItem x:Name="EpisodeUpgradeMode" Style="{StaticResource SeasonModeItemStyle}" Content="分集洗版" Tapped="OnSeasonModeTapped" Tag="{x:Bind}" />
                                        <toolkit:SegmentedItem x:Name="FullSeasonUpgradeMode" Style="{StaticResource SeasonModeItemStyle}" Content="全集洗版" Tapped="OnSeasonModeTapped" Tag="{x:Bind}" />
                                    </toolkit:Segmented>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <TextBlock x:Name="SubscriptionPlanSummary" Text="{x:Bind ViewModel.SubmitSummary, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.SubmitReviewVisibility, Mode=OneWay}" />
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ReviewVisibility, Mode=OneWay}">
                <CheckBox x:Name="ConfirmSubscriptionReview" Content="我已在 MoviePilot 核对订阅和下载任务，确认不会重复操作"
                    IsChecked="{x:Bind ViewModel.ReviewConfirmed, Mode=TwoWay}" />
                <Button x:Name="ReviewSubscriptionResult" Content="解除待核对状态并重新读取" IsEnabled="{x:Bind ViewModel.ReviewConfirmed, Mode=OneWay}" Click="OnReview" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
