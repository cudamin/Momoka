<ContentDialog x:Uid="MoviePilotSeasonPicker_Localization1" x:Class="Momoka.Shell.Views.MoviePilotSeasonPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momoka.Shell.ViewModels" xmlns:local="using:Momoka.Shell.Views"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    PrimaryButtonText="{x:Bind ViewModel.SubmitButtonText, Mode=OneWay}" CloseButtonText="取消" DefaultButton="None"
    PrimaryButtonStyle="{StaticResource EgPrimaryButtonStyle}" CloseButtonStyle="{StaticResource EgSecondaryButtonStyle}"
    HorizontalContentAlignment="Stretch" SizeChanged="OnPickerSizeChanged" Closing="OnPickerClosing"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}" PrimaryButtonClick="OnSubmit">
    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.Segmented/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="AccentButtonBackground" ResourceKey="EgAccentBrush" />
                    <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="EgAccentHoverBrush" />
                    <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="EgAccentPressedBrush" />
                    <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="EgAccentBrush" />
                    <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="EgAccentHoverBrush" />
                    <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="EgAccentPressedBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="AccentButtonBackground" ResourceKey="EgAccentBrush" />
                    <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="EgAccentHoverBrush" />
                    <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="EgAccentPressedBrush" />
                    <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="EgAccentBrush" />
                    <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="EgAccentHoverBrush" />
                    <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="EgAccentPressedBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast" />
            </ResourceDictionary.ThemeDictionaries>
            <!-- 2026-11-13 用户令「这个弹窗窗口缩小一点，紧凑一点」：比原来那版窄一档，四边留白也收了一档。 -->
            <x:Double x:Key="ContentDialogMaxWidth">620</x:Double>
            <Thickness x:Key="ContentDialogPadding">16</Thickness>
            <Thickness x:Key="ContentDialogTitleMargin">0,0,0,10</Thickness>
            <!-- 三种订阅方式：网页端一枚图标配一句短名，这里用 SegmentedItem 自带的 Icon 位，
                 字形在 16 的方框里，和旁边那颗开关同一行高。 -->
            <Style x:Key="SeasonModeItemStyle" TargetType="toolkit:SegmentedItem" BasedOn="{StaticResource ButtonSegmentedItemStyle}">
                <Setter Property="Padding" Value="4,4" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="FontSize" Value="{StaticResource EgEyebrowFontSize}" />
            </Style>
            <Style x:Key="SeasonModeIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="{StaticResource EgCaptionFontSize}" />
            </Style>
        </ResourceDictionary>
    </ContentDialog.Resources>
    <ContentDialog.Title>
        <Grid x:Name="PickerTitleBar" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8F1;" Foreground="{ThemeResource EgTextDimBrush}" FontSize="{StaticResource EgSubheadFontSize}" />
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:Uid="MoviePilotSeasonPicker_Localization2" Text="请选择订阅季" Style="{StaticResource EgSectionTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
            <Button x:Uid="MoviePilotSeasonPicker_DismissSeasonPicker" x:Name="DismissSeasonPicker" Grid.Column="2" Style="{StaticResource EgIconButtonStyle}" Click="OnDismissPicker"
                AutomationProperties.Name="关闭订阅季选择" ToolTipService.ToolTip="关闭">
                <FontIcon Glyph="&#xE8BB;" FontSize="{StaticResource EgBodyFontSize}" />
            </Button>
        </Grid>
    </ContentDialog.Title>
    <ScrollViewer x:Name="PickerScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PickerBody" Spacing="12" Padding="0,0,4,0">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.SubscribeProgressVisibility, Mode=OneWay}" />
            <InfoBar Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}" Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" />
            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.GroupsVisibility, Mode=OneWay}">
                <TextBlock x:Uid="MoviePilotSeasonPicker_Localization3" Text="选择剧集组" Style="{StaticResource EgCaptionStyle}" />
                <Grid>
                    <ScrollViewer x:Name="EpisodeGroupRail" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                        HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                        ViewChanged="OnGroupRailChanged" SizeChanged="OnGroupRailSizeChanged">
                        <ItemsRepeater x:Name="PickerEpisodeGroups" ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                            <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="8" /></ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:MoviePilotEpisodeGroupRow">
                                    <Button x:Name="PickEpisodeGroup" Width="168" Padding="0" Command="{x:Bind SwitchCommand}"
                                        Style="{StaticResource EgArtworkTileStyle}" AutomationProperties.Name="{x:Bind SwitchName}">
                                        <Grid MinHeight="44">
                                            <Border Background="{ThemeResource EgAccentMutedBrush}" CornerRadius="8" IsHitTestVisible="False" Visibility="{x:Bind CurrentVisibility}" />
                                            <StackPanel Orientation="Horizontal" Padding="10,7" Spacing="8">
                                                <FontIcon Glyph="{x:Bind PickerGlyph}" FontSize="{StaticResource EgBodyFontSize}" Foreground="{x:Bind PickerBrush}" />
                                                <StackPanel Width="118" Spacing="1">
                                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource EgBodyStyle}" Foreground="{x:Bind PickerBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind PickerSummary}" Style="{StaticResource EgCaptionStyle}" Foreground="{x:Bind PickerBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Style="{StaticResource EgFrameActiveStyle}" CornerRadius="8" Background="Transparent" IsHitTestVisible="False" Visibility="{x:Bind CurrentVisibility}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <Button x:Uid="MoviePilotSeasonPicker_PreviousEpisodeGroups" x:Name="PreviousEpisodeGroups" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource EgIconButtonStyle}"
                        Visibility="Collapsed" Click="OnPreviousGroups" AutomationProperties.Name="向前查看剧集组"><FontIcon Glyph="&#xE76B;" /></Button>
                    <Button x:Uid="MoviePilotSeasonPicker_NextEpisodeGroups" x:Name="NextEpisodeGroups" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource EgIconButtonStyle}"
                        Visibility="Collapsed" Click="OnNextGroups" AutomationProperties.Name="向后查看剧集组"><FontIcon Glyph="&#xE76C;" /></Button>
                </Grid>
            </StackPanel>
            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.SeasonNoticeVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.SeasonNotice, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button x:Uid="MoviePilotSeasonPicker_RetrySeasonStates" x:Name="RetrySeasonStates" Grid.Column="1" Content="重试入库状态" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.SeasonStateRetryVisibility, Mode=OneWay}" Click="OnRetrySeasonStates" />
            </Grid>
            <!--
                季卡照网页端的 SubscribeSeasonDialog：一张 2:3 海报、季名一行、评分／首播／集数一行、
                入库与订阅标签一行，右边一颗开关，底下一条带图标的三段订阅方式（2026-11-13 用户令
                「参考网页端重新设计卡片」）。整卡点一下就是选中／取消，开关和方式条各自单独命中。
            -->
            <ItemsRepeater x:Name="SubscribeSeasons" ItemsSource="{x:Bind ViewModel.Seasons, Mode=OneWay}">
                <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:MoviePilotMediaSeasonRow">
                        <Border Style="{StaticResource EgFrameStyle}" BorderThickness="1">
                            <Grid>
                                <Border Background="{ThemeResource EgAccentMutedBrush}" CornerRadius="{StaticResource EgPosterCornerRadius}"
                                    Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" IsHitTestVisible="False" />
                                <Grid Padding="10" ColumnSpacing="6" RowSpacing="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Button x:Name="ToggleSeasonCard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Padding="0" Tag="{x:Bind}" Click="OnToggleSeasonCard"
                                        IsEnabled="{x:Bind Editable, Mode=OneWay}" AutomationProperties.Name="{x:Bind PickerTitle}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Width="58" Height="87" CornerRadius="4" VerticalAlignment="Top" Background="{ThemeResource EgSurfaceAltBrush}">
                                                <Image Source="{x:Bind Poster, Mode=OneWay}" Stretch="UniformToFill" AutomationProperties.Name="{x:Bind PickerTitle}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                                                <TextBlock Text="{x:Bind PickerTitle}" Style="{StaticResource EgBodyStyle}" Foreground="{x:Bind PickerTitleBrush, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <local:WrapRow Spacing="10" RowSpacing="3">
                                                    <Border Padding="6,1" CornerRadius="9" Background="{ThemeResource EgAccentMutedBrush}" VerticalAlignment="Center" Visibility="{x:Bind RatingVisibility}">
                                                        <TextBlock Text="{x:Bind RatingText}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Grid ColumnSpacing="4" VerticalAlignment="Center" Visibility="{x:Bind AirDateVisibility}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE787;" FontSize="{StaticResource EgCaptionFontSize}" Foreground="{ThemeResource EgTextDimBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind AirDateText}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE714;" FontSize="{StaticResource EgCaptionFontSize}" Foreground="{ThemeResource EgTextDimBrush}" />
                                                        <TextBlock Text="{x:Bind EpisodeCountText}" Style="{StaticResource EgCaptionStyle}" />
                                                    </StackPanel>
                                                </local:WrapRow>
                                                <local:WrapRow Spacing="6" RowSpacing="3">
                                                    <Border Padding="6,1" CornerRadius="9" Background="{ThemeResource EgSurfaceAltBrush}">
                                                        <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" Foreground="{x:Bind StatusBrush, Mode=OneWay}" />
                                                    </Border>
                                                    <Border Padding="6,1" CornerRadius="9" Background="{ThemeResource EgSurfaceAltBrush}" Visibility="{x:Bind SubscriptionVisibility, Mode=OneWay}">
                                                        <TextBlock x:Uid="MoviePilotSeasonPicker_Localization4" Text="已订阅" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgDangerBrush}" />
                                                    </Border>
                                                </local:WrapRow>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <ToggleSwitch x:Uid="MoviePilotSeasonPicker_SelectSubscribeSeason" x:Name="SelectSubscribeSeason" Grid.Column="1" VerticalAlignment="Top"
                                        IsOn="{x:Bind Selected, Mode=TwoWay}" MinWidth="0" OnContent="" OffContent="" IsEnabled="{x:Bind Editable, Mode=OneWay}" AutomationProperties.Name="{x:Bind PickerTitle}"
                                        AutomationProperties.HelpText="开启订阅此季；关闭后提交会取消该季订阅，保留已入库文件" />
                                    <toolkit:Segmented x:Uid="MoviePilotSeasonPicker_SeasonModes" x:Name="SeasonModes" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Right"
                                        Style="{StaticResource ButtonSegmentedStyle}" SelectedIndex="{x:Bind ModeIndex, Mode=TwoWay}"
                                        Tag="{x:Bind}" KeyDown="OnSeasonModeKeyDown" IsEnabled="{x:Bind Editable, Mode=OneWay}"
                                        Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" AutomationProperties.Name="订阅方式">
                                        <toolkit:SegmentedItem x:Uid="MoviePilotSeasonPicker_NormalSubscribeMode" x:Name="NormalSubscribeMode" Style="{StaticResource SeasonModeItemStyle}" Content="普通订阅" Tapped="OnSeasonModeTapped" Tag="{x:Bind}">
                                            <toolkit:SegmentedItem.Icon><FontIcon Glyph="&#xE710;" Style="{StaticResource SeasonModeIconStyle}" /></toolkit:SegmentedItem.Icon>
                                        </toolkit:SegmentedItem>
                                        <toolkit:SegmentedItem x:Uid="MoviePilotSeasonPicker_EpisodeUpgradeMode" x:Name="EpisodeUpgradeMode" Style="{StaticResource SeasonModeItemStyle}" Content="分集洗版" Tapped="OnSeasonModeTapped" Tag="{x:Bind}">
                                            <toolkit:SegmentedItem.Icon><FontIcon Glyph="&#xE72C;" Style="{StaticResource SeasonModeIconStyle}" /></toolkit:SegmentedItem.Icon>
                                        </toolkit:SegmentedItem>
                                        <toolkit:SegmentedItem x:Uid="MoviePilotSeasonPicker_FullSeasonUpgradeMode" x:Name="FullSeasonUpgradeMode" Style="{StaticResource SeasonModeItemStyle}" Content="全集洗版" Tapped="OnSeasonModeTapped" Tag="{x:Bind}">
                                            <toolkit:SegmentedItem.Icon><FontIcon Glyph="&#xE735;" Style="{StaticResource SeasonModeIconStyle}" /></toolkit:SegmentedItem.Icon>
                                        </toolkit:SegmentedItem>
                                    </toolkit:Segmented>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <TextBlock x:Name="SubscriptionPlanSummary" Text="{x:Bind ViewModel.SubmitSummary, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.SubmitReviewVisibility, Mode=OneWay}" />
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ReviewVisibility, Mode=OneWay}">
                <CheckBox x:Uid="MoviePilotSeasonPicker_ConfirmSubscriptionReview" x:Name="ConfirmSubscriptionReview" Content="我已在 MoviePilot 核对订阅和下载任务，确认不会重复操作"
                    IsChecked="{x:Bind ViewModel.ReviewConfirmed, Mode=TwoWay}" />
                <Button x:Uid="MoviePilotSeasonPicker_ReviewSubscriptionResult" x:Name="ReviewSubscriptionResult" Content="解除待核对状态并重新读取" IsEnabled="{x:Bind ViewModel.ReviewConfirmed, Mode=OneWay}" Click="OnReview" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
