<Page x:Class="Momoka.Shell.Views.ServerListsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lists="using:Momoka.Shell.Services"
    Background="Transparent">
    <Grid Padding="{StaticResource EgPageMargin}" RowSpacing="{StaticResource EgSpaceM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="{StaticResource EgSpaceS}">
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource EgPageTitleStyle}"
                TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
            <ComboBox x:Name="ServerListAccount" Header="服务器账号" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanSelect, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}" DisplayMemberPath="Name" SelectionChanged="OnAccountChanged" />
            <ComboBox x:Name="ServerListKind" Header="清单类型" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanSelect, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.CollectionsVisibility, Mode=OneWay}" SelectionChanged="OnKindChanged">
                <ComboBoxItem Content="播放列表" />
                <ComboBoxItem Content="合集" />
            </ComboBox>
            <ComboBox x:Name="ServerListLibrary" Header="影视库" HorizontalAlignment="Stretch" DisplayMemberPath="Name" IsEnabled="{x:Bind ViewModel.CanSelect, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.Libraries, Mode=OneWay}" Visibility="{x:Bind ViewModel.LibraryVisibility, Mode=OneWay}"
                SelectionChanged="OnLibraryChanged" />
            <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}"
                Foreground="{ThemeResource EgTextDimBrush}" />
        </StackPanel>
        <CommandBar x:Name="ServerListCommands" Grid.Row="1" DefaultLabelPosition="Right" IsOpen="False" AutomationProperties.Name="清单操作">
            <AppBarButton x:Name="ServerListBack" Icon="Back" Label="返回清单" Click="OnBack"
                Visibility="{x:Bind ViewModel.MembersVisibility, Mode=OneWay}" />
            <AppBarButton x:Name="ServerListRefresh" Icon="Refresh" Label="刷新" Click="OnRefresh" />
            <AppBarButton x:Name="ServerListCreate" Icon="Add" Label="新建清单" Click="OnCreate"
                Visibility="{x:Bind ViewModel.CreateVisibility, Mode=OneWay}" />
            <AppBarButton x:Name="ServerListAdd" Icon="Add" Label="添加媒体" Click="OnAdd"
                Visibility="{x:Bind ViewModel.AddVisibility, Mode=OneWay}" />
            <AppBarButton x:Name="ServerListPlay" Icon="Play" Label="播放" Click="OnPlay"
                Visibility="{x:Bind ViewModel.PlayVisibility, Mode=OneWay}" />
            <AppBarButton x:Name="ServerListOpen" Icon="OpenFile" Label="打开详情" Click="OnOpen"
                Visibility="{x:Bind ViewModel.OpenVisibility, Mode=OneWay}" />
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="ServerListMoveUp" Label="上移" Click="OnMoveUp"
                    Visibility="{x:Bind ViewModel.UpVisibility, Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74A;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="ServerListMoveDown" Label="下移" Click="OnMoveDown"
                    Visibility="{x:Bind ViewModel.DownVisibility, Mode=OneWay}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74B;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="ServerListRemove" Icon="Remove" Label="移出清单" Click="OnRemove"
                    Visibility="{x:Bind ViewModel.RemoveVisibility, Mode=OneWay}" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <ProgressBar Grid.Row="2" IsIndeterminate="True" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}"
            AutomationProperties.Name="正在读取或保存服务器清单" />
        <InfoBar x:Name="ServerListNotice" Grid.Row="3" IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}" Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
        <ListView x:Name="ServerListDirectory" Grid.Row="4" ItemsSource="{x:Bind ViewModel.Lists, Mode=OneWay}"
            IsItemClickEnabled="True" ItemClick="OnListClicked" SelectionMode="None" HorizontalContentAlignment="Stretch"
            Visibility="{x:Bind ViewModel.DirectoryVisibility, Mode=OneWay}" AutomationProperties.Name="服务器普通清单">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="lists:ServerList">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource EgBodyStyle}" TextWrapping="Wrap" Margin="0,8" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <ListView x:Name="ServerListMembers" Grid.Row="4" ItemsSource="{x:Bind ViewModel.Members, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedMember, Mode=TwoWay}" SelectionMode="Single" HorizontalContentAlignment="Stretch"
            Visibility="{x:Bind ViewModel.MembersVisibility, Mode=OneWay}" AutomationProperties.Name="清单成员，按播放顺序">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="lists:ServerListMember">
                    <StackPanel Spacing="{StaticResource EgSpaceXS}" Margin="0,8">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource EgBodyStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource EgCaptionStyle}"
                            Foreground="{ThemeResource EgTextDimBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="4" Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" TextWrapping="Wrap"
            Style="{StaticResource EgBodyStyle}" Foreground="{ThemeResource EgTextDimBrush}"
            HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />
    </Grid>
</Page>
