<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="Momoka.Shell.Views.MoviePilotSiteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momoka.Shell.ViewModels"
    xmlns:local="using:Momoka.Shell.Views"
    PrimaryButtonText="{x:Bind ConfirmText}" DefaultButton="None"
    IsPrimaryButtonEnabled="False" PrimaryButtonClick="OnConfirm"
    Opened="OnOpened" Closed="OnClosed">
    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/MoviePilotSiteControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <x:Double x:Key="ContentDialogMaxWidth">660</x:Double>
            <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
        </ResourceDictionary>
    </ContentDialog.Resources>
    <ContentDialog.Title>
        <Grid x:Name="SiteDialogHeader" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE774;" FontSize="{StaticResource EgBodyFontSize}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="选择站点" Style="{StaticResource EgSubheadStyle}" VerticalAlignment="Center" />
            <Button x:Name="CloseSiteDialog" Grid.Column="2" Style="{StaticResource EgIconButtonStyle}"
                AutomationProperties.Name="关闭站点选择" ToolTipService.ToolTip="关闭（不保存、不搜索）" Click="OnClose">
                <FontIcon Glyph="&#xE711;" FontSize="{StaticResource EgCaptionFontSize}" />
            </Button>
        </Grid>
    </ContentDialog.Title>
    <ScrollViewer x:Name="SiteDialogScroll" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto" IsVerticalScrollChainingEnabled="False" Padding="0,0,4,0">
        <StackPanel x:Name="SiteDialogBody" Spacing="12">
            <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource EgBorderBrush}" Padding="0,12,0,0">
                <local:WrapRow x:Name="SiteActions" Spacing="8" RowSpacing="8">
                    <Button x:Name="SelectAllSites" Content="全选" Style="{StaticResource SiteDialogActionStyle}" Command="{x:Bind ViewModel.SelectAllCommand}" />
                    <Button x:Name="ClearSelectedSites" Content="清空" Style="{StaticResource SiteDialogActionStyle}" Command="{x:Bind ViewModel.ClearSelectionCommand}" />
                    <Button x:Name="ReloadSites" Style="{StaticResource SiteDialogActionStyle}" Command="{x:Bind ViewModel.RefreshCommand}"
                        AutomationProperties.Name="刷新站点目录" ToolTipService.ToolTip="重新读取站点目录">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource EgCaptionFontSize}" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="SelectedSiteCount" Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}"
                        Foreground="{ThemeResource EgAccentBrush}" VerticalAlignment="Center" />
                </local:WrapRow>
            </Border>
            <StackPanel Spacing="4">
                <CheckBox x:Name="UseDefaultSites" Content="默认站点" MinHeight="28" IsEnabled="{x:Bind ViewModel.CanComplete, Mode=OneWay}"
                    IsChecked="{x:Bind ViewModel.UseDefault, Mode=TwoWay}" />
                <TextBlock Text="默认站点跟随 MoviePilot；点击卡片或全选可改为指定站点。确认后保存，取消不更改偏好。"
                    Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextDimBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
            <InfoBar x:Name="SiteNotice" IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}" IsClosable="True"
                Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}" Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
            <ContentControl x:Name="SiteGridHost" IsEnabled="{x:Bind ViewModel.CanPick, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                <ItemsRepeater x:Name="SiteChoices" ItemsSource="{x:Bind ViewModel.Sites, Mode=OneWay}" SizeChanged="OnGridSizeChanged">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout x:Name="SiteGridLayout" MinItemWidth="168" MinItemHeight="44" MaximumRowsOrColumns="3"
                            MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:MoviePilotSearchSiteRow">
                            <ToggleButton x:Name="SelectSite" Tag="{x:Bind}" IsChecked="{x:Bind Selected, Mode=TwoWay}"
                                AutomationProperties.Name="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}"
                                Style="{StaticResource SiteCardToggleStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource EgTextDimBrush}"
                                        VerticalAlignment="Center" Visibility="{x:Bind UnselectedVisibility, Mode=OneWay}" IsHitTestVisible="False" />
                                    <Border Width="16" Height="16" CornerRadius="8" Background="{ThemeResource EgAccentBrush}"
                                        VerticalAlignment="Center" Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" IsHitTestVisible="False">
                                        <FontIcon Glyph="&#xE8FB;" FontSize="{StaticResource EgCaptionFontSize}" Foreground="{ThemeResource EgTextOnAccentBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource EgCaptionStyle}"
                                        TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ContentControl>
            <TextBlock x:Name="NoSearchSites" Text="没有可供搜索的已启用站点，可点击刷新重试。" Style="{StaticResource EgCaptionStyle}"
                TextWrapping="Wrap" Foreground="{ThemeResource EgTextDimBrush}" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
