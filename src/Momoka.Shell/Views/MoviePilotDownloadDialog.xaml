<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="Momoka.Shell.Views.MoviePilotDownloadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="加入下载" PrimaryButtonText="下载" CloseButtonText="取消" DefaultButton="Close"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
            <TextBlock Text="{x:Bind ViewModel.Confirmation, Mode=OneWay}" Style="{StaticResource EgBodyStyle}" TextWrapping="Wrap" />
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}" IsClosable="False"
                Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}" Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
            <ComboBox x:Name="DownloadClient" Header="下载器" HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.Downloaders, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Downloader, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}" />
            <ComboBox x:Name="DownloadPath" Header="保存路径" HorizontalAlignment="Stretch" IsEditable="True"
                PlaceholderText="留空使用 MoviePilot 默认路径"
                ItemsSource="{x:Bind ViewModel.Paths, Mode=OneWay}" Text="{x:Bind ViewModel.SavePath, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}" />
            <TextBlock Text="可选择已有路径或输入自定义路径；请使用下载器服务器上的路径。"
                Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextDimBrush}" TextWrapping="Wrap" />
            <Button x:Name="RefreshDownloadChoices" Content="刷新选项" Command="{x:Bind ViewModel.RefreshCommand}" HorizontalAlignment="Right" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
