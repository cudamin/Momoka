<UserControl
    x:Class="Momoka.Shell.Views.DanmakuPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dm="using:Momoka.Danmaku"
    MinWidth="280" MaxWidth="440">
    <ScrollViewer MaxHeight="600" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="弹幕 · 弹弹play" Style="{StaticResource EgSectionTitleStyle}" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="ShowToggle" Grid.Column="1" OffContent="关闭" OnContent="开启" Toggled="OnShowToggled" AutomationProperties.Name="显示弹幕" />
            </Grid>
            <TextBlock Style="{StaticResource EgCaptionStyle}" Text="{Binding DanmakuStatus}" TextWrapping="Wrap" />
            <TextBlock x:Name="SessionMessage" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" Visibility="Collapsed" />

            <StackPanel Spacing="8">
                <TextBlock Text="选择弹幕库" Style="{StaticResource EgBodyStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleBox" PlaceholderText="作品名称" MaxLength="120" AutomationProperties.Name="弹幕作品名称" />
                    <TextBox x:Name="EpisodeBox" Grid.Column="1" PlaceholderText="集数" MaxLength="6" AutomationProperties.Name="弹幕集数，留空搜索全部" />
                </Grid>
                <Button x:Name="SearchButton" Content="搜索弹弹play" Click="OnSearch" HorizontalAlignment="Stretch" />
                <ListView x:Name="Results" MaxHeight="200" SelectionMode="Single" SelectionChanged="OnResultSelected" Visibility="Collapsed" AutomationProperties.Name="弹弹play剧集搜索结果">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="dm:DandanPlayEpisode">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind AnimeTitle}" Style="{StaticResource EgBodyStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind EpisodeTitle}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button x:Name="LoadButton" Content="加载所选剧集的弹幕" Click="OnLoad" Visibility="Collapsed" HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel x:Name="Appearance" Spacing="12">
                <TextBlock Text="显示设置" Style="{StaticResource EgBodyStyle}" />
                <StackPanel Spacing="2">
                    <TextBlock x:Name="OpacityLabel" Style="{StaticResource EgCaptionStyle}" />
                    <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" StepFrequency="5" SnapsTo="StepValues" ValueChanged="OnStyleChanged" AutomationProperties.Name="弹幕不透明度" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="FontLabel" Style="{StaticResource EgCaptionStyle}" />
                    <Slider x:Name="FontSlider" Minimum="20" Maximum="64" StepFrequency="2" SnapsTo="StepValues" ValueChanged="OnStyleChanged" AutomationProperties.Name="弹幕字号" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="SpeedLabel" Style="{StaticResource EgCaptionStyle}" />
                    <Slider x:Name="SpeedSlider" Minimum="0.5" Maximum="2" StepFrequency="0.1" SnapsTo="StepValues" ValueChanged="OnStyleChanged" AutomationProperties.Name="弹幕速度" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="AreaLabel" Style="{StaticResource EgCaptionStyle}" />
                    <Slider x:Name="AreaSlider" Minimum="25" Maximum="100" StepFrequency="25" SnapsTo="StepValues" ValueChanged="OnStyleChanged" AutomationProperties.Name="弹幕显示区域" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="DensityLabel" Style="{StaticResource EgCaptionStyle}" />
                    <Slider x:Name="DensitySlider" Minimum="10" Maximum="100" StepFrequency="10" SnapsTo="StepValues" ValueChanged="OnStyleChanged" AutomationProperties.Name="同屏弹幕上限" />
                </StackPanel>
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="ScrollCheck" Content="滚动弹幕" Click="OnFiltersChanged" />
                    <CheckBox x:Name="TopCheck" Grid.Column="1" Content="顶部弹幕" Click="OnFiltersChanged" />
                    <CheckBox x:Name="BottomCheck" Grid.Row="1" Content="底部弹幕" Click="OnFiltersChanged" />
                    <CheckBox x:Name="ColorCheck" Grid.Row="1" Grid.Column="1" Content="彩色弹幕" Click="OnFiltersChanged" />
                    <CheckBox x:Name="RepeatCheck" Grid.Row="2" Grid.ColumnSpan="2" Content="合并 10 秒内的重复弹幕" Click="OnFiltersChanged" />
                </Grid>
                <TextBox x:Name="BlockBox" Header="屏蔽词" PlaceholderText="多个词用逗号分隔" MaxLength="4000" LostFocus="OnBlockLostFocus" AutomationProperties.Name="弹幕屏蔽词" />
            </StackPanel>
            <Button x:Name="SettingsButton" Content="更多弹幕设置与连接配置" Click="OnSettings" HorizontalAlignment="Stretch" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
