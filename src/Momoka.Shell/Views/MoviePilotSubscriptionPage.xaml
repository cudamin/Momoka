<Page x:Class="Momoka.Shell.Views.MoviePilotSubscriptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momoka.Shell.Views"
    xmlns:mp="using:Momoka.MoviePilot"
    xmlns:vm="using:Momoka.Shell.ViewModels"
    Background="{ThemeResource EgWindowBrush}">
    <Page.Resources>
        <Style x:Key="EgActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="{StaticResource EgActionHeight}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
            <Setter Property="Padding" Value="18,0,20,2" />
        </Style>
        <Style x:Key="EgRoundButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="{StaticResource EgActionHeight}" />
            <Setter Property="Height" Value="{StaticResource EgActionHeight}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <DataTemplate x:Key="SubscriptionFactTemplate" x:DataType="mp:MoviePilotMediaFact">
            <Border BorderThickness="{x:Bind local:MoviePilotSubscriptionPage.FactBorder(Last), Mode=OneTime}" BorderBrush="{ThemeResource EgBorderBrush}" Padding="14,8">
                <Grid ColumnSpacing="{StaticResource EgSpaceM}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource EgBodyStyle}" FontWeight="SemiBold" VerticalAlignment="Top" />
                    <Grid Grid.Column="1" ColumnSpacing="6" HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Viewbox Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0"
                            Visibility="{x:Bind local:MoviePilotSubscriptionPage.FactVisibility(Cloud), Mode=OneTime}">
                            <Path Stroke="{ThemeResource EgTextDimBrush}" StrokeThickness="1.5"
                                Data="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" />
                        </Viewbox>
                        <Border BorderThickness="1" BorderBrush="{ThemeResource EgTextDimBrush}" Padding="2,0" VerticalAlignment="Top"
                            Visibility="{x:Bind local:MoviePilotSubscriptionPage.ReleaseCountryVisibility(ReleaseCountry), Mode=OneTime}">
                            <TextBlock Text="{x:Bind ReleaseCountry}" Style="{StaticResource EgCaptionStyle}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" Style="{StaticResource EgBodyStyle}" FontWeight="SemiBold"
                            HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="MediaRelatedCardTemplate" x:DataType="vm:MoviePilotRelatedCard">
            <Button x:Name="OpenRelatedMedia" Command="{x:Bind OpenCommand}" Style="{StaticResource EgArtworkTileStyle}" Width="128"
                Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind Title}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                </Button.Resources>
                <StackPanel Spacing="8">
                    <Border x:Name="RelatedArtwork" Height="184" CornerRadius="6" Background="{ThemeResource EgSurfaceAltBrush}">
                        <Border CornerRadius="6">
                            <Border.Background><ImageBrush ImageSource="{x:Bind Poster, Mode=OneWay}" Stretch="UniformToFill" /></Border.Background>
                        </Border>
                    </Border>
                    <TextBlock x:Name="RelatedTitle" Text="{x:Bind Title}" Style="{StaticResource EgBodyStyle}" TextWrapping="Wrap" Margin="8,0"
                        ToolTipService.ToolTip="{x:Bind Title}" />
                    <TextBlock x:Name="RelatedSubtitle" Text="{x:Bind Subtitle}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" Margin="8,0,8,8" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid Loaded="OnDetailLoaded" SizeChanged="OnDetailSizeChanged">
        <Border x:Name="CardMaterialSource" Width="0" Height="0" IsHitTestVisible="False"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Grid x:Name="DetailContent" Visibility="{x:Bind MediaViewModel.DetailContentVisibility, Mode=OneWay}">
    <Grid x:Name="DetailBackdropRoot" IsHitTestVisible="False" Visibility="{x:Bind MediaViewModel.BackdropVisibility, Mode=OneWay}">
        <Border x:Name="DetailBackdropBand" Opacity="0.9" VerticalAlignment="Top"
            Height="{x:Bind MediaViewModel.BackdropHeight, Mode=OneWay}">
            <Border.Background>
                <ImageBrush ImageSource="{x:Bind MediaViewModel.Backdrop, Mode=OneWay}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Top" />
            </Border.Background>
        </Border>
        <Border x:Name="DetailBackdropScrim" VerticalAlignment="Top"
            Height="{x:Bind MediaViewModel.BackdropHeight, Mode=OneWay}"
            Background="{ThemeResource EgScrimBrush}" />
        <Border x:Name="DetailBackdropFade" Height="64" VerticalAlignment="Top" IsHitTestVisible="False"
            Margin="{x:Bind MediaViewModel.BackdropFadeMargin, Mode=OneWay}"
            Visibility="{x:Bind MediaViewModel.BackdropFadeVisibility, Mode=OneWay}">
            <Border.Background>
                <LinearGradientBrush x:Name="BackdropFadeBrush" StartPoint="0.5,0" EndPoint="0.5,1" />
            </Border.Background>
        </Border>
    </Grid>
    <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" SizeChanged="OnDetailScrollSizeChanged" ViewChanged="OnDetailViewChanged">
        <StackPanel>
            <!-- 资料卡参与头部自然高度，下方内容顺序排列、始终全宽。 -->
            <StackPanel x:Name="HeroSection">
            <StackPanel x:Name="HeroBlock" Padding="{x:Bind MediaViewModel.HeaderPadding, Mode=OneWay}" Spacing="12"
                SizeChanged="OnHeroContentSizeChanged">
            <Grid x:Name="HeroRow" Margin="0,12,0,12" ColumnSpacing="12" RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="HeroFactColumn" Width="288" /></Grid.ColumnDefinitions>
                <Border x:Name="HeroSurface" VerticalAlignment="Top" CornerRadius="{StaticResource EgCardCornerRadius}">
                <Grid x:Name="HeroGrid" MinHeight="300" ColumnSpacing="{StaticResource EgSpaceXL}" RowSpacing="16" SizeChanged="OnHeroSizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="DetailPoster" Width="210" Height="300" VerticalAlignment="Top" Style="{StaticResource EgFrameStyle}">
                        <Grid>
                            <Grid.Background>
                                <ImageBrush ImageSource="{x:Bind MediaViewModel.Poster, Mode=OneWay}" Stretch="UniformToFill" />
                            </Grid.Background>
                            <FontIcon Glyph="&#xE714;" Style="{StaticResource EgArtworkEmptyGlyphStyle}"
                                Visibility="{x:Bind MediaViewModel.PosterEmptyVisibility, Mode=OneWay}" />
                        </Grid>
                    </Border>
                    <StackPanel x:Name="HeroContent" Grid.Column="1" Spacing="{StaticResource EgSpaceM}">
                        <Border x:Name="LibraryBadge" Background="{ThemeResource EgAccentSoftBrush}"
                            CornerRadius="{StaticResource EgCornerBadgeCornerRadius}" Padding="8,2" HorizontalAlignment="Left"
                            Visibility="{x:Bind ViewModel.LibraryBadgeVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.LibraryBadge, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}"
                                Foreground="{ThemeResource EgAccentBrush}" />
                        </Border>
                        <TextBlock x:Name="MediaTitle" Text="{x:Bind MediaViewModel.Title, Mode=OneWay}" Style="{StaticResource EgOnScrimPageTitleStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind MediaViewModel.Meta, Mode=OneWay}" Style="{StaticResource EgOnScrimDataStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="MediaRating" Text="{x:Bind MediaViewModel.Rating, Mode=OneWay}"
                            Style="{StaticResource EgOnScrimDataStyle}" Foreground="{ThemeResource EgAccentBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.DetailStatus, Mode=OneWay}" Style="{StaticResource EgBodyStyle}"
                            Foreground="{ThemeResource EgAccentBrush}" />
                        <local:WrapRow x:Name="DetailActions" Spacing="10" RowSpacing="10">
                            <Button x:Name="SearchSubscription" Content="搜索资源" Style="{StaticResource EgActionButtonStyle}"
                                IsEnabled="{x:Bind MediaViewModel.CanInteract, Mode=OneWay}">
                                <Button.Flyout><MenuFlyout>
                                    <MenuFlyoutItem x:Name="SearchMediaTitle" Text="按标题搜索" Click="OnSearch" />
                                    <MenuFlyoutItem x:Name="SearchMediaImdb" Text="按 IMDb 搜索" Click="OnSearchImdb" />
                                </MenuFlyout></Button.Flyout>
                            </Button>
                            <Button x:Name="SearchAniBt" Content="在 AniBT 中搜索" Style="{StaticResource EgActionButtonStyle}"
                                Visibility="{x:Bind MediaViewModel.AniBtVisibility, Mode=OneWay}"
                                IsEnabled="{x:Bind MediaViewModel.CanSearchAniBt, Mode=OneWay}" Click="OnSearchAniBt" />
                            <Button x:Name="SearchMediaSubtitles" Content="搜索字幕" Style="{StaticResource EgActionButtonStyle}"
                                IsEnabled="{x:Bind MediaViewModel.CanInteract, Mode=OneWay}" Click="OnSearchSubtitles" />
                            <Button x:Name="ChooseSubscribeSeasons" Content="{x:Bind MediaViewModel.SubscribeLabel, Mode=OneWay}" Style="{StaticResource EgActionButtonStyle}"
                                IsEnabled="{x:Bind MediaViewModel.CanInteract, Mode=OneWay}" Click="OnChooseSeasons" />
                            <Button x:Name="PlayMediaLibraryItem" Content="播放已入库" Style="{StaticResource EgActionButtonStyle}"
                                Visibility="{x:Bind ViewModel.PlayFirstVisibility, Mode=OneWay}" Command="{x:Bind ViewModel.PlayFirstCommand}" />
                            <Button x:Name="EditSubscription" Visibility="{x:Bind SubscriptionSectionVisibility(ViewModel.Deleted), Mode=OneWay}" Content="编辑订阅" Style="{StaticResource EgActionButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanWriteSelected, Mode=OneWay}" Click="OnEdit" />
                            <Button x:Name="MoreActions" Style="{StaticResource EgRoundButtonStyle}" Click="OnMoreActions"
                                ToolTipService.ToolTip="更多" AutomationProperties.Name="更多">
                                <FontIcon FontSize="{StaticResource EgSubheadFontSize}" Glyph="&#xE712;" />
                            </Button>
                        </local:WrapRow>
                    </StackPanel>
                </Grid>
                </Border>
                <Border x:Name="HeroFacts" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="288" CornerRadius="{StaticResource EgCardCornerRadius}"
                    BorderBrush="{ThemeResource EgBorderBrush}" BorderThickness="{StaticResource EgCardBorderThickness}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border x:Name="SubscriptionRating" BorderBrush="{ThemeResource EgBorderBrush}" BorderThickness="0,0,0,1" Padding="14,16"
                            Visibility="{x:Bind MediaViewModel.StarsVisibility, Mode=OneWay}">
                            <ItemsRepeater x:Name="SubscriptionStars" ItemsSource="{x:Bind MediaViewModel.Stars, Mode=OneWay}" HorizontalAlignment="Center">
                                <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="8" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MoviePilotRatingStar">
                                        <Grid Width="16" Height="20">
                                            <FontIcon Glyph="&#xE734;" FontSize="{StaticResource EgSubheadFontSize}" Foreground="{ThemeResource EgTextBrush}" Opacity="0.23" />
                                            <Grid>
                                                <Grid.Clip><RectangleGeometry Rect="{x:Bind local:MoviePilotSubscriptionPage.StarClip(Fill), Mode=OneTime}" /></Grid.Clip>
                                                <FontIcon Glyph="&#xE735;" FontSize="{StaticResource EgSubheadFontSize}" Foreground="{ThemeResource EgWarningBrush}" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Border>
                        <StackPanel x:Name="FactList" Grid.Row="1" Spacing="0">
                            <ItemsRepeater x:Name="MediaFacts" ItemsSource="{x:Bind MediaViewModel.Facts, Mode=OneWay}" ItemTemplate="{StaticResource SubscriptionFactTemplate}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <InfoBar Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}" Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" />

            <InfoBar Visibility="{x:Bind MediaViewModel.NoticeVisibility, Mode=OneWay}" IsOpen="{x:Bind MediaViewModel.NoticeOpen, Mode=TwoWay}" Severity="{x:Bind MediaViewModel.NoticeSeverity, Mode=OneWay}"
                Title="{x:Bind MediaViewModel.NoticeTitle, Mode=OneWay}" Message="{x:Bind MediaViewModel.NoticeMessage, Mode=OneWay}" />
            </StackPanel>
            </StackPanel>
            <StackPanel x:Name="BodySheet" Background="{ThemeResource EgWindowBrush}"
                Padding="{x:Bind MediaViewModel.BodySheetPadding, Mode=OneWay}"
                Spacing="{x:Bind MediaViewModel.BodySheetSpacing, Mode=OneWay}">
            <StackPanel x:Name="BodyFlow" VerticalAlignment="Top" Spacing="{x:Bind MediaViewModel.BodySheetSpacing, Mode=OneWay}">
            <Grid x:Name="BodyRow" SizeChanged="OnBodyRowSizeChanged">
                <StackPanel x:Name="BodyPrimary" Spacing="8" VerticalAlignment="Top">
                    <StackPanel x:Name="HeroOverview" VerticalAlignment="Top"
                        Style="{StaticResource EgBodyPanelStyle}" Background="Transparent" BorderThickness="0"
                        Padding="0" Spacing="{StaticResource EgSpaceS}">
                        <TextBlock Text="{x:Bind MediaViewModel.Tagline, Mode=OneWay}" Style="{StaticResource EgDataStyle}" FontStyle="Italic" TextWrapping="Wrap" />
                        <TextBlock Text="简介" Style="{StaticResource EgSectionTitleStyle}" />
                        <TextBlock Text="{x:Bind MediaViewModel.Overview, Mode=OneWay}" Style="{StaticResource EgBodyStyle}"
                            TextWrapping="Wrap" MaxWidth="{StaticResource EgProseWidth}" HorizontalAlignment="Left" />
                        <ItemsRepeater x:Name="MediaSourceLinks" ItemsSource="{x:Bind MediaViewModel.Links, Mode=OneWay}">
                            <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="8" /></ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="mp:MoviePilotMediaLink">
                                <HyperlinkButton x:Name="OpenMediaSource" Content="{x:Bind Label}" NavigateUri="{x:Bind Url}" />
                            </DataTemplate></ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
            <StackPanel x:Name="SeasonPanel" Visibility="{x:Bind MediaViewModel.SeasonsVisibility, Mode=OneWay}"
                Padding="{x:Bind MediaViewModel.BodyPanelPadding, Mode=OneWay}"
                Style="{StaticResource EgBodyPanelStyle}" Spacing="{StaticResource EgSpaceM}" VerticalAlignment="Top">
                <local:MoviePilotMediaSeasonsView x:Name="MediaSeasons" />
            </StackPanel>
                </StackPanel>

            </Grid>

            <StackPanel x:Name="PeoplePanel" Style="{StaticResource EgBodyPanelStyle}"
                Padding="{x:Bind MediaViewModel.BodyPanelPadding, Mode=OneWay}"
                Spacing="10" Visibility="{x:Bind MediaViewModel.PeopleVisibility, Mode=OneWay}">
                <local:ShelfHead Title="演员阵容" ShowLines="{x:Bind MediaViewModel.ShowShelfLines, Mode=OneWay}" />
                <local:ShelfStrip x:Name="MediaPeople" ItemsSource="{x:Bind MediaViewModel.People, Mode=OneWay}"
                    ItemSpacing="16" PictureHeight="184" ItemTemplate="{StaticResource MediaRelatedCardTemplate}" />
            </StackPanel>
            <StackPanel x:Name="RecommendationsPanel" Style="{StaticResource EgBodyPanelStyle}"
                Padding="{x:Bind MediaViewModel.BodyPanelPadding, Mode=OneWay}"
                Spacing="10" Visibility="{x:Bind MediaViewModel.RecommendationsVisibility, Mode=OneWay}">
                <local:ShelfHead Title="相关推荐" ShowLines="{x:Bind MediaViewModel.ShowShelfLines, Mode=OneWay}" />
                <local:ShelfStrip x:Name="MediaRecommendations" ItemsSource="{x:Bind MediaViewModel.Recommendations, Mode=OneWay}"
                    ItemSpacing="16" PictureHeight="184" ItemTemplate="{StaticResource MediaRelatedCardTemplate}" />
            </StackPanel>
            <StackPanel x:Name="SimilarPanel" Style="{StaticResource EgBodyPanelStyle}"
                Padding="{x:Bind MediaViewModel.BodyPanelPadding, Mode=OneWay}"
                Spacing="10" Visibility="{x:Bind MediaViewModel.SimilarVisibility, Mode=OneWay}">
                <local:ShelfHead Title="相似作品" ShowLines="{x:Bind MediaViewModel.ShowShelfLines, Mode=OneWay}" />
                <local:ShelfStrip x:Name="MediaSimilar" ItemsSource="{x:Bind MediaViewModel.Similar, Mode=OneWay}"
                    ItemSpacing="16" PictureHeight="184" ItemTemplate="{StaticResource MediaRelatedCardTemplate}" />
            </StackPanel>
            </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    </Grid>
    <ScrollViewer x:Name="DetailErrorState" VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled" Visibility="{x:Bind MediaViewModel.DetailErrorVisibility, Mode=OneWay}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Margin="32,72" Spacing="20">
            <Viewbox MaxWidth="360" Height="132" Stretch="Uniform" AutomationProperties.Name="媒体信息不可用">
                <Canvas Width="360" Height="132">
                    <Viewbox Width="86" Height="132" Stretch="Uniform">
                        <TextBlock Text="5" Style="{StaticResource EgDisplayTitleStyle}" FontWeight="ExtraBold"
                            Foreground="{ThemeResource EgTextDimBrush}" />
                    </Viewbox>
                    <Path Stroke="{ThemeResource EgAccentBrush}" StrokeThickness="5">
                        <Path.Data><GeometryGroup>
                            <EllipseGeometry Center="160,66" RadiusX="55" RadiusY="55" />
                            <EllipseGeometry Center="292,66" RadiusX="55" RadiusY="55" />
                        </GeometryGroup></Path.Data>
                    </Path>
                    <Path Stroke="{ThemeResource EgTextDimBrush}" StrokeThickness="2">
                        <Path.Data><GeometryGroup>
                            <EllipseGeometry Center="190,66" RadiusX="11" RadiusY="11" />
                            <EllipseGeometry Center="175,92" RadiusX="11" RadiusY="11" />
                            <EllipseGeometry Center="145,92" RadiusX="11" RadiusY="11" />
                            <EllipseGeometry Center="130,66" RadiusX="11" RadiusY="11" />
                            <EllipseGeometry Center="145,40" RadiusX="11" RadiusY="11" />
                            <EllipseGeometry Center="175,40" RadiusX="11" RadiusY="11" />
                            <EllipseGeometry Center="322,66" RadiusX="11" RadiusY="11" />
                            <EllipseGeometry Center="307,92" RadiusX="11" RadiusY="11" />
                            <EllipseGeometry Center="277,92" RadiusX="11" RadiusY="11" />
                            <EllipseGeometry Center="262,66" RadiusX="11" RadiusY="11" />
                            <EllipseGeometry Center="277,40" RadiusX="11" RadiusY="11" />
                            <EllipseGeometry Center="307,40" RadiusX="11" RadiusY="11" />
                        </GeometryGroup></Path.Data>
                    </Path>
                    <Path Fill="{ThemeResource EgAccentBrush}">
                        <Path.Data><GeometryGroup>
                            <EllipseGeometry Center="160,66" RadiusX="7" RadiusY="7" />
                            <EllipseGeometry Center="292,66" RadiusX="7" RadiusY="7" />
                        </GeometryGroup></Path.Data>
                    </Path>
                </Canvas>
            </Viewbox>
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <TextBlock Text="出错啦！" Style="{StaticResource EgSectionTitleStyle}" TextAlignment="Center" />
                <Border Width="44" Height="3" Background="{ThemeResource EgAccentBrush}" CornerRadius="2" />
            </StackPanel>
            <TextBlock x:Name="DetailErrorMessage" Text="{x:Bind MediaViewModel.DetailError, Mode=OneWay}"
                Style="{StaticResource EgBodyStyle}" Foreground="{ThemeResource EgTextDimBrush}"
                TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="RetryMediaDetail" Content="重试" Click="OnRefreshDetails"
                HorizontalAlignment="Center" Style="{StaticResource EgSecondaryButtonStyle}" />
        </StackPanel>
    </ScrollViewer>
    <Grid x:Name="DetailLoading" Background="{ThemeResource EgScrimBrush}" IsHitTestVisible="False"
        Visibility="{x:Bind MediaViewModel.InitialLoadingVisibility, Mode=OneWay}">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{StaticResource EgCardCornerRadius}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource EgSpaceM}" VerticalAlignment="Center">
                <ProgressRing x:Name="DetailLoadingRing" Width="28" Height="28"
                    IsActive="{x:Bind MediaViewModel.InitialLoading, Mode=OneWay}"
                    Foreground="{ThemeResource EgAccentBrush}" AutomationProperties.Name="正在读取媒体详情" />
                <TextBlock Text="正在读取媒体详情…" Style="{StaticResource EgBodyStyle}" VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
    </Grid>
    <local:MoviePilotResourcePanel x:Name="MediaResources" Visibility="Collapsed" Closed="OnResourcesClosed" />
</Grid>
</Page>
