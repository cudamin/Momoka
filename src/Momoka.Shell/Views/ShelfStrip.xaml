<?xml version="1.0" encoding="utf-8"?>
<!-- 横向虚拟化货架。圆形翻页键浮在画面两侧，触摸、Shift+滚轮和键盘导航由原来的 ScrollView 路径保留。 -->
<UserControl
    x:Class="Momoka.Shell.Views.ShelfStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="EgShelfPageButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="{StaticResource EgOutlineThickness}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EgBorderStrongBrush}" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{ThemeResource EgSurfaceElevatedBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource EgTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
            <!-- 底色与描边由同一个矢量圆绘制；2 DIP 与 EgOutlineThickness 保持一致（厚度回归核对）。
                 仍是 Button：点击、自动化、焦点和外层位移动画不变，不使用位图或额外圆角裁剪。 -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Circle.Fill" Value="{ThemeResource ButtonBackgroundPointerOver}" />
                                            <Setter Target="Circle.Stroke" Value="{ThemeResource ButtonBorderBrushPointerOver}" />
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundPointerOver}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Circle.Fill" Value="{ThemeResource ButtonBackgroundPressed}" />
                                            <Setter Target="Circle.Stroke" Value="{ThemeResource ButtonBorderBrushPressed}" />
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundPressed}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Circle.Fill" Value="{ThemeResource ButtonBackgroundDisabled}" />
                                            <Setter Target="Circle.Stroke" Value="{ThemeResource ButtonBorderBrushDisabled}" />
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundDisabled}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Ellipse
                                x:Name="Circle"
                                Fill="{TemplateBinding Background}"
                                IsHitTestVisible="False"
                                Stretch="Fill"
                                Stroke="{TemplateBinding BorderBrush}"
                                StrokeThickness="2"
                                UseLayoutRounding="False" />
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Padding="{TemplateBinding Padding}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="Root"
        x:Uid="ShelfStrip_Root"
        Background="Transparent"
        GotFocus="OnGotFocus"
        IsTabStop="False"
        KeyDown="OnKeyDown"
        NoFocusCandidateFound="OnNoFocusCandidateFound"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited"
        PointerMoved="OnPointerEntered"
        TabFocusNavigation="Local"
        XYFocusKeyboardNavigation="Enabled">
        <!-- 6px 顶部余量容纳卡片的轻上浮，不扩大卡片自身尺寸或改变横向步长。 -->
        <ScrollView
            x:Name="Scroller"
            Padding="0,6,0,0"
            ContentOrientation="Horizontal"
            HorizontalScrollBarVisibility="Hidden"
            IsTabStop="False"
            SizeChanged="OnContentResized"
            VerticalScrollBarVisibility="Hidden"
            ViewChanged="OnViewChanged">
            <ItemsRepeater
                x:Name="Repeater"
                ElementPrepared="OnElementPrepared"
                IsTabStop="False"
                SizeChanged="OnContentResized">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="16" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollView>

        <Button
            x:Name="Prev"
            x:Uid="ShelfStrip_Prev"
            Click="OnPrevClicked"
            HorizontalAlignment="Left"
            IsHitTestVisible="False"
            IsTabStop="False"
            Opacity="0"
            Style="{StaticResource EgShelfPageButtonStyle}">
            <Button.RenderTransform>
                <TranslateTransform x:Name="PrevMotion" />
            </Button.RenderTransform>
            <Button.Resources>
                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="EgSurfaceHoverBrush" />
                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="EgSurfaceAltBrush" />
                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="EgAccentBrush" />
                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="EgTextBrush" />
                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="EgAccentBrush" />
                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="EgBorderStrongBrush" />
            </Button.Resources>
            <FontIcon FontSize="16" Glyph="&#xE76B;" />
        </Button>
        <Button
            x:Name="Next"
            x:Uid="ShelfStrip_Next"
            Click="OnNextClicked"
            HorizontalAlignment="Right"
            IsHitTestVisible="False"
            IsTabStop="False"
            Opacity="0"
            Style="{StaticResource EgShelfPageButtonStyle}">
            <Button.RenderTransform>
                <TranslateTransform x:Name="NextMotion" />
            </Button.RenderTransform>
            <Button.Resources>
                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="EgSurfaceHoverBrush" />
                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="EgSurfaceAltBrush" />
                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="EgAccentBrush" />
                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="EgTextBrush" />
                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="EgAccentBrush" />
                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="EgBorderStrongBrush" />
            </Button.Resources>
            <FontIcon FontSize="16" Glyph="&#xE76C;" />
        </Button>
    </Grid>
</UserControl>
