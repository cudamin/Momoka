<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Momoka.Shell.Views.MoviePilotResourceBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momoka.Shell.Views"
    xmlns:vm="using:Momoka.Shell.ViewModels">
    <UserControl.Resources>
        <Style x:Key="ResourceTag" TargetType="Border">
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{ThemeResource EgSurfaceAltBrush}" />
        </Style>
        <Style x:Key="ResourceTagText" TargetType="TextBlock" BasedOn="{StaticResource EgCaptionStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource EgAccentBrush}" />
        </Style>
    </UserControl.Resources>
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.FiltersVisibility, Mode=OneWay}">
            <TextBlock Text="资源搜索结果" Style="{StaticResource EgSubheadStyle}" />
            <Border Padding="10" Background="{ThemeResource EgSurfaceBrush}" CornerRadius="8">
                <local:WrapRow x:Name="FilterToolbar" Spacing="8" RowSpacing="8">
                    <Border Padding="10,6" CornerRadius="16" Background="{ThemeResource EgAccentBrush}" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextOnAccentBrush}"
                            Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                    </Border>
                    <ComboBox x:Name="SortOrder" Width="132" MinHeight="30" Padding="8,4"
                        AutomationProperties.Name="资源排序" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                        <x:String>默认排序</x:String><x:String>做种数</x:String><x:String>发布时间</x:String><x:String>体积从小到大</x:String><x:String>体积从大到小</x:String>
                    </ComboBox>
                    <local:MoviePilotResourceFacetPicker x:Name="SiteFilter" Facet="{x:Bind ViewModel.SiteFacet, Mode=OneWay}" />
                    <local:MoviePilotResourceFacetPicker x:Name="SeasonFilter" Facet="{x:Bind ViewModel.SeasonFacet, Mode=OneWay}" />
                    <local:MoviePilotResourceFacetPicker x:Name="PromotionFilter" Facet="{x:Bind ViewModel.PromotionFacet, Mode=OneWay}" />
                    <local:MoviePilotResourceFacetPicker x:Name="VideoFilter" Facet="{x:Bind ViewModel.VideoFacet, Mode=OneWay}" />
                    <local:MoviePilotResourceFacetPicker x:Name="EditionFilter" Facet="{x:Bind ViewModel.EditionFacet, Mode=OneWay}" />
                    <local:MoviePilotResourceFacetPicker x:Name="ResolutionFilter" Facet="{x:Bind ViewModel.ResolutionFacet, Mode=OneWay}" />
                    <local:MoviePilotResourceFacetPicker x:Name="GroupFilter" Facet="{x:Bind ViewModel.GroupFacet, Mode=OneWay}" />
                    <DropDownButton x:Name="FilterExpander" CornerRadius="16" Padding="10,4" MinHeight="30"
                        Background="{ThemeResource EgAccentSoftBrush}" Foreground="{ThemeResource EgAccentBrush}" BorderThickness="0"
                        AutomationProperties.Name="综合筛选">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71C;" FontSize="{StaticResource EgCaptionFontSize}" />
                            <TextBlock Text="{x:Bind ViewModel.AdvancedSummary, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}"
                                MaxWidth="220" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <Flyout x:Name="AdvancedFilters">
                                <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Width="244" Spacing="12">
                                        <TextBlock Text="综合筛选" Style="{StaticResource EgSubheadStyle}" />
                                        <TextBox x:Name="FilterText" Header="在结果中筛选" PlaceholderText="标题、副标题或标签"
                                            Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ComboBox x:Name="EpisodeFilter" Header="集" HorizontalAlignment="Stretch"
                                            Visibility="{x:Bind ViewModel.EpisodeVisibility, Mode=OneWay}"
                                            ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedEpisode, Mode=TwoWay}" />
                                        <ComboBox x:Name="LabelFilter" Header="标签" HorizontalAlignment="Stretch"
                                            Visibility="{x:Bind ViewModel.LabelVisibility, Mode=OneWay}"
                                            ItemsSource="{x:Bind ViewModel.Labels, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedLabel, Mode=TwoWay}" />
                                        <ComboBox x:Name="DateFilter" Header="发布时间" HorizontalAlignment="Stretch"
                                            SelectedIndex="{x:Bind ViewModel.DateIndex, Mode=TwoWay}">
                                            <x:String>不限时间</x:String><x:String>最近 24 小时</x:String><x:String>最近 7 天</x:String><x:String>最近 30 天</x:String><x:String>最近 90 天</x:String>
                                        </ComboBox>
                                        <CheckBox x:Name="SeededFilter" Content="仅有做种" IsChecked="{x:Bind ViewModel.SeededOnly, Mode=TwoWay}" />
                                        <CheckBox x:Name="HitAndRunFilter" Content="排除 HR" IsChecked="{x:Bind ViewModel.ExcludeHitAndRun, Mode=TwoWay}" />
                                        <Button x:Name="ResetAdvancedFilters" Content="清除筛选" Command="{x:Bind ViewModel.ResetCommand}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="ResetFilters" Content="清除筛选" Padding="10,4" MinHeight="30" CornerRadius="16"
                        Command="{x:Bind ViewModel.ResetCommand}" Visibility="{x:Bind ViewModel.ResetVisibility, Mode=OneWay}" />
                </local:WrapRow>
            </Border>
        </StackPanel>
        <ItemsControl x:Name="ActiveFilters" Grid.Row="1" ItemsSource="{x:Bind ViewModel.ActiveChoices, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ActiveChoicesVisibility, Mode=OneWay}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:WrapRow Spacing="6" RowSpacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MoviePilotResourceChoice">
                    <Button x:Name="RemoveFilter" Content="{x:Bind FilterLabel}" Command="{x:Bind RemoveCommand}"
                        AutomationProperties.Name="{x:Bind RemoveName}" CornerRadius="14" Padding="8,3" MinHeight="28"
                        FontSize="{StaticResource EgCaptionFontSize}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Grid.Row="2">
            <ItemsView x:Name="ResourceList" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                SelectionMode="None" IsItemInvokedEnabled="False" ItemTransitionProvider="{x:Null}">
                <ItemsView.Layout>
                    <UniformGridLayout MinItemWidth="236" MinItemHeight="364" MinRowSpacing="12" MinColumnSpacing="12"
                        ItemsStretch="Fill" ItemsJustification="Start" />
                </ItemsView.Layout>
                <ItemsView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MoviePilotResourceRow">
                        <ItemContainer AutomationProperties.Name="{x:Bind Title}">
                            <Grid x:Name="ResourceCard" Height="364" Background="{ThemeResource EgSurfaceBrush}" CornerRadius="8">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Padding="14,14,14,8" RowSpacing="6">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{x:Bind DisplayTitle}" Style="{StaticResource EgSubheadStyle}" FontWeight="SemiBold"
                                        FontFamily="{StaticResource EgUiFontFamily}" Margin="0,4,30,0" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                    <Border Grid.Row="1" Style="{StaticResource ResourceTag}" HorizontalAlignment="Left" Background="{ThemeResource EgAccentSoftBrush}"
                                        Visibility="{x:Bind SeasonEpisodeVisibility}">
                                        <TextBlock Text="{x:Bind SeasonEpisode}" Style="{StaticResource ResourceTagText}" />
                                    </Border>
                                    <Grid Grid.Row="2" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind SiteName}" Style="{StaticResource EgCaptionStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Seeders}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}" ToolTipService.ToolTip="做种人数" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Peers}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgWarningBrush}" ToolTipService.ToolTip="下载人数" />
                                    </Grid>
                                    <TextBlock Grid.Row="3" Text="{x:Bind Title}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextBrush}"
                                        MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                    <TextBlock Grid.Row="4" VerticalAlignment="Top" Text="{x:Bind Description}" Style="{StaticResource EgCaptionStyle}" MaxLines="3" TextWrapping="Wrap"
                                        TextTrimming="CharacterEllipsis" Visibility="{x:Bind DescriptionVisibility}" ToolTipService.ToolTip="{x:Bind Description}" />
                                    <TextBlock Grid.Row="5" Text="{x:Bind PublishedLine}" Style="{StaticResource EgCaptionStyle}" TextTrimming="CharacterEllipsis" />
                                    <local:WrapRow Grid.Row="6" Spacing="4" RowSpacing="4">
                                        <Border Style="{StaticResource ResourceTag}" Visibility="{x:Bind WebSourceVisibility}"><TextBlock Text="{x:Bind WebSource}" Style="{StaticResource ResourceTagText}" /></Border>
                                        <Border Style="{StaticResource ResourceTag}" Visibility="{x:Bind ResourceTypeVisibility}"><TextBlock Text="{x:Bind ResourceType}" Style="{StaticResource ResourceTagText}" Foreground="{ThemeResource EgDangerBrush}" /></Border>
                                        <Border Style="{StaticResource ResourceTag}" Visibility="{x:Bind ResolutionVisibility}"><TextBlock Text="{x:Bind Resolution}" Style="{StaticResource ResourceTagText}" Foreground="{ThemeResource EgInfoBrush}" /></Border>
                                        <Border Style="{StaticResource ResourceTag}" Visibility="{x:Bind VideoVisibility}"><TextBlock Text="{x:Bind VideoCodec}" Style="{StaticResource ResourceTagText}" Foreground="{ThemeResource EgWarningBrush}" /></Border>
                                        <Border Style="{StaticResource ResourceTag}" Visibility="{x:Bind EditionVisibility}"><TextBlock Text="{x:Bind Edition}" Style="{StaticResource ResourceTagText}" /></Border>
                                        <Border Style="{StaticResource ResourceTag}" Visibility="{x:Bind GroupVisibility}"><TextBlock Text="{x:Bind ReleaseGroup}" Style="{StaticResource ResourceTagText}" /></Border>
                                        <Border Style="{StaticResource ResourceTag}" Visibility="{x:Bind EffectVisibility}"><TextBlock Text="{x:Bind ResourceEffect}" Style="{StaticResource ResourceTagText}" /></Border>
                                        <Border Style="{StaticResource ResourceTag}" Visibility="{x:Bind HitAndRunVisibility}"><TextBlock Text="HR" Style="{StaticResource ResourceTagText}" Foreground="{ThemeResource EgDangerBrush}" /></Border>
                                    </local:WrapRow>
                                    <TextBlock Grid.Row="7" Text="{x:Bind LabelsText}" Style="{StaticResource EgCaptionStyle}" MaxLines="1" TextTrimming="CharacterEllipsis"
                                        Foreground="{ThemeResource EgAccentBrush}" Visibility="{x:Bind LabelsVisibility}" />
                                </Grid>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="7,3" CornerRadius="0,8,0,5"
                                    Background="{ThemeResource EgWarningBrush}" Visibility="{x:Bind PromotionVisibility}" ToolTipService.ToolTip="{x:Bind PromotionText}">
                                    <TextBlock Text="{x:Bind PromotionBadge}" Style="{StaticResource EgCaptionStyle}" FontWeight="SemiBold" Foreground="{ThemeResource EgTextOnAccentBrush}" />
                                </Border>
                                <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="6" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource EgBorderBrush}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="身份待核对" Grid.Column="1" Style="{StaticResource EgCaptionStyle}" VerticalAlignment="Center"
                                        Visibility="{x:Bind DownloadProblemVisibility}" ToolTipService.ToolTip="{x:Bind DownloadProblem}" />
                                    <Button x:Name="DownloadResource" Grid.Column="1" Content="{x:Bind DownloadLabel, Mode=OneWay}" Command="{x:Bind DownloadCommand}"
                                        Visibility="{x:Bind DownloadVisibility}" AutomationProperties.Name="{x:Bind DownloadAutomationName}" Padding="8,4" MinHeight="30"
                                        FontSize="{StaticResource EgCaptionFontSize}" />
                                    <Button x:Name="OpenTorrentPage" Grid.Column="2" Command="{x:Bind OpenDetailsCommand}" Width="30" Height="30" Padding="0"
                                        AutomationProperties.Name="{x:Bind DetailsAutomationName}" Visibility="{x:Bind DetailsVisibility}" ToolTipService.ToolTip="{x:Bind DetailsHint}">
                                        <FontIcon Glyph="&#xE946;" FontSize="{StaticResource EgBodyFontSize}" Foreground="{ThemeResource EgAccentBrush}" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </ItemsView.ItemTemplate>
            </ItemsView>
            <TextBlock Margin="20,32" HorizontalAlignment="Center" VerticalAlignment="Top"
                Style="{StaticResource EgBodyStyle}" Text="没有符合筛选条件的资源，可清除筛选后重试。"
                TextWrapping="Wrap" TextAlignment="Center" Visibility="{x:Bind ViewModel.NoMatchesVisibility, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
