<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Momoka.Shell.Views.MoviePilotResourceBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momoka.Shell.Views"
    xmlns:vm="using:Momoka.Shell.ViewModels">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MoviePilotResourceFilterStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ResourceTag" TargetType="Border">
                <Setter Property="Padding" Value="5,2" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Background" Value="{ThemeResource EgSurfaceAltBrush}" />
            </Style>
            <Style x:Key="ResourceTagText" TargetType="TextBlock" BasedOn="{StaticResource EgCaptionStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource EgAccentBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8" Margin="0,0,0,8" Visibility="{x:Bind ViewModel.FiltersVisibility, Mode=OneWay}">
            <TextBlock x:Uid="MoviePilotResourceBrowser_Localization1" Text="资源搜索结果" Style="{StaticResource EgSubheadStyle}" />
            <Border Padding="10" Background="{ThemeResource EgSurfaceBrush}" CornerRadius="8">
                <local:WrapRow x:Name="FilterToolbar" Spacing="8" RowSpacing="8">
                    <Border Padding="10,6" CornerRadius="16" Background="{ThemeResource EgAccentBrush}" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextOnAccentBrush}"
                            Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                    </Border>
                    <DropDownButton x:Name="SortOrder" Height="32" MinWidth="0" Padding="12,4,6,4" CornerRadius="4"
                        Background="{ThemeResource ControlFillColorTransparentBrush}" Foreground="{ThemeResource EgTextDimBrush}" BorderThickness="0"
                        VerticalAlignment="Center" AutomationProperties.Name="{x:Bind ViewModel.SortAutomationName, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!-- 每颗图标持有自己的 Geometry；不能把另一个 PathIcon 的 Data 再挂到本控件。 -->
                            <Grid Width="14" Height="14">
                                <PathIcon x:Name="SortAscendingIcon" Width="14" Height="14" Foreground="{ThemeResource EgTextDimBrush}"
                                    Data="M1,2 H4 V3.5 H1 Z M1,6 H7 V7.5 H1 Z M1,10 H10 V11.5 H1 Z M11.5,1 L9,4 H11 V13 H12.5 V4 H14 Z"
                                    Visibility="{x:Bind local:MoviePilotResourceBrowser.AscendingIconVisibility(ViewModel.SortDescending), Mode=OneWay}" />
                                <PathIcon x:Name="SortDescendingIcon" Width="14" Height="14" Foreground="{ThemeResource EgTextDimBrush}"
                                    Data="M1,2 H4 V3.5 H1 Z M1,6 H7 V7.5 H1 Z M1,10 H10 V11.5 H1 Z M11.5,13 L9,10 H11 V1 H12.5 V10 H14 Z"
                                    Visibility="{x:Bind local:MoviePilotResourceBrowser.DescendingIconVisibility(ViewModel.SortDescending), Mode=OneWay}" />
                            </Grid>
                            <TextBlock x:Name="SortLabel" Text="{x:Bind ViewModel.SortLabel, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}"
                                FontWeight="SemiBold" Foreground="{ThemeResource EgTextDimBrush}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <!-- RadioMenuFlyoutItem 的空 GroupName 也是共享组；方向与字段用每个浏览器自己的组名。 -->
                            <MenuFlyout x:Name="SortMenu" Placement="Bottom" Opening="OnSortMenuOpening">
                                <RadioMenuFlyoutItem x:Uid="MoviePilotResourceBrowser_SortAscending" x:Name="SortAscending" Text="升序" GroupName="{x:Bind SortDirectionGroup}"
                                    Click="OnSortDirectionClick" />
                                <RadioMenuFlyoutItem x:Uid="MoviePilotResourceBrowser_SortDescending" x:Name="SortDescending" Text="降序" GroupName="{x:Bind SortDirectionGroup}"
                                    Click="OnSortDirectionClick" />
                                <MenuFlyoutSeparator />
                                <RadioMenuFlyoutItem x:Uid="MoviePilotResourceBrowser_SortDefault" x:Name="SortDefault" Text="默认排序" Tag="0" GroupName="{x:Bind SortFieldGroup}"
                                    Click="OnSortFieldClick" />
                                <RadioMenuFlyoutItem x:Uid="MoviePilotResourceBrowser_SortSite" x:Name="SortSite" Text="站点" Tag="1" GroupName="{x:Bind SortFieldGroup}"
                                    Click="OnSortFieldClick" />
                                <RadioMenuFlyoutItem x:Uid="MoviePilotResourceBrowser_SortSize" x:Name="SortSize" Text="体积" Tag="2" GroupName="{x:Bind SortFieldGroup}"
                                    Click="OnSortFieldClick" />
                                <RadioMenuFlyoutItem x:Uid="MoviePilotResourceBrowser_SortSeeders" x:Name="SortSeeders" Text="做种数" Tag="3" GroupName="{x:Bind SortFieldGroup}"
                                    Click="OnSortFieldClick" />
                                <RadioMenuFlyoutItem x:Uid="MoviePilotResourceBrowser_SortPublishedAt" x:Name="SortPublishedAt" Text="发布时间" Tag="4" GroupName="{x:Bind SortFieldGroup}"
                                    Click="OnSortFieldClick" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <local:MoviePilotResourceFacetPicker x:Name="SiteFilter" Facet="{x:Bind ViewModel.SiteFacet, Mode=OneWay}" />
                    <local:MoviePilotResourceFacetPicker x:Name="SeasonFilter" Facet="{x:Bind ViewModel.SeasonFacet, Mode=OneWay}" />
                    <local:MoviePilotResourceFacetPicker x:Name="PromotionFilter" Facet="{x:Bind ViewModel.PromotionFacet, Mode=OneWay}" />
                    <local:MoviePilotResourceFacetPicker x:Name="VideoFilter" Facet="{x:Bind ViewModel.VideoFacet, Mode=OneWay}" />
                    <local:MoviePilotResourceFacetPicker x:Name="EditionFilter" Facet="{x:Bind ViewModel.EditionFacet, Mode=OneWay}" />
                    <local:MoviePilotResourceFacetPicker x:Name="ResolutionFilter" Facet="{x:Bind ViewModel.ResolutionFacet, Mode=OneWay}" />
                    <local:MoviePilotResourceFacetPicker x:Name="GroupFilter" Facet="{x:Bind ViewModel.GroupFacet, Mode=OneWay}" />
                    <!-- 2026-11-22 用户令「参考网页端源码，修改综合筛选，做成弹窗」：网页端的全部筛选是居中弹窗，
                         这里改成按钮 + ContentDialog；弹窗内容见 MoviePilotResourceFilterDialog.xaml。
                         悬停/按下状态钉在强调色柔和底上，避免框架默认的浅色悬停背景把图标衬没。 -->
                    <Button x:Uid="MoviePilotResourceBrowser_FilterExpander" x:Name="FilterExpander" CornerRadius="16"
                        AutomationProperties.Name="综合筛选" Style="{StaticResource EgResourceButtonStyle}" Click="OnAdvancedFilters">
                        <Button.Resources>
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="EgAccentMutedBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="EgAccentSoftBrush" />
                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="EgAccentBrush" />
                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="EgAccentBrush" />
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71C;" FontSize="{StaticResource EgCaptionFontSize}" Foreground="{ThemeResource EgAccentBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.AdvancedSummary, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}"
                                MaxWidth="220" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button x:Uid="MoviePilotResourceBrowser_ResetFilters" x:Name="ResetFilters" Content="清除筛选" Padding="10,4" MinHeight="30" CornerRadius="16"
                        Command="{x:Bind ViewModel.ResetCommand}" Visibility="{x:Bind ViewModel.ResetVisibility, Mode=OneWay}" />
                </local:WrapRow>
            </Border>
        </StackPanel>
        <ItemsControl x:Name="ActiveFilters" Grid.Row="1" Margin="0,0,0,8" ItemsSource="{x:Bind ViewModel.ActiveChoices, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ActiveChoicesVisibility, Mode=OneWay}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:WrapRow Spacing="6" RowSpacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MoviePilotResourceChoice">
                    <Border x:Name="ActiveFilterTag" Background="{ThemeResource EgAccentSoftBrush}" BorderBrush="{ThemeResource EgAccentMutedBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="10,0,2,0">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind FilterLabel}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}"
                                VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="220" />
                            <Button x:Name="RemoveFilter" Grid.Column="1" Command="{x:Bind RemoveCommand}"
                                AutomationProperties.Name="{x:Bind RemoveName}" ToolTipService.ToolTip="{x:Bind RemoveName}"
                                CornerRadius="14" Padding="6" MinWidth="28" MinHeight="28"
                                Background="{ThemeResource ControlFillColorTransparentBrush}" Foreground="{ThemeResource EgAccentBrush}"
                                BorderThickness="0" UseSystemFocusVisuals="True">
                                <FontIcon Glyph="&#xE711;" FontSize="{StaticResource EgCaptionFontSize}" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Grid.Row="2">
            <!-- 整张卡就是下载入口（2026-10-29 用户令，对齐网页端 TorrentCard）：点卡片打开下载选择栏，
                 卡上不再有下载按钮。右下角那颗方钮只负责打开站点网页，自己吃掉指针事件，不会顺带下载。 -->
            <ItemsView x:Name="ResourceList" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                Padding="{StaticResource EgScrollBarLane}"
                SelectionMode="None" IsItemInvokedEnabled="True" ItemInvoked="OnResourceInvoked" ItemTransitionProvider="{x:Null}">
                <ItemsView.Layout>
                    <UniformGridLayout MinItemWidth="236" MinItemHeight="364" MinRowSpacing="12" MinColumnSpacing="12"
                        ItemsStretch="Fill" ItemsJustification="Start" />
                </ItemsView.Layout>
                <ItemsView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MoviePilotResourceRow">
                        <ItemContainer AutomationProperties.Name="{x:Bind CardAutomationName, Mode=OneWay}"
                            AutomationProperties.HelpText="{x:Bind CardHint, Mode=OneWay}">
                            <Grid x:Name="ResourceCard" Height="364" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8"
                                ToolTipService.ToolTip="{x:Bind CardHint, Mode=OneWay}">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Padding="14,14,14,8" RowSpacing="6">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{x:Bind DisplayTitle}" Style="{StaticResource EgSubheadStyle}" FontWeight="SemiBold"
                                        FontFamily="{StaticResource EgUiFontFamily}" Margin="0,4,30,0" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                    <Border Grid.Row="1" Style="{StaticResource ResourceTag}" HorizontalAlignment="Left" Background="{ThemeResource EgAccentSoftBrush}"
                                        Visibility="{x:Bind SeasonEpisodeVisibility}">
                                        <TextBlock Text="{x:Bind SeasonEpisode}" Style="{StaticResource ResourceTagText}" />
                                    </Border>
                                    <Grid Grid.Row="2" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind SiteName}" Style="{StaticResource EgCaptionStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Uid="MoviePilotResourceBrowser_Localization8" Grid.Column="1" Text="{x:Bind Seeders}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}" ToolTipService.ToolTip="做种人数" />
                                        <TextBlock x:Uid="MoviePilotResourceBrowser_Localization9" Grid.Column="2" Text="{x:Bind Peers}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgWarningBrush}" ToolTipService.ToolTip="下载人数" />
                                    </Grid>
                                    <TextBlock Grid.Row="3" Text="{x:Bind Title}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextBrush}"
                                        MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                    <TextBlock Grid.Row="4" VerticalAlignment="Top" Text="{x:Bind Description}" Style="{StaticResource EgCaptionStyle}" MaxLines="3" TextWrapping="Wrap"
                                        TextTrimming="CharacterEllipsis" Visibility="{x:Bind DescriptionVisibility}" ToolTipService.ToolTip="{x:Bind Description}" />
                                    <TextBlock Grid.Row="5" Text="{x:Bind PublishedLine}" Style="{StaticResource EgCaptionStyle}" TextTrimming="CharacterEllipsis" />
                                    <local:WrapRow Grid.Row="6" Spacing="4" RowSpacing="4">
                                        <Border Style="{StaticResource ResourceTag}" Visibility="{x:Bind WebSourceVisibility}"><TextBlock Text="{x:Bind WebSource}" Style="{StaticResource ResourceTagText}" /></Border>
                                        <Border Style="{StaticResource ResourceTag}" Visibility="{x:Bind ResourceTypeVisibility}"><TextBlock Text="{x:Bind ResourceType}" Style="{StaticResource ResourceTagText}" Foreground="{ThemeResource EgDangerBrush}" /></Border>
                                        <Border Style="{StaticResource ResourceTag}" Visibility="{x:Bind ResolutionVisibility}"><TextBlock Text="{x:Bind Resolution}" Style="{StaticResource ResourceTagText}" Foreground="{ThemeResource EgInfoBrush}" /></Border>
                                        <Border Style="{StaticResource ResourceTag}" Visibility="{x:Bind VideoVisibility}"><TextBlock Text="{x:Bind VideoCodec}" Style="{StaticResource ResourceTagText}" Foreground="{ThemeResource EgWarningBrush}" /></Border>
                                        <Border Style="{StaticResource ResourceTag}" Visibility="{x:Bind EditionVisibility}"><TextBlock Text="{x:Bind Edition}" Style="{StaticResource ResourceTagText}" /></Border>
                                        <Border Style="{StaticResource ResourceTag}" Visibility="{x:Bind GroupVisibility}"><TextBlock Text="{x:Bind ReleaseGroup}" Style="{StaticResource ResourceTagText}" /></Border>
                                        <Border Style="{StaticResource ResourceTag}" Visibility="{x:Bind EffectVisibility}"><TextBlock Text="{x:Bind ResourceEffect}" Style="{StaticResource ResourceTagText}" /></Border>
                                        <Border Style="{StaticResource ResourceTag}" Visibility="{x:Bind HitAndRunVisibility}"><TextBlock Text="HR" Style="{StaticResource ResourceTagText}" Foreground="{ThemeResource EgDangerBrush}" /></Border>
                                    </local:WrapRow>
                                    <TextBlock Grid.Row="7" Text="{x:Bind LabelsText}" Style="{StaticResource EgCaptionStyle}" MaxLines="1" TextTrimming="CharacterEllipsis"
                                        Foreground="{ThemeResource EgAccentBrush}" Visibility="{x:Bind LabelsVisibility}" />
                                </Grid>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="7,3" CornerRadius="0,8,0,5"
                                    Background="{ThemeResource EgWarningBrush}" Visibility="{x:Bind PromotionVisibility}" ToolTipService.ToolTip="{x:Bind PromotionText}">
                                    <TextBlock Text="{x:Bind PromotionBadge}" Style="{StaticResource EgCaptionStyle}" FontWeight="SemiBold" Foreground="{ThemeResource EgTextOnAccentBrush}" />
                                </Border>
                                <!-- 已加入下载：整圈强调色，和网页端「已下载」的绿框同一个意思；只是读的状态，不接指针。 -->
                                <Border BorderBrush="{ThemeResource EgAccentBrush}" BorderThickness="{StaticResource EgOutlineThickness}"
                                    CornerRadius="8" IsHitTestVisible="False" Visibility="{x:Bind SubmittedVisibility, Mode=OneWay}" />
                                <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource EgBorderBrush}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <!-- 身份待核对与过程状态各说各的：前者不因后者出现或消失而收起来。 -->
                                        <TextBlock x:Uid="MoviePilotResourceBrowser_Localization10" Text="身份待核对" Style="{StaticResource EgCaptionStyle}" VerticalAlignment="Center" Foreground="{ThemeResource EgWarningBrush}"
                                            Visibility="{x:Bind DownloadProblemVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind DownloadProblem}" />
                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" VerticalAlignment="Center"
                                            Foreground="{ThemeResource EgTextDimBrush}" Visibility="{x:Bind StatusVisibility, Mode=OneWay}" />
                                        <Button x:Name="OpenTorrentPage" Command="{x:Bind OpenDetailsCommand}" Width="30" Height="30" Padding="0"
                                            AutomationProperties.Name="{x:Bind DetailsAutomationName}" Visibility="{x:Bind DetailsVisibility}" ToolTipService.ToolTip="{x:Bind DetailsHint}">
                                            <FontIcon Glyph="&#xE946;" FontSize="{StaticResource EgBodyFontSize}" Foreground="{ThemeResource EgAccentBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </ItemsView.ItemTemplate>
            </ItemsView>
            <TextBlock x:Uid="MoviePilotResourceBrowser_Localization11" Margin="20,32" HorizontalAlignment="Center" VerticalAlignment="Top"
                Style="{StaticResource EgBodyStyle}" Text="没有符合筛选条件的资源，可清除筛选后重试。"
                TextWrapping="Wrap" TextAlignment="Center" Visibility="{x:Bind ViewModel.NoMatchesVisibility, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
