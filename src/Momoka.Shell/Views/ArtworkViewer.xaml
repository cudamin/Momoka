<?xml version="1.0" encoding="utf-8"?>
<!--
  「看大图」：一张图按对话框能给的面积摆出来，只读。

  一张 ContentDialog 而不是自己画一层浮层：这一格要的正是「盖住别的、只让看这一张、按 Esc 就退」，
  而 ContentDialog 生来就是这三件事。摆成浮层的话，遮罩、焦点圈、Esc、点外面关掉，四样都得自己接一遍。

  图按 Uniform 摆（完整看得见，不裁）——这一颗键的名字就是「看」，裁掉一半的图不叫看。底下那行写的是
  这一种图的名称，不是尺寸：用户看的是画面，而这一张是按 1280 解出来的，写尺寸反而是一句谎。
-->
<ContentDialog x:Uid="ArtworkViewer_ContentDialog1"
    x:Class="Momoka.Shell.Views.ArtworkViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:CommunityToolkit.WinUI"
    CloseButtonText="关闭">

    <ContentDialog.Resources>
        <!-- The framework adds a top-only overlay; keep the complete library window on the sidebar color. -->
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="LayerFillColorDefaultBrush" />
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <!-- 系统给 ContentDialog 的那层影子落在窗口外沿，不落在画框上；看大图时这张画自己也得离底
             一档。IsMasked 必须关掉：宿主是一块透明面板，按 alpha 取形状会什么都取不到。 -->
        <ui:AttachedDropShadow
            x:Key="ViewerShadow"
            BlurRadius="30"
            Color="Black"
            CornerRadius="12"
            IsMasked="False"
            Offset="0,10,0"
            Opacity="0.45" />
    </ContentDialog.Resources>

    <!-- 24 的余量是影子要的地方：CastTo 是这块面板，子视觉裁在它的边界上，画框贴边就一点影子也看不见。 -->
    <Grid x:Name="ViewerRoot" Padding="24">
        <Grid
            x:Name="ShadowHost"
            Background="Transparent"
            ui:Effects.Shadow="{StaticResource ViewerShadow}">
            <Border MaxHeight="640" Style="{StaticResource EgFrameStyle}">
                <Image
                    x:Name="Shot"
                    Stretch="Uniform" />
            </Border>
        </Grid>
    </Grid>
</ContentDialog>
