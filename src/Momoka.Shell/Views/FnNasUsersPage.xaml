<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Momoka.Shell.Views.FnNasUsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momoka.Shell.ViewModels"
    Background="{ThemeResource EgWindowBrush}">
    <Page.Resources>
        <Style x:Key="FnNasCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource EgSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
            <Setter Property="BorderThickness" Value="{StaticResource EgCardBorderThickness}" />
            <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <DataTemplate x:Key="FnNasChoiceTemplate" x:DataType="vm:FnNasChoice">
            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="FnNasPermissionTemplate" x:DataType="vm:FnNasChoice">
            <CheckBox x:Name="FnNasPermissionCheck" Content="{x:Bind Name}" IsChecked="{x:Bind Selected, Mode=TwoWay}" Margin="0,3" />
        </DataTemplate>
    </Page.Resources>
    <Grid x:Name="PageLayout" RowSpacing="12" Padding="0,0,4,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=OneWay}" IsClosable="False"
                Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}" Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
        </StackPanel>
        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
            <Grid RowSpacing="16" Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Spacing="12">
                    <TextBlock Text="用户" Style="{StaticResource EgSectionTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="FnNasUsersNew" Content="新增用户" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.NewUserCommand}" Visibility="{x:Bind ViewModel.DefaultActionsVisibility, Mode=OneWay}" />
                        <Button x:Name="FnNasUsersDefaults" Content="新用户默认权限" Command="{x:Bind ViewModel.DefaultsCommand}" Visibility="{x:Bind ViewModel.DefaultActionsVisibility, Mode=OneWay}" />
                        <Button x:Name="FnNasUsersRefresh" Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
                    </StackPanel>
                </StackPanel>
                <ListView x:Name="FnNasUsersList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Users, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnUserClick" IsEnabled="{x:Bind ViewModel.CanUse, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FnNasUserRow">
                            <Grid ColumnSpacing="16" Padding="8,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource EgSubheadStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Access}" Style="{StaticResource EgBodyStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind NasAccount}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="最近访问" Style="{StaticResource EgCaptionStyle}" />
                                        <TextBlock Text="{x:Bind LastLogin}" Style="{StaticResource EgCaptionStyle}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Role}" Style="{StaticResource EgCaptionStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Grid RowSpacing="16" Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="FnNasUserBack" Content="返回" Command="{x:Bind ViewModel.BackCommand}" />
                    <TextBlock Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}" Style="{StaticResource EgSectionTitleStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <ScrollView x:Name="FnNasUserEditorScroll" Grid.Row="1">
                    <StackPanel Spacing="16" Padding="0,0,0,16">
                        <Border Style="{StaticResource FnNasCard}" Visibility="{x:Bind ViewModel.IdentityVisibility, Mode=OneWay}">
                            <StackPanel Spacing="16">
                                <TextBox x:Name="FnNasUserName" Header="用户名" MaxLength="32" Text="{x:Bind ViewModel.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <PasswordBox x:Name="FnNasUserPassword" Header="密码" MaxLength="127" Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />
                                <PasswordBox x:Name="FnNasUserConfirmPassword" Header="确认密码" MaxLength="127" Password="{x:Bind ViewModel.ConfirmPassword, Mode=TwoWay}" />
                                <TextBlock Text="{x:Bind ViewModel.PasswordNote, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FnNasCard}" Visibility="{x:Bind ViewModel.PermissionVisibility, Mode=OneWay}">
                            <StackPanel Spacing="12">
                                <ComboBox x:Name="FnNasUserPermission" Header="可访问媒体库" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.Permission, Mode=TwoWay}">
                                    <x:String>无媒体库访问权限</x:String><x:String>部分媒体库</x:String><x:String>全部媒体库（含以后新增）</x:String>
                                </ComboBox>
                                <ItemsControl x:Name="FnNasUserLibraries" ItemsSource="{x:Bind ViewModel.Libraries, Mode=OneWay}" ItemTemplate="{StaticResource FnNasPermissionTemplate}" Visibility="{x:Bind ViewModel.LibrariesVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="FnNasUserUnlock" Content="解锁用户" Command="{x:Bind ViewModel.UnlockCommand}" Visibility="{x:Bind ViewModel.UnlockVisibility, Mode=OneWay}" />
                            <Button x:Name="FnNasUserDelete" Content="删除用户" Command="{x:Bind ViewModel.DeleteCommand}" Visibility="{x:Bind ViewModel.DeleteVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollView>
                <Button x:Name="FnNasUserSave" Grid.Row="2" Content="保存" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
