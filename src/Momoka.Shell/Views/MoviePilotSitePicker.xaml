<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Momoka.Shell.Views.MoviePilotSitePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momoka.Shell.ViewModels">
    <UserControl.Resources>
        <!-- 弹出面板底栏那三颗：面板里的小动作，比页面上的次级按钮矮一档、窄一圈。 -->
        <Style x:Key="SiteFlyoutAction" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Background" Value="{ThemeResource EgSurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="{StaticResource EgCaptionFontSize}" />
        </Style>
        <!-- 一行一个站点：整行都能点，不只那颗小方块。 -->
        <Style x:Key="SiteRowCheckBox" TargetType="CheckBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock x:Name="SiteLabel" Text="搜索站点" Style="{StaticResource EgCaptionStyle}" VerticalAlignment="Center" />
        <!-- 搜索框里的站点入口没有底色（2026-10-29 用户令）：它是框内的一段字，不是一颗深色胶囊。
             悬停与按下仍由原生按钮状态给反馈，键盘焦点也照旧。 -->
        <DropDownButton x:Name="ChooseSites" AutomationProperties.Name="选择搜索站点" ToolTipService.ToolTip="选择搜索站点"
            Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="6,0,4,0" MinHeight="30" MaxWidth="180">
            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <DropDownButton.Flyout>
                <Flyout x:Name="SitesFlyout" Opening="OnOpening" Placement="BottomEdgeAlignedRight">
                    <Flyout.FlyoutPresenterStyle>
                        <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                            <Setter Property="Background" Value="{ThemeResource EgSurfaceElevatedBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MaxWidth" Value="420" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <Grid Width="312">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Padding="16,14,16,10" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="搜索站点" Style="{StaticResource EgSubheadStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CatalogueText, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}"
                                Foreground="{ThemeResource EgTextDimBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Border Grid.Row="1" Margin="16,0,16,10" Padding="12,10,12,8" Background="{ThemeResource EgSurfaceBrush}" CornerRadius="10">
                            <StackPanel Spacing="4">
                                <CheckBox x:Name="UseDefaultSites" Content="使用 MoviePilot 默认站点" MinHeight="28"
                                    IsChecked="{x:Bind ViewModel.UseDefault, Mode=TwoWay}" />
                                <TextBlock Text="取消勾选后可指定站点，支持多选。" Style="{StaticResource EgCaptionStyle}"
                                    Foreground="{ThemeResource EgTextDimBrush}" TextWrapping="Wrap" Margin="32,0,0,0" />
                            </StackPanel>
                        </Border>
                        <ProgressBar Grid.Row="2" Margin="16,0,16,10" IsIndeterminate="True" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
                        <InfoBar Grid.Row="3" Margin="16,0,16,10" IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}" IsClosable="True"
                            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                            Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}" Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
                        <ScrollViewer Grid.Row="4" MaxHeight="264" Padding="8,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SiteChoices" ItemsSource="{x:Bind ViewModel.Sites, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanPick, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MoviePilotSearchSiteRow">
                                        <CheckBox x:Name="SelectSite" IsChecked="{x:Bind Selected, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Name}" Tag="{x:Bind}"
                                            Style="{StaticResource SiteRowCheckBox}">
                                            <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Grid.Row="4" Margin="16,6,16,10" Text="没有可供搜索的已启用站点" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap"
                            Foreground="{ThemeResource EgTextDimBrush}" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />
                        <Border Grid.Row="5" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource EgBorderBrush}" Padding="12,8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button x:Name="SelectAllSites" Content="全选" Style="{StaticResource SiteFlyoutAction}" Command="{x:Bind ViewModel.SelectAllCommand}" />
                                <Button x:Name="ClearSelectedSites" Grid.Column="1" Content="清空" Style="{StaticResource SiteFlyoutAction}" Command="{x:Bind ViewModel.ClearSelectionCommand}" />
                                <Button x:Name="ReloadSites" Grid.Column="3" Style="{StaticResource SiteFlyoutAction}" Command="{x:Bind ViewModel.RefreshCommand}"
                                    AutomationProperties.Name="刷新站点目录" ToolTipService.ToolTip="重新读取站点目录">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource EgCaptionFontSize}" />
                                        <TextBlock Text="刷新" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Flyout>
            </DropDownButton.Flyout>
        </DropDownButton>
    </StackPanel>
</UserControl>
