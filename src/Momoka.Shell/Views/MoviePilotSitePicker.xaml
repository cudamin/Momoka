<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Momoka.Shell.Views.MoviePilotSitePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momoka.Shell.ViewModels">
    <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="搜索站点" Style="{StaticResource EgCaptionStyle}" VerticalAlignment="Center" />
        <DropDownButton x:Name="ChooseSites" AutomationProperties.Name="选择搜索站点" MaxWidth="180">
            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            <DropDownButton.Flyout>
                <Flyout x:Name="SitesFlyout" Opening="OnOpening">
                    <StackPanel Width="260" Spacing="10">
                        <CheckBox x:Name="UseDefaultSites" Content="使用 MoviePilot 默认站点"
                            IsChecked="{x:Bind ViewModel.UseDefault, Mode=TwoWay}" />
                        <TextBlock Text="取消勾选后可指定站点，支持多选。" Style="{StaticResource EgCaptionStyle}"
                            Foreground="{ThemeResource EgTextDimBrush}" TextWrapping="Wrap" />
                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
                        <InfoBar IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}" IsClosable="True"
                            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                            Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}" Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SiteChoices" ItemsSource="{x:Bind ViewModel.Sites, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanPick, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MoviePilotSearchSiteRow">
                                        <CheckBox x:Name="SelectSite" IsChecked="{x:Bind Selected, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Name}" Tag="{x:Bind}">
                                            <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" MaxWidth="210" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="没有可供搜索的已启用站点" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SelectAllSites" Content="全选" Command="{x:Bind ViewModel.SelectAllCommand}" />
                            <Button x:Name="ClearSelectedSites" Content="清空" Command="{x:Bind ViewModel.ClearSelectionCommand}" />
                            <Button x:Name="ReloadSites" Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Flyout>
            </DropDownButton.Flyout>
        </DropDownButton>
    </StackPanel>
</UserControl>
