<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Momoka.Shell.Views.MoviePilotSitePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock x:Name="SiteLabel" Text="搜索站点" Style="{StaticResource EgCaptionStyle}" VerticalAlignment="Center" />
        <!-- 搜索框内仍是无底色的原生按钮；选择界面由独立网格对话框承载。 -->
        <Button x:Name="ChooseSites" AutomationProperties.Name="选择搜索站点" ToolTipService.ToolTip="选择搜索站点"
            Background="Transparent" BorderThickness="0" CornerRadius="{StaticResource EgSearchCornerRadius}" Padding="6,0,4,0" MinHeight="30" MaxWidth="180"
            Click="OnChooseSites">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}"
                    TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="{StaticResource EgCaptionFontSize}" />
            </Grid>
        </Button>
    </StackPanel>
</UserControl>
