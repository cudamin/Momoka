<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Momoka.Shell.Views.MoviePilotResourceFacetPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momoka.Shell.ViewModels">
    <DropDownButton x:Name="OpenFacet" CornerRadius="16" Padding="10,4" MinHeight="30"
        Background="{ThemeResource EgAccentSoftBrush}" Foreground="{ThemeResource EgAccentBrush}"
        BorderThickness="0" AutomationProperties.Name="{x:Bind Facet.Summary, Mode=OneWay}"
        Visibility="{x:Bind Facet.Visibility, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon FontSize="{StaticResource EgCaptionFontSize}" Glyph="{x:Bind Facet.Glyph, Mode=OneWay}" />
            <TextBlock Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}"
                Text="{x:Bind Facet.Summary, Mode=OneWay}" />
        </StackPanel>
        <DropDownButton.Flyout>
            <Flyout x:Name="ChoicesFlyout">
                <StackPanel Width="236" Spacing="8">
                    <TextBlock Style="{StaticResource EgSubheadStyle}" Text="{x:Bind Facet.Label, Mode=OneWay}" />
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FacetChoices" ItemsSource="{x:Bind Facet.Choices, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MoviePilotResourceChoice">
                                    <CheckBox x:Name="SelectChoice" IsChecked="{x:Bind Selected, Mode=TwoWay}"
                                        AutomationProperties.Name="{x:Bind Label}">
                                        <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" MaxWidth="196" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Flyout>
        </DropDownButton.Flyout>
    </DropDownButton>
</UserControl>
