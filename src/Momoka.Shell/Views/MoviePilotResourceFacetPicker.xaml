<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Momoka.Shell.Views.MoviePilotResourceFacetPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momoka.Shell.Views"
    xmlns:vm="using:Momoka.Shell.ViewModels">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MoviePilotResourceFilterStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="ResourceFilterOptionTemplate" x:DataType="vm:MoviePilotResourceChoice">
                <ToggleButton x:Name="SelectChoice" Style="{StaticResource ResourceFilterOptionStyle}"
                    IsChecked="{x:Bind Selected, Mode=TwoWay}" AutomationProperties.Name="{x:Bind FilterLabel}">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource EgCaptionFontSize}"
                            Visibility="{x:Bind CheckVisibility, Mode=OneWay}" />
                        <!-- 字色继承原生 ContentPresenter，选中态不被固定字色盖住。 -->
                        <TextBlock Grid.Column="1" Text="{x:Bind Label}" TextWrapping="Wrap" />
                    </Grid>
                </ToggleButton>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <DropDownButton x:Name="OpenFacet" CornerRadius="{StaticResource EgSearchCornerRadius}" Padding="10,4" MinHeight="30"
        Background="{ThemeResource EgAccentSoftBrush}" Foreground="{ThemeResource EgAccentBrush}"
        BorderThickness="0" AutomationProperties.Name="{x:Bind Facet.Summary, Mode=OneWay}"
        Visibility="{x:Bind Facet.Visibility, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon FontSize="{StaticResource EgCaptionFontSize}" Glyph="{x:Bind Facet.Glyph, Mode=OneWay}" />
            <TextBlock Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}"
                Text="{x:Bind Facet.Summary, Mode=OneWay}" />
        </StackPanel>
        <DropDownButton.Flyout>
            <Flyout x:Name="ChoicesFlyout">
                <StackPanel Width="280" MaxWidth="280" Spacing="12">
                    <TextBlock Style="{StaticResource EgSubheadStyle}" Text="{x:Bind Facet.Label, Mode=OneWay}" />
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled" Padding="4">
                        <ItemsControl x:Name="FacetChoices" ItemsSource="{x:Bind Facet.Choices, Mode=OneWay}"
                            ItemTemplate="{StaticResource ResourceFilterOptionTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><local:WrapRow Spacing="8" RowSpacing="8" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Flyout>
        </DropDownButton.Flyout>
    </DropDownButton>
</UserControl>
