<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Momoka.Shell.Views.FnNasPasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource EgWindowBrush}">
    <Page.Resources>
        <Style x:Key="FnNasCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource EgSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
            <Setter Property="BorderThickness" Value="{StaticResource EgCardBorderThickness}" />
            <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </Page.Resources>
    <Grid x:Name="PageLayout" RowSpacing="12" Padding="0,0,4,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=OneWay}" IsClosable="False"
                Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}" Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
            <InfoBar x:Name="FnNasPasswordUnsavedNotice" IsClosable="False" Severity="Warning"
                IsOpen="{x:Bind ViewModel.HasUnsavedChanges, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.UnsavedVisibility, Mode=OneWay}" Title="本地设置尚未保存"
                Message="当前内存设置尚未写入本地。重试只保存本地，不会再次修改服务器密码，也不会提交新输入的草稿。">
                <InfoBar.ActionButton>
                    <Button x:Name="FnNasPasswordRetryLocalSave" Content="重试本地保存"
                        Command="{x:Bind ViewModel.RetrySaveLocalCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
        <ScrollView Grid.Row="1" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
            <StackPanel Spacing="16" Padding="0,0,0,20" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Text="修改密码" Style="{StaticResource EgSectionTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="修改当前飞牛影视账号的登录密码。保存成功后，Momoka 会改用新密码保持登录。"
                    Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                <Border Style="{StaticResource FnNasCard}">
                    <StackPanel Spacing="16">
                        <PasswordBox x:Name="FnNasPasswordNew" Header="新密码" MaxLength="127" PasswordRevealMode="Peek"
                            Password="{x:Bind ViewModel.NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <PasswordBox x:Name="FnNasPasswordConfirm" Header="确认密码" MaxLength="127" PasswordRevealMode="Peek"
                            Password="{x:Bind ViewModel.ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="密码长度为 6～127 个字符。" Style="{StaticResource EgCaptionStyle}" />
                        <Button x:Name="FnNasPasswordSave" Content="保存修改" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SaveCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
