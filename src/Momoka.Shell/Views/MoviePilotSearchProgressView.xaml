<UserControl
    x:Class="Momoka.Shell.Views.MoviePilotSearchProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momoka.Shell.Views">
    <Border x:Name="ProgressCard" Padding="16,14" CornerRadius="12"
        Background="{ThemeResource EgSurfaceAltBrush}"
        Visibility="{x:Bind ViewModel.Visibility, Mode=OneWay}">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid Width="48" Height="48" VerticalAlignment="Center">
                    <ProgressRing x:Name="SearchRing" Width="48" Height="48"
                        Foreground="{ThemeResource EgAccentBrush}" Background="{ThemeResource EgAccentSoftBrush}"
                        IsActive="{x:Bind ViewModel.IsActive, Mode=OneWay}"
                        IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                        Value="{x:Bind ViewModel.Value, Mode=OneWay}" />
                    <FontIcon Glyph="&#xE721;" FontSize="{StaticResource EgSubheadFontSize}" Foreground="{ThemeResource EgAccentBrush}" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressStatus" Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                        Style="{StaticResource EgBodyStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <local:WrapRow Spacing="6" RowSpacing="4">
                        <Border Padding="8,3" CornerRadius="10" Background="{ThemeResource EgAccentSoftBrush}"
                            HorizontalAlignment="Left" MaxWidth="600">
                            <TextBlock Text="{x:Bind ViewModel.TitleText, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}"
                                Foreground="{ThemeResource EgAccentBrush}" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Border Padding="8,3" CornerRadius="10" Background="{ThemeResource EgAccentSoftBrush}"
                            HorizontalAlignment="Left" Visibility="{x:Bind ViewModel.YearVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.YearText, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}"
                                Foreground="{ThemeResource EgAccentBrush}" />
                        </Border>
                    </local:WrapRow>
                </StackPanel>
                <TextBlock x:Name="ProgressPercent" Grid.Column="2" VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.PercentText, Mode=OneWay}" Style="{StaticResource EgBodyStyle}"
                    FontWeight="SemiBold" Foreground="{ThemeResource EgAccentBrush}" />
            </Grid>
            <ProgressBar x:Name="SearchBar" Grid.Row="1" Height="4"
                Foreground="{ThemeResource EgAccentBrush}" Background="{ThemeResource EgAccentSoftBrush}"
                IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                Value="{x:Bind ViewModel.Value, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
