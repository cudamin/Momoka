<?xml version="1.0" encoding="utf-8"?>
<!--
  A library, a folder, a season, a person's credits, or a set of search results: all five are the same
  page with a different query behind it.

  What the WinForms grid could not do and this one gets for nothing: containers are virtualised and
  recycled, the columns reflow to whatever width the window has, and the page keeps scrolling instead
  of stopping at the first hundred items.

  There are no literal sizes left in here. The cell, the card and the bitmap the card was decoded for
  all come from LibraryViewModel, which is what the three numbers that used to be written out below —
  CardWidth 170, PosterHeight 255, MinItemWidth 170 — quietly prevented: moving the old 海报宽度 slider
  resized the home page and left this one, the page it is obviously about, untouched. That setting row
  was deleted 2026-09-05 and the width settled on CardSize's one default; the sizes still come from the
  view model rather than the markup, so there is exactly one place they live.

  Requirement 4's sort keys and requirement 5's filters are chosen in the two flyouts and decided in the
  view model; requirement 6 (已看/收藏/编辑) is the ContextRequested handler on the card template.
-->
<Page
    x:Class="Momoka.Shell.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:local="using:Momoka.Shell.Views"
    xmlns:tkcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Momoka.Shell.ViewModels"
    Background="{ThemeResource LayerFillColorDefaultBrush}">

    <Page.Resources>
        <Style x:Key="LibraryPillStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{ThemeResource EgSurfaceHoverBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="{StaticResource EgCaptionFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="LibraryTabStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="{StaticResource EgBodyFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RecentSearchButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <!-- ItemsView 的格子在指针下面会自己铺一层灰底（SubtleFillColorSecondary），按下去再深一档。
             这一套里「指针在这张卡上」是卡片外面那圈胶片格整圈变强调色说的（见 Theme/Styles.xaml 的
             EgFrameStyle），格子那层灰底叠上去就成了两句话说同一件事，而且它比卡片大一圈、圆角也不是同
             一档 —— 一面墙扫过去，跟着指针走的是一块灰影，不是那张卡。

             改成透明而不是去掉 ItemContainer：焦点框、键盘调用、回收都在它身上，只有这一层底不要。
             放在页级资源里，三个模板（海报、缩略图、列表）共用一份 —— 查这两个键是从格子往上走到这儿的。
             静止和边框那三个键默认就是透明的，不必重说。 -->
        <SolidColorBrush x:Key="ItemContainerPointerOverBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ItemContainerPressedBackground" Color="Transparent" />

        <!-- 一格筛选条。比头图上那几颗药丸小一档（那几颗是 EgActionHeight、会去按的主键），这一格是「一条
             正在生效的筛选」，读的时候是个标签，点的时候才是个键：所以高度只够一行字，圆角和别处「你会去按
             的东西」同一档，外圈一根发丝线交代它可点。 -->
        <Style x:Key="EgChipButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
            <Setter Property="Padding" Value="12,0,12,2" />
            <Setter Property="FontSize" Value="{StaticResource EgCaptionFontSize}" />
        </Style>

        <!-- 飞牛筛选面板上的一个可选值。官网页端是「全部」加一组文字，选中变强调色；
             这里用 ToggleButton 自带的选中态，不额外造一套画法。 -->
        <Style x:Key="FnNasFilterChoiceStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="{StaticResource EgCaptionFontSize}" />
        </Style>

        <DataTemplate x:Key="FnNasLayoutEntryTemplate" x:DataType="local:LayoutEntry">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE73E;" FontSize="{StaticResource EgCaptionFontSize}"
                    Visibility="{x:Bind CheckVisibility}" />
                <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- ============================================================ 推荐页那三排货架
             2026-10-17 用户令「复刻网页端的推荐页面，三个分区 继续观看、最新集、最近发布的剧集」。
             用的就是主页那三件（CardShelf / ShelfStrip / ShelfHead / PosterCard），所以卡片的形状、
             悬停那一层、翻页箭头和右键菜单与主页是同一份实现，不另写一套「像主页的」卡片。 -->

        <!-- 一排卡里的一张。Button 保留点击、键盘激活和焦点框；三态底色一律透明，卡片自己的悬停由
             PosterCard 画（与主页同一份写法）。 -->
        <DataTemplate x:Key="ShelfCardTemplate" x:DataType="local:CardItem">
            <Button
                Background="Transparent"
                BorderThickness="0"
                Click="OnShelfCardClicked"
                ContextRequested="OnCardContextRequested"
                Padding="0">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                </Button.Resources>
                <local:PosterCard
                    ActionRequested="OnCardActionRequested"
                    Card="{x:Bind}"
                    CardWidth="{x:Bind CardWidth, Mode=OneWay}"
                    PosterHeight="{x:Bind PosterHeight, Mode=OneWay}" />
            </Button>
        </DataTemplate>

        <!-- 那一排卡。高度绑 RowHeight（图 + 底下两行字），横向一条带子，翻页由两端的圆形键管。 -->
        <DataTemplate x:Key="ShelfStripTemplate" x:DataType="vm:CardShelf">
            <local:ShelfStrip
                Height="{x:Bind RowHeight}"
                ItemSpacing="18"
                ItemTemplate="{StaticResource ShelfCardTemplate}"
                ItemsSource="{x:Bind Cards}" />
        </DataTemplate>

        <!-- 一整排：牌子（标题 + 底下那条线）接一条带子。牌子在这里是**死的** —— 网页端这三行标题不可点，
             这一页也没有「更多」可去（三排各自已经是整份清单）。所以 Offer 不绑、Tag 不挂、Note 不绑
             （「20 项」那个胶囊在这一页没有意义，网页端也没有）。 -->
        <DataTemplate x:Key="ShelfRowTemplate" x:DataType="vm:CardShelf">
            <StackPanel Spacing="{StaticResource EgSpaceM}">
                <local:ShelfHead Title="{x:Bind Title, Mode=OneWay}" />
                <ContentPresenter
                    Content="{x:Bind}"
                    ContentTemplate="{StaticResource ShelfStripTemplate}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PosterTemplate" x:DataType="local:CardItem">
            <!-- ItemContainer, not a Button in a Border: it is the one element that gives an
                 ItemsView child its hover state, keyboard focus and invoke handling for free. -->
            <ItemContainer>
                <!-- The card carries its own drawn size, which is provably the width its bitmap was
                     decoded for; see CardSize. -->
                <local:PosterCard
                    ActionRequested="OnCardActionRequested"
                    Card="{x:Bind}"
                    CardWidth="{x:Bind CardWidth, Mode=OneWay}"
                    ContextRequested="OnCardContextRequested"
                    PosterHeight="{x:Bind PosterHeight, Mode=OneWay}" />
            </ItemContainer>
        </DataTemplate>

        <!-- 缩略图视图：16:9 宽卡。PosterCard 本身就支持宽幅（CardItem 的 wide 决定取剧照优先），
             这里只需要让卡片以自己的宽高绘制 —— 数据驱动，模板零分支。 -->
        <DataTemplate x:Key="ThumbTemplate" x:DataType="local:CardItem">
            <ItemContainer>
                <local:PosterCard
                    ActionRequested="OnCardActionRequested"
                    Card="{x:Bind}"
                    CardWidth="{x:Bind CardWidth, Mode=OneWay}"
                    ContextRequested="OnCardContextRequested"
                    PosterHeight="{x:Bind PosterHeight, Mode=OneWay}" />
            </ItemContainer>
        </DataTemplate>

        <DataTemplate x:Key="FavoriteRowTemplate" x:DataType="vm:FavoriteRow">
            <StackPanel Spacing="8" Visibility="{x:Bind GroupVisibility, Mode=OneWay}">
                <TextBlock Text="{x:Bind Title}" Style="{StaticResource EgSectionTitleStyle}"
                    AutomationProperties.HeadingLevel="Level2" />
                <ItemsRepeater x:Name="FavoriteCards" ItemsSource="{x:Bind Cards}" ItemTemplate="{StaticResource ShelfCardTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsJustification="Start" ItemsStretch="None"
                            MinItemWidth="{x:Bind CardWidth, Mode=OneWay}" MinItemHeight="{x:Bind RowHeight, Mode=OneWay}"
                            MinColumnSpacing="18" MinRowSpacing="24" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" TextWrapping="Wrap"
                    Style="{StaticResource EgBodyStyle}" Foreground="{ThemeResource EgTextDimBrush}"
                    Visibility="{x:Bind StatusVisibility, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="FavoriteRetry" Content="重新加载" Tag="{x:Bind}" Click="OnFavoriteMoreClicked"
                    HorizontalAlignment="Left" Visibility="{x:Bind RetryVisibility, Mode=OneWay}" />
                <Button x:Name="FavoriteMore" Content="加载更多" Tag="{x:Bind}" Click="OnFavoriteMoreClicked"
                    HorizontalAlignment="Left" Visibility="{x:Bind MoreVisibility, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="UpcomingDayTemplate" x:DataType="vm:UpcomingDay">
            <StackPanel Spacing="{StaticResource EgSpaceS}">
                <TextBlock Style="{StaticResource EgSectionTitleStyle}" Text="{x:Bind Title}"
                    AutomationProperties.HeadingLevel="Level2" />
                <ItemsRepeater ItemsSource="{x:Bind Cards}" ItemTemplate="{StaticResource ShelfCardTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsJustification="Start" ItemsStretch="None"
                            MinItemWidth="{x:Bind CardWidth}" MinItemHeight="{x:Bind RowHeight}"
                            MinColumnSpacing="18" MinRowSpacing="24" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </DataTemplate>

        <!-- 列表视图：EpisodeRow —— 详情页单集列表的同一个行控件，列表视图就是那个样子：左小图
             右标题/信息行/简介。ItemContainer 提供悬浮/焦点/调用；右键菜单和另外两个模板一样挂在
             行上 —— 行的悬浮层只有一个播放键，已观看/收藏/更多都在这个菜单里。 -->
        <DataTemplate x:Key="ListTemplate" x:DataType="local:CardItem">
            <ItemContainer>
                <local:EpisodeRow
                    ActionRequested="OnCardActionRequested"
                    Card="{x:Bind}"
                    ContextRequested="OnCardContextRequested" />
            </ItemContainer>
        </DataTemplate>

        <!-- 列表视图自己的布局：一行占满页宽，所以是 StackLayout，不是下面那个网格。UniformGridLayout
             只会按 MinItemWidth 铺格子，一页铺四格 —— 而这一行是「左边图、右边字」，格子那么窄，图被
             裁掉一截，标题、信息行、简介整段被挤到格子外面，列表看上去就是一堆没有字的小图。行高不用
             算：图有自己的高，字排完就是行的高。 -->
        <StackLayout x:Key="ListLayout" Spacing="12" />
        <!-- 表格视图：一行占满页宽，行与行之间只隔一条发丝线那么一点，读起来才是一张表。 -->
        <StackLayout x:Key="TableLayout" Spacing="2" />
        <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource EgCaptionStyle}">
            <Setter Property="Foreground" Value="{ThemeResource EgTextDimBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- 表格的一行：每一格由 CardItem 算好（文字 + 列宽），这里只负责摆出来。列头在
             LibraryPage.BuildTableHeader 里用同一份宽度生成，两处不会各算一套。 -->
        <DataTemplate x:Key="TableRowTemplate" x:DataType="local:CardItem">
            <ItemContainer>
                <Grid Padding="12,0" MinHeight="44" BorderBrush="{ThemeResource EgBorderBrush}" BorderThickness="0,0,0,1">
                    <ItemsControl ItemsSource="{x:Bind Cells}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:CardCell">
                                <TextBlock
                                    Width="{x:Bind Width}"
                                    Padding="0,0,12,0"
                                    Style="{StaticResource EgBodyStyle}"
                                    Text="{x:Bind Text}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ItemContainer>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="PageRoot" Margin="{StaticResource EgPageMargin}" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 搜索区独立占据整行的中心；两侧放不下时，标题和工具栏一起落到下一行。 -->
            <Grid x:Name="HeaderLayout" ColumnSpacing="24" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="LibrarySectionsSurface" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource EgSurfaceHoverBrush}" CornerRadius="18" Padding="3"
                    Visibility="{x:Bind ViewModel.SectionVisibility, Mode=OneWay}">
                    <local:WrapRow x:Name="LibrarySections" Spacing="0" RowSpacing="4" CenterRows="True" />
                </Border>
                <HyperlinkButton x:Name="LibraryBrowseGroup" Grid.Row="3" Grid.ColumnSpan="2"
                    HorizontalAlignment="Center" Content="{x:Bind ViewModel.BrowseGroupLabel, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.BrowseGroupVisibility, Mode=OneWay}"
                    ToolTipService.ToolTip="返回分类列表" Click="OnBrowseGroupBack" />
                <TextBlock x:Name="LibraryTitle" Text="{x:Bind local:LibraryPage.HeaderTitle(ViewModel.SearchVisibility, ViewModel.Heading), Mode=OneWay}" Style="{StaticResource EgPageTitleStyle}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind ViewModel.Heading, Mode=OneWay}" />

                <Border x:Name="SearchSurface" Grid.ColumnSpan="2" Padding="10,8" CornerRadius="14"
                    Background="{ThemeResource EgSurfaceBrush}" BorderBrush="{ThemeResource EgBorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.SearchVisibility, Mode=OneWay}">
                    <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                    <Grid x:Name="SearchForm" ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <AutoSuggestBox
                            x:Name="SearchInput"
                            Grid.ColumnSpan="2"
                            x:Uid="LibrarySearchBox"
                            HorizontalAlignment="Stretch"
                            CornerRadius="12"
                            VerticalAlignment="Center"
                            QueryIcon="Find"
                            QuerySubmitted="OnSearchSubmitted"
                            TextChanged="OnSearchTextChanged"
                            Text="{x:Bind ViewModel.SearchText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.SearchVisibility, Mode=OneWay}" />

                        <!-- 结果来源：库里的 Emby，还是去 MoviePilot 找新片。见 LibraryPage.OnSourceChanged。 -->
                        <tkcontrols:Segmented
                            x:Name="SourceTabs"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            SelectedIndex="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.MoviePilotTabsVisibility, Mode=OneWay}">
                            <tkcontrols:SegmentedItem AutomationProperties.Name="媒体库搜索"><TextBlock Text="媒体库" TextWrapping="Wrap" TextAlignment="Center" /></tkcontrols:SegmentedItem>
                            <tkcontrols:SegmentedItem AutomationProperties.Name="MoviePilot 订阅搜索"><TextBlock Text="MoviePilot 订阅" TextWrapping="Wrap" TextAlignment="Center" /></tkcontrols:SegmentedItem>
                            <tkcontrols:SegmentedItem AutomationProperties.Name="MoviePilot 资源搜索"><TextBlock Text="MoviePilot 资源" TextWrapping="Wrap" TextAlignment="Center" /></tkcontrols:SegmentedItem>
                            <tkcontrols:SegmentedItem AutomationProperties.Name="AniBT 搜索"><TextBlock Text="AniBT" TextWrapping="Wrap" TextAlignment="Center" /></tkcontrols:SegmentedItem>
                        </tkcontrols:Segmented>
                    </Grid>
                </Border>

                <Grid x:Name="ToolbarSurface" Grid.ColumnSpan="2" Grid.Row="2" Padding="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.ToolbarVisibility, Mode=OneWay}">
                    <local:WrapRow
                        x:Name="Toolbar"
                        Spacing="8"
                        RowSpacing="8"
                        VerticalAlignment="Center">

                        <TextBlock x:Name="LibraryItemCount" Text="{x:Bind ViewModel.TotalLabel, Mode=OneWay}"
                            FontSize="{StaticResource EgCaptionFontSize}" FontWeight="SemiBold" Margin="0,0,2,0" VerticalAlignment="Center" />
                        <!-- 播放全部 / 随机播放：Emby 工具栏的 btnPlay / btnShuffle。命令在视图模型里，载入
                             中自己就是灰的，与排序/筛选的即时行为一致。 -->
                        <Button
                            x:Name="PlayAllButton"
                            MinHeight="32"
                            Style="{StaticResource LibraryPillStyle}"
                            Visibility="{x:Bind ViewModel.DirectPlayVisibility, Mode=OneWay}"
                x:Uid="LibraryPage_PlayAllButton"
                            Command="{x:Bind ViewModel.PlayAllCommand}"
                            HorizontalContentAlignment="Center"
                            MinWidth="0"
                            Padding="12,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE768;" />
                                <TextBlock Text="播放" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="PlayRandomButton"
                            MinHeight="32"
                            Style="{StaticResource LibraryPillStyle}"
                            Visibility="{x:Bind ViewModel.DirectPlayVisibility, Mode=OneWay}"
                x:Uid="LibraryPage_PlayRandomButton"
                            Command="{x:Bind ViewModel.PlayRandomCommand}"
                            HorizontalContentAlignment="Center"
                            MinWidth="0"
                            Padding="12,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE8B1;" />
                                <TextBlock Text="随机播放" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="SortButton" Style="{StaticResource LibraryPillStyle}"
                            Visibility="{x:Bind ViewModel.SortFilterVisibility, Mode=OneWay}"
                            ToolTipService.ToolTip="排序" AutomationProperties.Name="排序">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE8CB;" />
                                <TextBlock x:Name="SortText" Text="{x:Bind ViewModel.ToolbarSortLabel, Mode=OneWay}" />
                                <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.SortGlyph, Mode=OneWay}" />
                            </StackPanel>
                            <Button.Flyout>
                                <!-- 网页端那一列：按字段名排序、选中的那条带勾、右边一个方向箭头。
                                     用 ListView 而不是 MenuFlyout：MenuFlyoutItem 画不出「右端还有一个可点的
                                     箭头」这一格。 -->
                                <Flyout x:Name="SortMenu" Opening="OnSortMenuOpening" Placement="Bottom">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="4" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="MaxWidth" Value="280" />
                                            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <ListView
                                        x:Name="SortList"
                                        x:FieldModifier="internal"
                                        AutomationProperties.Name="排序方式"
                                        IsItemClickEnabled="True"
                                        ItemClick="OnSortItemClick"
                                        SelectionMode="None"
                                        Width="200">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="MinHeight" Value="32" />
                                                <Setter Property="Padding" Value="10,0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SortEntry">
                                                <Grid ColumnSpacing="8" MinWidth="168">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon
                                                        FontSize="{StaticResource EgCaptionFontSize}"
                                                        Glyph="&#xE73E;"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind CheckVisibility}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Style="{StaticResource EgBodyStyle}"
                                                        Text="{x:Bind Label}"
                                                        TextTrimming="CharacterEllipsis"
                                                        VerticalAlignment="Center" />
                                                    <Button
                                                        Grid.Column="2"
                                                        AutomationProperties.Name="{x:Bind ArrowName}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="OnSortDirectionClicked"
                                                        MinHeight="0"
                                                        MinWidth="0"
                                                        Padding="4"
                                                        Tag="{x:Bind Option}"
                                                        Visibility="{x:Bind ArrowVisibility}">
                                                        <FontIcon FontSize="{StaticResource EgCaptionFontSize}" Glyph="{x:Bind Glyph}" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <!-- 网页端的筛选：打开的是盖住整页的一块面板（网页端也是个模态框），不是浮层。
                             浮层是亚克力的，底下的卡片墙会从面板底下透上来 —— 设置面板当初就是因为这个改成
                             页内模态层的，这一块跟着它。 -->
                        <Button
                            x:Name="FilterButton"
                            Style="{StaticResource LibraryPillStyle}" Width="{x:Bind ViewModel.FilterButtonWidth, Mode=OneWay}" Padding="0"
                            AutomationProperties.Name="筛选"
                            MinHeight="32"
                            Visibility="{x:Bind ViewModel.FilterVisibility, Mode=OneWay}"
                            HorizontalContentAlignment="Center"
                            MinWidth="0"
                            Click="OnFilterClicked"
                            ToolTipService.ToolTip="{x:Bind ViewModel.FilterTooltip, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE71C;" />
                                <TextBlock x:Name="FilterText" Visibility="Collapsed"
                x:Uid="LibraryPage_FilterText" />
                                <TextBlock Text="筛选" VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.FnNasFilterTextVisibility, Mode=OneWay}" />
                                <!-- How many filters are on, without spending a row of the page saying so. -->
                                <InfoBadge
                                    Value="{x:Bind ViewModel.FilterCount, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.FilterBadgeVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <!-- 飞牛官网页端的「布局」：只有竖幅海报与横幅海报两项。Emby 那颗齿轮里的分组与
                             显示字段对飞牛的接口没有作用，所以飞牛收起齿轮、改摆这一颗。 -->
                        <Button x:Name="FnNasLayoutButton" Style="{StaticResource LibraryPillStyle}"
                            Visibility="{x:Bind ViewModel.LayoutVisibility, Mode=OneWay}"
                            ToolTipService.ToolTip="布局" AutomationProperties.Name="布局">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="{StaticResource EgCaptionFontSize}" Glyph="&#xE8A9;" />
                                <TextBlock Text="布局" />
                                <FontIcon FontSize="{StaticResource EgCaptionFontSize}" Glyph="&#xE70D;" />
                            </StackPanel>
                            <Button.Flyout>
                                <!-- 与排序菜单同一种浮层：MenuFlyout 在这颗键上会算错锚点、翻到工具栏上面去。 -->
                                <Flyout x:Name="FnNasLayoutMenu" Placement="Bottom" Opening="OnFnNasLayoutMenuOpening">
                                    <ListView x:Name="FnNasLayoutList" Width="180" SelectionMode="None"
                                        IsItemClickEnabled="True" ItemClick="OnFnNasLayoutItemClick"
                                        ItemTemplate="{StaticResource FnNasLayoutEntryTemplate}">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="MinHeight" Value="36" />
                                                <Setter Property="Padding" Value="10,0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                    </ListView>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <!-- 网页端那颗齿轮：视图、图像大小、分组、显示字段。原来 ⋯ 里那个「视图」三选一的
                             子菜单由它接手 —— 那三档只是网页端七档里的三档，图像大小和显示字段也没有入口。
                             打开的是本页盖上来的一块面板（网页端也是个模态框），不是浮层：浮层是亚克力的，
                             卡片墙会从面板底下透上来。 -->
                        <Button x:Name="LibrarySettingsButton" Style="{StaticResource LibraryPillStyle}"
                            Width="32" Padding="0" ToolTipService.ToolTip="设置" AutomationProperties.Name="设置"
                            Click="OnSettingsClicked"
                            Visibility="{x:Bind ViewModel.SettingsVisibility, Mode=OneWay}">
                            <FontIcon FontSize="{StaticResource EgBodyFontSize}" Glyph="&#xE712;" />
                        </Button>
                    </local:WrapRow>
                </Grid>

            </Grid>

            <!-- 生效中的筛选，一条一格，点一格去掉一条 —— 在这之前「筛的是什么」只有那颗按钮上的一个数字，
                 而这个选择是跨会话记住的：屏上写着「筛选 1」，人却容易以为库里少了东西。

                 飞牛不铺这一行：它的筛选面板在工具栏下面展开，选中的值就在面板里亮着，收起后按钮上的数字
                 仍然在（用户 2026-10-19 令「点击选项后不要在界面添加标签」）。这一行只给 Emby。

                 摆在搜索框底下、卡片上头，而不是挂在那颗按钮旁边：它是「这一屏为什么是这些」的交代，跟标题
                 和总数是一伙的；而且筛得多的时候它要能折行，挂在工具栏里就得跟排序、视图那几颗键抢宽度。
                 整行没有筛选时收起（FilterChipsVisibility），一个像素都不占。 -->
            <local:WrapRow
                x:Name="LibraryFilterChips"
                Grid.Row="1"
                RowSpacing="8"
                Spacing="8"
                Visibility="{x:Bind ViewModel.FilterChipsVisibility, Mode=OneWay}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.FilterChips, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:WrapRow RowSpacing="8" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilterChipRow">
                            <!-- 一格就是一颗按钮：整格可点，点掉这一条。字后面跟一个 ✕ 而不是把 ✕ 做成第二颗
                                 按钮 —— 一格里两个可点的东西，键盘走一遍就是两站，而它们做的是同一件事。 -->
                            <Button
                                automation:AutomationProperties.Name="{x:Bind AutomationName}"
                                Command="{x:Bind DropCommand}"
                                Style="{StaticResource EgChipButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind AutomationName}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" />
                                    <FontIcon
                                        FontSize="10"
                                        Glyph="&#xE711;"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 末尾那颗：一次清空。做成链接样子而不是又一颗药丸 —— 它不是一条筛选，不该和它们一样重。 -->
                <HyperlinkButton x:Uid="LibraryPage_HyperlinkButton4"
                    AutomationProperties.AutomationId="LibraryClearFiltersButton"
                    Command="{x:Bind ViewModel.ClearFiltersCommand}"
                    Padding="4,2,4,2"
                    VerticalAlignment="Center" />
            </local:WrapRow>

            <!-- 飞牛筛选：官网页端展开在工具栏下面的那一条，不是 Emby 那种盖住整页的浮层。
                 行和值都来自 /tag/list，题材、地区再经官方映射表换成中文。 -->
            <Border Grid.Row="2" Margin="0,0,0,4" Padding="16,12"
                Background="{ThemeResource EgSurfaceBrush}"
                BorderBrush="{ThemeResource EgBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{x:Bind ViewModel.FnNasFilterVisibility, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="筛选" Style="{StaticResource EgSubheadStyle}" VerticalAlignment="Center" />
                        <HyperlinkButton x:Name="FnNasFilterCollapse" Content="收起" HorizontalAlignment="Right" Click="OnFnNasFilterCloseClicked"
                            Padding="4,2,4,2" VerticalAlignment="Center" />
                    </Grid>
                    <ProgressBar IsIndeterminate="True"
                        Visibility="{x:Bind ViewModel.FnNasFilterLoadingVisibility, Mode=OneWay}" />
                    <ItemsControl x:Name="FnNasFilterRowsList" ItemsSource="{x:Bind ViewModel.FnNasFilterRows, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FnNasFilterRow">
                                <Grid ColumnSpacing="12" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource EgBodyStyle}"
                                        Foreground="{ThemeResource EgTextDimBrush}" VerticalAlignment="Center" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Choices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <local:WrapRow Spacing="4" RowSpacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FnNasFilterChoice">
                                                <ToggleButton Content="{x:Bind Label}"
                                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                    Style="{StaticResource FnNasFilterChoiceStyle}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <HyperlinkButton x:Name="FnNasFilterClear" Content="清除筛选" HorizontalAlignment="Left"
                        Command="{x:Bind ViewModel.ClearFiltersCommand}" Padding="4,2,4,2" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Indeterminate and one row of its own: a ring in the middle of the page would move the
             grid when it appeared, and the grid is already showing whatever arrived first. -->
        <ProgressBar
            x:Name="LibraryBusyBar"
            Grid.Row="1"
            Height="2"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.LibraryBusyVisibility, Mode=OneWay}" />

        <!-- TwoWay on IsOpen, so dismissing the bar is recorded rather than only drawn: the next
             failure has to be able to reopen it. -->
        <InfoBar
            x:Name="LibraryNoticeBar"
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" />

        <!-- Emby 结果区整块（网格 + 字母条 + 空态）包进 EmbyContent，好被「MoviePilot」分段一处切走
             （见 OnSourceChanged）。 -->
        <Grid x:Name="EmbyContent" Grid.Row="2">
            <!-- Grid so the letter bar can sit over the scroller's right edge without taking a column
                 away from it（Emby 的 alphaPicker 是 position:fixed 的覆盖层，不是布局成员）。 -->
            <Grid RowSpacing="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <SelectorBar x:Name="SearchCategories" HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.SearchCategoriesVisibility, Mode=OneWay}">
                    <SelectorBarItem x:Name="TopResultsCategory" Text="热门结果" IsSelected="True" Tag="TopResults" />
                    <SelectorBarItem x:Name="SeriesCategory" Text="节目" Tag="Series" />
                    <SelectorBarItem x:Name="MoviesCategory" Text="影片" Tag="Movies" />
                    <SelectorBarItem x:Name="EpisodesCategory" Text="集" Tag="Episodes" />
                </SelectorBar>
            <!-- 表格视图要能横向滚：勾满字段时一行比页面宽，从前是从右边裁掉。列头与每一行必须在同一个
                 滚动面里 —— 各滚各的，滚了行、列头就留在原处。其余视图这个滚动器不滚（横向滚动关掉、
                 画布宽度跟着页面走），卡片墙的排布与从前一模一样。 -->
            <ScrollViewer
                x:Name="TableScroll"
                x:FieldModifier="internal"
                Grid.Row="1"
                Grid.RowSpan="2"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                Visibility="{x:Bind ViewModel.GridVisibility, Mode=OneWay}">
                <Grid x:Name="TableCanvas" x:FieldModifier="internal">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 表格视图的列头。列在代码里按勾上的字段生成（见 LibraryPage.BuildTableHeader），
                         与每一行用同一套宽度 —— 两处各写一遍宽度，第一列就会歪。 -->
                    <Grid x:Name="TableHeader" x:FieldModifier="internal" Grid.Row="0" Padding="12,0" Margin="0,0,0,16" Visibility="Collapsed" />
                    <!-- 这张网格叫 CardWall 而不是 Cards：页面上有一个 x:Name 与某张 DataTemplate 里
                         x:Bind 的路径同名（货架那一排绑的是 CardShelf.Cards），XAML 编译器会以一个
                         说不出所以然的 WMC9999（连错误资源都找不到）整份失败。2026-10-17 加推荐页三排时
                         撞上这一格，逐块二分才落到这里。改名比留一个查不出来的编译器坑便宜。 -->
                    <ItemsView
                        x:Name="CardWall"
                        Grid.Row="1"
                        Visibility="{x:Bind ViewModel.SearchResultsVisibility, Mode=OneWay}"
                        IsItemInvokedEnabled="True"
                        ItemInvoked="OnItemInvoked"
                        ItemTemplate="{StaticResource PosterTemplate}"
                        ItemTransitionProvider="{x:Null}"
                        ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}"
                        SelectionMode="None">
                        <ItemsView.Layout>
                            <!-- ItemsStretch="Fill" is what makes the grid reflow instead of leaving a ragged
                                 right margin, and it is the reason resizing looks settled (requirement 1).

                                 The cell size follows CardSize's poster width and the current view shape; the
                                 height is the picture plus the two lines of text under it, worked out in the
                                 view model rather than typed in here.

                                 行距比列距大：卡片底下那两行字是它自己的（离画面 8 像素），一行一行之间要是和一列
                                 一列之间一样宽，那两行字就悬在两张画面中间，读起来像是下一排卡片的标题。24 对 16
                                 把每张画面和它自己的字归成一组，一面墙也就读成一行一行，而不是一片方块。 -->
                            <UniformGridLayout
                                x:Name="CardLayout"
                                ItemsStretch="Fill"
                                MinColumnSpacing="16"
                                MinItemHeight="{x:Bind ViewModel.RowHeight, Mode=OneWay}"
                                MinItemWidth="{x:Bind ViewModel.CardMinWidth, Mode=OneWay}"
                                MinRowSpacing="24" />
                        </ItemsView.Layout>
                    </ItemsView>
                </Grid>
            </ScrollViewer>

            <!-- 推荐页那三排。占的是网格那一格（同一行、同样跨到字母条那一行），两者互斥：
                 网格在的时候这块整个收起，反过来也一样（见 LibraryViewModel.GridVisibility）。
                 整页一个竖向滚动器 —— 三排各自横向翻页，竖着滚的是这一页。 -->
            <ScrollViewer
                x:Name="RecommendedScroll"
                x:FieldModifier="internal"
                Grid.Row="1"
                Grid.RowSpan="2"
                Padding="0,0,0,32"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto"
                Visibility="{x:Bind ViewModel.RecommendedVisibility, Mode=OneWay}">
                <ItemsRepeater
                    x:Name="RecommendedRows"
                    x:FieldModifier="internal"
                    ItemTemplate="{StaticResource ShelfRowTemplate}"
                    ItemsSource="{x:Bind ViewModel.RecommendedShelves, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <!-- 排与排之间 32：比一排自己标题到卡片的 12 宽得多，读起来才是三件事。 -->
                        <StackLayout Orientation="Vertical" Spacing="32" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>

            <ScrollViewer x:Name="FavoritesScroll" x:FieldModifier="internal"
                Grid.Row="1" Grid.RowSpan="2" Padding="0,0,0,32"
                HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                Visibility="{x:Bind ViewModel.FavoritesVisibility, Mode=OneWay}">
                <ItemsRepeater x:Name="FavoritesGroups" x:FieldModifier="internal"
                    ItemsSource="{x:Bind ViewModel.VisibleFavoriteRows, Mode=OneWay}" ItemTemplate="{StaticResource FavoriteRowTemplate}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="40" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>

            <ScrollViewer x:Name="UpcomingScroll" x:FieldModifier="internal"
                Grid.Row="1" Grid.RowSpan="2" Padding="0,0,0,32"
                HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                Visibility="{x:Bind ViewModel.UpcomingVisibility, Mode=OneWay}">
                <ItemsRepeater x:Name="UpcomingGroups" x:FieldModifier="internal"
                    ItemTemplate="{StaticResource UpcomingDayTemplate}"
                    ItemsSource="{x:Bind ViewModel.UpcomingDays, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="40" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- 字母跳转条：只在按名称排序且有足够条目时出现（对应 Emby 的 enableAlphaPicker +
                 总数 > 30）。点击跳到该字母第一项；当前字母高亮随滚动更新。 -->
            <local:AlphaBar
                x:Name="Alpha"
                Grid.Row="2"
                JumpRequested="OnAlphaJump"
                Visibility="{x:Bind ViewModel.AlphaVisibility, Mode=OneWay}" />
        </Grid>

        <StackPanel x:Name="UpcomingLoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
            Spacing="{StaticResource EgSpaceL}" Visibility="{x:Bind ViewModel.UpcomingLoadingVisibility, Mode=OneWay}">
            <ProgressRing x:Name="UpcomingLoadingRing" x:FieldModifier="internal" Width="44" Height="44"
                IsActive="{x:Bind ViewModel.UpcomingLoading, Mode=OneWay}" IsIndeterminate="True"
                Foreground="{ThemeResource EgAccentBrush}" AutomationProperties.Name="正在加载电视节目预告" />
            <TextBlock Text="正在加载预告…" Style="{StaticResource EgBodyStyle}"
                Foreground="{ThemeResource EgTextDimBrush}" TextAlignment="Center"
                AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <Button x:Name="UpcomingRetryButton" Content="重新加载" HorizontalAlignment="Center" VerticalAlignment="Center"
            Click="OnUpcomingRetryClicked" Visibility="{x:Bind ViewModel.UpcomingErrorVisibility, Mode=OneWay}" />

        <StackPanel
            HorizontalAlignment="Center"
            Margin="24,72,24,0"
            Spacing="20"
            VerticalAlignment="Top"
            Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
            <Border Width="72" Height="72" CornerRadius="24" Background="{ThemeResource EgSurfaceAltBrush}">
                <FontIcon Glyph="&#xE721;" FontSize="28" Foreground="{ThemeResource EgAccentBrush}" />
            </Border>
            <TextBlock Style="{StaticResource EgBodyStyle}" Foreground="{ThemeResource EgTextDimBrush}" Text="{x:Bind ViewModel.EmptyNotice, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
            <Grid x:Name="RecentSearchSection" MaxWidth="900" RowSpacing="12" HorizontalAlignment="Stretch"
                Visibility="{x:Bind ViewModel.RecentSearchVisibility, Mode=OneWay}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="最近搜索" Style="{StaticResource EgSectionTitleStyle}" VerticalAlignment="Center" />
                    <Button x:Name="ClearRecentSearches" Content="清除" HorizontalAlignment="Right"
                        Style="{StaticResource RecentSearchButtonStyle}" Command="{x:Bind ViewModel.ClearRecentSearchesCommand}"
                        Visibility="{x:Bind ViewModel.ClearRecentVisibility, Mode=OneWay}" />
                </Grid>
                <ListView x:Name="RecentSearchList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.RecentSearches, Mode=OneWay}"
                    SelectionMode="None" HorizontalContentAlignment="Stretch">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecentSearchRow">
                            <Grid ColumnSpacing="12" Padding="0,8" BorderBrush="{ThemeResource EgBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button x:Name="OpenRecentSearch" Command="{x:Bind OpenCommand}" Style="{StaticResource RecentSearchButtonStyle}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Bind Title}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid Height="84" CornerRadius="{StaticResource EgPosterCornerRadius}" Background="{ThemeResource EgSurfaceAltBrush}">
                                            <FontIcon Glyph="&#xE8E5;" Foreground="{ThemeResource EgTextDimBrush}" />
                                            <Image Source="{x:Bind Card.Poster, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource EgBodyStyle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind TypeLabel}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextDimBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button x:Name="RemoveRecentSearch" Grid.Column="1" Command="{x:Bind RemoveCommand}" VerticalAlignment="Center"
                                    Style="{StaticResource RecentSearchButtonStyle}" AutomationProperties.Name="{x:Bind RemoveLabel}" ToolTipService.ToolTip="{x:Bind RemoveLabel}">
                                    <SymbolIcon Symbol="Cancel" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="1" Text="暂无最近搜索" Margin="0,20" Style="{StaticResource EgBodyStyle}"
                    Foreground="{ThemeResource EgTextDimBrush}" Visibility="{x:Bind ViewModel.NoRecentVisibility, Mode=OneWay}" />
            </Grid>
        </Grid>

        <!-- MoviePilot 那一段，和 EmbyContent 叠在同一格，按分段切显隐（默认藏着，见 OnSourceChanged）。 -->
        <local:MoviePilotSearchPanel
            x:Name="MoviePilotPanel"
            Grid.Row="2"
            Visibility="Collapsed" />
        <local:MoviePilotVersionsView x:Name="MoviePilotResources" Grid.Row="2" Visibility="Collapsed" />
        <local:AniBtSearchPanel x:Name="AniBtPanel" Grid.Row="2" Visibility="Collapsed" />

        <!-- 筛选面板盖在整页上。与设置面板同一套做法：铺满整层、点外面关掉、面板自己一颗 ✕。 -->
        <Grid
            x:Name="FilterOverlay"
            x:FieldModifier="internal"
            Grid.RowSpan="3"
            Visibility="Collapsed">
            <Button
                x:Name="FilterScrim"
                x:FieldModifier="internal"
                AutomationProperties.Name="关闭筛选"
                Background="{ThemeResource EgScrimBrush}"
                BorderThickness="0"
                Click="OnFilterScrimClicked"
                CornerRadius="0"
                HorizontalAlignment="Stretch"
                IsTabStop="False"
                Padding="0"
                VerticalAlignment="Stretch">
                <Button.Resources>
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="EgScrimBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="EgScrimBrush" />
                </Button.Resources>
            </Button>
            <local:FilterPanel
                x:Name="FilterPane"
                x:FieldModifier="internal"
                Changed="OnFilterChanged"
                CloseRequested="OnFilterCloseRequested"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>

        <!-- 设置面板盖在整页上（网页端那颗齿轮打开的就是一块模态框）。铺满三层，压住搜索、工具栏与网格。
             关掉有两条路：面板上那颗 ✕，或者点面板外面那片空位（铺满整层的遮罩按钮，三态同色，
             所以指针划过去它不会忽明忽暗）。 -->
        <Grid
            x:Name="SettingsOverlay"
            x:FieldModifier="internal"
            Grid.RowSpan="3"
            Visibility="Collapsed">
            <Button
                x:Name="SettingsScrim"
                x:FieldModifier="internal"
                AutomationProperties.Name="关闭设置"
                Background="{ThemeResource EgScrimBrush}"
                BorderThickness="0"
                Click="OnSettingsScrimClicked"
                CornerRadius="0"
                HorizontalAlignment="Stretch"
                IsTabStop="False"
                Padding="0"
                VerticalAlignment="Stretch">
                <Button.Resources>
                    <!-- 三态同一个色：遮罩不是一颗会被按下去的键，它是「面板外面」那片地方。 -->
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="EgScrimBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="EgScrimBrush" />
                </Button.Resources>
            </Button>
            <local:LibrarySettingsPanel
                x:Name="SettingsPane"
                x:FieldModifier="internal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Changed="OnDisplayChanged" />
        </Grid>
    </Grid>
</Page>
