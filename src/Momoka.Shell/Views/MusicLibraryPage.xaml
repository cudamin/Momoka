<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Momoka.Shell.Views.MusicLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momoka.Shell.Views"
    xmlns:vm="using:Momoka.Shell.ViewModels"
    Background="{ThemeResource EgMicaCommandBrush}">
    <Grid Padding="28,24,28,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource EgPageTitleStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind ViewModel.CountLabel, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Click="OnRefresh" Style="{StaticResource EgIconButtonStyle}"
                AutomationProperties.Name="刷新音乐" ToolTipService.ToolTip="刷新"><FontIcon Glyph="&#xE72C;" /></Button>
        </Grid>
        <AutoSuggestBox x:Name="MusicSearch" Grid.Row="1" MaxWidth="560" HorizontalAlignment="Stretch"
            Visibility="{x:Bind ViewModel.SearchVisibility, Mode=OneWay}"
            PlaceholderText="搜索歌曲、专辑、艺术家或歌单" QueryIcon="Find" QuerySubmitted="OnSearch"
            Text="{x:Bind ViewModel.Search, Mode=TwoWay}" />
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Enabled" Visibility="{x:Bind ViewModel.TabsVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <RadioButton x:Name="TracksTab" Content="歌曲" Tag="0" GroupName="MusicSection" IsChecked="True" Checked="OnSection" />
                <RadioButton x:Name="AlbumsTab" Content="专辑" Tag="1" GroupName="MusicSection" Checked="OnSection" />
                <RadioButton x:Name="ArtistsTab" Content="艺术家" Tag="2" GroupName="MusicSection" Checked="OnSection" />
                <RadioButton x:Name="PlaylistsTab" Content="歌单" Tag="3" GroupName="MusicSection" Checked="OnSection" />
                <RadioButton x:Name="FavoritesTab" Content="收藏" Tag="4" GroupName="MusicSection" Checked="OnSection" Visibility="{x:Bind ViewModel.FavoriteTabVisibility, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
        <InfoBar x:Name="Notice" Grid.Row="3" IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}" Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
        <Grid x:Name="MusicContent" Grid.Row="4" Background="{ThemeResource EgMicaContentBrush}" CornerRadius="{StaticResource OverlayCornerRadius}">
            <ListView x:Name="MusicRows" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" IsItemClickEnabled="True"
                SelectionMode="None" ItemClick="OnItemClick" ContainerContentChanging="OnContainerChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="8,6" /></Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:CardItem">
                        <Grid ColumnSpacing="14" MinHeight="56">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border CornerRadius="8" Background="{ThemeResource EgSurfaceBrush}">
                                <Grid><FontIcon Glyph="&#xE8D6;" Foreground="{ThemeResource EgTextDimBrush}" /><Image Source="{x:Bind Poster, Mode=OneWay}" Stretch="UniformToFill" /></Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource EgBodyStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind vm:MusicLibraryViewModel.Duration(Item), Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <Button x:Name="MoreButton" Content="加载更多" Click="OnMore" HorizontalAlignment="Center"
                        Visibility="{x:Bind local:MusicLibraryPage.Show(ViewModel.MoreAvailable), Mode=OneWay}" />
                </ListView.Footer>
            </ListView>
            <TextBlock Text="暂无音乐" Style="{StaticResource EgBodyStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />
            <ProgressRing x:Name="LoadingRing" IsActive="{x:Bind ViewModel.Busy, Mode=OneWay}" Width="32" Height="32"
                HorizontalAlignment="Center" VerticalAlignment="Top" />
        </Grid>
    </Grid>
</Page>
