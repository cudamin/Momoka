<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Momoka.Shell.Views.FnNasTasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Momoka.Shell.ViewModels"
    Background="{ThemeResource EgWindowBrush}">
    <Page.Resources>
        <Style x:Key="FnNasCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource EgSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <DataTemplate x:Key="FnNasChoiceTemplate" x:DataType="vm:FnNasChoice">
            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="FnNasPermissionTemplate" x:DataType="vm:FnNasChoice">
            <CheckBox x:Name="FnNasPermissionCheck" Content="{x:Bind Name}" IsChecked="{x:Bind Selected, Mode=TwoWay}" Margin="0,3" />
        </DataTemplate>
    </Page.Resources>
    <Grid x:Name="PageLayout" RowSpacing="12" Padding="0,0,4,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=OneWay}" IsClosable="False"
                Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}" Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
        </StackPanel>
        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
            <ScrollView x:Name="FnNasTasksScroll">
                <StackPanel Spacing="16" Padding="0,0,0,20">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="任务计划" Style="{StaticResource EgSectionTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
                        <Button x:Name="FnNasTasksRefresh" Grid.Column="1" Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
                    </Grid>
                    <Border Style="{StaticResource FnNasCard}">
                        <StackPanel Spacing="12">
                            <ToggleSwitch x:Name="FnNasTasksEnabled" Header="定时执行任务" IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}" />
                            <TextBlock Text="每天凌晨自动执行任务，以提升日常使用影视的体验。" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ItemsControl x:Name="FnNasTaskList" ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FnNasTaskRow">
                                <Border Style="{StaticResource FnNasCard}" Margin="0,0,0,12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource EgSubheadStyle}" />
                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource EgBodyStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Started}" Style="{StaticResource EgCaptionStyle}" />
                                        <TextBlock Text="{x:Bind Finished}" Style="{StaticResource EgCaptionStyle}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="FnNasTasksSave" Content="保存任务计划" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
                </StackPanel>
            </ScrollView>
        </Grid>
    </Grid>
</Page>
