<?xml version="1.0" encoding="utf-8"?>
<!--
  查看遗漏集。服务器按刮削源的元数据算出这部剧／这一季本该有、而库里没有的单集，一集一行：左边一张剧照，
  右边「S1:E1 - 集名」、播出日期和两行简介 —— 参考网页端那张表的样子。

  上面两颗开关管这一张表列哪几条：特别篇（第 0 季）和预告（首播日期还在未来的那些）。默认两颗都关，列的就是
  正片里已经播过的那几集；拨开才把那一类也带上。筛在本地做（ItemDetail.MissingShown），拨一下立刻出结果 ——
  实测这两个条件服务器那条接口一个都不认（见 EmbyClient.GetMissingEpisodesAsync 那段）。

  行上的 MP 入口用于搜索分集；动画、动漫同时提供 AniBT 来源，下载统一交给 MoviePilot。
-->
<ContentDialog x:Uid="MissingEpisodesDialog_ContentDialog1"
    x:Class="Momoka.Shell.Views.MissingEpisodesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Momoka.Shell.Views"
    Title="查看遗漏集"
    DefaultButton="Close"
    CloseButtonText="关闭">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">780</x:Double>
    </ContentDialog.Resources>

    <Grid RowSpacing="{StaticResource EgSpaceM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 抬头那一句在左，两颗开关在右：开关管的是这张表列哪几条，摆得离表近一点。 -->
        <Grid ColumnSpacing="{StaticResource EgSpaceL}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="Summary"
                VerticalAlignment="Center"
                Style="{StaticResource EgDataStyle}"
                TextWrapping="Wrap" />

            <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                Spacing="{StaticResource EgSpaceL}">
                <!-- 开关自己那两个字（开／关）留空：这两颗是筛选，状态看滑块位置就够，而参考图上也只有标签加一颗
                     开关。名字仍旧给全，读屏那一头念的是「特别篇／预告」。 -->
                <ToggleSwitch x:Name="SpecialsSwitch"
                    AutomationProperties.Name="特别篇"
                    Header="特别篇"
                    OffContent=""
                    OnContent=""
                    Toggled="OnToggled" />
                <ToggleSwitch x:Name="UnairedSwitch"
                    AutomationProperties.Name="预告"
                    Header="预告"
                    OffContent=""
                    OnContent=""
                    Toggled="OnToggled" />
            </StackPanel>
        </Grid>

        <ListView x:Name="List"
            Grid.Row="1"
            MaxHeight="440"
            IsItemClickEnabled="False"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="views:MissingEpisodeRow">
                    <Grid ColumnSpacing="{StaticResource EgSpaceM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 胶片格和单集行同一个样式键（发丝框、圆角、底色都在上面）。占位字形垫在图后，
                             这一列一行的图都是同一个剧的缩略图，取不到时那一格也不是一块空白。 -->
                        <Border Height="{x:Bind PosterHeight}"
                            Style="{StaticResource EgFrameStyle}"
                            Width="{x:Bind CardWidth}">
                            <Grid>
                                <FontIcon Glyph="&#xE7F4;" Style="{StaticResource EgArtworkEmptyGlyphStyle}" />
                                <Image Source="{x:Bind Poster, Mode=OneWay}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1"
                            Spacing="{StaticResource EgSpaceXS}"
                            VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource EgDataStrongStyle}"
                                Text="{x:Bind Label}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource EgDataStyle}"
                                Text="{x:Bind Info}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind InfoVisibility}" />
                            <TextBlock MaxLines="2"
                                Style="{StaticResource EgCaptionStyle}"
                                Text="{x:Bind Overview}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind OverviewVisibility}" />
                            <Button x:Name="SearchMissingMoviePilot" Content="MP" Tag="{x:Bind Episode}"
                                HorizontalAlignment="Left" Click="OnSearchMoviePilot"
                                AutomationProperties.Name="{x:Bind SearchName}" ToolTipService.ToolTip="使用 MoviePilot 搜索这一集"
                                Visibility="{x:Bind SearchVisibility}" />
                            <DropDownButton x:Name="SearchMissingSources" Content="MP" HorizontalAlignment="Left"
                                AutomationProperties.Name="{x:Bind SearchName}" Visibility="{x:Bind AnimeSearchVisibility}">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="MissingMoviePilot" Text="使用 MoviePilot" Tag="{x:Bind Episode}" Click="OnSearchMoviePilot" />
                                        <MenuFlyoutItem x:Name="MissingAniBt" Text="使用 AniBT API 搜索" Tag="{x:Bind Episode}" Click="OnSearchAniBt" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
