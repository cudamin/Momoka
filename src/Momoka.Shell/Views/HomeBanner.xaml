<?xml version="1.0" encoding="utf-8"?>
<!--
  主页通栏轮播：背景铺到窗口顶边和两侧，字幕和操作浮在图上，下沿渐变接回首页内容。
  BannerPictureLoader 在解码时读取原图左侧颜色，向左延长原图宽度的 15%；高斯只处理延长区，并在其中淡出，
  与原图合成同一张位图。**商店版式不用这一套**（2026-11-16 用户实屏「没必要加高斯模糊」）：那张原图站在
  圆角卡片里、由 UniformToFill 自己裁，扩边与过渡高斯都关掉（见 BannerSlide.SetLeftExtension）。
  两层 ImageBrush 保持 UniformToFill，整体等比例覆盖画框，切换和慢镜头一起运行。
  图片、延长区不会分开加载，也不使用镜像场景或固定黑色填充。原图每个像素及比例保持不变。
  轮播内容先取继续观看，不够再取最近添加；带高按版式走 HomeCarousel.BandHeight（整宽版式照旧，商店版式另两档）。
-->
<UserControl
    x:Class="Momoka.Shell.Views.HomeBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Momoka.Shell.Views">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- 高对比度不上亚克力：那一档的整个意思是「别让任何东西半透明」，箭头退回系统窗口色、
                     字形退回系统字色（同 Theme/ActionButtons.xaml 那条路）。 -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="EgBannerPageRestBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="EgBannerPageHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="EgBannerPagePressBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <!-- 只换翻页箭头自己的那支墨，不碰 EgOnScrimBrush：带上的片名、读数、简介仍走原来那一支。 -->
                    <SolidColorBrush x:Key="EgBannerPageInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 翻页箭头的三个态，同 ShelfStrip 里那三个：盖在剧照上，所以不跟主题走。
                 2026-11-08 用户令「主页轮播图的翻页按钮改成亚克力」：三支实色换成同一支深色的磨砂玻璃，
                 tint 固定在这支压图用的深色上（不取窗口底色 —— 浅色主题那支接近白，白字形会看不见），
                 三态靠染色浓度分档：静止半透、悬停与按下一档比一档实。箭头只在指针停在带上时浮出。 -->
            <Color x:Key="EgBannerPageColor">#FF0C0E11</Color>
            <!-- 箭头自己的字形墨：常态与带上的字同一支浅墨，高对比度单独换系统字色。 -->
            <StaticResource x:Key="EgBannerPageInkBrush" ResourceKey="EgOnScrimBrush" />
            <AcrylicBrush
                x:Key="EgBannerPageRestBrush"
                FallbackColor="{StaticResource EgBannerPageColor}"
                TintColor="{StaticResource EgBannerPageColor}"
                TintLuminosityOpacity="0.35"
                TintOpacity="0.55" />
            <AcrylicBrush
                x:Key="EgBannerPageHoverBrush"
                FallbackColor="{StaticResource EgBannerPageColor}"
                TintColor="{StaticResource EgBannerPageColor}"
                TintLuminosityOpacity="0.3"
                TintOpacity="0.72" />
            <AcrylicBrush
                x:Key="EgBannerPagePressBrush"
                FallbackColor="{StaticResource EgBannerPageColor}"
                TintColor="{StaticResource EgBannerPageColor}"
                TintLuminosityOpacity="0.3"
                TintOpacity="0.88" />

            <!-- 右下张数读数那条底条用这一支；代码里按 Resources 取键，键少一个会在自检里就抛出来。 -->
            <SolidColorBrush x:Key="EgBannerDotBrush" Color="#59F3F5F8" />

            <!-- 带子自己的底在 Theme/Palette.xaml 里（EgBannerBaseBrush）：图还没解码到的那一瞬、整条带收起来之前的
                  那一帧，看见的就是它（2026-09-11 剧照铺满整条带之后，它不再在带子的左右两边露面）。右边那一列媒体库
                  2026-09-08 删掉之后，用这一支画刷的只剩这一条带。 -->

            <!-- 播放键原来是一块写死的白底黑字，四支画刷四个态。改成跟主题走的强调色之后那四支全没用了 ——
                 详情页头图上的播放键本来就是强调色，同一个产品两个最大的画面上，最主要的那颗键不该一个白
                 一个绿。 -->
            <!-- 「详情」键 2026-11-17 退役（用户令「去掉轮播图上的详情按钮，改为点击轮播图直接进入详情页面」）；
                 这两支悬停／按下薄光留给商店版式右栏的推荐卡。 -->
            <SolidColorBrush x:Key="EgBannerGhostHoverBrush" Color="#38F3F5F8" />
            <SolidColorBrush x:Key="EgBannerGhostPressBrush" Color="#50F3F5F8" />

            <!-- 播放键与翻页箭头的高度和圆角都取词表，跟详情页头图上那六颗一样：38 高、圆角 8。BasedOn 是必须的，见
                 ShelfStrip 里同一处注释：隐式样式只在没设过 Style 时生效。
                 左右边距 8（原来 14）：这两颗贴着带的边沿走，「按钮旁边移动一些」—— 它们各占的那一段（8 到 46）是
                 留给箭头的两条窄栏，而字块站在左上区域、左边距比左边那条窄栏更宽（见下面 Info 的 Margin），两边不同
                 列，所以箭头落进字块的高度范围时也压不到字。 -->
            <Style x:Key="EgBannerPageButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="{StaticResource EgActionHeight}" />
                <Setter Property="Height" Value="{StaticResource EgActionHeight}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="8,0,8,0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{StaticResource EgBannerPageRestBrush}" />
                <Setter Property="Foreground" Value="{StaticResource EgBannerPageInkBrush}" />
                <!-- 默认收起：指针在带上才浮出，同 ShelfStrip。 -->
                <Setter Property="Visibility" Value="Collapsed" />
            </Style>

            <!--
              商店版式的翻页箭头（2026-11-16 重做）：参考图里是两颗小小的圆形键，站在大图中线的左右沿上。
              只覆盖尺寸与圆角，三态画刷、字形墨和「指针在带上才浮出」都沿用上面那一支。
            -->
            <Style x:Key="EgBannerPageRoundStyle" TargetType="Button" BasedOn="{StaticResource EgBannerPageButtonStyle}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="Margin" Value="10,0,10,0" />
                <Setter Property="FontSize" Value="11" />
            </Style>

            <!--
              轮播片名（2026-11-16 重做）：整宽版式仍用整条带最大的一档（52），商店版式改用详情页头图那一档
              （36、可折两行）—— 参考图的商店大图只占左侧一列，52 号的片名在那里会把字块撑得比按钮还高。
              两支都以现有样式为底，只在这里换个名字，代码按版式换 Style。
            -->
            <Style x:Key="EgBannerDisplayTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource EgDisplayTitleStyle}" />
            <Style x:Key="EgBannerStoreTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource EgHeroTitleStyle}" />

            <Style x:Key="EgBannerPlayStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Height" Value="{StaticResource EgActionHeight}" />
                <Setter Property="MinWidth" Value="142" />
                <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
                <Setter Property="Padding" Value="24,0,24,2" />
            </Style>

            <!--
              商店版式右栏那三张推荐卡（2026-11-16「参考上图在设置中再添加一版轮播图」）：一张图铺满、左下角一行标题。
              图由代码按当前台上那张换成接下来的三张；这里只负责剪裁和悬停反馈。圆角剪在内容那层 Border 上，
              和主页那张主卡用同一档 EgCardCornerRadius。悬停／按下沿用原本给「详情」键准备的两支薄光，不另造颜色。
            -->
            <Style x:Key="EgBannerRailCardStyle" TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <!--
                  **这两条拉伸不能省**（2026-11-16 实屏）：按钮不写 HorizontalAlignment / VerticalAlignment 时，
                  在 Grid 格子里按内容宽度和高度站住 —— 右栏三张卡只剩标题那么宽、一张大卡也只有渐变底那么高，
                  整列看着像三块缩在左上角的小牌子。显式 Stretch 之后卡面才铺满自己的格子（大卡 2 份、小卡 1 份）。
                -->
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{StaticResource EgBannerBaseBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HoverLayer.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="PressLayer.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                                <Border
                                    x:Name="HoverLayer"
                                    Background="{StaticResource EgBannerGhostHoverBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                                <Border
                                    x:Name="PressLayer"
                                    Background="{StaticResource EgBannerGhostPressBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 底部分页圆点（商店版式）：命中区比点本身大一圈，点由代码按当前张数建。
                 点不是 Tab 停靠位 —— 方向键仍由整条带接管，十来颗圆点不该把 Tab 队列撑长。
                 Padding 4 与下面圆点的 6 号直径合起来 14，加上圆点那一行上下各 10／4 的呼吸正好是
                 HomeCarousel.DotsHeight（28）。 -->
            <Style x:Key="EgBannerDotButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
      IsTabStop 在带本身上，左右方向键翻页：翻页箭头默认是收起的，收起的按键接不了焦点，所以不用键盘的人靠
      箭头、用键盘的人靠这里 —— 底边那排分页小横条 2026-09-13 整个删了（「删除封面中心下方的那个组件」），
      翻页剩下箭头、方向键和自动翻页。
    -->
    <Grid
        x:Name="Root"
                x:Uid="HomeBanner_Root"
        Background="Transparent"
        IsTabStop="True"
        UseSystemFocusVisuals="True"
        PointerEntered="OnPointerEntered"
        PointerMoved="OnPointerEntered"
        PointerExited="OnPointerExited"
        GotFocus="OnBannerGotFocus"
        LostFocus="OnBannerLostFocus"
        KeyDown="OnKeyDown">

        <!--
          商店截图只作视觉参考（Store 闭源）。已核 Gallery v2.9.3 / 14a4a1a2b8ddc527dc4a7d5f7e743d7c2bc97db7
          Samples/Grid/GridPage.xaml[.cs]、Samples/Acrylic/AcrylicPage.xaml[.cs]、Styles/ItemTemplates.xaml：
          原生 Grid 与响应式改位没有一主三辅的成套实现，因此沿用本项目的按内容宽计算；不使用窗口宽触发器。
          宽屏主图左、推荐右；窄屏主图满宽、圆点下方左大右二小。四张卡与圆点始终保留同一实例。
        -->
        <Grid x:Name="Stage" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeroRow" Height="Auto" />
                <RowDefinition x:Name="DotsRow" Height="0" />
                <RowDefinition x:Name="RecommendationsRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MainColumn" Width="*" />
                <ColumnDefinition x:Name="RailGapColumn" Width="0" />
                <ColumnDefinition x:Name="RailColumn" Width="0" />
            </Grid.ColumnDefinitions>

        <!--
          **框没有了**（「占满窗口的上半部分（包括窗口标题），下方使用渐变衔接」，2026-09-11）。2026-09-10 到
          09-11 之间这里是一个 <c>Border</c>，圆角、整圈发丝线、卡片底色三样齐全 —— 那时「弄个框把轮播图框起来
          （圆角）」被落定成「四边各留 24 的卡片」。现在带子要铺到窗口的三条边（上、左、右），贴着窗口的边画
          圆角会在窗口角上剪出三角形的缺口，整圈发丝线也没有边可收（四条边里三条就是窗口自己的边），卡片底色
          更是要遮住剧照；三条理由一起作废，<c>Border</c> 换回 <c>Grid</c>。
          底沿那条「跟内容交代一下」的渐变（<c>Under</c>，09-11「下方使用渐变衔接」加的）09-12 按他一句
          「轮播图的下方不用加黑色渐变」删了 —— 带子的下沿就是一条硬边，直接接底下的货架。
          带子的底色（<c>EgBannerBaseBrush</c>）挪到这一层：<c>Grid</c> 也有 <c>Background</c>，用它兜住图还没
          解码到的那一瞬和整条带收起来之前的那一帧。它不跟主题走（Palette 里那一段写着理由：带上的字走
          <c>EgOnScrim</c> 那套浅墨，底色跟着主题变成近白就是白底白字）。
        -->
        <!--
          商店版式的大图自己是**一张圆角卡片**（2026-11-16 用户指出「怎么有些地方不是圆角」）：圆点在卡片下面
          之后，BannerCard 的圆角只在整条轮播最外圈，大图的右两角和下两角落在内部，会露出直角。所以这一层
          单独剪四边圆角，半径由 HomePage.SyncCarouselLayout 按显示模式拨（商店 16、沉浸 0）。
        -->
        <Border
            x:Name="HeroClip"
            Grid.Column="0"
            Background="{StaticResource EgBannerBaseBrush}"
            CornerRadius="{StaticResource EgCardCornerRadius}">
        <Grid x:Name="Frame" Background="{StaticResource EgBannerBaseBrush}">
            <!-- 台上那张剧照还没到的那一瞬（开场第一张，或者换到一张还没解码的）：整条带扫一道光。
                 **摆在 Band 外面**：那一层自己的规矩是「只有两层剧照，别的什么都不铺」（下面那一段长注释），
                 而这一层不是画，是「这儿马上有图」的说明 —— 图一到就整个停掉（见 HomeBanner.Paint）。
                 判据是台上那层画刷有没有图，不是「这一批里有没有幻灯片」：换张时另一层还压着上一张，
                 那时台上永远有图，光不该冒出来。 -->
            <views:Shimmer x:Name="PictureShimmer" />
            <!--
              保留单位 ScaleTransform 与定位名称；图片停留与换张均不再自动缩放。
              位图与高斯过渡始终共用同一层布局，尺寸变化只调整裁切，不重放背景动画。
            -->
            <Grid x:Name="Band" RenderTransformOrigin="0.5,0.5" Tapped="OnBannerTapped">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="BandScale" />
                </Grid.RenderTransform>

                <!--
                  **带里只有两层剧照，别的什么都不铺**（「去掉首页封面轮播图的黑边」，2026-09-11）。这里在 09-11
                  当天先站过一对镜像的翼、又换成两片纯色底，两版都被他否了；三版镜像翼的毛病按顺序记在文件头那
                  一段，免得下一个窗口又从某一版重新试一遍。**结论是让图自己铺满**：没有边，就没有边的问题。

                  带子的底色（`Frame` 的 `EgBannerBaseBrush`）只剩两个用处 —— 图还没解码到的那一瞬、整条带收起
                  来之前的那一帧。它不跟主题走（Palette 里那一段写着理由：带上的字走 `EgOnScrim` 那套浅墨，底色
                  跟着主题变成近白就是白底白字）。
                -->

                <!--
                  两层剧照轮着上：走下一张时新的那层淡入、旧的那层淡出，所以带上任何时候都有图，不会闪一下底色。

                  **铺满是靠 ImageBrush，不是靠 Image**（「去掉首页封面轮播图的黑边」，2026-09-11）。这两层是空
                  Grid（没有任何孩子），背景是一支 <c>ImageBrush Stretch="UniformToFill"</c>：画刷把图按自己的
                  比例放大到盖住整格、多出来的一截对半裁掉（<c>AlignmentX/Y</c> 默认就是 Center），而空 Grid 由
                  对齐撑满整格 —— 两件事都是定义清楚的。
                  **为什么不用 Image 控件**：它按内容取尺寸、不吃满格子（09-10 那批横幅实验量到过），于是给死
                  `Width`/`Height` 也不保险 —— 2026-09-11 这一版第一趟就撞上了：自检量到元素 1014×570 而带子
                  1014×341，实拍里图从带子顶上开始铺、下沿那一截（花田）整片被裁掉，也就是**裁在了顶上而不是
                  居中**。ImageBrush 没有这条脾气。别把它换回 Image。
                  「上下各裁 5%」（09-10「轮播图上下各裁切百分之五」）和它那个常数 `KeptShare` 随这一改删了：
                  上下各 5% 是把图放进一个只差一成的格子里才说得通的数，现在裁多少是算出来的。
                -->
                <!--
                  两层剧照外面再套一层自己的圆角（2026-11-17 用户报「轮播图左上和左下圆角处有一条 1 像素亮边」）：
                  商店版式的大图是 16 圆角（HeroClip 那一层），剧照被圆角裁掉时最外一圈像素是「原图边缘色 ×
                  部分覆盖」—— 原图在那一段偏亮的时候，弧线上就留下一条比两侧都亮的细线，颜色跟着这张剧照走。
                  **光靠 HeroClip 剪不掉**：被裁的就是剧照自己。所以这里再收进一层比卡片小 1 的圆角（15）并让开
                  1 像素底色（EgBannerBaseBrush）：弧线上不再有剧照的像素，那条亮边也就没有了。
                  两处数值都由 HomeBanner.SetCardCornerRadius 按显示模式拨 —— 沉浸通栏是 0 圆角、0 缩进，
                  图照旧铺到窗口的三条边上（那里没有圆角，也就没有这条亮边）。
                  外面那层 Grid 是给自检留的结构：Band 的直接孩子里仍然只有三道遮罩（Top／Fade／RightShade），
                  PictureRead 量的也仍是整条带的尺寸（两层照样撑满 Band 内沿，图上让开的那一圈在这一层剪）。
                -->
                <Grid x:Name="PictureHost">
                    <Border
                        x:Name="PictureClip"
                        Margin="1"
                        Background="{StaticResource EgBannerBaseBrush}"
                        CornerRadius="15">
                        <Grid>
                            <Grid x:Name="LayerA" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="PictureScaleA" />
                                </Grid.RenderTransform>
                                <Grid.Background>
                                    <ImageBrush Stretch="UniformToFill" />
                                </Grid.Background>
                            </Grid>
                            <Grid x:Name="LayerB" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="PictureScaleB" />
                                </Grid.RenderTransform>
                                <Grid.Background>
                                    <ImageBrush Stretch="UniformToFill" />
                                </Grid.Background>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Gallery Samples/RadialGradientBrush/RadialGradientBrushPage.xaml/.xaml.cs,
                     v2.9.3 / commit 14a4a1a2b8ddc527dc4a7d5f7e743d7c2bc97db7:
                     原生画刷的 Absolute 坐标和 Center/GradientOrigin 同步。只给剧照加轻微鼠标光，
                     阅读遮罩、文字和按钮仍在上面；颜色由现有 EgOnScrimBrush 角色提供。 -->
                <Rectangle
                    x:Name="PointerGlow"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"
                    AutomationProperties.AccessibilityView="Raw">
                    <Rectangle.Fill>
                        <RadialGradientBrush
                            x:Name="PointerGlowBrush"
                            Center="0,0"
                            GradientOrigin="0,0"
                            MappingMode="Absolute"
                            RadiusX="180"
                            RadiusY="180"
                            SpreadMethod="Pad"
                            Opacity="0.13">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="0.35" Color="Transparent" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!--
                  带上的阅读遮罩保留三层：标题栏顶罩（Top）、左侧字块渐变（Fade）和右侧边缘。
                  三层摆在剧照之后、字块之前，只压图；底部不加渐变。颜色使用固定 ARGB
                  （#0C0E11，同 EgOnScrim* 那一族）：高对比度那本词典里只有画刷没有颜色键，写颜色键会在运行时抛。

                  **顶上那条 120 高的（Top）是 2026-09-10 删掉、2026-09-11 找回来的**：通栏之后标题栏那一行
                  （含系统那三颗窗口按钮）又浮在剧照上，浅墨画在一张亮剧照上读不出来，所以顶上要压一层。它压的是
                  <b>窗口的顶边</b>那一段，不是带子的顶边 —— 带子的顶边就是窗口的顶边，两回事在这里是一回事。
                -->
                <Border x:Name="Top" Height="96" VerticalAlignment="Top">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Offset="0" Color="#70101217" />
                            <GradientStop Offset="0.45" Color="#28101217" />
                            <GradientStop Offset="1" Color="#00101217" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!--
                  左边那道渐变幕（2026-09-10 起）：左头近实心（#E6，九成）、往右一路淡出到全透明。它的主顾从头到尾
                  是**那块字** —— 字压在图上，亮剧照上（量过的一张粉色动画剧照：简介 1.9:1）没有它读不出来。
                  09-11「去掉首页封面轮播图的黑边」之后它多了一句更要紧的：**这条带从左沿到右沿都是图了**，字的底下
                  不再有纯色底兜着，全靠它。
                  **多宽由代码算**（Resize）：**「字块左沿 ＋ 字块最宽 ＋ ScrimBreath」**（幕得盖过字的尾巴，右边留
                  一口气再散尽）。从前还要与「左边纯色那一片的宽 ＋ 图宽的三成半」取大的那个 —— 那一项 09-11 随
                  「两边不再有纯色」删了（`FadeShare`）。
                  **右边不配一道对称的浓幕**：右边没有字要托，两边都压浓在屏上就是「一张被左右夹黑的图」—— 那正是
                  他 09-11 要去掉的东西；右边收边只靠下面那条薄薄的一层。
                  它一头在带沿、一头跟着字块算，所以不跟下、右两条走 Rims 那句「半张之前散尽」（自检里判它的是
                  Melts）。
                -->
                <Border x:Name="Fade" HorizontalAlignment="Left">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Offset="0" Color="#F0101217" />
                            <GradientStop Offset="0.35" Color="#C2101217" />
                            <GradientStop Offset="0.70" Color="#66101217" />
                            <GradientStop Offset="1" Color="#00101217" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!--
                  右边那一条：最薄的一层，收的是**带子自己的右沿**。它 09-11 上半天收的是「右片翼压到带沿上」那条
                  硬边；翼和纯色底都拆了之后，它收的是**图自己被裁的那条边**（`UniformToFill` 把图裁在框里，框沿
                  就是一条硬边），外加一点点压角。字不在这一边，所以浓度只有下边那层的一半上下，伸进来的深度也只有
                  它的一半上下。**0x4A 离 Probe 那句「贴边那头 alpha > 0x40」只剩一档**，要再淡得连那句断言一起改。
                  他 09-11 说「去掉黑边」要的是两侧那两片纯色，不是这一条 —— 谁嫌它还黑，改成 0 之后连断言一起改。
                -->
                <Border x:Name="RightShade">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
                            <GradientStop Offset="0" Color="#4A0C0E11" />
                            <GradientStop Offset="0.19" Color="#000C0E11" />
                            <GradientStop Offset="1" Color="#000C0E11" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!--
                  字块竖向居中站在左边（「字块放到封面居中的位置」，2026-09-10 —— 左边距 60 不动）。**它整块都压在
                  剧照上**（09-11 起带里没有纯色底了，字的中后段更是直接压在剧照上）—— 托着它的是左边那道渐变幕
                  （Fade，宽度由 Resize 按字块算，见上面那一段）。徽标顶在片名头上，同详情页头图上的 TitlePlate。
                  PlaceLogo 早删了：徽标由这一叠布局。

                  竖向这一轴它走过三站：左下（09-09 之前）→ 左上角（09-10「把红框里的东西移动到左上角」，顶距 116
                  再收成 40）→ 现在的居中。右下那块张数读数独立贴下沿，和字块不再共用一条避让规则（底边那排分页
                  小横条从前也贴下沿，2026-09-13 整个删了）—— 居中这一版字块最宽那一档的尾巴也够不到下沿
                  （带子最矮 240，字块最高 210，两头还各有一口气）。

                  每一行各有自己的 TranslateTransform，因为换一张时它们错着抬起来（见 HomeBanner.Rise）；动画在代码里
                  搭，Storyboard.TargetName 只在运行时解析，写在这里编译不出错、跑起来才抛。

                  左边距 60（原来 28，页面脊线的位置）让开翻页箭头：箭头从左边占到 46，余下 14 是箭头和字之间的一口气。
                  所以字块不和 PageSlate 的 24 左对齐 —— 页面抬头和画面内容不是一层，后者要让出箭头那条窄栏。
                -->
                <StackPanel
                    x:Name="Info"
                    Margin="60,0,0,0"
                    MaxWidth="620"
                    Spacing="10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    <!-- 这支位移给矮窗档翻档用（见 HomeFoldMotion）：字块让位那一下（PlaceInfo 换底边距）是硬切，
                         而压上来的那一排是滑上来的，页面在这支变换上补一趟让它们同时走。必须写在标记里 ——
                         WinUI 3 的 RenderTransform 出厂就是一支单位 MatrixTransform，代码里「见空就装」永远走不进去
                         （理由写在 ShelfTemplate 里那一段）。 -->
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>

                    <!--
                      下面这四行各自套一层 Grid（<c>…Row</c>），为的是那层跟着字形走的影子（见 TextInk）：影子挂在同
                      一格里排在字前面的那个空元素上，而抬起来那一下的位移和淡入写在这一格上 —— 两样分开写的话，字抬
                      起来了影子还留在原处。所以 **RenderTransform 和 Opacity 都在 Row 这一层，不在字上**。
                      影子只在亮剧照上才看得出用处：量过的账在 TextInk 那段注释里（粉色那张动画剧照上简介 1.9:1）。
                    -->

                    <!-- 剧集自己的徽标，没有就整行收起（StackPanel 的 Spacing 不给收起来的孩子留位置）—— 「这个剧集
                         没有徽标」和「徽标没画出来」在屏上长得一样，而只有后一种是这份代码的错。
                         上限 280×56 抄的是详情页头图上那块 TitlePlate，也就是这个应用里另一处「徽标顶在片名头上」的
                         地方；它在右下角那一版是 240×86，站进字块之后收一档 —— 五行东西叠起来，而带子最矮那一档
                         只有 240 高（HomeCarousel.MinHeight，带子按它自己的宽算出来的高够不到 240 的时候），一整块
                         字得放得进去。 -->
                    <Grid x:Name="LogoRow">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="LogoShift" />
                        </Grid.RenderTransform>
                        <Border x:Name="LogoInk" IsHitTestVisible="False" />
                        <Image
                            x:Name="LogoImage"
                            Stretch="Uniform"
                            MaxHeight="44"
                            MaxWidth="260"
                            HorizontalAlignment="Left"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Grid>

                    <!-- 字号字体字色全在 EgDisplayTitleStyle 里 —— 从 2026-09-12 起它是这一处自己的键（详情页
                         头图上那一行分出去成了 EgHeroTitleStyle：那一行会折行，折行的行距另有讲究）。原来这里
                         写死 40/Bold 而没写字体，于是主页最大的一块字是「更大的正文字」；前景取的还是播放键那支
                         画刷 —— 一支键的画刷去画字，改主题时那两处必然各走各的。
                         MaxLines="1"：这一行不折行（片名长了截断加省略号），所以它用不着详情页那一支的行高。 -->
                    <Grid x:Name="TitleRow">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="TitleShift" />
                        </Grid.RenderTransform>
                        <Border x:Name="TitleInk" IsHitTestVisible="False" />
                        <TextBlock
                            x:Name="TitleText"
                            Style="{StaticResource EgBannerDisplayTitleStyle}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- 集号和那串读数（「S03E09 · 2024 · 1080P · 2H14M」），所以走等宽的那一支 —— 和详情页头图
                         上同一行东西同一种字。 -->
                    <Grid x:Name="CaptionRow">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="CaptionShift" />
                        </Grid.RenderTransform>
                        <Border x:Name="CaptionInk" IsHitTestVisible="False" />
                        <TextBlock
                            x:Name="CaptionText"
                            Style="{StaticResource EgOnScrimDataStrongStyle}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- 两行就够：这条带是「看一眼决定看不看」，不是简介页。字比上面那行读数暗一档 —— 原来这里
                         是 Opacity 0.86 装出来的暗，而暗一档本来就是一支画刷的事。 -->
                    <Grid x:Name="SynopsisRow" HorizontalAlignment="Left">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="SynopsisShift" />
                        </Grid.RenderTransform>
                        <Border x:Name="SynopsisInk" IsHitTestVisible="False" />
                        <TextBlock
                            x:Name="SynopsisText"
                            Style="{StaticResource EgOnScrimBodyStyle}"
                            Foreground="{StaticResource EgOnScrimDimBrush}"
                            LineHeight="24"
                            MaxLines="2"
                            TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <StackPanel
                        x:Name="Actions"
                        Orientation="Horizontal"
                        Spacing="12"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="ActionsShift" />
                        </StackPanel.RenderTransform>

                        <!-- 强调色键，四个态全交给 AccentButtonStyle：Palette 那三份词典连 AccentFillColor* 一起
                             改，ThemeHost 换主题时也一起重涂，所以这颗键跟着主题走（同详情页头图上那一颗）。
                             「详情」键 2026-11-17 退役：点带子的其它地方直接进详情（OnBannerTapped），
                             这颗播放键仍是「现在就看」那一条路。 -->
                        <Button x:Name="PlayButton" Style="{StaticResource EgBannerPlayStyle}" Click="OnPlayClicked">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="13"
                                    Glyph="&#xE768;" />
                                <TextBlock x:Name="PlayText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Button
                    x:Name="PrevButton"
                    x:Uid="HomeBanner_PrevButton"
                    Style="{StaticResource EgBannerPageButtonStyle}"
                    HorizontalAlignment="Left"
                    Content="&#xE76B;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="14"
                    IsTabStop="False"
                    Click="OnPrevClicked">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="EgBannerPageHoverBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="EgBannerPagePressBrush" />
                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="EgBannerPageInkBrush" />
                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="EgBannerPageInkBrush" />
                    </Button.Resources>
                </Button>

                <Button
                    x:Name="NextButton"
                    x:Uid="HomeBanner_NextButton"
                    Style="{StaticResource EgBannerPageButtonStyle}"
                    HorizontalAlignment="Right"
                    Content="&#xE76C;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="14"
                    IsTabStop="False"
                    Click="OnNextClicked">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="EgBannerPageHoverBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="EgBannerPagePressBrush" />
                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="EgBannerPageInkBrush" />
                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="EgBannerPageInkBrush" />
                    </Button.Resources>
                </Button>

                <!-- 小横条那排分页指示 2026-09-13 上午整个删了（「删除封面中心下方的那个组件」），第几张看右下角
                     这块读数。同一天下午按他一句「把轮播图左下角这个稍微放大一点这个，把下方那条线弄成进度条，
                     跑满进度条就翻页」把这块从 12 号字／120×2 放大到 14 号／160×3，底下那条线也定死了身份：
                     进度条 —— 从左往右填满一个 Dwell，填满的那一拍钟到点、翻下一张。
                     **条和翻页是同一只钟**（HomeBanner.OnTick 按经过时间直接写 ScaleX，2026-11-02）：悬停和焦点
                     都不再停表 —— 指针停在窗口上半截是常态，停表就是「卡住不动」、移开清零就是「跑到一半回退」。
                     它也不跟系统的动画开关走：它是一句读数，不是装饰（见 SyncTimer 的说明）。 -->
                <StackPanel
                    x:Name="SlideStatus"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,60,28"
                    IsHitTestVisible="False">
                    <TextBlock
                        x:Name="SlideCounter"
                        HorizontalAlignment="Right"
                        FontSize="14"
                        Style="{StaticResource EgOnScrimDataStrongStyle}" />
                    <Border Width="160" Height="3" Background="{StaticResource EgBannerDotBrush}" CornerRadius="1.5">
                        <Border x:Name="CountdownBar" Background="{ThemeResource EgAccentBrush}" CornerRadius="1.5" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CountdownScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
        </Border>

            <!--
              这三张推荐跟随主卡取接下来的三张，保持原有图片订阅、点击入口与无障碍名称。
              Resize 只改原生 Grid 行列：宽档上大下二小，窄档左大右二小；间隔统一 12 DIP。
            -->
            <Grid x:Name="Rail" Grid.Column="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="RailTopRow" Height="2*" />
                    <RowDefinition x:Name="RailMiddleRow" Height="12" />
                    <RowDefinition x:Name="RailBottomRow" Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RailBigColumn" Width="*" />
                    <ColumnDefinition x:Name="RailMiddleColumn" Width="0" />
                    <ColumnDefinition x:Name="RailSmallColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="RailBigCard"
                    Grid.Row="0"
                    Style="{StaticResource EgBannerRailCardStyle}"
                    AutomationProperties.AutomationId="BannerRailCard1"
                    Click="OnRailCardClicked">
                    <Border
                        x:Name="RailBigSurface"
                        Background="{StaticResource EgBannerBaseBrush}"
                        CornerRadius="{StaticResource EgCardCornerRadius}">
                        <Grid>
                            <Border
                                Height="132"
                                Opacity="0.86"
                                VerticalAlignment="Bottom"
                                IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Offset="0" Color="Transparent" />
                                        <GradientStop Offset="1" Color="{StaticResource EgBannerPageColor}" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock
                                x:Name="RailBigTitle"
                                Margin="16,0,16,14"
                                MaxLines="2"
                                Style="{StaticResource EgOnScrimSectionTitleStyle}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>
                </Button>

                <Grid x:Name="RailSmallCards" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SmallFirstColumn" Width="*" />
                        <ColumnDefinition x:Name="SmallGapColumn" Width="12" />
                        <ColumnDefinition x:Name="SmallSecondColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="SmallFirstRow" Height="*" />
                        <RowDefinition x:Name="SmallGapRow" Height="0" />
                        <RowDefinition x:Name="SmallSecondRow" Height="0" />
                    </Grid.RowDefinitions>

                    <Button
                        x:Name="RailSmallCardA"
                        Grid.Column="0"
                        Style="{StaticResource EgBannerRailCardStyle}"
                        AutomationProperties.AutomationId="BannerRailCard2"
                        Click="OnRailCardClicked">
                        <Border
                            x:Name="RailSmallSurfaceA"
                            Background="{StaticResource EgBannerBaseBrush}"
                            CornerRadius="{StaticResource EgCardCornerRadius}">
                            <Grid>
                                <Border
                                    Height="76"
                                    Opacity="0.86"
                                    VerticalAlignment="Bottom"
                                    IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Offset="0" Color="Transparent" />
                                            <GradientStop Offset="1" Color="{StaticResource EgBannerPageColor}" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock
                                    x:Name="RailSmallTitleA"
                                    Margin="12,0,12,10"
                                    MaxLines="2"
                                    Style="{StaticResource EgOnScrimSubheadStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>
                    </Button>

                    <Button
                        x:Name="RailSmallCardB"
                        Grid.Column="2"
                        Style="{StaticResource EgBannerRailCardStyle}"
                        AutomationProperties.AutomationId="BannerRailCard3"
                        Click="OnRailCardClicked">
                        <Border
                            x:Name="RailSmallSurfaceB"
                            Background="{StaticResource EgBannerBaseBrush}"
                            CornerRadius="{StaticResource EgCardCornerRadius}">
                            <Grid>
                                <Border
                                    Height="76"
                                    Opacity="0.86"
                                    VerticalAlignment="Bottom"
                                    IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Offset="0" Color="Transparent" />
                                            <GradientStop Offset="1" Color="{StaticResource EgBannerPageColor}" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock
                                    x:Name="RailSmallTitleB"
                                    Margin="12,0,12,10"
                                    MaxLines="2"
                                    Style="{StaticResource EgOnScrimSubheadStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>
                    </Button>
                </Grid>
            </Grid>

        <!--
          商店版式的分页圆点（2026-11-16 重做）：**在两张卡片下面的页面底上**，不是压在剧照里 —— 参考图两种
          窗口宽度下都是这样，深度 12 的版本会和主卡右下读数打架。这一行的宽由 Resize 拨成主卡那一列，圆点
          因此在主卡下方居中（参考图也是对齐大图而不是整条轮播）。
          点由代码按张数建；没有第二张、或不是商店版式时整行收起，不占高度（Root.Height 跟着重算）。
        -->
        <Grid
            x:Name="DotsHost"
            Grid.Row="1"
            HorizontalAlignment="Left"
            Visibility="Collapsed">
            <StackPanel
                x:Name="PageDots"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,10,0,4"
                Spacing="0"
                Visibility="Collapsed" />
        </Grid>
        </Grid>
    </Grid>
</UserControl>
