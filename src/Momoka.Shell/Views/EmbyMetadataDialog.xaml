<?xml version="1.0" encoding="utf-8"?>
<!-- Emby's server-backed editor. Jellyfin and FnNas keep their own existing forms. -->
<ContentDialog x:Class="Momoka.Shell.Views.EmbyMetadataDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momoka.Shell.Views"
    Title="编辑元数据" PrimaryButtonText="保存" CloseButtonText="取消" DefaultButton="Primary"
    PrimaryButtonClick="OnSave" Closing="OnClosing">
    <ContentDialog.Resources>
        <!-- The framework adds a top-only overlay; the dialog surface is glass, so let it show through. -->
        <StaticResource x:Key="ContentDialogTopOverlay" ResourceKey="SystemControlTransparentBrush" />
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">320</x:Double>
    </ContentDialog.Resources>
    <Grid x:Name="DialogBody" MinWidth="280" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <InfoBar x:Name="Problem" IsClosable="False" IsOpen="False" Severity="Error" />
            <ProgressBar x:Name="SavingProgress" IsIndeterminate="True" Visibility="Collapsed" />
        </StackPanel>
        <ScrollViewer x:Name="EditorScroll" Grid.Row="1" MaxHeight="520"
            HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,16,8" Spacing="16">
                <TextBlock x:Name="ItemPathText" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                <!-- Icon-only 36 DIP buttons cannot inherit the text-button's 11 DIP side padding. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="NameBox" Header="标题"  TextChanged="OnEdited" />
                    <ToggleButton x:Name="NameLock" Grid.Column="1" Tag="Name" Width="36" Height="32" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Bottom"
                        Checked="OnLockChanged" Unchecked="OnLockChanged" AutomationProperties.Name="锁定此字段，阻止自动刷新覆盖">
                        <FontIcon Glyph="&#xE785;" />
                    </ToggleButton>
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="SortNameBox" Header="排序标题" PlaceholderText="留空则由服务器自动生成" TextChanged="OnEdited" />
                    <ToggleButton x:Name="SortNameLock" Grid.Column="1" Tag="SortName" Width="36" Height="32" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Bottom"
                        Checked="OnLockChanged" Unchecked="OnLockChanged" AutomationProperties.Name="锁定此字段，阻止自动刷新覆盖">
                        <FontIcon Glyph="&#xE785;" />
                    </ToggleButton>
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="DateCreatedBox" Header="加入日期" PlaceholderText="2026-10-28 17:33:45" TextChanged="OnEdited" />
                    <Button x:Name="PickCreatedDateButton" Grid.Column="1" Width="36" Height="32" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Bottom"
                        AutomationProperties.Name="选择加入日期和时间" ToolTipService.ToolTip="选择日期和时间">
                        <FontIcon Glyph="&#xE787;" />
                        <Button.Flyout>
                            <Flyout x:Name="CreatedDateFlyout" Opening="OnCreatedDateOpening" FlyoutPresenterStyle="{StaticResource EgLibraryFlyoutSurfaceStyle}">
                                <StackPanel Width="284" Spacing="12">
                                    <CalendarDatePicker x:Name="AddedDatePicker" Header="加入日期" HorizontalAlignment="Stretch"
                                        DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}" />
                                    <TimePicker x:Name="AddedTimePicker" Header="时间" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" />
                                    <Button x:Name="ApplyCreatedDateButton" Content="确定" Click="OnApplyCreatedDate" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <TextBlock Text="在 Emby Server 控制台的“媒体库”设置中可配置如何确定加入日期。"
                    TextWrapping="Wrap" Style="{StaticResource EgCaptionStyle}" Margin="0,-8,0,0" />
                <StackPanel x:Name="IndexRow" Spacing="16" Visibility="Collapsed">
                    <TextBox x:Name="ParentIndexBox" Header="季编号" TextChanged="OnEdited" />
                    <TextBox x:Name="IndexBox" Header="集编号" TextChanged="OnEdited" />
                </StackPanel>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="CommunityRatingBox" Header="社区评分" PlaceholderText="0 – 10" TextChanged="OnEdited" />
                    <ToggleButton x:Name="CommunityRatingLock" Grid.Column="1" Tag="CommunityRating" Width="36" Height="32" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Bottom"
                        Checked="OnLockChanged" Unchecked="OnLockChanged" AutomationProperties.Name="锁定此字段，阻止自动刷新覆盖">
                        <FontIcon Glyph="&#xE785;" />
                    </ToggleButton>
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="OverviewBox" Header="概要" AcceptsReturn="True" Height="156" TextWrapping="Wrap" TextChanged="OnEdited" />
                    <ToggleButton x:Name="OverviewLock" Grid.Column="1" Tag="Overview" Width="36" Height="32" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Bottom"
                        Checked="OnLockChanged" Unchecked="OnLockChanged" AutomationProperties.Name="锁定此字段，阻止自动刷新覆盖">
                        <FontIcon Glyph="&#xE785;" />
                    </ToggleButton>
                </Grid>
                <CalendarDatePicker x:Name="PremiereDatePicker" Header="发行日期" HorizontalAlignment="Stretch"
                    PlaceholderText="选择日期" DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}" DateChanged="OnDateChanged" />
                <Button x:Name="ClearPremiereDate" Content="清除发行日期" HorizontalAlignment="Left" Click="OnClearDate" />
                <TextBox x:Name="ProductionYearBox" Header="年份" TextChanged="OnEdited" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="OfficialRatingBox" Header="家长评分" HorizontalAlignment="Stretch" SelectionChanged="OnChoiceChanged" />
                    <ToggleButton x:Name="OfficialRatingLock" Grid.Column="1" Tag="OfficialRating" Width="36" Height="32" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Bottom"
                        Checked="OnLockChanged" Unchecked="OnLockChanged" AutomationProperties.Name="锁定此字段，阻止自动刷新覆盖">
                        <FontIcon Glyph="&#xE785;" />
                    </ToggleButton>
                </Grid>
                <ComboBox x:Name="CustomRatingBox" Header="自定义评分" HorizontalAlignment="Stretch" SelectionChanged="OnChoiceChanged" />
                <TextBlock Text="自定义评分不会显示，但会用于家长控制评估。家长评分字段仍会显示。"
                    TextWrapping="Wrap" Style="{StaticResource EgCaptionStyle}" Margin="0,-8,0,0" />
                <ComboBox x:Name="VideoFormatBox" Header="3D 格式" HorizontalAlignment="Stretch" SelectionChanged="OnChoiceChanged" />
                <Expander x:Name="AdditionalFields" Header="更多字段" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="16">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="OriginalTitleBox" Header="原始标题"  TextChanged="OnEdited" />
                    <ToggleButton x:Name="OriginalTitleLock" Grid.Column="1" Tag="OriginalTitle" Width="36" Height="32" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Bottom"
                        Checked="OnLockChanged" Unchecked="OnLockChanged" AutomationProperties.Name="锁定此字段，阻止自动刷新覆盖">
                        <FontIcon Glyph="&#xE785;" />
                    </ToggleButton>
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="CriticRatingBox" Header="影评指数" PlaceholderText="0 – 100" TextChanged="OnEdited" />
                    <ToggleButton x:Name="CriticRatingLock" Grid.Column="1" Tag="CriticRating" Width="36" Height="32" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Bottom"
                        Checked="OnLockChanged" Unchecked="OnLockChanged" AutomationProperties.Name="锁定此字段，阻止自动刷新覆盖">
                        <FontIcon Glyph="&#xE785;" />
                    </ToggleButton>
                </Grid>
                    </StackPanel>
                </Expander>
                <StackPanel x:Name="ExternalIdsSection" Spacing="12">
                    <TextBlock Text="外部标识符" Style="{StaticResource EgSectionTitleStyle}" />
                    <StackPanel x:Name="ExternalIdRows" Spacing="16" />
                </StackPanel>
                <local:MetadataListEditor x:Name="GenresEditor" />
                <local:MetadataListEditor x:Name="PeopleEditor" />
                <local:MetadataListEditor x:Name="StudiosEditor" />
                <local:MetadataListEditor x:Name="TagsEditor" />
                <TextBlock Text="元数据设置" Style="{StaticResource EgSectionTitleStyle}" Margin="0,8,0,0" />
                <ComboBox x:Name="LanguageBox" Header="首选元数据下载语言" HorizontalAlignment="Stretch" SelectionChanged="OnChoiceChanged" />
                <TextBlock Text="留空可继承上级项目的设置，或者使用全局默认值。"
                    TextWrapping="Wrap" Style="{StaticResource EgCaptionStyle}" Margin="0,-8,0,0" />
                <ComboBox x:Name="CountryBox" Header="国家或地区" HorizontalAlignment="Stretch" SelectionChanged="OnChoiceChanged" />
                <TextBlock Text="留空可继承上级项目的设置，或者使用全局默认值。"
                    TextWrapping="Wrap" Style="{StaticResource EgCaptionStyle}" Margin="0,-8,0,0" />
                <ToggleSwitch x:Name="LockItemSwitch" Header="锁定此项目可防止今后改动" Toggled="OnToggleChanged" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
