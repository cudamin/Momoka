<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Momoka.Shell.Views.MoviePilotReorganizeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:moviepilot="using:Momoka.MoviePilot"
    HorizontalContentAlignment="Stretch"
    SizeChanged="OnDialogSizeChanged"
    DefaultButton="None">
    <ContentDialog.Resources>
        <!-- 整行路径与固定操作区保留，字段沿用订阅表单的原生标题和共享输入样式。 -->
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">880</x:Double>
        <Thickness x:Key="ContentDialogTitleMargin">0,0,0,16</Thickness>
        <Thickness x:Key="ContentDialogCommandSpaceMargin">0,16,0,0</Thickness>
        <Thickness x:Key="ContentDialogPadding">22</Thickness>
        <Style x:Key="ReorganizeHint" TargetType="TextBlock" BasedOn="{StaticResource EgCaptionStyle}">
            <Setter Property="Foreground" Value="{ThemeResource EgTextDimBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="8,2,0,0" />
        </Style>
        <Style x:Key="ReorganizeActionStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{ThemeResource EgSurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource EgTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="ReorganizeToggleStyle" TargetType="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="50" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ContentDialog.Resources>
    <ContentDialog.Title>
        <Grid x:Name="ReorganizeTitle" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8DE;" Foreground="{ThemeResource EgTextDimBrush}" />
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization1" Text="手动整理" Style="{StaticResource EgSectionTitleStyle}" />
                <TextBlock x:Name="ReorganizeSubtitle" Style="{StaticResource EgCaptionStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
            <Button x:Uid="MoviePilotReorganizeDialog_DismissReorganize" x:Name="DismissReorganize" Grid.Column="2" Click="OnDismiss" CornerRadius="{ThemeResource ControlCornerRadius}" Style="{StaticResource EgIconButtonStyle}"
                AutomationProperties.Name="关闭手动整理" ToolTipService.ToolTip="关闭">
                <FontIcon Glyph="&#xE8BB;" FontSize="{StaticResource EgSubheadFontSize}" />
            </Button>
        </Grid>
    </ContentDialog.Title>
    <Grid x:Name="DialogBody" MinWidth="260" RowSpacing="12" SizeChanged="OnBodySizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <InfoBar x:Name="Problem" IsClosable="False" IsOpen="False" Severity="Error" />
        <ScrollViewer x:Name="FormScroll" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto" Padding="0,8,8,4">
            <StackPanel Spacing="10">
                <ContentControl x:Name="FormPanel" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="16">
                        <StackPanel x:Name="HistoryLookupPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock x:Name="HistorySummary" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                            <AutoSuggestBox x:Uid="MoviePilotReorganizeDialog_HistoryQuery" x:Name="HistoryQuery" Header="查找整理历史" PlaceholderText="输入原片名或文件名"
                                QueryIcon="Find" QuerySubmitted="OnHistoryQuery" />
                            <ComboBox x:Uid="MoviePilotReorganizeDialog_HistoryBox" x:Name="HistoryBox" Header="原整理记录" HorizontalAlignment="Stretch"
                                DisplayMemberPath="Display" SelectionChanged="OnHistoryChanged" />
                        </StackPanel>
                        <Grid x:Name="DestinationGrid" ColumnSpacing="20" RowSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel x:Name="TargetStorageField" Spacing="4">
                                <ComboBox x:Uid="MoviePilotReorganizeDialog_TargetStorageBox" x:Name="TargetStorageBox" Style="{StaticResource EgComboBoxStyle}"
                                    AutomationProperties.Name="目的存储" PlaceholderText="自动" HorizontalAlignment="Stretch" MinWidth="0"
                                    DisplayMemberPath="Name" SelectionChanged="OnStorageChanged">
                                    <ComboBox.Header>
                                        <TextBlock x:Uid="MoviePilotReorganizeDialog_TargetStorageLabel" x:Name="TargetStorageLabel" Text="目的存储" />
                                    </ComboBox.Header>
                                </ComboBox>
                                <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization2" Style="{StaticResource ReorganizeHint}" Text="整理目的存储，选择自动时由后端匹配" />
                            </StackPanel>
                            <StackPanel x:Name="TransferMethodField" Spacing="4">
                                <ComboBox x:Uid="MoviePilotReorganizeDialog_TransferTypeBox" x:Name="TransferTypeBox" Style="{StaticResource EgComboBoxStyle}"
                                    AutomationProperties.Name="整理方式" HorizontalAlignment="Stretch" MinWidth="0" SelectionChanged="OnSelectionEdited">
                                    <ComboBox.Header>
                                        <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization8" Text="整理方式" />
                                    </ComboBox.Header>
                                    <ComboBoxItem x:Uid="MoviePilotReorganizeDialog_Localization3" Content="自动" Tag="" />
                                    <ComboBoxItem x:Uid="MoviePilotReorganizeDialog_Localization4" Content="复制" Tag="copy" />
                                    <ComboBoxItem x:Uid="MoviePilotReorganizeDialog_Localization5" Content="移动（移走源文件）" Tag="move" />
                                    <ComboBoxItem x:Uid="MoviePilotReorganizeDialog_Localization6" Content="硬链接" Tag="link" />
                                    <ComboBoxItem x:Uid="MoviePilotReorganizeDialog_Localization7" Content="软链接" Tag="softlink" />
                                </ComboBox>
                                <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization9" Style="{StaticResource ReorganizeHint}" Text="文件操作整理方式，选择自动时使用后端匹配结果或默认规则" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="TargetPathPanel" Spacing="4">
                            <ComboBox x:Uid="MoviePilotReorganizeDialog_TargetPathBox" x:Name="TargetPathBox" Style="{StaticResource EgComboBoxStyle}"
                                AutomationProperties.Name="目的路径" PlaceholderText="自动" HorizontalAlignment="Stretch" MinWidth="0" IsEditable="True"
                                SelectionChanged="OnDirectoryChanged">
                                <ComboBox.Header>
                                    <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization10" Text="目的路径" />
                                </ComboBox.Header>
                            </ComboBox>
                            <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization11" Style="{StaticResource ReorganizeHint}" Text="整理目的路径，选择自动将由后端按源路径匹配" />
                            <Border x:Name="MatchedPathPanel" Visibility="Collapsed" Padding="12,8" CornerRadius="{StaticResource EgSearchCornerRadius}"
                                Background="{ThemeResource EgAccentSoftBrush}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MatchedPathText" Style="{StaticResource EgBodyStyle}" Foreground="{ThemeResource EgAccentBrush}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button x:Uid="MoviePilotReorganizeDialog_UseMatchedPathButton" x:Name="UseMatchedPathButton" AutomationProperties.Name="使用匹配路径" Grid.Column="1" Click="OnUseMatchedPath"
                                        VerticalAlignment="Center" Style="{StaticResource ReorganizeActionStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE73E;" FontSize="{StaticResource EgBodyFontSize}" /><TextBlock x:Uid="MoviePilotReorganizeDialog_Localization12" Text="使用匹配路径" /></StackPanel>
                </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <Grid x:Name="RecognitionGrid" ColumnSpacing="20" RowSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel x:Name="TypeField" Spacing="4">
                                <ComboBox x:Uid="MoviePilotReorganizeDialog_TypeBox" x:Name="TypeBox" Style="{StaticResource EgComboBoxStyle}"
                                    AutomationProperties.Name="类型" HorizontalAlignment="Stretch" MinWidth="0" SelectionChanged="OnTypeChanged">
                                    <ComboBox.Header>
                                        <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization16" Text="类型" />
                                    </ComboBox.Header>
                                    <ComboBoxItem x:Uid="MoviePilotReorganizeDialog_Localization13" Content="自动" Tag="" />
                                    <ComboBoxItem x:Uid="MoviePilotReorganizeDialog_Localization14" Content="电影" Tag="电影" />
                                    <ComboBoxItem x:Uid="MoviePilotReorganizeDialog_Localization15" Content="电视剧" Tag="电视剧" />
                                </ComboBox>
                                <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization17" Style="{StaticResource ReorganizeHint}" Text="文件的媒体类型" />
                            </StackPanel>
                            <StackPanel x:Name="MediaSourceField" Spacing="4">
                                <ComboBox x:Uid="MoviePilotReorganizeDialog_SourceBox" x:Name="SourceBox" Style="{StaticResource EgComboBoxStyle}"
                                    AutomationProperties.Name="数据源" HorizontalAlignment="Stretch" MinWidth="0" DisplayMemberPath="Name" SelectionChanged="OnSourceChanged">
                                    <ComboBox.Header>
                                        <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization18" Text="数据源" />
                                    </ComboBox.Header>
                                </ComboBox>
                                <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization19" Style="{StaticResource ReorganizeHint}" Text="默认使用后台识别设置，可为本次整理与刮削单独切换" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="IdentityGrid" ColumnSpacing="20" RowSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel x:Name="MediaIdPanel" Spacing="4">
                                <AutoSuggestBox x:Uid="MoviePilotReorganizeDialog_MediaIdBox" x:Name="MediaIdBox" Header="媒体编号" PlaceholderText="留空自动识别，或输入片名查找"
                                    QueryIcon="Find" TextChanged="OnMediaIdChanged" QuerySubmitted="OnMediaIdQuery" SuggestionChosen="OnSuggestionChosen" />
                                <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization20" Style="{StaticResource ReorganizeHint}" Text="用所选数据源的原生编号。" />
                            </StackPanel>
                            <StackPanel x:Name="SeasonField" Spacing="4">
                                <TextBox x:Uid="MoviePilotReorganizeDialog_SeasonBox" x:Name="SeasonBox" Header="季（特别篇为 0）" PlaceholderText="留空自动识别" TextChanged="OnEdited" />
                                <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization21" Style="{StaticResource ReorganizeHint}" Text="留空按文件名识别，特别篇填 0。" />
                            </StackPanel>
                            <StackPanel x:Name="EpisodeField" Spacing="4">
                                <TextBox x:Uid="MoviePilotReorganizeDialog_EpisodeBox" x:Name="EpisodeBox" Header="集（如 1 或 1,2）" PlaceholderText="起始集,终止集" TextChanged="OnEdited" />
                                <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization22" Style="{StaticResource ReorganizeHint}" Text="写单集或起始集,终止集。" />
                            </StackPanel>
                            <StackPanel x:Name="EpisodeGroupPanel" Spacing="4">
                                <ComboBox x:Uid="MoviePilotReorganizeDialog_EpisodeGroupBox" x:Name="EpisodeGroupBox" Header="剧集组" PlaceholderText="默认排序，或填写剧集组编号" HorizontalAlignment="Stretch"
                                    MinWidth="0" IsEditable="True" DisplayMemberPath="Label" SelectionChanged="OnSelectionEdited" />
                                <TextBlock x:Uid="MoviePilotReorganizeDialog_EpisodeGroupHint" x:Name="EpisodeGroupHint" Style="{StaticResource ReorganizeHint}" Text="可填 TMDB 剧集组编号。" />
                            </StackPanel>
                            <StackPanel x:Name="EpisodeFormatField" Spacing="4">
                                <TextBox x:Uid="MoviePilotReorganizeDialog_EpisodeFormatBox" x:Name="EpisodeFormatBox" Header="集数定位" PlaceholderText="使用 {ep} 定位集数" TextChanged="OnEdited" />
                                <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization23" Style="{StaticResource ReorganizeHint}" Text="用 {ep} 标记集数位置。" />
                            </StackPanel>
                            <StackPanel x:Name="EpisodeOffsetField" Spacing="4">
                                <TextBox x:Uid="MoviePilotReorganizeDialog_EpisodeOffsetBox" x:Name="EpisodeOffsetBox" Header="集数偏移" PlaceholderText="如 -10 或 EP*2" TextChanged="OnEdited" />
                                <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization24" Style="{StaticResource ReorganizeHint}" Text="按表达式调整识别到的集号。" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="FileOptionsGrid" ColumnSpacing="20" RowSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel x:Name="PartField" Spacing="4">
                                <TextBox x:Uid="MoviePilotReorganizeDialog_PartBox" x:Name="PartBox" Style="{StaticResource EgTextBoxStyle}"
                                    AutomationProperties.Name="指定Part" PlaceholderText="如 part1" TextChanged="OnEdited">
                                    <TextBox.Header>
                                        <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization25" Text="指定Part" />
                                    </TextBox.Header>
                                </TextBox>
                                <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization26" Style="{StaticResource ReorganizeHint}" Text="指定Part，如part1" />
                            </StackPanel>
                            <StackPanel x:Name="MinimumSizeField" Spacing="4">
                                <TextBox x:Uid="MoviePilotReorganizeDialog_MinSizeBox" x:Name="MinSizeBox" Style="{StaticResource EgTextBoxStyle}"
                                    AutomationProperties.Name="最小文件大小（MB）" Text="0" TextChanged="OnEdited">
                                    <TextBox.Header>
                                        <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization27" Text="最小文件大小（MB）" />
                                    </TextBox.Header>
                                </TextBox>
                                <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization28" Style="{StaticResource ReorganizeHint}" Text="只整理大于最小文件大小的文件" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="FolderOptionsGrid" ColumnSpacing="20" RowSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel x:Name="TypeFolderField" Spacing="4">
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ToggleSwitch x:Uid="MoviePilotReorganizeDialog_TypeFolderToggle" x:Name="TypeFolderToggle" Style="{StaticResource ReorganizeToggleStyle}" Toggled="OnFolderOptionChanged" AutomationProperties.Name="按类型分类" />
                                    <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization29" Grid.Column="1" Text="按类型分类" Style="{StaticResource EgBodyStyle}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization30" Style="{StaticResource ReorganizeHint}" Text="整理时目的路径下按媒体类型添加子目录" />
                            </StackPanel>
                            <StackPanel x:Name="CategoryFolderField" Spacing="4">
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ToggleSwitch x:Uid="MoviePilotReorganizeDialog_CategoryFolderToggle" x:Name="CategoryFolderToggle" Style="{StaticResource ReorganizeToggleStyle}" Toggled="OnFolderOptionChanged" AutomationProperties.Name="按类别分类" />
                                    <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization31" Grid.Column="1" Text="按类别分类" Style="{StaticResource EgBodyStyle}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization32" Style="{StaticResource ReorganizeHint}" Text="整理时在目的路径下按媒体类别添加子目录" />
                            </StackPanel>
                            <StackPanel x:Name="ScrapeField" Spacing="4">
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ToggleSwitch x:Uid="MoviePilotReorganizeDialog_ScrapeToggle" x:Name="ScrapeToggle" Style="{StaticResource ReorganizeToggleStyle}" Toggled="OnFolderOptionChanged" AutomationProperties.Name="刮削元数据" />
                                    <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization33" Grid.Column="1" Text="刮削元数据" Style="{StaticResource EgBodyStyle}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization34" Style="{StaticResource ReorganizeHint}" Text="整理完成后自动刮削元数据" />
                            </StackPanel>
                            <StackPanel x:Name="FromHistoryField" Spacing="4">
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ToggleSwitch x:Uid="MoviePilotReorganizeDialog_FromHistoryToggle" x:Name="FromHistoryToggle" Style="{StaticResource ReorganizeToggleStyle}" Toggled="OnFromHistoryChanged" AutomationProperties.Name="复用历史识别信息" />
                                    <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization35" Grid.Column="1" Text="复用历史识别信息" Style="{StaticResource EgBodyStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock x:Uid="MoviePilotReorganizeDialog_Localization36" Style="{StaticResource ReorganizeHint}" Text="使用历史整理记录中已识别的媒体信息" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ContentControl>
                <ItemsControl x:Name="PreviewList" ItemsSource="{x:Bind Lines}" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="moviepilot:MoviePilotTransferLine">
                            <StackPanel Spacing="4" Padding="10" Margin="0,0,0,8" Background="{ThemeResource EgSurfaceAltBrush}">
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="{x:Bind DisplaySource}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Style="{StaticResource EgBodyStyle}" Text="{x:Bind Headline}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="{x:Bind StatusLine}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="ConfirmationPanel" Visibility="Collapsed" Padding="12" Background="{ThemeResource EgSurfaceAltBrush}" CornerRadius="{StaticResource EgCardCornerRadius}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="ConfirmationText" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                        <CheckBox x:Uid="MoviePilotReorganizeDialog_ConfirmChanges" x:Name="ConfirmChanges" Content="我已核对源文件、目标路径和旧记录的影响" Checked="OnConfirmed" Unchecked="OnConfirmed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="10">
            <Border Height="1" Background="{ThemeResource EgBorderBrush}" />
            <Grid x:Name="ProgressRow" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ProgressRing x:Name="PreviewRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                <TextBlock x:Name="PreviewSummary" Grid.Column="1" Style="{StaticResource EgCaptionStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
            <Grid x:Name="ActionsGrid" ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Button x:Uid="MoviePilotReorganizeDialog_PreviewButton" x:Name="PreviewButton" AutomationProperties.Name="预览" Click="OnPreview" Style="{StaticResource ReorganizeActionStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE890;" FontSize="{StaticResource EgBodyFontSize}" /><TextBlock x:Uid="MoviePilotReorganizeDialog_Localization37" Text="预览" /></StackPanel>
                </Button>
                <Button x:Uid="MoviePilotReorganizeDialog_QueueButton" x:Name="QueueButton" AutomationProperties.Name="加入整理队列" Grid.Column="1" Click="OnQueueSubmit" Style="{StaticResource ReorganizeActionStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="{StaticResource EgBodyFontSize}" /><TextBlock x:Uid="MoviePilotReorganizeDialog_Localization38" Text="加入整理队列" /></StackPanel>
                </Button>
                <Button x:Uid="MoviePilotReorganizeDialog_ReorganizeButton" x:Name="ReorganizeButton" AutomationProperties.Name="重新整理" Grid.Column="3" Click="OnReorganizeSubmit" CornerRadius="{ThemeResource ControlCornerRadius}" Style="{StaticResource AccentButtonStyle}" MinHeight="36">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="{StaticResource EgBodyFontSize}" /><TextBlock x:Uid="MoviePilotReorganizeDialog_Localization39" Text="重新整理" /></StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</ContentDialog>
