<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Momoka.Shell.Views.MoviePilotReorganizeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:moviepilot="using:Momoka.MoviePilot"
    HorizontalContentAlignment="Stretch"
    SizeChanged="OnDialogSizeChanged"
    DefaultButton="None">
    <ContentDialog.Resources>
        <!-- 表单按四列排（2026-10-30）：上游网页端只有 720 宽、内容要滚，这里把窗口放大到能一次看全。 -->
        <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">880</x:Double>
        <Thickness x:Key="ContentDialogTitleMargin">0,0,0,8</Thickness>
        <Thickness x:Key="ContentDialogCommandSpaceMargin">0,16,0,0</Thickness>
        <Thickness x:Key="ContentDialogPadding">18</Thickness>
        <Style x:Key="ReorganizeActionStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{ThemeResource EgSurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource EgTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="ReorganizeToggleStyle" TargetType="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="50" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ContentDialog.Resources>
    <ContentDialog.Title>
        <Grid x:Name="ReorganizeTitle" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8DE;" Foreground="{ThemeResource EgTextDimBrush}" />
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="手动整理" Style="{StaticResource EgSectionTitleStyle}" />
                <TextBlock x:Name="ReorganizeSubtitle" Style="{StaticResource EgCaptionStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
            <Button x:Name="DismissReorganize" Grid.Column="2" Click="OnDismiss" Style="{StaticResource EgIconButtonStyle}"
                AutomationProperties.Name="关闭手动整理" ToolTipService.ToolTip="关闭">
                <FontIcon Glyph="&#xE8BB;" FontSize="{StaticResource EgSubheadFontSize}" />
            </Button>
        </Grid>
    </ContentDialog.Title>
    <Grid x:Name="DialogBody" MinWidth="260" RowSpacing="12" SizeChanged="OnBodySizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <InfoBar x:Name="Problem" IsClosable="False" IsOpen="False" Severity="Error" />
        <ScrollViewer x:Name="FormScroll" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto" Padding="0,0,18,0">
            <StackPanel Spacing="10">
                <ContentControl x:Name="FormPanel" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="BatchSelectionSummary" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                        <StackPanel x:Name="HistoryLookupPanel" Spacing="0">
                        <Expander x:Name="AdvancedOptions" Header="原整理记录与源文件" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="从原记录找回真实源文件，不会把媒体库中的软链接当成新的下载文件。" TextWrapping="Wrap" />
                                <TextBox x:Name="SourcePathBox" Header="媒体库当前文件" IsReadOnly="True" TextWrapping="Wrap" />
                                <AutoSuggestBox x:Name="HistoryQuery" Header="查找整理历史" PlaceholderText="输入原片名或文件名"
                                    QueryIcon="Find" QuerySubmitted="OnHistoryQuery" />
                                <ComboBox x:Name="HistoryBox" Header="原整理记录" HorizontalAlignment="Stretch"
                                    DisplayMemberPath="Display" SelectionChanged="OnHistoryChanged" />
                                <TextBlock x:Name="HistorySummary" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                                <TextBox x:Name="OriginalSourceBox" Header="本次实际源文件" IsReadOnly="True" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                        </StackPanel>
                        <Grid x:Name="DestinationGrid" ColumnSpacing="14" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="TargetStorageField" Spacing="6">
                                <ComboBox x:Name="TargetStorageBox" Header="目的存储" PlaceholderText="自动" HorizontalAlignment="Stretch"
                                    DisplayMemberPath="Name" SelectionChanged="OnStorageChanged" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="自动时由后端匹配。" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="TransferMethodField" Spacing="6">
                                <ComboBox x:Name="TransferTypeBox" Header="整理方式" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionEdited">
                                    <ComboBoxItem Content="自动" Tag="" /><ComboBoxItem Content="复制" Tag="copy" />
                                    <ComboBoxItem Content="移动（移走源文件）" Tag="move" /><ComboBoxItem Content="硬链接" Tag="link" /><ComboBoxItem Content="软链接" Tag="softlink" />
                                </ComboBox>
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="选目录后自动采用目录方式。" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="TypeField" Spacing="6">
                                <ComboBox x:Name="TypeBox" Header="类型" HorizontalAlignment="Stretch" SelectionChanged="OnTypeChanged">
                                    <ComboBoxItem Content="自动" Tag="" /><ComboBoxItem Content="电影" Tag="电影" /><ComboBoxItem Content="电视剧" Tag="电视剧" />
                                </ComboBox>
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="自动时由后端识别。" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="MediaSourceField" Spacing="6">
                                <ComboBox x:Name="SourceBox" Header="数据源" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="OnSourceChanged" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="默认沿用后台识别设置。" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="TargetPathPanel" Spacing="6">
                            <ComboBox x:Name="TargetPathBox" Header="目的路径" PlaceholderText="自动" HorizontalAlignment="Stretch" IsEditable="True"
                                SelectionChanged="OnDirectoryChanged" />
                            <TextBlock Style="{StaticResource EgCaptionStyle}" Text="可选媒体库目录，或直接填写路径。" TextWrapping="Wrap" />
                            <Border x:Name="MatchedPathPanel" Visibility="Collapsed" Padding="10" CornerRadius="{StaticResource EgCardCornerRadius}"
                                Background="{StaticResource EgAccentSoftBrush}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MatchedPathText" Style="{StaticResource EgBodyStyle}" Foreground="{ThemeResource EgAccentBrush}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button x:Name="UseMatchedPathButton" Grid.Column="1" Content="使用匹配路径" Click="OnUseMatchedPath"
                                        VerticalAlignment="Center" Style="{StaticResource ReorganizeActionStyle}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <Grid x:Name="IdentityGrid" ColumnSpacing="14" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="MediaIdPanel" Spacing="6">
                                <AutoSuggestBox x:Name="MediaIdBox" Header="媒体编号" PlaceholderText="留空自动识别，或输入片名查找"
                                    QueryIcon="Find" TextChanged="OnMediaIdChanged" QuerySubmitted="OnMediaIdQuery" SuggestionChosen="OnSuggestionChosen" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="用所选数据源的原生编号。" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="SeasonField" Spacing="6">
                                <TextBox x:Name="SeasonBox" Header="季（特别篇为 0）" PlaceholderText="留空自动识别" TextChanged="OnEdited" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="留空按文件名识别，特别篇填 0。" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="EpisodeField" Spacing="6">
                                <TextBox x:Name="EpisodeBox" Header="集（如 1 或 1,2）" PlaceholderText="起始集,终止集" TextChanged="OnEdited" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="写单集或起始集,终止集。" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="EpisodeGroupPanel" Spacing="6">
                                <ComboBox x:Name="EpisodeGroupBox" Header="剧集组" PlaceholderText="默认排序，或填写剧集组编号" HorizontalAlignment="Stretch"
                                    IsEditable="True" DisplayMemberPath="Label" SelectionChanged="OnSelectionEdited" />
                                <TextBlock x:Name="EpisodeGroupHint" Style="{StaticResource EgCaptionStyle}" Text="可填 TMDB 剧集组编号。" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="EpisodeFormatField" Spacing="6">
                                <TextBox x:Name="EpisodeFormatBox" Header="集数定位" PlaceholderText="使用 {ep} 定位集数" TextChanged="OnEdited" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="用 {ep} 标记集数位置。" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="EpisodeOffsetField" Spacing="6">
                                <TextBox x:Name="EpisodeOffsetBox" Header="集数偏移" PlaceholderText="如 -10 或 EP*2" TextChanged="OnEdited" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="按表达式调整识别到的集号。" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="FileOptionsGrid" ColumnSpacing="14" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="PartField" Spacing="6">
                                <TextBox x:Name="PartBox" Header="指定 Part" PlaceholderText="如 part1" TextChanged="OnEdited" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="留空不指定分段。" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="MinimumSizeField" Spacing="6">
                                <TextBox x:Name="MinSizeBox" Header="最小文件大小（MB）" Text="0" TextChanged="OnEdited" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="0 表示不限。" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="ScrapeField" Spacing="6">
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ToggleSwitch x:Name="ScrapeToggle" Style="{StaticResource ReorganizeToggleStyle}" Toggled="OnFolderOptionChanged" AutomationProperties.Name="刮削元数据" />
                                    <TextBlock Grid.Column="1" Text="刮削元数据" Style="{StaticResource EgBodyStyle}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="整理完成后自动刮削。" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="FromHistoryField" Spacing="6">
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ToggleSwitch x:Name="FromHistoryToggle" Style="{StaticResource ReorganizeToggleStyle}" Toggled="OnFromHistoryChanged" AutomationProperties.Name="复用历史识别信息" />
                                    <TextBlock Grid.Column="1" Text="复用历史识别信息" Style="{StaticResource EgBodyStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="用原记录的媒体信息。" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="FolderOptionsGrid" ColumnSpacing="14" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel x:Name="TypeFolderField" Spacing="6">
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ToggleSwitch x:Name="TypeFolderToggle" Style="{StaticResource ReorganizeToggleStyle}" Toggled="OnFolderOptionChanged" AutomationProperties.Name="按类型分类" />
                                    <TextBlock Grid.Column="1" Text="按类型分类" Style="{StaticResource EgBodyStyle}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="按电影、电视剧建子目录。" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="CategoryFolderField" Spacing="6">
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ToggleSwitch x:Name="CategoryFolderToggle" Style="{StaticResource ReorganizeToggleStyle}" Toggled="OnFolderOptionChanged" AutomationProperties.Name="按类别分类" />
                                    <TextBlock Grid.Column="1" Text="按类别分类" Style="{StaticResource EgBodyStyle}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="按媒体类别建子目录。" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource EgCaptionStyle}" Text="按原记录重新整理可能清理旧目标和成功历史；必须先预览、再核对确认。" TextWrapping="Wrap" />
                    </StackPanel>
                </ContentControl>
                <ItemsControl x:Name="PreviewList" ItemsSource="{x:Bind Lines}" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="moviepilot:MoviePilotTransferLine">
                            <StackPanel Spacing="4" Padding="10" Margin="0,0,0,8" Background="{ThemeResource EgSurfaceAltBrush}">
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="{x:Bind Source}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Style="{StaticResource EgBodyStyle}" Text="{x:Bind Headline}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="{x:Bind StatusLine}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="ConfirmationPanel" Visibility="Collapsed" Padding="12" Background="{ThemeResource EgSurfaceAltBrush}" CornerRadius="{StaticResource EgCardCornerRadius}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="ConfirmationText" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                        <CheckBox x:Name="ConfirmChanges" Content="我已核对源文件、目标路径和旧记录的影响" Checked="OnConfirmed" Unchecked="OnConfirmed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="6">
            <Grid x:Name="ProgressRow" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ProgressRing x:Name="PreviewRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                <TextBlock x:Name="PreviewSummary" Grid.Column="1" Style="{StaticResource EgCaptionStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
            <Grid x:Name="ActionsGrid" ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Button x:Name="PreviewButton" Content="预览" Click="OnPreview" Style="{StaticResource ReorganizeActionStyle}" />
                <Button x:Name="QueueButton" Grid.Column="1" Content="加入整理队列" Click="OnQueueSubmit" Style="{StaticResource ReorganizeActionStyle}" />
                <Button x:Name="ReorganizeButton" Grid.Column="3" Content="重新整理" Click="OnReorganizeSubmit" Style="{StaticResource AccentButtonStyle}" MinHeight="36" />
            </Grid>
        </StackPanel>
    </Grid>
</ContentDialog>
