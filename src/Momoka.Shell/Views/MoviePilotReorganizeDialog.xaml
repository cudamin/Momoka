<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Momoka.Shell.Views.MoviePilotReorganizeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:moviepilot="using:Momoka.MoviePilot"
    HorizontalContentAlignment="Stretch"
    SizeChanged="OnDialogSizeChanged"
    DefaultButton="None">
    <ContentDialog.Resources>
        <!-- 与网页端一致：紧凑的两列表单、整行路径、固定底部操作；短窗口只滚动正文。 -->
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">880</x:Double>
        <Thickness x:Key="ContentDialogTitleMargin">0,0,0,16</Thickness>
        <Thickness x:Key="ContentDialogCommandSpaceMargin">0,16,0,0</Thickness>
        <Thickness x:Key="ContentDialogPadding">22</Thickness>
        <Style x:Key="ReorganizePickerStyle" TargetType="ComboBox" BasedOn="{StaticResource EgComboBoxStyle}">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="38,12,0,12" />
            <Setter Property="CornerRadius" Value="{StaticResource EgPickerCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource EgActionGlassBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EgBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="{StaticResource EgBodyFontSize}" />
        </Style>
        <Style x:Key="ReorganizeTextStyle" TargetType="TextBox" BasedOn="{StaticResource EgTextBoxStyle}">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="38,12,12,12" />
            <Setter Property="CornerRadius" Value="{StaticResource EgPickerCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource EgSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EgBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="{StaticResource EgBodyFontSize}" />
        </Style>
        <Thickness x:Key="ComboBoxEditableTextPadding">38,12,32,12</Thickness>
        <Style x:Key="ReorganizeActionStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{ThemeResource EgActionGlassBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource EgTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="ReorganizeToggleStyle" TargetType="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="50" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ContentDialog.Resources>
    <ContentDialog.Title>
        <Grid x:Name="ReorganizeTitle" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8DE;" Foreground="{ThemeResource EgTextDimBrush}" />
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="手动整理" Style="{StaticResource EgSectionTitleStyle}" />
                <TextBlock x:Name="ReorganizeSubtitle" Style="{StaticResource EgCaptionStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
            <Button x:Name="DismissReorganize" Grid.Column="2" Click="OnDismiss" Style="{StaticResource EgIconButtonStyle}"
                AutomationProperties.Name="关闭手动整理" ToolTipService.ToolTip="关闭">
                <FontIcon Glyph="&#xE8BB;" FontSize="{StaticResource EgSubheadFontSize}" />
            </Button>
        </Grid>
    </ContentDialog.Title>
    <Grid x:Name="DialogBody" MinWidth="260" RowSpacing="12" SizeChanged="OnBodySizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <InfoBar x:Name="Problem" IsClosable="False" IsOpen="False" Severity="Error" />
        <ScrollViewer x:Name="FormScroll" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto" Padding="0,8,8,4">
            <StackPanel Spacing="10">
                <ContentControl x:Name="FormPanel" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="24">
                        <StackPanel x:Name="HistoryLookupPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock x:Name="HistorySummary" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                            <AutoSuggestBox x:Name="HistoryQuery" Header="查找整理历史" PlaceholderText="输入原片名或文件名"
                                QueryIcon="Find" QuerySubmitted="OnHistoryQuery" />
                            <ComboBox x:Name="HistoryBox" Header="原整理记录" HorizontalAlignment="Stretch"
                                DisplayMemberPath="Display" SelectionChanged="OnHistoryChanged" />
                        </StackPanel>
                        <Grid x:Name="DestinationGrid" ColumnSpacing="24" RowSpacing="20" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel x:Name="TargetStorageField" Spacing="6">
                                <Grid>
                                    <ComboBox x:Name="TargetStorageBox" Style="{StaticResource ReorganizePickerStyle}" AutomationProperties.Name="目的存储" PlaceholderText="自动" HorizontalAlignment="Stretch"
                                    DisplayMemberPath="Name" SelectionChanged="OnStorageChanged" />
                                    <FontIcon Glyph="&#xE958;" FontSize="{StaticResource EgSubheadFontSize}" Foreground="{ThemeResource EgTextDimBrush}"
                                        HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
                                    <Border Background="{ThemeResource EgSurfaceBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="18,-9,0,0" Padding="4,0" IsHitTestVisible="False">
                                        <TextBlock x:Name="TargetStorageLabel" Text="目的存储" Style="{StaticResource EgCaptionStyle}" />
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="整理目的存储，选择自动时由后端匹配" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="TransferMethodField" Spacing="6">
                                <Grid>
                                    <ComboBox x:Name="TransferTypeBox" Style="{StaticResource ReorganizePickerStyle}" AutomationProperties.Name="整理方式" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionEdited">
                                    <ComboBoxItem Content="自动" Tag="" /><ComboBoxItem Content="复制" Tag="copy" />
                                    <ComboBoxItem Content="移动（移走源文件）" Tag="move" /><ComboBoxItem Content="硬链接" Tag="link" /><ComboBoxItem Content="软链接" Tag="softlink" />
                                </ComboBox>
                                    <FontIcon Glyph="&#xE8AB;" FontSize="{StaticResource EgSubheadFontSize}" Foreground="{ThemeResource EgTextDimBrush}"
                                        HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
                                    <Border Background="{ThemeResource EgSurfaceBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="18,-9,0,0" Padding="4,0" IsHitTestVisible="False">
                                        <TextBlock Text="整理方式" Style="{StaticResource EgCaptionStyle}" />
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="文件操作整理方式，选择自动时使用后端匹配结果或默认规则" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="TargetPathPanel" Spacing="6">
                            <Grid>
                                    <ComboBox x:Name="TargetPathBox" Style="{StaticResource ReorganizePickerStyle}" AutomationProperties.Name="目的路径" PlaceholderText="自动" HorizontalAlignment="Stretch" IsEditable="True"
                                SelectionChanged="OnDirectoryChanged" />
                                    <FontIcon Glyph="&#xE8B7;" FontSize="{StaticResource EgSubheadFontSize}" Foreground="{ThemeResource EgTextDimBrush}"
                                        HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
                                    <Border Background="{ThemeResource EgSurfaceBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="18,-9,0,0" Padding="4,0" IsHitTestVisible="False">
                                        <TextBlock Text="目的路径" Style="{StaticResource EgCaptionStyle}" />
                                    </Border>
                                </Grid>
                            <TextBlock Style="{StaticResource EgCaptionStyle}" Text="整理目的路径，选择自动将由后端按源路径匹配" TextWrapping="Wrap" />
                            <Border x:Name="MatchedPathPanel" Visibility="Collapsed" Padding="12,8" CornerRadius="{StaticResource EgSearchCornerRadius}"
                                Background="{ThemeResource EgAccentSoftBrush}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MatchedPathText" Style="{StaticResource EgBodyStyle}" Foreground="{ThemeResource EgAccentBrush}"
                                        TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button x:Name="UseMatchedPathButton" AutomationProperties.Name="使用匹配路径" Grid.Column="1" Click="OnUseMatchedPath"
                                        VerticalAlignment="Center" Style="{StaticResource ReorganizeActionStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE73E;" FontSize="{StaticResource EgBodyFontSize}" /><TextBlock Text="使用匹配路径" /></StackPanel>
                </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <Grid x:Name="RecognitionGrid" ColumnSpacing="24" RowSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel x:Name="TypeField" Spacing="6">
                                <Grid>
                                    <ComboBox x:Name="TypeBox" Style="{StaticResource ReorganizePickerStyle}" AutomationProperties.Name="类型" HorizontalAlignment="Stretch" SelectionChanged="OnTypeChanged">
                                    <ComboBoxItem Content="自动" Tag="" /><ComboBoxItem Content="电影" Tag="电影" /><ComboBoxItem Content="电视剧" Tag="电视剧" />
                                </ComboBox>
                                    <FontIcon Glyph="&#xE714;" FontSize="{StaticResource EgSubheadFontSize}" Foreground="{ThemeResource EgTextDimBrush}"
                                        HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
                                    <Border Background="{ThemeResource EgSurfaceBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="18,-9,0,0" Padding="4,0" IsHitTestVisible="False">
                                        <TextBlock Text="类型" Style="{StaticResource EgCaptionStyle}" />
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="文件的媒体类型" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="MediaSourceField" Spacing="6">
                                <Grid>
                                    <ComboBox x:Name="SourceBox" Style="{StaticResource ReorganizePickerStyle}" AutomationProperties.Name="数据源" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="OnSourceChanged" />
                                    <FontIcon Glyph="&#xE1A5;" FontSize="{StaticResource EgSubheadFontSize}" Foreground="{ThemeResource EgTextDimBrush}"
                                        HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
                                    <Border Background="{ThemeResource EgSurfaceBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="18,-9,0,0" Padding="4,0" IsHitTestVisible="False">
                                        <TextBlock Text="数据源" Style="{StaticResource EgCaptionStyle}" />
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="默认使用后台识别设置，可为本次整理与刮削单独切换" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="IdentityGrid" ColumnSpacing="24" RowSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel x:Name="MediaIdPanel" Spacing="6">
                                <AutoSuggestBox x:Name="MediaIdBox" Header="媒体编号" PlaceholderText="留空自动识别，或输入片名查找"
                                    QueryIcon="Find" TextChanged="OnMediaIdChanged" QuerySubmitted="OnMediaIdQuery" SuggestionChosen="OnSuggestionChosen" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="用所选数据源的原生编号。" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="SeasonField" Spacing="6">
                                <TextBox x:Name="SeasonBox" Header="季（特别篇为 0）" PlaceholderText="留空自动识别" TextChanged="OnEdited" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="留空按文件名识别，特别篇填 0。" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="EpisodeField" Spacing="6">
                                <TextBox x:Name="EpisodeBox" Header="集（如 1 或 1,2）" PlaceholderText="起始集,终止集" TextChanged="OnEdited" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="写单集或起始集,终止集。" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="EpisodeGroupPanel" Spacing="6">
                                <ComboBox x:Name="EpisodeGroupBox" Header="剧集组" PlaceholderText="默认排序，或填写剧集组编号" HorizontalAlignment="Stretch"
                                    IsEditable="True" DisplayMemberPath="Label" SelectionChanged="OnSelectionEdited" />
                                <TextBlock x:Name="EpisodeGroupHint" Style="{StaticResource EgCaptionStyle}" Text="可填 TMDB 剧集组编号。" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="EpisodeFormatField" Spacing="6">
                                <TextBox x:Name="EpisodeFormatBox" Header="集数定位" PlaceholderText="使用 {ep} 定位集数" TextChanged="OnEdited" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="用 {ep} 标记集数位置。" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="EpisodeOffsetField" Spacing="6">
                                <TextBox x:Name="EpisodeOffsetBox" Header="集数偏移" PlaceholderText="如 -10 或 EP*2" TextChanged="OnEdited" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="按表达式调整识别到的集号。" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="FileOptionsGrid" ColumnSpacing="24" RowSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel x:Name="PartField" Spacing="6">
                                <Grid>
                                    <TextBox x:Name="PartBox" Style="{StaticResource ReorganizeTextStyle}" AutomationProperties.Name="指定Part" PlaceholderText="如 part1" TextChanged="OnEdited" />
                                    <FontIcon Glyph="&#xE8C8;" FontSize="{StaticResource EgSubheadFontSize}" Foreground="{ThemeResource EgTextDimBrush}"
                                        HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
                                    <Border Background="{ThemeResource EgSurfaceBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="18,-9,0,0" Padding="4,0" IsHitTestVisible="False">
                                        <TextBlock Text="指定Part" Style="{StaticResource EgCaptionStyle}" />
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="指定Part，如part1" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="MinimumSizeField" Spacing="6">
                                <Grid>
                                    <TextBox x:Name="MinSizeBox" Style="{StaticResource ReorganizeTextStyle}" AutomationProperties.Name="最小文件大小（MB）" Text="0" TextChanged="OnEdited" />
                                    <FontIcon Glyph="&#xE8A5;" FontSize="{StaticResource EgSubheadFontSize}" Foreground="{ThemeResource EgTextDimBrush}"
                                        HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
                                    <Border Background="{ThemeResource EgSurfaceBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="18,-9,0,0" Padding="4,0" IsHitTestVisible="False">
                                        <TextBlock Text="最小文件大小（MB）" Style="{StaticResource EgCaptionStyle}" />
                                    </Border>
                                </Grid>
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="只整理大于最小文件大小的文件" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="FolderOptionsGrid" ColumnSpacing="24" RowSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel x:Name="TypeFolderField" Spacing="6">
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ToggleSwitch x:Name="TypeFolderToggle" Style="{StaticResource ReorganizeToggleStyle}" Toggled="OnFolderOptionChanged" AutomationProperties.Name="按类型分类" />
                                    <TextBlock Grid.Column="1" Text="按类型分类" Style="{StaticResource EgBodyStyle}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="整理时目的路径下按媒体类型添加子目录" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="CategoryFolderField" Spacing="6">
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ToggleSwitch x:Name="CategoryFolderToggle" Style="{StaticResource ReorganizeToggleStyle}" Toggled="OnFolderOptionChanged" AutomationProperties.Name="按类别分类" />
                                    <TextBlock Grid.Column="1" Text="按类别分类" Style="{StaticResource EgBodyStyle}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="整理时在目的路径下按媒体类别添加子目录" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="ScrapeField" Spacing="6">
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ToggleSwitch x:Name="ScrapeToggle" Style="{StaticResource ReorganizeToggleStyle}" Toggled="OnFolderOptionChanged" AutomationProperties.Name="刮削元数据" />
                                    <TextBlock Grid.Column="1" Text="刮削元数据" Style="{StaticResource EgBodyStyle}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="整理完成后自动刮削元数据" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="FromHistoryField" Spacing="6">
                                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ToggleSwitch x:Name="FromHistoryToggle" Style="{StaticResource ReorganizeToggleStyle}" Toggled="OnFromHistoryChanged" AutomationProperties.Name="复用历史识别信息" />
                                    <TextBlock Grid.Column="1" Text="复用历史识别信息" Style="{StaticResource EgBodyStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="使用历史整理记录中已识别的媒体信息" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ContentControl>
                <ItemsControl x:Name="PreviewList" ItemsSource="{x:Bind Lines}" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="moviepilot:MoviePilotTransferLine">
                            <StackPanel Spacing="4" Padding="10" Margin="0,0,0,8" Background="{ThemeResource EgSurfaceAltBrush}">
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="{x:Bind Source}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Style="{StaticResource EgBodyStyle}" Text="{x:Bind Headline}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="{x:Bind StatusLine}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="ConfirmationPanel" Visibility="Collapsed" Padding="12" Background="{ThemeResource EgSurfaceAltBrush}" CornerRadius="{StaticResource EgCardCornerRadius}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="ConfirmationText" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                        <CheckBox x:Name="ConfirmChanges" Content="我已核对源文件、目标路径和旧记录的影响" Checked="OnConfirmed" Unchecked="OnConfirmed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="10">
            <Border Height="1" Background="{ThemeResource EgBorderBrush}" />
            <Grid x:Name="ProgressRow" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ProgressRing x:Name="PreviewRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                <TextBlock x:Name="PreviewSummary" Grid.Column="1" Style="{StaticResource EgCaptionStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
            <Grid x:Name="ActionsGrid" ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Button x:Name="PreviewButton" AutomationProperties.Name="预览" Click="OnPreview" Style="{StaticResource ReorganizeActionStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE890;" FontSize="{StaticResource EgBodyFontSize}" /><TextBlock Text="预览" /></StackPanel>
                </Button>
                <Button x:Name="QueueButton" AutomationProperties.Name="加入整理队列" Grid.Column="1" Click="OnQueueSubmit" Style="{StaticResource ReorganizeActionStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="{StaticResource EgBodyFontSize}" /><TextBlock Text="加入整理队列" /></StackPanel>
                </Button>
                <Button x:Name="ReorganizeButton" AutomationProperties.Name="重新整理" Grid.Column="3" Click="OnReorganizeSubmit" Style="{StaticResource AccentButtonStyle}" MinHeight="36">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="{StaticResource EgBodyFontSize}" /><TextBlock Text="重新整理" /></StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</ContentDialog>
