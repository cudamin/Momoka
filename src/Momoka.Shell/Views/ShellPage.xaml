        </Grid>

        <!-- Gallery MainWindow.xaml at 14a4a1a2b8ddc527dc4a7d5f7e743d7c2bc97db7:
             标题栏用原生 AutoSuggestBox、Find 和 TextChanged/QuerySubmitted，适配现有窗口挖洞及搜索页生命周期。
             Copyright (c) Microsoft Corporation. Licensed under the MIT License. -->
        <AutoSuggestBox
            x:Name="TitleSearchBox"
            x:Uid="ShellPage_TitleSearchBox"
            Height="34"
            Margin="0,7,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            VerticalContentAlignment="Center"
            CornerRadius="8"
            TextBoxStyle="{StaticResource EgSearchTextBoxStyle}"
            PlaceholderText="搜索媒体库、订阅等"
            QueryIcon="Find"
            GotFocus="OnTitleSearchGotFocus"
            TextChanged="OnTitleSearchTextChanged"
            QuerySubmitted="OnTitleSearchSubmitted"
            Visibility="Collapsed">
            <AutoSuggestBox.Resources>
                <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="EgBorderBrush" />
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
            </AutoSuggestBox.Resources>
        </AutoSuggestBox>

    </Grid>

        <!-- 账号那一颗：2026-11-13 用户令「人像图标移到最小化左边、和搜索栏对齐」—— 侧边栏模式里它不再跟着
             设置一起蹲在窗口左下角，而是回到标题栏右上角、系统那三颗窗口按钮左边，只留那一颗人像字形。
             于是「栏里的账号」和「标题栏里的账号」又合成一个落位，服务器／用户／注销那张菜单始终只有一份。

             两档的样子：侧边栏模式那一档是 40×40 的方格里一颗人像（和栏里那些按钮同一块方格、同一条中线，
             中心 y=24 与正中那颗搜索框对齐）；非侧边栏模式那一档仍是「名字 · 服务器」那一段文字，从顶下 4 起。

             它站在窗口算成标题栏的那 48 像素里，所以得像左边那一排一样挖洞（见 ReportTitleBarHoles）。

             设置不再跟着它走：那颗现在是侧边栏自己的页脚项（NavigationView.FooterMenuItems，见下面那条
             Sidebar），尺寸、右沿、图标格子都由框架按同一条度量算，不必再手摆一个「并排还是上下叠」。 -->
        <!-- 这里的边距只是首次布局前的一个近似值：每次落位都由 ApplyAccountCluster 按
             TitleBar.RightInset + 8 重算（系统那三颗在 Tall 档是 144 宽）。 -->
        <Grid
            x:Name="AccountCluster"
            Canvas.ZIndex="11"
            Margin="0,4,152,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
            <Button
                x:Name="AccountButton"
                x:Uid="ShellPage_AccountButton"
                Padding="10,3"
                MaxWidth="240"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Left"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="{StaticResource EgCardCornerRadius}"
                Visibility="Collapsed">
                <!-- 外一层两列（字形、文字）而不是 StackPanel：StackPanel 横向量孩子时给的是无限宽，
                     里面那几格 `*` 因此退化成 `Auto`，服务器名长了只能被按钮裁掉、截不出省略号。
                     这里第二列是 `*`，文字那一格拿到的是按钮真正的宽度，超了会截字。列间距写 0 ——
                     字形在侧边栏那一档才露面，格与格之间那道 8 会白占一段，把它挤得偏左。 -->
                <Grid ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 侧边栏模式那一档只留这一颗人像：栏里放不下名字和服务器名，而标题栏右上角那一格
                         只有 40 见方。字号取 EgTitleFontSize（20）—— 这一排的图标是 28 的放大框（实测墨高
                         约 22），16 那档放进 40 的方格会显小；走刻度键而不是内联数字。 -->
                    <FontIcon
                        x:Name="AccountGlyph"
                        Grid.Column="0"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="{StaticResource EgTitleFontSize}"
                        Glyph="&#xE77B;"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />

                    <!-- 两格文字：2026-11-13 起只剩一行这一种排法。侧边栏模式里账号只留一颗人像（名字和服务器名
                         都放不下），两行那一档随之退役 —— 现在唯一露字的地方是标题栏右上角，那里只有 48 像素高，
                         13 号那行自己就 17，两行本来就装不进。名字、中间那颗「·」、服务器名从左排到右，
                         服务器名占 `*`、长了截省略号。 -->
                    <Grid x:Name="AccountText" Grid.Column="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="AccountUser"
                    x:Uid="ShellPage_AccountUser"
                            Grid.Column="0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />

                        <!-- 中间那个「·」：把名字和服务器隔开，墨跟着服务器那一行走（淡的一支）。-->
                        <TextBlock
                            x:Name="AccountDot"
                            Grid.Column="1"
                            FontSize="13"
                            Text="·"
                            VerticalAlignment="Center" />

                        <!-- 服务器名走读数字（EgDataStyle）：和页头右上角那行、和卡片上的年份时长
                             是同一种字。它是机器串，不是一句话。 -->
                        <TextBlock
                            x:Name="AccountServer"
                    x:Uid="ShellPage_AccountServer"
                            Grid.Column="2"
                            Style="{StaticResource EgDataStyle}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />

                        <!-- 朝下：菜单从这颗按钮底下落出来（标题栏右上角那一档没有别的落法）。 -->
                        <FontIcon
                            x:Name="AccountChevron"
                            Grid.Column="3"
                            FontSize="12"
                            Glyph="&#xE70D;"
                            VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            <Button.Flyout>
                <Flyout x:Name="AccountMenu" Placement="BottomEdgeAlignedRight">
                    <Flyout.FlyoutPresenterStyle>
                        <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                            <Setter Property="Padding" Value="6" />
                            <Setter Property="Background" Value="{ThemeResource EgFrostBrush}" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MaxWidth" Value="360" />
                            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <StackPanel x:Name="AccountMenuBody" Width="280" Spacing="2">
                        <StackPanel.Resources>
                            <Style x:Key="AccountActionStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="6,3" />
                                <Setter Property="MinHeight" Value="32" />
                                <Setter Property="FontSize" Value="{StaticResource EgCaptionFontSize}" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock x:Name="AccountIdentityItem" AutomationProperties.AutomationId="AccountIdentityStatus"
                            Margin="6,3" Style="{StaticResource EgCaptionStyle}" FontSize="{StaticResource EgEyebrowFontSize}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AccountOnlineItem" Margin="6,0" Style="{StaticResource EgCaptionStyle}" FontSize="{StaticResource EgEyebrowFontSize}" Visibility="Collapsed" />
                        <Grid x:Name="AggregateModeRow" Margin="6,3" ColumnSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="聚合模式" Style="{StaticResource EgBodyStyle}" FontSize="{StaticResource EgCaptionFontSize}" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="AggregateModeItem" Grid.Column="1" OnContent="开" OffContent="关"
                                MinWidth="0" FontSize="{StaticResource EgCaptionFontSize}" AutomationProperties.Name="聚合模式" Toggled="OnAggregateModeToggled">
                                <ToggleSwitch.Resources>
                                    <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="EgAccentBrush" />
                                    <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="EgAccentBrush" />
                                    <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="EgAccentBrush" />
                                    <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="EgTextOnAccentBrush" />
                                    <StaticResource x:Key="ToggleSwitchKnobFillOnPointerOver" ResourceKey="EgTextOnAccentBrush" />
                                    <StaticResource x:Key="ToggleSwitchKnobFillOnPressed" ResourceKey="EgTextOnAccentBrush" />
                                </ToggleSwitch.Resources>
                            </ToggleSwitch>
                        </Grid>
                        <ListView x:Name="AccountProfileList" MaxHeight="256" SelectionMode="None"
                            AutomationProperties.Name="服务器与账号">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="32" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <Button x:Name="ServerListsEntry" Content="服务器清单" Visibility="Collapsed" Style="{StaticResource AccountActionStyle}" Click="OnServerListsClicked" />
                        <Button x:Name="AddServerItem" x:Uid="ShellPage_AddServerItem" Content="添加服务器…" Style="{StaticResource AccountActionStyle}" Click="OnAddServerClicked" />
                        <Button x:Name="AddAccountItem" x:Uid="ShellPage_AddAccountItem" Content="添加账号…" Style="{StaticResource AccountActionStyle}" Click="OnAddAccountClicked" />
                        <Button x:Name="AccountSignOutItem" x:Uid="ShellPage_AccountSignOutItem" Content="注销" Style="{StaticResource AccountActionStyle}" Click="OnSignOut" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
            </Button>
        </Grid>

        <!-- 页面那一块，从窗口最左边开始 —— 侧边栏删掉之后这里再没有第二列，所以从前那道竖发丝线（面板和
             片场之间那一根）跟着走了，框架给「工作区」画的那道边、那个圆角、那圈边距也一起没了（它们是
             NavigationView 模板的东西）。

             2026-11-14 侧栏并入商店模式：商店用上外边距 48，让标题栏直接露出窗口 Mica；沉浸恢复旧版
             上内边距 48，让画布铺入标题栏。页面起点始终是 48，切换只改变画布上沿（见 ApplySidebarLayout）。

             **整棵树唯一画窗口画布的地方（2026-11-12，用户令「改为Mica」）**：EgCanvasBrush 是压在 Mica 上
             的一层 60% 窗口色，各页面的根背景因此都写 Transparent —— 见 Palette.xaml 那颗键的注释。这一块
             不上底色的话，页面背后就是一块裸的 Mica，正文压上去会花；上两层的话 Mica 又白开。换底色、换
             浓度都只改这一行和 Palette/ThemeHost 那三处。

             这一块整个收起（登录页、播放时）就是「浏览态在不在」，所以 Visibility 写在它身上：从前那是
             NavigationView 的活。 -->
        <Grid
            x:Name="ContentHost"
            Background="{ThemeResource EgCanvasBrush}"
            Margin="0,48,0,0"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 左右 24，和 EgPageMargin 的左右 24 一样：面包屑和它底下那块场记板因此左对齐在同一
                 条竖线上。原来是 18，于是「媒体库 › 剧名」比页面标题往左出去 10 像素 —— 一整条别的
                 都对齐了的界面里，这种 10 像素是最显眼的那种脏。

                 底色和墨都由 PaintTitleInk 画，这里不写：详情页的剧照要「跟主页一样，占满标题栏」，
                 也就是从窗口顶边一路铺到这一行的底下，那时这一行必须是透明的 —— 一条实心条压在图上
                 就是那个要求要去掉的黑边。两种底两种墨，一处判断，写在代码里那一处。

                 ZIndex 而不是挪声明顺序：ContentFrame 是后一个孩子，天生画在这一行的上面，而页面里
                 那张固定的剧照正是往上顶过这一行的。数字提上来，字就在图上；顺序不动，读这个文件的人
                 还是先看到面包屑、后看到页面。 -->
            <Grid
                x:Name="TrailBar"
                Canvas.ZIndex="1"
                Padding="32,12,32,12"
                Visibility="Collapsed">
                <Grid.Resources>
                    <!-- 这一行的墨：字和字中间那个人字尖共用一支。
                         一支可改颜色的画刷、不是两个键各写一个色：改字典里的键对已经画出来的那几格
                         没有用（它们握着的是解析时那个对象），改这一个对象的 Color 才当场跟着变 ——
                         和 ThemeHost、和标题栏那两支墨同一个道理。
                         人字尖归框架的模板画，认的是 BreadcrumbBarNormalForegroundBrush 这个键，所以
                         构造时把同一支画刷也挂到那个键上（见 ShellPage.xaml.cs）。 -->
                    <SolidColorBrush x:Key="EgTrailInkBrush" />
                </Grid.Resources>

                <!-- ItemsSource is assigned in code: the trail is a private field, and a breadcrumb
                     of one entry only repeats the heading the page draws right below this row. -->
                <BreadcrumbBar
                    x:Name="Trail"
                    ItemClicked="OnBreadcrumbClicked"
                    VerticalAlignment="Center">
                    <!-- 走读数字：一条路径是「你在哪」的机器串，不是一句话，所以和页头右上角那行、
                         和账号下面那行服务器名同一种字。Binding 而不是 x:Bind —— 一格面包屑的数据
                         就是那个 Crumb 本身，靠它的 ToString 出字，没有属性可绑。
                         Foreground 写在这里而不是让 EgDataStyle 说：那支样式自己设了 Foreground，
                         而写在格子上的值压得过样式里的 setter。 -->
                    <BreadcrumbBar.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Foreground="{StaticResource EgTrailInkBrush}"
                                Style="{StaticResource EgDataStyle}"
                                Text="{Binding}" />
                        </DataTemplate>
                    </BreadcrumbBar.ItemTemplate>
                </BreadcrumbBar>
            </Grid>

            <!-- 浏览导航由 BrowseTransition 直接交接新页，页面内容的入场各自管理。 -->
            <Frame x:Name="ContentFrame" Grid.Row="1" />

        </Grid>

        <!-- 折叠侧栏的媒体库悬停预览（2026-11-13 用户令「侧边栏折叠时，媒体库鼠标悬停也添加一个 ui 动画，
             从左到右扩出来，显示在内容区，不要遮挡侧边栏，支持查看媒体库名、媒体封面，聚合模式下支持查看更多」）：
             一条跟着鼠标所在库图标走的浮层，左沿钉在栏右边（代码里算，永远不压住 56 宽的图标栏），盖在内容区上面。
             底色用 EgFrostBrush —— 它是一块短暂浮层，不是长期窗口基底（材质分工见 CLAUDE.md 的材质表）。

             内容只有三块：库名/服务器那一行、最多三张媒体封面、以及聚合模式下的一颗「查看更多」。封面在代码里
            按面板宽现摆，面板本身不做虚拟化 —— 一次最多三张，没有长列表要收。 -->
        <Border
            x:Name="LibraryPreviewPanel"
            Canvas.ZIndex="2"
            Width="340"
            Padding="16"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{ThemeResource EgFrostBrush}"
            BorderBrush="{ThemeResource EgBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource EgCardCornerRadius}"
            RenderTransformOrigin="0,0.5"
            Visibility="Collapsed"
            PointerEntered="OnLibraryPreviewPointerEntered"
            PointerExited="OnLibraryPreviewPointerExited">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock
                        x:Name="LibraryPreviewTitle"
                        MaxLines="1"
                        Style="{StaticResource EgSubheadStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="LibraryPreviewMeta"
                        MaxLines="1"
                        Style="{StaticResource EgCaptionStyle}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="Collapsed" />
                </StackPanel>

                <Grid Grid.Row="1" MinHeight="120">
                    <Grid x:Name="LibraryPreviewCovers" ColumnSpacing="10" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <ProgressRing
                        x:Name="LibraryPreviewLoading"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsActive="False" />
                    <TextBlock
                        x:Name="LibraryPreviewEmpty"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource EgCaptionStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </Grid>

                <Button
                    x:Name="LibraryPreviewMore"
                    Grid.Row="2"
                    AutomationProperties.AutomationId="SidebarLibraryPreviewMore"
                    Click="OnLibraryPreviewMoreClicked"
                    Content="查看更多"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource EgSecondaryButtonStyle}"
                    Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- 只承载导航菜单，页面仍留在原来的 Frame 中。关闭模式时不改页面的父节点或返回栈。

             **2026-10-13：这条栏自带的那颗 ≡ 收掉了**（IsPaneToggleButtonVisible="False"）—— 它挪到窗口
             左上角（标题的位置）当标题栏那一排的第一颗（见 NavToggleButton）。收掉它换来的正是「菜单项往上顶
             到标题栏下沿」：那颗开关原先在栏里占着一格，主页/搜索那几项因此被压到它下面。

             **2026-11-13 设置那颗又回到 FooterMenuItems**（用户令「统一侧边栏按钮的大小」）：2026-10-13 把它
             搬出去，是为了和账号「展开并排、折叠上下叠」；现在账号已回到标题栏右上角，栏底只剩它一颗，页脚项
             反而最合适 —— 尺寸、右沿、图标格子都由框架按栏里那些条目同一条度量算，手摆两档的代码整段删掉。
             它 `SelectsOnInvoked="False"`：开的是另一个窗口，不该把这一页的目的地改掉或点亮。

             **底色 2026-11-12 晚清掉，2026-11-14 又按用户令加回来**：清掉是用户令「侧边栏和标题栏采用云母
             Alt」；11-14 用户指出「侧边栏与内容区之间对比度不够高」，要求侧栏加深一层面色。于是这一块铺
             EgSidebarBrush（85% 窗口色，比内容画布的 60% 更实一档，15% 的 Mica Alt 仍透上来），栏作为一整列
             （含左上角的应用名）自带分界，标题栏右侧仍只露材质。栏自己的 NavigationViewDefaultPaneBackground
             早在 2026-10-14 就钉成 Transparent，所以整条栏只有这一道底，没有第二道面。 -->
        <Grid x:Name="SidebarHost" Canvas.ZIndex="1" HorizontalAlignment="Left"
            Background="{ThemeResource EgSidebarBrush}" Visibility="Collapsed">
            <NavigationView x:Name="Sidebar" Margin="0,48,0,0"
                PaneDisplayMode="Left" OpenPaneLength="256" CompactPaneLength="56"
                IsPaneOpen="True" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsTitleBarAutoPaddingEnabled="False" AlwaysShowHeader="False"
                ItemInvoked="OnSidebarItemInvoked" SelectionChanged="OnSidebarSelectionChanged">
                <!-- 栏里那几项的度量（2026-11-13 用户令「统一侧边栏按钮的大小」＋「参考 codex 窗口边框的宽度
                     和高度」）：**订在 NavigationView 自己身上**，而不是应用级调色板 —— 元素级资源是最近的一层，
                     模板里的 ThemeResource 一定先找到这几颗，不会被框架主题字典里同名的 36/16/4,2 抢走。

                     栏 56 宽、按钮左右各留 4 → 方格 48 宽、40 高；框架给条目的图标格等于栏宽减 8（56−8=48），
                     正好和方格同宽，字形因此居中落在栏的中线 28 上 —— 标题栏那一排（托盘 40、字形 28、缩进 8）
                     的字形中线也是 28，用户要的「返回键和下面那一列对齐」就是这条线。图标盒 16→20（模板里那层
                     Viewbox 按它缩放，栏里所有图标一起放大，不用逐个改字号）；条目 36→40 高、上下各 2
                     → 一格 44 的行。

                     选中那一项用实心底（用户令「切换到对应页面后按钮切换为实心」）：框架默认只是 6% 白，
                     压在云母上几乎看不出来。取 EgSurfaceHoverBrush —— 不透明、和别处的悬停面同一支角色色，
                     换主题时由 ThemeHost 顺手涂过去。 -->
                <NavigationView.Resources>
                    <x:Double x:Key="NavigationViewItemOnLeftMinHeight">40</x:Double>
                    <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">20</x:Double>
                    <Thickness x:Key="NavigationViewItemButtonMargin">4,2</Thickness>
                    <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="EgSurfaceHoverBrush" />
                    <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="EgSurfaceHoverBrush" />
                    <StaticResource x:Key="NavigationViewItemBackgroundSelectedPressed" ResourceKey="EgSurfaceHoverBrush" />
                </NavigationView.Resources>
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="SidebarHome" Content="主页" Tag="home" Icon="Home" />
                    <!-- 「搜索」这一项 2026-11-13 按用户令删掉（「开启侧边栏模式时删除侧边栏的搜索按钮」）：
                         搜索入口只剩标题栏正中那颗框（窄窗没有替代入口），点它进搜索页。 -->
                    <NavigationViewItem x:Name="SidebarFavorites" Content="收藏" Tag="favorites" Visibility="Collapsed">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xEB51;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <!-- 两个分区标题（2026-10-13 晚）：媒体库那几项和 MoviePilot 那两条订阅各归一段，订阅段
                         排在媒体库段下面（用户：「侧边栏展开时新增订阅分区，放在媒体库下面」）。媒体库那几项
                         是运行时插进来的（见 ShellPage.Sidebar.cs 的 RebuildSidebarLibraries），插在
                         SidebarLibrariesHeader 之后、SidebarSubscriptionsHeader 之前 —— 所以这两条标题
                         的先后就是两段的先后，别把订阅标题挪到媒体库标题上面去。

                         分区标题只有栏展开时才画得出字（收成 56 宽的图标栏时框架把标题整条收掉），这正是
                         「侧边栏展开时新增订阅分区」那一句要的样子。「订阅」这条的可见性跟两条订阅入口
                         同进同退，见 ShellPage.Sidebar.cs 的 SyncSidebar。 -->
                    <NavigationViewItemHeader x:Name="SidebarLibrariesHeader" Content="媒体库" Visibility="Collapsed" />
                    <NavigationViewItemHeader x:Name="SidebarSubscriptionsHeader" Content="订阅" Visibility="Collapsed" />

                    <!-- MoviePilot 的两条订阅入口（2026-10-13）：开关没开或连不上时整条收起，判据是
                         MoviePilotService.Available（见 ShellPage.Sidebar.cs 的 SyncSidebar）。Tag 直接
                         用 HomeLayout 那两把钥匙 —— 主页那两排订阅用的是同一对，改名时一处生效。

                         图标 2026-10-13 晚照 MoviePilot 网页端复刻：网页端主导航里这两条用的是 Material
                         Design Icons 的 movie-open-outline（场记板）和 television（带底座的电视），见
                         work/moviepilot-protocol-*/frontend-v3/src/router/i18n-menu.ts。这里把原图那 24×24
                         的路径按 2/3 缩到 16×16 —— 栏里图标格就是 16 见方（同旁边那几颗 FontIcon），而
                         **PathIcon 不缩放几何也不居中**（见 PlayerPage.xaml 那条实测），照 24 画会被裁掉。
                         MDI 的许可跟着 uosc 那一份走，见 assets/mpv-ui/LICENSE-MaterialIcons.txt。 -->
                    <NavigationViewItem x:Name="SidebarMoviePilotMovies" Content="订阅·电影"
                        Tag="moviepilot:movies" Visibility="Collapsed">
                        <NavigationViewItem.Icon>
                            <PathIcon Data="F1 M 13.89,1.45 L 11.27,1.97 L 13.1,4.33 L 14.41,4.07 L 13.89,1.45 M 9.31,2.36 L 8,2.62 L 9.83,4.97 L 11.14,4.71 L 9.31,2.36 M 6.05,3 L 4.73,3.27 L 6.57,5.63 L 7.87,5.37 L 6.05,3 M 2.77,3.67 L 2.12,3.79 C 1.4,3.93,0.93,4.64,1.07,5.36 L 1.33,6.67 L 4.6,6.02 L 2.77,3.67 M 13.33,8 V 13.33 H 2.67 V 8 H 13.33 M 14.67,6.67 H 1.33 V 13.33 C 1.33,14.07,1.93,14.67,2.67,14.67 H 13.33 C 14.07,14.67,14.67,14.07,14.67,13.33 V 6.67 Z" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="SidebarMoviePilotSeries" Content="订阅·电视剧"
                        Tag="moviepilot:series" Visibility="Collapsed">
                        <NavigationViewItem.Icon>
                            <PathIcon Data="F1 M 14,11.33 H 2 V 3.33 H 14 M 14,2 H 2 A 1.33,1.33 0 0 0 0.67,3.33 V 11.33 A 1.33,1.33 0 0 0 2,12.67 H 5.33 V 14 H 10.67 V 12.67 H 14 A 1.33,1.33 0 0 0 15.33,11.33 V 3.33 A 1.33,1.33 0 0 0 14,2 Z" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <!-- 设置（2026-11-13 回到页脚）：栏里那几项的字形是 16 的 PathIcon/FontIcon，由同一个图标盒
                         放大，这里只换字形本身。名字与提示沿用原来那颗按钮的本地化键。

                         WinUI Gallery, Microsoft (MIT), 6de91feccadfbb0a796b71caedead5a2284f730e:
                         WinUIGallery/Samples/AnimatedIcon/AnimatedIconPage.xaml 的 NavigationView 示例：
                         NavigationViewItem 会在 Normal/PointerOver/Pressed 之间自己驱动 AnimatedIcon，
                         回退仍是同一颗设置齿轮。应用「UI 动画」关闭时由 ShellPage.Sidebar.cs 把 Source
                         置空，只留这颗静态回退。 -->
                    <NavigationViewItem x:Name="SidebarSettings" x:Uid="ShellPage_SidebarSettingsButton"
                        Content="设置" Tag="settings" SelectsOnInvoked="False">
                        <NavigationViewItem.Icon>
                            <AnimatedIcon x:Name="SidebarSettingsIcon">
                                <AnimatedIcon.Source>
                                    <animatedvisuals:AnimatedSettingsVisualSource />
                                </AnimatedIcon.Source>
                                <AnimatedIcon.FallbackIconSource>
                                    <FontIconSource Glyph="&#xE713;" />
                                </AnimatedIcon.FallbackIconSource>
                            </AnimatedIcon>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>
            </NavigationView>
        </Grid>

        <!-- 侧边栏右沿的拖动条（2026-11-14 用户令「新增支持拖动侧边栏边缘调整侧边栏宽度」）：
             一条压在 SidebarHost 与内容区交界上的透明命中带，宽 7、从标题栏下沿（48）到底；指针进入时
             换成左右箭头，按住左键左右拖就改 Sidebar.OpenPaneLength（见 ShellPage.Sidebar.cs）。
             它整体站在内容区这一侧（左沿正好在栏的右沿），因此不会切走栏里滚动条与条目的命中；
             Canvas.ZIndex 高于 SidebarHost（1）、低于外壳那一行（10），标题栏的拖动区不受影响。
             栏收起时一起收起：收成 56 的图标栏没有「拖宽」这一档，开合仍归标题栏那颗折叠键。 -->
        <local:SidebarResizeGrip
            x:Name="SidebarResizeGrip"
            Canvas.ZIndex="2"
            Width="7"
            Margin="256,48,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Background="Transparent"
            AutomationProperties.Name="调整侧边栏宽度"
            Visibility="Collapsed" />

        <local:SignInPage x:Name="SignIn" />

        <local:MusicPlayerBar x:Name="MusicBar" Canvas.ZIndex="12" Visibility="Collapsed"
            VerticalAlignment="Bottom" Margin="20,0,20,16" MaxWidth="1120" />

        <!-- The player, a sibling rather than a page in the frame. It has to be able to take the whole
             window: the island is one shared surface, so anything still visible behind it would paint
             its own opaque background over the region where mpv's child window shows through. -->
        <local:PlayerPage x:Name="Player" Canvas.ZIndex="20" />

        <!-- The shell's one notification channel, replacing the WinForms toast window. Docked at the
             top because the player owns the bottom of the window, and closable because a report of what
             a playback did is worth reading at the user's pace rather than the timer's.
             顶上 52 = 标题栏那 40 加原来的 12：这一条不该压在那排按钮上。 -->
        <InfoBar
            x:Name="Toast"
            Canvas.ZIndex="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,60,0,0"
            MaxWidth="560"
            CornerRadius="16"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</UserControl>
