            </StackPanel>
            <!-- Gallery 14a4a1a2b8ddc527dc4a7d5f7e743d7c2bc97db7/MainWindow.xaml 的 TitleBar.Title
                 使用应用名；本项目保留现有 HWND 标题栏宿主，用原生 TextBlock 放在导航按钮右边。
                 标题独立于按钮行，仍属可拖动区；位置随按钮显隐和侧栏缩进更新。 -->
            <TextBlock x:Name="AppTitleLabel" Text="Momoka" Style="{StaticResource EgBodyStyle}"
                FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"
