<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="Momoka.Shell.Views.MoviePilotMediaManagementDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Close" PrimaryButtonClick="OnConfirm">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </ContentDialog.Resources>
    <Grid MinWidth="280" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock x:Name="SummaryText" Style="{StaticResource EgSubheadStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="WarningText" Style="{StaticResource EgBodyStyle}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar x:Name="Activity" IsIndeterminate="True" />
            <InfoBar x:Name="Notice" IsClosable="False" IsOpen="False" Severity="Error" />
        </StackPanel>
        <ScrollViewer x:Name="RecordScroll" Grid.Row="2" MaxHeight="360" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <TextBox x:Name="RecordDetails" Header="确认的 MP 整理记录与文件范围" IsReadOnly="True" TextWrapping="Wrap"
                AutomationProperties.Name="MP 整理记录与源、媒体库文件范围" />
        </ScrollViewer>
    </Grid>
</ContentDialog>
