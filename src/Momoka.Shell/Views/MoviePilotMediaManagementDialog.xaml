<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="Momoka.Shell.Views.MoviePilotMediaManagementDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momoka.Shell.Views"
    xmlns:vm="using:Momoka.Shell.ViewModels"
    DefaultButton="Close" PrimaryButtonClick="OnConfirm">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1160</x:Double>
        <Style x:Key="RecordContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </ContentDialog.Resources>
    <ContentDialog.CloseButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource EgActionGlassBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource EgTextBrush}" />
        </Style>
    </ContentDialog.CloseButtonStyle>
    <Grid x:Name="ManagementPanel" Width="1060" MaxHeight="660" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock x:Name="SummaryText" Style="{StaticResource EgSubheadStyle}" TextWrapping="Wrap" MaxLines="2"
                TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
            <local:WrapRow x:Name="ScopeSummary" Spacing="8" Visibility="Collapsed">
                <Border Padding="10,5" CornerRadius="{StaticResource EgCornerBadgeCornerRadius}" Background="{ThemeResource EgSurfaceAltBrush}">
                    <TextBlock x:Name="HistoryScope" Style="{StaticResource EgCaptionStyle}" />
                </Border>
                <Border Padding="10,5" CornerRadius="{StaticResource EgCornerBadgeCornerRadius}" Background="{ThemeResource EgSurfaceAltBrush}">
                    <TextBlock x:Name="SourceScope" Style="{StaticResource EgCaptionStyle}" />
                </Border>
                <Border Padding="10,5" CornerRadius="{StaticResource EgCornerBadgeCornerRadius}" Background="{ThemeResource EgSurfaceAltBrush}">
                    <TextBlock x:Name="DestinationScope" Style="{StaticResource EgCaptionStyle}" />
                </Border>
            </local:WrapRow>
            <TextBlock x:Name="WarningText" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar x:Name="Activity" IsIndeterminate="True" />
            <InfoBar x:Name="Notice" IsClosable="False" IsOpen="False" Severity="Error" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="CountText" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <CheckBox x:Name="SelectAllRecords" Grid.Column="1" Content="全选" IsThreeState="True" Click="OnSelectAll"
                    Visibility="Collapsed" AutomationProperties.Name="全选整理记录" />
            </Grid>
        </StackPanel>
        <ListView x:Name="RecordList" Grid.Row="2" ItemsSource="{x:Bind Records}" SelectionMode="None"
            IsItemClickEnabled="False" ItemContainerStyle="{StaticResource RecordContainerStyle}"
            ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="整理记录与文件操作结果">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:MoviePilotHistoryRecordRow">
                    <Border Padding="16" Background="{ThemeResource EgSurfaceAltBrush}" CornerRadius="{StaticResource EgCardCornerRadius}"
                        Loaded="OnRecordLoaded" DataContextChanged="OnRecordContextChanged">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <CheckBox x:Name="SelectRecord" IsChecked="{x:Bind Media.Selected, Mode=TwoWay}" MinWidth="24" MinHeight="24"
                                Padding="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Media.SelectionName, Mode=OneTime}"
                                Visibility="{x:Bind local:MoviePilotMediaManagementDialog.SelectionVisibility(Selectable), Mode=OneTime}" />
                            <Grid x:Name="RecordCard" Grid.Column="1" ColumnSpacing="18" SizeChanged="OnCardSizeChanged">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid x:Name="CardIdentity" ColumnSpacing="12" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource EgFrameStyle}" Width="42" Height="63" VerticalAlignment="Top">
                                        <Grid>
                                            <FontIcon Glyph="&#xE8B2;" FontSize="{StaticResource EgTitleFontSize}" Foreground="{ThemeResource EgTextDimBrush}"
                                                Visibility="{x:Bind Media.EmptyArtworkVisibility, Mode=OneWay}" />
                                            <Border><Border.Background><ImageBrush ImageSource="{x:Bind Media.Artwork, Mode=OneWay}" Stretch="UniformToFill" /></Border.Background></Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Media.Title, Mode=OneTime}" Style="{StaticResource EgBodyStyle}" FontWeight="SemiBold" MaxLines="2"
                                            TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                        <TextBlock Text="{x:Bind Media.EpisodeLabel, Mode=OneTime}" Style="{StaticResource EgBodyStyle}" FontWeight="SemiBold"
                                            Visibility="{x:Bind local:MoviePilotMediaManagementDialog.MessageVisibility(Media.EpisodeLabel), Mode=OneTime}" />
                                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="CardPaths" Grid.Column="1" ColumnSpacing="8" RowSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Width="1" Background="{ThemeResource EgBorderBrush}" Grid.RowSpan="2" Margin="0,8,0,8" />
                                    <Ellipse Width="6" Height="6" Stroke="{ThemeResource EgTextDimBrush}" Fill="{ThemeResource EgSurfaceAltBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                    <Ellipse Grid.Row="1" Width="6" Height="6" Fill="{ThemeResource EgAccentBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind SourceStorage}" Style="{StaticResource EgCaptionStyle}" Margin="0,1,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind DestinationStorage}" Style="{StaticResource EgCaptionStyle}" Margin="0,1,0,0" />
                                    <StackPanel Grid.Column="2" Spacing="3" ToolTipService.ToolTip="{x:Bind SourcePath}">
                                        <TextBlock x:Name="SourceFolderText" Text="{x:Bind SourceDirectory}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock x:Name="SourceFullPath" Text="{x:Bind SourceName}" Style="{StaticResource EgCaptionStyle}" FontWeight="SemiBold"
                                            Foreground="{ThemeResource EgTextBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="3" ToolTipService.ToolTip="{x:Bind DestinationPath}">
                                        <TextBlock x:Name="DestinationFolderText" Text="{x:Bind DestinationDirectory}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock x:Name="DestinationFullPath" Text="{x:Bind DestinationName}" Style="{StaticResource EgCaptionStyle}" FontWeight="SemiBold"
                                            Foreground="{ThemeResource EgTextBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="CardFacts" Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                    <Border Padding="8,3" CornerRadius="{StaticResource EgCornerBadgeCornerRadius}" Background="{ThemeResource EgSurfaceBrush}" HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind State}" Style="{StaticResource EgCaptionStyle}" FontWeight="SemiBold"
                                            Foreground="{x:Bind local:MoviePilotMediaManagementDialog.StateBrush(NeedsReview, Positive), Mode=OneTime}" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Media.Details, Mode=OneTime}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ResultSteps}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap"
                                        Visibility="{x:Bind local:MoviePilotMediaManagementDialog.ResultVisibility(Selectable), Mode=OneTime}" />
                                </StackPanel>
                                <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{x:Bind Message}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" Margin="0,8,0,0"
                                    Visibility="{x:Bind local:MoviePilotMediaManagementDialog.MessageVisibility(Message), Mode=OneTime}"
                                    Foreground="{ThemeResource EgWarningBrush}" IsTextSelectionEnabled="True" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
