<?xml version="1.0" encoding="utf-8"?>
<!--
  The servers page: one card per saved account, a scan of the local network, and the aggregate-mode switch.

  Every binding here is x:Bind rather than Binding. The difference that matters is not the speed — it is
  that x:Bind is compiled against a named type, so a renamed property fails the build instead of failing
  silently at runtime, which is exactly how the 「当前」 badge below went unnoticed: it was an InfoBadge
  whose Value is an int, given a string, and nothing said so until the row tried to draw.

  Every button is a Command, not a Click handler. A command that cannot run right now is greyed out by the
  framework, which is what the page's old `if (_busy) return;` guards were trying and failing to convey.
-->
<Page
    x:Class="Momoka.Shell.Views.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:emby="using:Momoka.Emby"
    xmlns:local="using:Momoka.Shell.Views"
    xmlns:vm="using:Momoka.Shell.ViewModels"
    Background="{ThemeResource EgWindowBrush}">

    <Page.Resources>
        <!--
          工具栏那三颗：图标加字，压平到底 —— 它们和聚合模式开关共用一条表面，再给每颗键描一圈边框就成了
          三层框套在一起。
        -->
        <Style x:Key="ServersToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!--
          账号卡的主按钮：登录 / 设为默认是这张卡上唯一要读字才知道干什么的动作，所以给它文字和账号图标；
          下线、删除留给右侧两颗图标键，靠提示说明。底色抬一档、描一圈发丝边，和卡片本身分开。
        -->
        <Style x:Key="ServersActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{ThemeResource EgSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="{StaticResource EgBodyFontSize}" />
        </Style>

        <Style x:Key="ServersListContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- 每个账号是独立卡片。服务器模板只分组，不再套一圈服务器卡片。 -->
        <DataTemplate x:Key="AccountTemplate" x:DataType="vm:AccountRow">
            <Border Tag="{x:Bind}"
                Background="{ThemeResource EgSurfaceBrush}"
                BorderBrush="{ThemeResource EgBorderBrush}"
                BorderThickness="{StaticResource EgCardBorderThickness}"
                CornerRadius="{StaticResource EgCardCornerRadius}"
                Margin="0,0,0,10"
                Padding="16,12">
                <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                <Border.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Text="测试服务器连接"
                            Command="{x:Bind Owner.TestCommand}"
                            CommandParameter="{x:Bind ServerGroup}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72C;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Text="新增账号"
                            Command="{x:Bind Owner.AddAccountCommand}"
                            CommandParameter="{x:Bind ServerGroup}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE710;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Text="退出登录（清除保存的令牌）"
                            Command="{x:Bind Owner.SignOutAccountCommand}"
                            CommandParameter="{x:Bind}"
                            Visibility="{x:Bind SignOutVisibility}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8A5;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Text="删除此服务器及全部账号"
                            Command="{x:Bind Owner.DeleteServerCommand}"
                            CommandParameter="{x:Bind ServerGroup}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Border.ContextFlyout>
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <local:WrapRow Spacing="8" RowSpacing="4" VerticalAlignment="Center">
                        <TextBlock Text="≡" VerticalAlignment="Center" Opacity="0.45"
                            ToolTipService.ToolTip="按住卡片拖动调整账号顺序" />
                        <TextBlock
                            Style="{StaticResource EgSectionTitleStyle}"
                            MaxWidth="260"
                            Text="{x:Bind ServerName}"
                            TextTrimming="CharacterEllipsis" />
                        <Border Background="{ThemeResource EgAccentSoftBrush}" CornerRadius="8"
                            Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource EgCaptionStyle}"
                                Foreground="{ThemeResource EgAccentBrush}" Text="{x:Bind KindLabel}" />
                        </Border>
                        <TextBlock Style="{StaticResource EgBodyStyle}" FontWeight="SemiBold"
                            MaxWidth="220" Text="{x:Bind Username}" TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource EgCaptionStyle}"
                            Text="{x:Bind Status}" VerticalAlignment="Center" />
                        <Border Background="{ThemeResource EgAccentSoftBrush}" CornerRadius="10"
                            Padding="8,2" VerticalAlignment="Center" Visibility="{x:Bind OnlineVisibility}">
                            <TextBlock Style="{StaticResource EgCaptionStyle}"
                                Foreground="{ThemeResource EgAccentBrush}" Text="在线" />
                        </Border>
                        <Border Background="{ThemeResource EgAccentBrush}" CornerRadius="10"
                            Padding="8,2" VerticalAlignment="Center" Visibility="{x:Bind CurrentVisibility}">
                            <TextBlock x:Uid="ServersPage_TextBlock1" Style="{StaticResource EgCaptionStyle}"
                                Foreground="{ThemeResource EgTextOnAccentBrush}" />
                        </Border>
                    </local:WrapRow>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="AccountLoginButton"
                            ToolTipService.ToolTip="{x:Bind LoginLabel}"
                            AutomationProperties.Name="{x:Bind LoginLabel}"
                            Visibility="{x:Bind LoginVisibility}"
                            Style="{StaticResource ServersActionButtonStyle}"
                            Command="{x:Bind Owner.LoginAccountCommand}" CommandParameter="{x:Bind}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="{StaticResource EgBodyFontSize}" Glyph="{x:Bind LoginGlyph}" />
                                <TextBlock Text="{x:Bind LoginShortLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AccountOfflineButton"
                            AutomationProperties.Name="下线"
                            ToolTipService.ToolTip="下线（保留已保存的账号）"
                            Visibility="{x:Bind OfflineVisibility}"
                            Style="{StaticResource EgIconButtonStyle}"
                            Command="{x:Bind Owner.TakeOfflineCommand}" CommandParameter="{x:Bind}">
                            <FontIcon Glyph="&#xE7E8;" />
                        </Button>
                        <Button x:Name="AccountDeleteButton" x:Uid="ServersPage_ButtonA2"
                            AutomationProperties.Name="{x:Bind DeleteLabel}"
                            Style="{StaticResource EgIconButtonStyle}"
                            Command="{x:Bind Owner.DeleteAccountCommand}" CommandParameter="{x:Bind}">
                            <FontIcon Glyph="&#xE74D;" />
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource EgCaptionStyle}"
                        Text="{x:Bind Url}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Url}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ServerTemplate" x:DataType="vm:ServerRow">
            <Grid Tag="{x:Bind}">
                <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- 外层拖拽的抓手：账号卡自己的拖拽归内层列表，服务器组的换位从这里按下去。 -->
                <Grid Grid.Column="0" Background="Transparent"
                    ToolTipService.ToolTip="按住拖动调整服务器顺序">
                    <TextBlock Text="⋮⋮" FontSize="{StaticResource EgCaptionFontSize}"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,12,0,0" Opacity="0.45" />
                </Grid>
                <ListView
                    x:Name="AccountList"
                    Grid.Column="1"
                    Tag="{x:Bind Accounts}"
                    AllowDrop="True"
                    CanDragItems="True"
                    CanReorderItems="True"
                    DragItemsCompleted="OnAccountDragCompleted"
                    DragItemsStarting="OnAccountDragStarting"
                    IsSwipeEnabled="False"
                    ItemContainerStyle="{StaticResource ServersListContainerStyle}"
                    ItemsSource="{x:Bind Accounts}"
                    ItemTemplate="{StaticResource AccountTemplate}"
                    Loaded="OnAccountListLoaded"
                    Margin="0"
                    Padding="0"
                    ReorderMode="Enabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionMode="None"
                    Unloaded="OnAccountListUnloaded" />
                <!-- 空服务器仍有登录、删除入口；没有账号时不伪造一张账号卡。 -->
                <Border Grid.Column="1" Background="{ThemeResource EgSurfaceBrush}"
                    BorderBrush="{ThemeResource EgBorderBrush}"
                    BorderThickness="{StaticResource EgCardBorderThickness}"
                    CornerRadius="{StaticResource EgCardCornerRadius}"
                    Margin="0,0,0,10" Padding="16,12" Visibility="{x:Bind EmptyVisibility}">
                    <Grid ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <local:WrapRow Spacing="8" RowSpacing="4" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource EgSectionTitleStyle}" Text="{x:Bind Name}"
                                MaxWidth="260" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource EgCaptionStyle}" Text="{x:Bind KindLabel}"
                                VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource EgCaptionStyle}" Text="未保存账号"
                                VerticalAlignment="Center" />
                        </local:WrapRow>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button x:Name="ServerLoginButton" Style="{StaticResource ServersActionButtonStyle}"
                                AutomationProperties.Name="登录服务器" ToolTipService.ToolTip="登录服务器"
                                Command="{x:Bind Owner.LoginServerCommand}" CommandParameter="{x:Bind}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="{StaticResource EgBodyFontSize}" Glyph="&#xE77B;" />
                                    <TextBlock Text="登录服务器" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ServerDeleteButton" x:Uid="ServersPage_ButtonA5"
                                AutomationProperties.Name="删除服务器" Style="{StaticResource EgIconButtonStyle}"
                                Command="{x:Bind Owner.DeleteServerCommand}" CommandParameter="{x:Bind}">
                                <FontIcon Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource EgCaptionStyle}"
                            Text="{x:Bind Url}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Url}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="PageLayout" Margin="{StaticResource EgPageMargin}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16" RowSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="16" Background="{ThemeResource EgAccentSoftBrush}">
                <FontIcon Glyph="&#xE968;" Foreground="{ThemeResource EgAccentBrush}" FontSize="24" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Uid="ServersPage_Heading" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.Subheading, Mode=OneWay}" Foreground="{ThemeResource EgTextDimBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!--
          工具栏和聚合模式开关同一条表面（用户 2026-10-25：「这两个改到同一行里」）：左边是三个动作，右边是
          开关，开关下面那行说明只在关着的时候占地方 —— 开着的时候它就是结论本身，不必再解释一遍。
        -->
        <Border
            AutomationProperties.AutomationId="ServersAggregateCard"
            Grid.Row="1"
            Background="{ThemeResource EgSurfaceBrush}"
            BorderBrush="{ThemeResource EgBorderBrush}"
            BorderThickness="{StaticResource EgCardBorderThickness}"
            CornerRadius="{StaticResource EgCardCornerRadius}"
            Padding="10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:WrapRow Spacing="2" RowSpacing="2" VerticalAlignment="Center">
                        <Button
                            AutomationProperties.AutomationId="ServersAddButton"
                            Style="{StaticResource ServersToolbarButtonStyle}"
                            Command="{x:Bind ViewModel.NewAccountCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="{StaticResource EgSubheadFontSize}" Glyph="&#xE710;" />
                                <TextBlock x:Uid="ServersPage_AddAccountLabel" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.AutomationId="ServersDiscoverButton"
                            Style="{StaticResource ServersToolbarButtonStyle}"
                            Command="{x:Bind ViewModel.DiscoverCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="{StaticResource EgSubheadFontSize}" Glyph="&#xE721;" />
                                <TextBlock x:Uid="ServersPage_DiscoverLabel" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.AutomationId="ServersRefreshButton"
                            Style="{StaticResource ServersToolbarButtonStyle}"
                            Command="{x:Bind ViewModel.RefreshCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="{StaticResource EgSubheadFontSize}" Glyph="&#xE72C;" />
                                <TextBlock x:Uid="ServersPage_RefreshLabel" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.AutomationId="ServersSortButton"
                            AutomationProperties.Name="{x:Bind ViewModel.SortButtonLabel, Mode=OneWay}"
                            Style="{StaticResource ServersToolbarButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SortTooltip, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.SortButtonLabel, Mode=OneWay}" VerticalAlignment="Center" />
                                <FontIcon FontSize="{StaticResource EgCaptionFontSize}"
                                    Glyph="{x:Bind ViewModel.SortGlyph, Mode=OneWay}" />
                            </StackPanel>
                            <Button.Flyout>
                                <!-- 与库页排序菜单同一种表：选中项带勾，方向箭头只挂在当前字段上。 -->
                                <Flyout x:Name="ServerSortMenu" Placement="Bottom" Opening="OnServerSortMenuOpening">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="4" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="MaxWidth" Value="320" />
                                            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <ListView
                                        x:Name="ServerSortList"
                                        x:FieldModifier="internal"
                                        AutomationProperties.Name="排序方式"
                                        IsItemClickEnabled="True"
                                        ItemClick="OnServerSortItemClick"
                                        SelectionMode="None"
                                        Width="250">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="MinHeight" Value="34" />
                                                <Setter Property="Padding" Value="10,0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ServerSortEntry">
                                                <Grid ColumnSpacing="8" MinWidth="210">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon FontSize="{StaticResource EgCaptionFontSize}"
                                                        Glyph="&#xE73E;" VerticalAlignment="Center"
                                                        Visibility="{x:Bind CheckVisibility}" />
                                                    <TextBlock Grid.Column="1" Style="{StaticResource EgBodyStyle}"
                                                        Text="{x:Bind Label}" TextTrimming="CharacterEllipsis"
                                                        VerticalAlignment="Center" />
                                                    <Button Grid.Column="2"
                                                        AutomationProperties.Name="{x:Bind ArrowName}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Click="OnServerSortDirectionClicked" MinHeight="0"
                                                        MinWidth="0" Padding="4" Tag="{x:Bind Mode}"
                                                        Visibility="{x:Bind ArrowVisibility}">
                                                        <FontIcon FontSize="{StaticResource EgCaptionFontSize}" Glyph="{x:Bind Glyph}" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </local:WrapRow>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.AggregateOptionsVisibility, Mode=OneWay}">
                        <FontIcon
                            FontSize="{StaticResource EgSubheadFontSize}"
                            Foreground="{ThemeResource EgAccentBrush}"
                            Glyph="&#xE8AB;" />
                        <TextBlock FontWeight="SemiBold" Text="聚合模式" VerticalAlignment="Center" />
                        <ToggleSwitch
                            x:Name="AggregateToggle"
                            AutomationProperties.Name="聚合模式"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind ViewModel.AggregateMode, Mode=TwoWay}"
                            OnContent=""
                            OffContent="" />
                    </StackPanel>
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Margin="12,0,12,4"
                    FontSize="{StaticResource EgCaptionFontSize}"
                    Foreground="{ThemeResource EgTextDimBrush}"
                    Text="{x:Bind ViewModel.AggregateNote, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.NoteVisibility, Mode=OneWay}" />
            </Grid>
        </Border>

        <ProgressBar
            Grid.Row="2"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />

        <!-- TwoWay on IsOpen, so dismissing the bar is recorded rather than only drawn: the next
             message has to be able to reopen it. -->
        <InfoBar
            Grid.Row="2"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" />

        <ListView
            AutomationProperties.AutomationId="ServersDiscoveredList"
            Grid.Row="3"
            IsItemClickEnabled="True"
            ItemClick="OnDiscoveredPicked"
            ItemsSource="{x:Bind ViewModel.Discovered, Mode=OneWay}"
            Margin="0,4,0,0"
            Padding="{StaticResource EgScrollBarLane}"
            MaxHeight="184"
            Visibility="{x:Bind ViewModel.DiscoveredVisibility, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="emby:EmbyDiscoveredServer">
                    <Grid ColumnSpacing="12" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource EgAccentBrush}"
                            Glyph="&#xE774;"
                            VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                            <TextBlock
                                FontSize="{StaticResource EgCaptionFontSize}"
                                Foreground="{ThemeResource EgTextDimBrush}"
                                Text="{x:Bind DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ScrollView Grid.Row="4" Padding="{StaticResource EgScrollBarLane}" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{ThemeResource EgSurfaceBrush}" BorderBrush="{ThemeResource EgBorderBrush}"
                    BorderThickness="{StaticResource EgCardBorderThickness}" CornerRadius="{StaticResource EgCardCornerRadius}" Padding="32"
                    Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center" Spacing="16" MaxWidth="400">
                        <FontIcon Glyph="&#xE774;" FontSize="40" Foreground="{ThemeResource EgAccentBrush}" />
                        <TextBlock x:Uid="ServersPage_EmptyHeading" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock x:Uid="ServersPage_TextBlock8" Foreground="{ThemeResource EgTextDimBrush}"
                            TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <ListView
                    x:Name="ServersList"
                    AllowDrop="True"
                    CanDragItems="True"
                    CanReorderItems="True"
                    DragItemsCompleted="OnServerDragCompleted"
                    DragItemsStarting="OnServerDragStarting"
                    IsSwipeEnabled="False"
                    ItemContainerStyle="{StaticResource ServersListContainerStyle}"
                    ItemsSource="{x:Bind ViewModel.Servers, Mode=OneWay}"
                    ItemTemplate="{StaticResource ServerTemplate}"
                    Loaded="OnServerListLoaded"
                    Margin="0"
                    Padding="0"
                    ReorderMode="Enabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionMode="None"
                    Unloaded="OnServerListUnloaded" />
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
