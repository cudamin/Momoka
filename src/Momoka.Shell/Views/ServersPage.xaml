<?xml version="1.0" encoding="utf-8"?>
<!--
  The servers page: saved servers, the accounts on each, a scan of the local network, and what the poster
  cache has taken up on disk.

  Every binding here is x:Bind rather than Binding. The difference that matters is not the speed — it is
  that x:Bind is compiled against a named type, so a renamed property fails the build instead of failing
  silently at runtime, which is exactly how the 「当前」 badge below went unnoticed: it was an InfoBadge
  whose Value is an int, given a string, and nothing said so until the row tried to draw.

  Every button is a Command, not a Click handler. A command that cannot run right now is greyed out by the
  framework, which is what the page's old `if (_busy) return;` guards were trying and failing to convey.
-->
<Page
    x:Class="Momoka.Shell.Views.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:emby="using:Momoka.Emby"
    xmlns:local="using:Momoka.Shell.Views"
    xmlns:vm="using:Momoka.Shell.ViewModels"
    Background="{ThemeResource EgWindowBrush}">

    <Page.Resources>
        <!-- Declared before the server template that reaches for it: a StaticResource inside a
             DataTemplate is resolved as the dictionary is parsed, so a forward reference fails. -->
        <DataTemplate x:Key="AccountTemplate" x:DataType="vm:AccountRow">
            <Grid ColumnSpacing="10" Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{x:Bind Username}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="{StaticResource EgCaptionFontSize}"
                        Foreground="{ThemeResource EgTextDimBrush}"
                        Text="{x:Bind Status}" />
                </StackPanel>
                <Button x:Name="AccountLoginButton"
                    Grid.Column="1"
                    ToolTipService.ToolTip="{x:Bind LoginLabel}"
                    AutomationProperties.Name="{x:Bind LoginLabel}"
                    Visibility="{x:Bind LoginVisibility}"
                    Style="{StaticResource EgIconButtonStyle}"
                    Command="{x:Bind Owner.LoginAccountCommand}"
                    CommandParameter="{x:Bind}">
                    <FontIcon Glyph="&#xE8A5;" />
                </Button>
                <Button x:Name="AccountSignOutButton"
                    Grid.Column="2" Content="退出"
                    AutomationProperties.Name="退出此账号"
                    Visibility="{x:Bind SignOutVisibility}"
                    Command="{x:Bind Owner.SignOutAccountCommand}"
                    CommandParameter="{x:Bind}" />
                <Button x:Uid="ServersPage_ButtonA2"
                    Grid.Column="3"
                    Style="{StaticResource EgIconButtonStyle}"
                    Command="{x:Bind Owner.DeleteAccountCommand}"
                    CommandParameter="{x:Bind}">
                    <FontIcon Glyph="&#xE74D;" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ServerTemplate" x:DataType="vm:ServerRow">
            <Border
                Background="{ThemeResource EgSurfaceBrush}"
                BorderBrush="{ThemeResource EgBorderBrush}"
                BorderThickness="{StaticResource EgCardBorderThickness}"
                CornerRadius="{StaticResource EgCardCornerRadius}"
                Margin="0,0,0,16"
                Padding="20">
                <StackPanel Spacing="18">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{x:Bind Name}" />
                                    <Border
                                        Background="{ThemeResource EgAccentSoftBrush}"
                                        CornerRadius="8"
                                        Padding="8,2"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="{StaticResource EgCaptionFontSize}"
                                            Foreground="{ThemeResource EgAccentBrush}"
                                            Text="{x:Bind KindLabel}" />
                                    </Border>
                                </StackPanel>
                                <!-- A pill, not an InfoBadge: that control's Value is a number for a
                                     count, and it has no way to show a word. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border
                                        Background="{ThemeResource EgAccentSoftBrush}"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        Visibility="{x:Bind OnlineVisibility}">
                                        <TextBlock
                                            FontSize="{StaticResource EgCaptionFontSize}"
                                            Foreground="{ThemeResource EgAccentBrush}"
                                            Text="在线" />
                                    </Border>
                                    <Border
                                        Background="{ThemeResource EgAccentBrush}"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        Visibility="{x:Bind CurrentVisibility}">
                                        <TextBlock x:Uid="ServersPage_TextBlock1"
                                            FontSize="{StaticResource EgCaptionFontSize}"
                                            Foreground="{ThemeResource EgTextOnAccentBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                Foreground="{ThemeResource EgTextDimBrush}"
                                Text="{x:Bind Url}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button x:Uid="ServersPage_ButtonA3"
                                Style="{StaticResource EgIconButtonStyle}"
                                Command="{x:Bind Owner.TestCommand}"
                                CommandParameter="{x:Bind}">
                                <FontIcon Glyph="&#xE72C;" />
                            </Button>
                            <Button
                                ToolTipService.ToolTip="{x:Bind LoginLabel}"
                                AutomationProperties.Name="{x:Bind LoginLabel}"
                                Style="{StaticResource EgIconButtonStyle}"
                                Command="{x:Bind Owner.LoginServerCommand}"
                                CommandParameter="{x:Bind}">
                                <FontIcon Glyph="&#xE8A5;" />
                            </Button>
                            <Button x:Name="ServerAddAccountButton"
                                ToolTipService.ToolTip="{x:Bind AddAccountLabel}"
                                AutomationProperties.Name="{x:Bind AddAccountLabel}"
                                Style="{StaticResource EgIconButtonStyle}"
                                Command="{x:Bind Owner.AddAccountCommand}" CommandParameter="{x:Bind}">
                                <FontIcon Glyph="&#xE710;" />
                            </Button>
                            <Button x:Uid="ServersPage_ButtonA5"
                                Style="{StaticResource EgIconButtonStyle}"
                                Command="{x:Bind Owner.DeleteServerCommand}"
                                CommandParameter="{x:Bind}">
                                <FontIcon Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border
                        Background="{ThemeResource EgSurfaceAltBrush}"
                        BorderBrush="{ThemeResource EgBorderBrush}"
                        BorderThickness="{StaticResource EgCardBorderThickness}"
                        CornerRadius="{StaticResource EgCardCornerRadius}"
                        Padding="16,14">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ServersPage_TextBlock2" FontWeight="SemiBold" />
                                <TextBlock
                                    Grid.Column="1"
                                    Foreground="{ThemeResource EgTextDimBrush}"
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind AccountSummary}" />
                            </Grid>

                            <!-- 所有账号都可以同时在线；这一页只显示谁在线、谁需要登录。 -->
                            <ItemsControl ItemTemplate="{StaticResource AccountTemplate}" ItemsSource="{x:Bind Accounts}" />

                            <TextBlock x:Uid="ServersPage_TextBlock3"
                                Foreground="{ThemeResource EgTextFaintBrush}"
                                Visibility="{x:Bind EmptyAccountsVisibility}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="PageLayout" Margin="{StaticResource EgPageMargin}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16" RowSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Width="48" Height="48" CornerRadius="16" Background="{ThemeResource EgAccentSoftBrush}">
                <FontIcon Glyph="&#xE968;" Foreground="{ThemeResource EgAccentBrush}" FontSize="24" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Uid="ServersPage_Heading" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.Subheading, Mode=OneWay}" Foreground="{ThemeResource EgTextDimBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <!-- CommandBar keeps every action reachable through its overflow on a narrow settings pane. -->
            <CommandBar Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch"
                DefaultLabelPosition="Right" Background="{ThemeResource EgSurfaceBrush}"
                CornerRadius="12" IsOpen="False">
                <AppBarButton x:Uid="ServersPage_AddAction" AutomationProperties.AutomationId="ServersAddButton"
                    Icon="Add" Command="{x:Bind ViewModel.AddServerCommand}" />
                <AppBarButton x:Uid="ServersPage_DiscoverAction" AutomationProperties.AutomationId="ServersDiscoverButton"
                    Icon="Find" Command="{x:Bind ViewModel.DiscoverCommand}" />
                <AppBarButton x:Uid="ServersPage_RefreshAction" AutomationProperties.AutomationId="ServersRefreshButton"
                    Icon="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
            </CommandBar>
        </Grid>

        <ProgressBar
            Grid.Row="1"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />

        <!-- TwoWay on IsOpen, so dismissing the bar is recorded rather than only drawn: the next
             message has to be able to reopen it. -->
        <InfoBar
            Grid.Row="1"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" />

        <!--
          聚合模式：这台程序连接服务器的行为，不随服务器变化。关着时一次只保持一个在线来源；开着时多台服务器、
          多个账号同时在线。拨一下当场写进设置并让会话收口，不必重启。
        -->
        <Border
            AutomationProperties.AutomationId="ServersAggregateCard"
            Grid.Row="2"
            Background="{ThemeResource EgSurfaceBrush}"
            BorderBrush="{ThemeResource EgBorderBrush}"
            BorderThickness="{StaticResource EgCardBorderThickness}"
            CornerRadius="{StaticResource EgCardCornerRadius}"
            Padding="20,16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="11" Background="{ThemeResource EgAccentSoftBrush}">
                    <FontIcon Glyph="&#xE8AB;" FontSize="{StaticResource EgSubheadFontSize}" Foreground="{ThemeResource EgAccentBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="聚合模式" />
                    <TextBlock
                        FontSize="{StaticResource EgCaptionFontSize}"
                        Foreground="{ThemeResource EgTextDimBrush}"
                        Text="{x:Bind ViewModel.AggregateNote, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    x:Name="AggregateToggle"
                    AutomationProperties.Name="聚合模式"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    IsOn="{x:Bind ViewModel.AggregateMode, Mode=TwoWay}"
                    OnContent=""
                    OffContent="" />
            </Grid>
        </Border>

        <ListView
            AutomationProperties.AutomationId="ServersDiscoveredList"
            Grid.Row="3"
            IsItemClickEnabled="True"
            ItemClick="OnDiscoveredPicked"
            ItemsSource="{x:Bind ViewModel.Discovered, Mode=OneWay}"
            Margin="0,4,0,0"
            MaxHeight="184"
            Visibility="{x:Bind ViewModel.DiscoveredVisibility, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="emby:EmbyDiscoveredServer">
                    <Grid ColumnSpacing="12" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource EgAccentBrush}"
                            Glyph="&#xE774;"
                            VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                            <TextBlock
                                FontSize="{StaticResource EgCaptionFontSize}"
                                Foreground="{ThemeResource EgTextDimBrush}"
                                Text="{x:Bind DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ScrollView Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{ThemeResource EgSurfaceBrush}" BorderBrush="{ThemeResource EgBorderBrush}"
                    BorderThickness="{StaticResource EgCardBorderThickness}" CornerRadius="{StaticResource EgCardCornerRadius}" Padding="32"
                    Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center" Spacing="16" MaxWidth="400">
                        <FontIcon Glyph="&#xE774;" FontSize="40" Foreground="{ThemeResource EgAccentBrush}" />
                        <TextBlock x:Uid="ServersPage_EmptyHeading" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock x:Uid="ServersPage_TextBlock8" Foreground="{ThemeResource EgTextDimBrush}"
                            TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemTemplate="{StaticResource ServerTemplate}" ItemsSource="{x:Bind ViewModel.Servers, Mode=OneWay}" />
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
