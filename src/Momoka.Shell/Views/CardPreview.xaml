<?xml version="1.0" encoding="utf-8"?>
<!-- 边框从原封面撑开；文字保持最终尺寸，详情点击面与播放键是兄弟控件。 -->
<UserControl
    x:Class="Momoka.Shell.Views.CardPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Raw">
    <Grid x:Name="Panel">
        <Grid x:Name="HitRoot">
            <Border x:Name="Surface"
                Background="{ThemeResource EgSurfaceBrush}"
                BorderBrush="{ThemeResource EgBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource EgCardCornerRadius}" />
            <Button x:Name="DetailsButton"
                AutomationProperties.AutomationId="CardPreviewDetails"
                Click="OnDetailsClicked" Padding="0" BorderThickness="0"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="Transparent" CornerRadius="{StaticResource EgCardCornerRadius}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                </Button.Resources>
            </Button>
            <Grid x:Name="ContentRoot" Padding="19" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="10">
                    <StackPanel x:Name="Heading" MinHeight="40" Spacing="8" Margin="0,0,116,0">
                        <Grid x:Name="LogoSlot" Height="44" Visibility="Collapsed">
                            <Image x:Name="LogoImage" Stretch="Uniform" HorizontalAlignment="Left" MaxWidth="220" />
                        </Grid>
                        <TextBlock x:Name="TitleText"
                            MaxLines="2" Style="{StaticResource EgSectionTitleStyle}"
                            TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                        <!-- 专辑的悬停补一行艺术家：卡片底下那行副标题就是它，影视条目不显示。 -->
                        <TextBlock x:Name="ArtistText" MaxLines="1" Margin="0,-2,0,0"
                            Style="{StaticResource EgBodyStyle}" Foreground="{ThemeResource EgTextDimBrush}"
                            TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    </StackPanel>
                    <Grid x:Name="FactsBlock">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="RatingBlock" Orientation="Horizontal" Spacing="4" Margin="0,0,10,0">
                            <FontIcon Glyph="&#xE735;" FontSize="{StaticResource EgCaptionFontSize}" Foreground="{ThemeResource EgAccentBrush}" />
                            <TextBlock x:Name="RatingText" Style="{StaticResource EgCaptionStyle}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="MetaText" Grid.Column="1" Margin="0,0,10,0"
                            Style="{StaticResource EgCaptionStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="GenresText" Grid.Column="2"
                            Style="{StaticResource EgCaptionStyle}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock x:Name="OverviewText" Foreground="{ThemeResource EgTextDimBrush}"
                        MaxLines="2" Style="{StaticResource EgBodyStyle}"
                        TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                </StackPanel>
                <Border x:Name="Media" Grid.Row="1" Margin="0,14,0,0"
                    Background="{ThemeResource EgSurfaceAltBrush}" CornerRadius="{StaticResource EgPosterCornerRadius}"
                    SizeChanged="OnMediaSizeChanged" />
                <StackPanel x:Name="ResumeBlock" Grid.Row="2" Margin="0,14,0,0" Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="CardPreview_Resume" Style="{StaticResource EgCaptionStyle}" />
                        <TextBlock x:Name="ResumeText" Grid.Column="1" HorizontalAlignment="Right"
                            Style="{StaticResource EgDataStrongStyle}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ProgressBar x:Name="ResumeProgress" AutomationProperties.AutomationId="CardPreviewProgress"
                        Minimum="0" Maximum="100" IsIndeterminate="False" Foreground="{ThemeResource EgAccentBrush}" />
                </StackPanel>
                <!-- 订阅封面也用同一块面板（2026-11-24 用户令「给主页订阅列表也加悬浮」）。订阅不是可播放条目，
                     这里没有播放键和续播条，换成订阅自己的资料行；空值整行收起。
                     同日后续用户令「去掉 订阅状态 订阅中 那一行」：状态行整行删除，不再按值显隐。 -->
                <StackPanel x:Name="SubscriptionBlock" Grid.Row="2" Margin="0,14,0,0" Spacing="6" Visibility="Collapsed">
                    <Grid x:Name="SubscriptionProgressRow" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="CardPreview_SubscriptionProgress" Style="{StaticResource EgCaptionStyle}" />
                        <TextBlock x:Name="SubscriptionProgressText" Grid.Column="1" HorizontalAlignment="Right"
                            Style="{StaticResource EgDataStrongStyle}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid x:Name="SubscriptionUserRow" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="CardPreview_SubscriptionUser" Style="{StaticResource EgCaptionStyle}" />
                        <TextBlock x:Name="SubscriptionUserText" Grid.Column="1" HorizontalAlignment="Right"
                            Style="{StaticResource EgDataStrongStyle}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid x:Name="SubscriptionUpdatedRow" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="CardPreview_SubscriptionUpdated" Style="{StaticResource EgCaptionStyle}" />
                        <TextBlock x:Name="SubscriptionUpdatedText" Grid.Column="1" HorizontalAlignment="Right"
                            Style="{StaticResource EgDataStrongStyle}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>
            </Grid>
            <Button x:Name="PlayButton" AutomationProperties.AutomationId="CardPreviewPlay"
                Click="OnPlayClicked" CornerRadius="10" Padding="14,8" Margin="19"
                Style="{StaticResource EgSecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="{StaticResource EgCaptionFontSize}" />
                    <TextBlock x:Name="PlayText" />
                </StackPanel>
            </Button>
            <!-- 订阅预览的右上角操作（2026-11-24 用户令「右上角添加一个编辑订阅按钮」）：订阅没有播放键，
                 这一格交给「编辑订阅」，点开这条订阅的编辑窗口。几何与播放键同一档，标题据此让出宽度。
                 外面这层只负责与面板同样的 19 内边距，空处不吃指针，正文照旧点得到。 -->
            <Grid x:Name="EditSubscriptionSlot" Padding="19" HorizontalAlignment="Right" VerticalAlignment="Top"
                Visibility="Collapsed">
                <Button x:Uid="CardPreview_EditSubscription" x:Name="EditSubscriptionButton"
                    AutomationProperties.AutomationId="CardPreviewEditSubscription"
                    Click="OnEditSubscriptionClicked" CornerRadius="10" Padding="14,8" Margin="0"
                    Style="{StaticResource EgSecondaryButtonStyle}" Content="编辑订阅" />
            </Grid>
            <!-- 同一个媒体表面随封面撑开；前层渐显新图，背后旧图保持不透明，不露出底色。 -->
            <Canvas IsHitTestVisible="False">
                <Border x:Name="TransitionCover" CornerRadius="{StaticResource EgPosterCornerRadius}"
                    Background="{ThemeResource EgSurfaceAltBrush}">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="UniformToFill" />
                        <Image x:Name="TransitionImage" Stretch="UniformToFill" Opacity="0" />
                        <!-- 服务器内有预告时，静音循环的那一层盖在静态宽图上面；播放器由代码创建，
                             失败或没有预告就保持下面那张图。 -->
                        <Grid x:Name="TrailerHost" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Canvas>
        </Grid>
    </Grid>
</UserControl>
