<?xml version="1.0" encoding="utf-8"?>
<!-- Window backdrop -> BaseAlt command layer -> content layer. Preserve SDK alpha values.
     Source: microsoft-ui-xaml ba3a8d59, Common_themeresources_any.xaml.
     HighContrast color tokens are sentinels; use system colors as the SDK brushes do. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="EgMicaCommandBrush" Color="{ThemeResource LayerOnMicaBaseAltFillColorDefault}" />
            <SolidColorBrush x:Key="EgMicaContentBrush" Color="{ThemeResource LayerFillColorDefault}" />
            <SolidColorBrush x:Key="EgMicaCardBrush" Color="{ThemeResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="EgMicaCardBorderBrush" Color="{ThemeResource CardStrokeColorDefault}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="EgMicaCommandBrush" Color="{ThemeResource LayerOnMicaBaseAltFillColorDefault}" />
            <SolidColorBrush x:Key="EgMicaContentBrush" Color="{ThemeResource LayerFillColorDefault}" />
            <SolidColorBrush x:Key="EgMicaCardBrush" Color="{ThemeResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="EgMicaCardBorderBrush" Color="{ThemeResource CardStrokeColorDefault}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EgMicaCommandBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EgMicaContentBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EgMicaCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EgMicaCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
