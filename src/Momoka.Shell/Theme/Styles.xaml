<?xml version="1.0" encoding="utf-8"?>
<!--
  字、尺寸、以及界面里反复出现的那几种形状。Palette.xaml 管颜色，这里管其余的一切。

  这两个文件分工的判据是「换主题会不会动它」：颜色会，字号和圆角不会。所以 Palette.xaml 里那三份
  ThemeDictionaries 只剩颜色，原来挂在它尾巴上的「与主题无关」那一段整段搬到了这里 —— 唯独两个
  EgOnScrim* 画刷留在那边，它们是颜色，只是恰好不跟主题走。

  方向是「放映室」：这个客户端没有东西要卖给谁，它是一台把片子交给 mpv 的仪器。所以剧照是胶片，围着
  它的每一样东西都是刻度和标签 —— 标题用机器和仪表上刻的那种字，数字一律等宽，结构靠发丝线而不靠
  色块，海报是方的胶片格而不是圆角卡片。

  在 App.xaml 里并在 Palette.xaml 之后。两份都在应用级，所以谁引用谁的键都解析得到。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momoka.Shell.Views"
    xmlns:theme="using:Momoka.Shell">

    <!-- 详情媒体菜单使用轻透的系统亚克力，透明底让背景颜色透出。 -->
    <Style x:Key="EgDetailMenuPresenterStyle" TargetType="MenuFlyoutPresenter"
           BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
        <Setter Property="Background" Value="{ThemeResource DesktopAcrylicTransparentBrush}" />
        <Setter Property="local:DetailMenuSurface.Enabled" Value="True" />
        <Setter Property="SystemBackdrop">
            <Setter.Value><local:DetailMenuBackdrop /></Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
    </Style>

    <!-- ============================ 三种字 ============================ -->

    <!--
      正文。WinForms 那版用的就是它，换过来时保留，两边看着才像同一个产品；Segoe UI Variable 在这里
      没有能用的汉字覆盖。这一个必须留在树根上 —— 自检有一条盯着 ShellPage.FontFamily 就是它。
    -->
    <FontFamily x:Key="EgUiFontFamily">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI</FontFamily>

    <!--
      标题字：Bahnschrift 是微软自带的 DIN 1451 可变字体（Win10 1709 起随系统），也就是刻在胶片罐、
      推子条和放映机铭牌上的那种字。SemiCondensed 这一档窄，所以同样的版面能放下更大的号 —— 页面
      标题因此从 28 提到 34 而没有变宽。
      逗号后面那个不是保险，是分工：Bahnschrift 没有汉字，中文标题由 Microsoft YaHei UI 接着画，
      一串里前面的字体缺哪个字就往后落一个。整套字体缺席时（非 Windows 10 1709+）也是落到它，界面
      退回全 YaHei，只是失去这一层区分。
    -->
    <FontFamily x:Key="EgDisplayFontFamily">Bahnschrift SemiCondensed, Microsoft YaHei UI</FontFamily>

    <!--
      数字字。时长、年份、分辨率、码率、集号、条目数一律走它 —— 等宽之后同一列里的数字对得齐，而且
      数字从「一句话里的词」变成「仪表上的读数」，这是整套里最出身份的一个决定。
      Cascadia Mono 排在前面是机会性的：装了 Windows Terminal 或 VS 的机器上有，本机没有，于是落到
      Consolas（`C:\Windows\Fonts\consola.ttf`，每台 Windows 都有）。最后一档兜汉字。
    -->
    <FontFamily x:Key="EgDataFontFamily">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <!-- 字号阶。14 和 12 一个没动 —— 界面里上百处引用它们。 -->
    <x:Double x:Key="EgEyebrowFontSize">11</x:Double>
    <x:Double x:Key="EgCaptionFontSize">12</x:Double>
    <x:Double x:Key="EgBodyFontSize">14</x:Double>
    <x:Double x:Key="EgSubheadFontSize">16</x:Double>
    <!-- 播放页左上角第二行（文件信息）那一档。**它不是「阶里 18 那一个」** ——
         独占 uosc 顶栏给这一行的字号是 `\fs` = `round(alt_title_size * 0.71)`，但 libass 的 `\fs`
         按 **72 DPI 的 pt** 渲染，而这里的 `FontSize` 是 **96 DPI 的 px**：同一个数，屏上差 0.75 倍
         （72/96）。实测为证（两边同串「└ 1920 x 1080 · HEVC · AAC · Studio GreenTea」，当时的 0.77 档）：
         独占窗口档 `\fs18` 墨迹宽 292、独占全屏档 `\fs24` 宽 388（比值 1.33 ＝ 字号比，说明这条换算是线性的），
         而集成照抄 18px 画出来是 385 —— **正好是独占全屏档那一档**，比窗口档大三分之一，用户令
         2026-09-28 更晚「集成模式下面的元数据体积太大了，与独占模式不一致」说的就是它。
         于是先按 18 × 0.75 ＝ 13.5 定档；用户令 2026-09-29「元数据缩小一点点，集成模式和独占模式大小要一致」
         把独占的因子 0.77 收到 0.71（窗口档 `\fs17`、全屏档 `\fs22`），这边跟着落到 17 × 0.75 ＝ 12.75；
         全屏档 `\fs22` → 16.5（见 ApplyTitleScale）。
         嫌大嫌小改这一个数，**但独占 TopBar.lua 的 0.71 因子要一起动**（见那边的 MOMOKA[topbar-subline-size]）。 -->
    <x:Double x:Key="EgSublineFontSize">12.75</x:Double>
    <x:Double x:Key="EgTimelineFontSize">18</x:Double>
    <x:Double x:Key="EgTitleFontSize">20</x:Double>
    <x:Double x:Key="EgHeaderFontSize">36</x:Double>
    <x:Double x:Key="EgDisplayFontSize">52</x:Double>

    <!--
      眉字的字距，千分之一 em 为单位（CharacterSpacing 就是这个单位）。0.14 em 是「小号大写要读得开」
      的那一档；正文一律不动字距。
    -->
    <x:Int32 x:Key="EgEyebrowSpacing">140</x:Int32>

    <!-- ============================ 几何 ============================ -->

    <!-- 你会去点的面板：设置卡片、账号那一块、对话框、浮出菜单。留着圆角，手感上它还是个 Windows 应用。 -->
    <CornerRadius x:Key="EgCardCornerRadius">16</CornerRadius>

    <!--
      同一档圆角，给「一块板要分两截画」的那一处（集页整段上方那块大面板：上截贴在头图那一格里、下截贴在
      尾部那一格，两截各自只有外侧两个角）。这两个键里的 16 必须和上面那个一样 —— XAML 里没有「取一个
      CornerRadius 的前两个角」这种写法，所以是抄一份数而不是引用一份，改圆角要三处一起改。
    -->
    <CornerRadius x:Key="EgCardCornerRadiusTop">16,16,0,0</CornerRadius>
    <CornerRadius x:Key="EgCardCornerRadiusBottom">0,0,16,16</CornerRadius>

    <!--
      封面的圆角（「把封面改成圆角的」）：海报、剧照、单集缩略图那一格，也就是 EgFrameStyle 和详情页头部
      那张海报。8 和上面那个面板的圆角同一个数 —— 整套界面只有这一档圆角，两个键是为了以后能各自改。
      在这之前它是 0：胶片格本来是方的，一墙密排的海报靠直角读得清。现在照用户说的走，圆角回来了。
      圆角只有 Border 剪得动 —— Border 会按自己的 CornerRadius 裁掉孩子，Grid 和 Panel 只是把自己的底色
      和框线画圆，孩子照旧方着。所以凡是「里面那张图自己铺到四边」的块，用下面那个 0，见那条说明。
    -->
    <CornerRadius x:Key="EgPosterCornerRadius">12</CornerRadius>

    <!--
      还是方的那几块：设置里那六块色板。它们的共同点不是「大」，是**里面的东西自己画到边而外面那层剪不动它**：
      那一处外面是 Button，圆角只会让底色缩进去、露出孩子的直角。
      （主页那条通栏轮播从前也在这里 —— 它四边就是窗口的边和侧边栏那道竖线；2026-09-10「弄个框把轮播图框起来
      （圆角）」之后它换成了自己的 EgFrame 圆角框（HomeBanner.xaml 里 Frame 那一段），不再用这个键。）
    -->
    <CornerRadius x:Key="EgBleedCornerRadius">0</CornerRadius>

    <!-- 所有输入框统一使用用户截图中搜索框的圆角。保留平台模板、颜色与输入行为；
         旧的详情/设置键作为别名，避免不同页面再次各自定义同一档几何。 -->
    <CornerRadius x:Key="EgSearchCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="EgPickerCornerRadius">12</CornerRadius>

    <!-- 详情文件选项的行高，纯文字与选择框共用。DetailPage 同步选择框内边距及箭头的
         ComboBoxMinHeight；保留 MinHeight 让长文字仍能换行。探针核对实际控件高度与两种音轨状态的间距。
         2026-11-15 用户令「加高选择框的高度」，从 28 抬到 36：28 高配那一档 4/12 的圆角都挤在
         一条窄边里，圆角读不出来；抬到 36 之后同页的 12 DIP 圆角才画得成圆角矩形而不是一条方槽。
         四行（视频、媒体源、音频、字幕）一起抬，竖距仍是 6 —— 行高分开就换了一种节奏。
         2026-11-16 用户令「这个选择框弄扁一点」：36 收到 32，四行一起降；同页圆角按同一比例
         收到 10，半个高度 16 减去 10 仍是 6 的直腰，既不回到方槽，也不会滑成两端半圆的胶囊。 -->
    <x:Double x:Key="EgPickerRowHeight">32</x:Double>
    <Style x:Key="EgTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource EgSearchCornerRadius}" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource EgTextBoxStyle}" />
    <Style x:Key="EgPasswordBoxStyle" TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource EgSearchCornerRadius}" />
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource EgPasswordBoxStyle}" />
    <!-- NumberBox 没有命名默认样式；只加属性样式，保留类型默认模板。
         generic.xaml 的 InputBox 显式使用 NumberBoxTextBoxStyle，并通过 TemplateBinding 接收外层圆角。 -->
    <Style TargetType="NumberBox">
        <Setter Property="CornerRadius" Value="{StaticResource EgSearchCornerRadius}" />
    </Style>
    <Style x:Key="EgComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource EgSearchCornerRadius}" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource EgComboBoxStyle}" />
    <Style TargetType="AutoSuggestBox" BasedOn="{StaticResource DefaultAutoSuggestBoxStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource EgSearchCornerRadius}" />
    </Style>

    <!--
      详情页那几颗下拉的衣服：<local:EgPicker> 是 ComboBox 的子类，显式样式按「类型精确相等」匹配，框架给
      ComboBox 的那一份隐式样式（generic.xaml 里那条 TargetType="ComboBox"）不会落到子类身上 —— 不接这一行，
      那几颗下拉会一个模板都没有，屏上是空的。接项目的框架派生样式以取得相同圆角；弹层开在哪棵树
      里仍由 C#（EgPicker.OnApplyTemplate）处理。
      隐式（没有 x:Key）而不是给每颗下拉写 Style=""：同一件衣服穿在好几颗上，写几遍只会漂。
      摆在这个文件而不是 App.xaml —— 这里管形状、Palette 管颜色，一颗下拉穿什么衣服属于前者。
    -->
    <Style TargetType="local:EgPicker" BasedOn="{StaticResource EgComboBoxStyle}" />

    <!-- 与 MP 资源分面相同的紧凑圆角与角色色，保留框架的焦点和下拉模板。 -->
    <Style x:Key="EgResourceFilterStyle" TargetType="local:EgPicker" BasedOn="{StaticResource EgComboBoxStyle}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="{StaticResource EgSearchCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{ThemeResource EgAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource EgAccentBrush}" />
        <Setter Property="FontSize" Value="{StaticResource EgCaptionFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="EgResourceButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="{StaticResource EgSearchCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{ThemeResource EgAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource EgAccentBrush}" />
        <Setter Property="FontSize" Value="{StaticResource EgCaptionFontSize}" />
    </Style>

    <!--
      ===================== 对话框的表面（2026-10-28） =====================

      用户指着「请选择订阅季」那张表说圆角和背景都不对，并把下载确认弹窗（MoviePilotDownloadDialog）
      指名当样板。源码上这是两套皮：框架默认那张是 ContentDialogBackground 的纯灰底、1 像素边框、
      OverlayCornerRadius（8）；下载弹窗自己写成了 EgSurfaceBrush 底、EgCardCornerRadius（16）圆角、
      无边框。所以这里把下载弹窗那四样收成一条共享样式，弹窗不再各写一遍。

      为什么不是只写一条 TargetType="ContentDialog" 的隐式样式：隐式样式按类型精确匹配（同上面
      EgPicker 那条的理由，2026-10-28 实拍复核过一次 —— 季选择弹窗仍是框架灰底），从 ContentDialog
      派生的每一张表都匹配不上。所以每个具体弹窗类型各接一行；新增弹窗类型时在这里补一行，
      DialogChromeTests 会数源码里的派生类清单。

      基础样式必须 BasedOn DefaultContentDialogStyle：派生类型那一行只接样式、不另给模板，模板由这里
      进来。CornerRadius 由模板里 BackgroundElement 那颗 Border 用 TemplateBinding 吃下，Border 按圆角
      剪孩子，所以底部按钮区跟着圆；底色同时画到正文和按钮区（CommandSpace 也 TemplateBinding
      Background）。

      2026-10-30（用户：「更多菜单里的一些弹窗背景不要用亚克力，卡片和按钮等可以用」）：底色是实心
      EgSurfaceBrush —— 弹窗自己这块面不上亚克力，读字优先；弹窗里的卡片、按钮仍各走各的亚克力，
      不受这一条影响。下载弹窗头上那四个本地属性仍是它的样板；往后哪张表要有例外，在它自己头上写
      属性即可，不用拆这条。

      2026-10-29 起这条样式还负责「点弹窗外面就关掉它」（DialogDismiss.ClosesOnOutsideClick）：
      用户要的是项目里所有弹窗、以及以后新增的弹窗都有这一下，所以它跟表面属性放在同一条基础样式上，
      派生类型那一行只接样式就一起带上；不得通过本地 False 或替换样式绕过，测试会检查。
    -->
    <Style x:Key="EgDialogSurfaceStyle" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="Background" Value="{ThemeResource EgSurfaceBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource EgTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
        <Setter Property="local:DialogDismiss.ClosesOnOutsideClick" Value="True" />
        <Setter Property="theme:ThemeHost.FollowChanges" Value="True" />
    </Style>

    <!-- 媒体库弹窗（2026-10-28）：只覆盖库管理相关类型，背景与设置侧栏使用同一个主题角色。
         不改 EgDialogSurfaceStyle：MoviePilot、普通确认框和设置窗口仍维持原来的表面。
         2026-10-30 弹窗表面不上亚克力之后，这一条继续钉侧栏底色。 -->
    <Style x:Key="EgLibraryDialogSurfaceStyle" TargetType="ContentDialog" BasedOn="{StaticResource EgDialogSurfaceStyle}">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
    </Style>
    <Style x:Key="EgLibraryFlyoutSurfaceStyle" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource EgTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
    </Style>

    <!-- 代码里 new 的普通 ContentDialog（确认框、播放信息、通知服务挑选等）。 -->
    <Style TargetType="ContentDialog" BasedOn="{StaticResource EgDialogSurfaceStyle}" />

    <!-- XAML 里定义的各张表，按类型各接一行；MoviePilotDownloadDialog 保留自己那一份。 -->
    <Style TargetType="local:AniBtScrapeDialog" BasedOn="{StaticResource EgLibraryDialogSurfaceStyle}" />
    <Style TargetType="local:ArtworkViewer" BasedOn="{StaticResource EgLibraryDialogSurfaceStyle}" />
    <Style TargetType="local:CollectionDialog" BasedOn="{StaticResource EgLibraryDialogSurfaceStyle}" />
    <Style TargetType="local:CoverDialog" BasedOn="{StaticResource EgLibraryDialogSurfaceStyle}" />
    <Style TargetType="local:CoverPickerDialog" BasedOn="{StaticResource EgLibraryDialogSurfaceStyle}" />
    <Style TargetType="local:EmbyMetadataDialog" BasedOn="{StaticResource EgLibraryDialogSurfaceStyle}" />
    <Style TargetType="local:FnNasMatchDialog" BasedOn="{StaticResource EgLibraryDialogSurfaceStyle}" />
    <Style TargetType="local:FnNasMetadataDialog" BasedOn="{StaticResource EgLibraryDialogSurfaceStyle}" />
    <Style TargetType="local:FnNasVersionsDialog" BasedOn="{StaticResource EgLibraryDialogSurfaceStyle}" />
    <Style TargetType="local:FnNasRemovedFilesDialog" BasedOn="{StaticResource EgLibraryDialogSurfaceStyle}" />
    <Style TargetType="local:IdentifyDialog" BasedOn="{StaticResource EgLibraryDialogSurfaceStyle}" />
    <Style TargetType="local:MetadataDialog" BasedOn="{StaticResource EgLibraryDialogSurfaceStyle}" />
    <Style TargetType="local:MissingEpisodesDialog" BasedOn="{StaticResource EgLibraryDialogSurfaceStyle}" />
    <Style TargetType="local:MoviePilotMediaManagementDialog" BasedOn="{StaticResource EgDialogSurfaceStyle}" />
    <Style TargetType="local:MoviePilotReorganizeDialog" BasedOn="{StaticResource EgDialogSurfaceStyle}" />
    <Style TargetType="local:MoviePilotResourceFilterDialog" BasedOn="{StaticResource EgDialogSurfaceStyle}" />
    <Style TargetType="local:MoviePilotSeriesReorganizeDialog" BasedOn="{StaticResource EgDialogSurfaceStyle}" />
    <Style TargetType="local:MoviePilotSeasonPicker" BasedOn="{StaticResource EgDialogSurfaceStyle}" />
    <Style TargetType="local:MoviePilotSiteDialog" BasedOn="{StaticResource EgDialogSurfaceStyle}" />
    <Style TargetType="local:NotificationEditDialog" BasedOn="{StaticResource EgDialogSurfaceStyle}" />
    <Style TargetType="local:NotificationServicePicker" BasedOn="{StaticResource EgDialogSurfaceStyle}" />
    <Style TargetType="local:RefreshMetadataDialog" BasedOn="{StaticResource EgLibraryDialogSurfaceStyle}" />
    <Style TargetType="local:SubtitleDialog" BasedOn="{StaticResource EgLibraryDialogSurfaceStyle}" />
    <Style TargetType="local:FnNasSubtitleDialog" BasedOn="{StaticResource EgLibraryDialogSurfaceStyle}" />

    <!-- 下载弹窗自己的表面写在它头上（见上一条），这里只给它「点外面就关」那一项：不接这一行，它是
         全项目唯一一张点了外面没反应的弹窗。 -->
    <Style TargetType="local:MoviePilotDownloadDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="theme:ThemeHost.FollowChanges" Value="True" />
        <Setter Property="local:DialogDismiss.ClosesOnOutsideClick" Value="True" />
    </Style>

    <!-- 发丝线的粗细。结构靠它，不靠色块 —— 所以只有一档，加粗只发生在框线变强调色的时候。 -->
    <Thickness x:Key="EgHairline">1</Thickness>
    <!-- 封面不画外圈（2026-10-28 用户令）：PosterCard 与主页订阅海报不再切换 EgFrameActiveStyle。
         分隔线、输入框和徽章仍用 EgHairline；键盘容器保留中性焦点提示。 -->
    <Thickness x:Key="EgCardBorderThickness">0</Thickness>
    <!-- 货架翻页圆钮和仍需标识选中状态的独立控件使用 2 DIP 描边；不用于主页封面。 -->
    <Thickness x:Key="EgOutlineThickness">2</Thickness>

    <!-- 胶片格右上角那颗方块的边长：一个数字或一个对勾刚好放得下。 -->
    <x:Double x:Key="EgCornerBadgeSize">20</x:Double>

    <!--
      同一颗方块的圆角（「封面右上角的那个改成圆角」，2026-09-14）。取 6，不是封面那档 12 —— 这颗只有
      20 见方，12 就是整颗圆掉了、读不出它是个角标；6 让四个角都磨圆一点，还看得出是块方牌。
      右上角那一角同时在框的圆角里（EgFrameStyle 按 12 剪孩子，比 6 大），所以那一角实际看的是框的弧，
      另外三个角看这里的 6。数字和对勾共用这一颗，圆角自然也共用。
    -->
    <CornerRadius x:Key="EgCornerBadgeCornerRadius">6</CornerRadius>

    <!-- 看到一半时压在下边框线上的那条进度，2px —— 比发丝线粗一档，才看得出它是「读数」不是「边」。 -->
    <x:Double x:Key="EgProgressThickness">2</x:Double>

    <!--
      按键的高度。整套界面只有这一个 —— 头图上的播放键、轮播的播放和详情、翻页箭头、圆图标键，以前是
      38/40/44 三档混着，差 2 像素的两颗键并排放着只会显得没对齐。方形图标键的边长也是它。
    -->
    <x:Double x:Key="EgActionHeight">44</x:Double>

    <!--
      「修改媒体封面图」面板上那六格的框宽（2026-09-13）。

      三档是两个数：格宽和内缩后的图宽。图宽比格宽小 24，是给那一行三个图标键腾的地方 —— 键的边长 40，
      三个并排是 120 + 两个 8 的间隔 = 136，所以 140 的帧宽放得下，而 164 的格宽（140 + 两侧各 12 的余量）
      再乘 6 格加五道间隔，正好落在对话框 1000 的上限里。
    -->
    <x:Double x:Key="EgArtworkFrameWidth">140</x:Double>
    <x:Double x:Key="EgArtworkCellWidth">164</x:Double>

    <!--
      背景图那一排的格宽。它比上面那六格宽一档（188 对 164），因为这一排一行只摆得来四五张 —— 背景图是
      16:9 的横图，摆成六格那样窄一条的话，缩略图里什么都认不出。
    -->
    <x:Double x:Key="EgBackdropFrameWidth">188</x:Double>
    <x:Double x:Key="EgBackdropCellWidth">212</x:Double>

    <!-- ============================ 间距 ============================ -->

    <!--
      间距刻度，2026-09-06 按 WinUI-Gallery 那套重排（「间距 → 统一 24 / 36」）。全部是 4 的倍数 —— Fluent
      的版面就是一张 4 像素的格纸，而这套界面从前是 8、10、12、16、18、20、28 混着，其中 18 和 28 根本不在
      那张格纸上。

        XS  4   贴着的两样东西之间（徽标和它的字）
        S   8   一叠里相邻两行
        M  12   一块板里两组之间
        L  16   卡片之间、货架里两张卡之间
        XL 24   **页面四边、板的内边距** —— 这是这套界面的主间距
        2XL 36  两大块内容之间（页头和第一排货架、正文里两块板）

      为什么写成键而不是各处写数字：这六个数一改，整套跟着改；而这一节存在之前，「页边多宽」这个答案分散在
      七个页面加三个控件里，各写各的。**没有一处新的写死数字该出现在标记里** —— 引这几个键。
    -->
    <x:Double x:Key="EgSpaceXS">4</x:Double>
    <x:Double x:Key="EgSpaceS">8</x:Double>
    <x:Double x:Key="EgSpaceM">12</x:Double>
    <x:Double x:Key="EgSpaceL">16</x:Double>
    <x:Double x:Key="EgSpaceXL">24</x:Double>
    <x:Double x:Key="EgSpace2XL">36</x:Double>

    <!--
      页面四边。四边同一个数（XL，24），2026-09-06 从 28,20,28,20 换过来 —— **Gallery 那套页面是 24 的边距**，
      而 28 是这套界面自己长出来的一个数，不在 4 的格纸上，也和顶上那两行外壳的内缩对不齐。
      跟着这个数走的还有两处，它们必须一起改，否则屏上就是几条差 4 像素的错位竖线：面包屑那一行的左右内缩、
      主页那块牌子的左右、标题栏那一排图标的缩进（17 + 托盘留白 7 = 24）。三样东西一条竖线，见 ShellPage.xaml
      里那两段说明。（从前第四处是标签栏第一格的左边距，那条标签栏 2026-09-08 删掉了。）
    -->
    <Thickness x:Key="EgPageMargin">32,28,32,28</Thickness>

    <!--
      页面级滚动条的车道。WinUI 的竖向滚动条压在滚动内容的右缘上（ScrollBarSize 12 +
      ScrollViewerScrollBarMargin / ScrollViewScrollBarsMargin 两边各 1），内容不留出这条带子，
      卡片、行尾按钮和开关就被它盖住。20 = 12 + 2 + 6 的空隙，和设置页 2026-10-27 那个
      「滚动条独立槽位」是同一个数。

      用法：滚动容器的 Padding 右值，或滚动内容的 Margin 右值 —— ItemsView 的 Padding 落在
      ItemsRepeater 的 Margin 上，ScrollViewer / ListView 的 Padding 落在内容或 ItemsPresenter 的
      Margin 上，两种都只收内容、不动滚动条。滚动条随后仍贴着滚动区右缘，只是内容不再伸到它底下。
    -->
    <Thickness x:Key="EgScrollBarLane">0,0,20,0</Thickness>

    <!--
      一块板／一张卡里面留多宽。和页边同一个数（XL），所以页边、框线、内边距叠起来是 24 + 1 + 24 —— 板上的
      字和页头的字差 25，看起来是「缩进了一格」而不是「差了几像素」。
      单独一个键而不是直接引 <c>EgSpaceXL</c>：<c>Padding</c> 要的是 Thickness，而刻度那六个是 Double，
      资源引用之间不会替你转换类型（写错的症状是运行时崩在解析这一句上）。
    -->
    <Thickness x:Key="EgPanelPadding">24</Thickness>

    <!--
      一段话最宽排到哪儿。**这是行长，不是版面宽度**：正文 14 号，一个汉字就是 14 像素宽，所以 760 是一行五十来
      个字 —— 读一段话舒服的行长是三十到五十个字，再长眼睛回到下一行的行首就会找错行。
      详情页那段剧情说明从前是通栏的：他那台 1649 宽的窗口上一行七十多个字（2026-09-05 界面复查）。整页跟着通栏
      的东西（那几条卡片带、媒体信息那张表）一个都不用它 —— 那些是并排的格子，格子越宽越好，只有连续的句子有
      行长这回事。
    -->
    <x:Double x:Key="EgProseWidth">760</x:Double>

    <!-- ============================ 文字 ============================ -->
    <!--
      全部带 x:Key，一个隐式样式都没有：应用级的 `Style TargetType="TextBlock"` 会命中界面上每一块
      文字，包括框架控件模板内部的那些。
    -->

    <!--
      眉字：场记板最上面那一行小字，写的是「这是哪一区」。等宽 + 字距拉开 + 一档更淡的字，它的职责
      是定位而不是被读 —— 所以它绝不承担标题的内容，标题在它下面那行。
    -->
    <Style x:Key="EgEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EgDataFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource EgEyebrowFontSize}" />
        <Setter Property="CharacterSpacing" Value="{StaticResource EgEyebrowSpacing}" />
        <Setter Property="Foreground" Value="{ThemeResource EgTextFaintBrush}" />
        <Setter Property="TextLineBounds" Value="Tight" />
    </Style>

    <!-- 页面标题：场记板的第二行，通栏线的上面。 -->
    <Style x:Key="EgPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EgDisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource EgHeaderFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource EgTextBrush}" />
        <Setter Property="TextLineBounds" Value="Tight" />
    </Style>

    <!--
      片名：主页轮播上那一个。整屏最大的一块字。
      （详情页头图上那一行 2026-09-12 分出去成了下面那个 EgHeroTitleStyle —— 那一行会折行，两行的账和
      轮播上这一行不是一笔，理由写在那个键上。）
    -->
    <Style x:Key="EgDisplayTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource EgPageTitleStyle}">
        <Setter Property="FontSize" Value="{StaticResource EgDisplayFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource EgOnScrimBrush}" />
    </Style>

    <!--
      详情页头图上的片名（电影、剧、季、集四种页面共用）。从 EgDisplayTitleStyle 分出来的两处改动
      （2026-09-12，他一张截图两句话：「缩小到上下不会重叠就好」）：

      1. 字号落到页面标题那一档（36）。「无职转生～到了异世界就拿出真本事～」这种长片名在 52 上折两行，
         两行合起来一百三十多像素；而这一行上面顶着徽标、下面紧跟「S3:E2 - 集名」，整段字被它一个人撑高。
         轮播上那一行不折行（单行铺满，字号大正是它的活），所以那一头照旧 52。
      2. 行高写死 45（36 × 1.25）。这一支字体是 Bahnschrift SemiCondensed，汉字从雅黑掉下来 —— 行距按
         Bahnschrift 算，而雅黑的字比那个行距高，于是折行时两行直接叠在一起：他那张截图上第二行的字咬进了
         第一行。LineHeight 只是个下限（LineStackingStrategy 默认取「行高和内容高两者取大」），所以它在这里
         =「还给汉字一个正常的行距」，不是把行压扁。
         ⚠️ 字号要是改回 52，这个 45 就得跟着改（1.25 倍），否则行距又比字小。
    -->
    <Style x:Key="EgHeroTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource EgPageTitleStyle}">
        <Setter Property="Foreground" Value="{StaticResource EgOnScrimBrush}" />
        <Setter Property="LineHeight" Value="45" />
    </Style>

    <!-- 分区标题：卡片带的名字、设置页每张卡片的名字。 -->
    <Style x:Key="EgSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EgDisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource EgTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource EgTextBrush}" />
    </Style>

    <Style x:Key="EgSubheadStyle" TargetType="TextBlock" BasedOn="{StaticResource EgSectionTitleStyle}">
        <Setter Property="FontSize" Value="{StaticResource EgSubheadFontSize}" />
    </Style>

    <!--
      设置类子页的页标题（2026-11-17 字体审计）：控制台、通知、服务器这三页的抬头一直是内联的
      26 号半粗，没写字体，于是它和主页/详情那些 36 号标题不是一个角色 —— 同一个产品里两种「页标题」。
      只补族与角色，字号仍是 26、行高不动：这三页的抬头下面紧跟着卡片，换行高会挪一整块。
    -->
    <Style x:Key="EgSubpageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource EgSectionTitleStyle}">
        <Setter Property="FontSize" Value="26" />
    </Style>

    <!--
      读数。凡是数字都走这两个：时长、年份、分辨率、码率、集号、条目数。等宽不只是好看 —— 一列里的
      数字对得齐，而「2024 · 1080P · 2H14M」这种一行几段的读数不会因为字宽不同而挤成一团。
    -->
    <Style x:Key="EgDataStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EgDataFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource EgCaptionFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource EgTextDimBrush}" />
    </Style>

    <Style x:Key="EgDataStrongStyle" TargetType="TextBlock" BasedOn="{StaticResource EgDataStyle}">
        <Setter Property="Foreground" Value="{ThemeResource EgTextBrush}" />
    </Style>

    <Style x:Key="EgBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EgUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource EgBodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource EgTextBrush}" />
    </Style>

    <Style x:Key="EgCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource EgBodyStyle}">
        <Setter Property="FontSize" Value="{StaticResource EgCaptionFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource EgTextDimBrush}" />
    </Style>

    <!--
      压在剧照上的那几行：详情页头部和主页轮播。两处的暗罩都是写死的黑（浅色主题也一样，压的是照片不是
      主题色），所以字也不跟主题走 —— 颜色取 Palette 里那两支 EgOnScrim 画刷。

      除了颜色，字体和字号跟页面里的完全同一套，一档都不新造：以前这两处各写各的 FontSize="40"、
      FontSize="34"、Opacity="0.86"，于是同一个产品的两个大画面，字不一样大、也不是同一种字。
    -->
    <Style x:Key="EgOnScrimEyebrowStyle" TargetType="TextBlock" BasedOn="{StaticResource EgEyebrowStyle}">
        <Setter Property="Foreground" Value="{StaticResource EgOnScrimDimBrush}" />
    </Style>

    <Style x:Key="EgOnScrimBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource EgBodyStyle}">
        <Setter Property="Foreground" Value="{StaticResource EgOnScrimBrush}" />
    </Style>

    <Style x:Key="EgOnScrimDataStyle" TargetType="TextBlock" BasedOn="{StaticResource EgDataStyle}">
        <Setter Property="Foreground" Value="{StaticResource EgOnScrimDimBrush}" />
    </Style>

    <Style x:Key="EgOnScrimDataStrongStyle" TargetType="TextBlock" BasedOn="{StaticResource EgDataStyle}">
        <Setter Property="Foreground" Value="{StaticResource EgOnScrimBrush}" />
    </Style>

    <!-- 卡片带那块牌子压在剧照上时的标题（ShelfHead.OnScrim）：集页把同季那一带摆在头图底下的画面里。 -->
    <Style x:Key="EgOnScrimSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource EgSectionTitleStyle}">
        <Setter Property="Foreground" Value="{StaticResource EgOnScrimBrush}" />
    </Style>

    <!--
      压在剧照上的次一级标题（2026-11-16 主页轮播商店版式右栏下面那两张小卡）：字号与字重取 EgSubheadStyle
      （16、SemiBold），只把墨换成剧照上的浅色。两行片名是常态，所以不另写字号 —— 小卡上再大一档就会挤成
      三行，再小一档又认不出是标题。
    -->
    <Style x:Key="EgOnScrimSubheadStyle" TargetType="TextBlock" BasedOn="{StaticResource EgSubheadStyle}">
        <Setter Property="Foreground" Value="{StaticResource EgOnScrimBrush}" />
    </Style>

    <!--
      场记板压在剧照上的那一份：主页的大图铺到窗口顶边之后，页眉就站在图上了（见 PageSlate.OnScrim）。
      只换颜色，字体字号一档不改 —— 同一块场记板换个底，不该顺手换成另一个字号。
    -->
    <Style x:Key="EgOnScrimPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource EgPageTitleStyle}">
        <Setter Property="Foreground" Value="{StaticResource EgOnScrimBrush}" />
    </Style>

    <!-- ============================ 形状 ============================ -->

    <!--
      通栏发丝线。场记板下面那一条，也是任何两块内容之间要分开时用的那一条 —— 整页只有这一种横向
      结构。用 Border 而不是 Rectangle：它在 Grid 里横向 Stretch 是默认行为，不用写宽度。
    -->
    <Style x:Key="EgRuleStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource EgBorderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!--
      胶片格：海报、缩略图、剧照外面那一圈。签名元素就是这根线 —— 卡片的所有状态都由它和它四个角上
      的东西表达，不靠药丸徽章、不靠阴影、不靠缩放：

        · 静止        1px 发丝框，圆角 8（「把封面改成圆角的」，见 EgPosterCornerRadius）
        · 指针/焦点   整圈变强调色（唯一会给整圈上色的事，所以它和持久状态永不撞车）
        · 看到一半    2px 强调色压在下边框线上，长度就是进度
        · 还剩几集    右上角一颗强调色方块，里面是等宽的数字
        · 全看完      同一颗方块，里面换成对勾
        · 没开始看    什么都不加 —— 一屋子海报里绝大多数都是没看过的，标它等于标了全场

      圆角一上来，里面那几件东西是被这一圈剪着的（Border 会按 CornerRadius 裁孩子）：右上角那颗方块
      跟着圆了一个角，底边那条进度两头各被切掉两三个像素。两处都是对的 —— 它们本来就说自己是「框的
      一部分」，框圆了它们就该跟着圆。那颗方块自己另有一档 6 的圆角（EgCornerBadgeCornerRadius，
      2026-09-14）：朝里的三个角是它自己的弧度，只有朝外那一角是这一圈剪出来的 —— 框的 12 比它的 6
      大，所以那一角读的是框的弧。
    -->
    <Style x:Key="EgFrameStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="{StaticResource EgCardBorderThickness}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource EgPosterCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource EgSurfaceAltBrush}" />
    </Style>

    <!-- 指针与键盘焦点共用的强调边线。集行和选择器仍使用它；普通与主页订阅封面不再切到这一档。 -->
    <Style x:Key="EgFrameActiveStyle" TargetType="Border" BasedOn="{StaticResource EgFrameStyle}">
        <Setter Property="BorderThickness" Value="{StaticResource EgOutlineThickness}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EgAccentBrush}" />
    </Style>

    <!-- 正文分组卡与设置卡共用深色亚克力；外层页面纸面保持自己的滚动遮挡规则。 -->
    <Style x:Key="EgBodyPanelStyle" TargetType="StackPanel">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource EgCardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource EgPanelPadding}" />
    </Style>

    <!-- Gallery v2.9.3 / 14a4a1a2b8ddc527dc4a7d5f7e743d7c2bc97db7:
         Controls/ControlExample.xaml、Styles/Grid.xaml 使用原生圆角表面与分隔线。
         Gallery 没有卡内标题和媒体货架的成套样例，详情两页共用这一组原生组合。 -->
    <Style x:Key="EgStoreDetailCardStyle" TargetType="StackPanel" BasedOn="{StaticResource EgBodyPanelStyle}">
        <Setter Property="Background" Value="{ThemeResource EgSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Spacing" Value="0" />
    </Style>
    <Style x:Key="EgStoreDetailCardHeaderStyle" TargetType="Border">
        <Setter Property="Padding" Value="24,10" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style x:Key="EgStoreDetailCardContentStyle" TargetType="StackPanel">
        <Setter Property="Padding" Value="24" />
        <Setter Property="Spacing" Value="10" />
    </Style>

    <!--
      右上角那颗方块。数字和对勾用同一颗，因为它们说的是同一件事 ——「还剩多少」，对勾就是「零」。
      跟框线齐平（没有外边距），它是框的一部分而不是浮在图上的贴纸；四角磨圆 6（见
      EgCornerBadgeCornerRadius），圆了之后它仍是块贴角的牌，不是一颗浮起来的圆形徽章。
    -->
    <Style x:Key="EgCornerBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource EgAccentBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource EgCornerBadgeCornerRadius}" />
        <Setter Property="MinWidth" Value="{StaticResource EgCornerBadgeSize}" />
        <Setter Property="Height" Value="{StaticResource EgCornerBadgeSize}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Padding" Value="4,0,4,0" />
    </Style>

    <Style x:Key="EgCornerBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EgDataFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource EgEyebrowFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource EgTextOnAccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 保留系统模板的焦点、键盘和高对比行为，只统一交互表面的尺寸。 -->
    <Style x:Key="EgPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="22,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="EgSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="Background" Value="{ThemeResource EgSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
    </Style>

    <!--
      弹窗底部一排行动键（2026-11-19）。

      用户指着「编辑订阅」底部那三颗键说形状要统一：当时「保存」接的是 22 DIP 圆角的胶囊，
      「取消订阅」「关闭」还是框架默认的 4 DIP 小圆角，一排里两套几何。统一到框架那档 4 DIP 之后
      用户又说「按钮太大了」—— 44 高的胶囊一走，三颗全成了 44 高的大块，于是尺寸回到系统弹窗的
      32 高、常规内边距：三颗同高、同圆角、同内边距，主行动仍靠强调色底和半粗字突出，危险次行动
      靠红字。32 也是 `ContentDialogButtonMinHeight` 与 DefaultButtonStyle 的默认值，跟别的弹窗一致。

      主键只覆盖 EgPrimaryButtonStyle 的尺寸和圆角，三态、焦点环和禁用行为仍走 AccentButtonStyle；
      次键保留 DefaultButtonStyle 的中性底和三态，只补几何。只给这一张弹窗用，别处要跟随就显式
      接这两个键 —— 不写隐式 Button 样式：ContentDialog 底部的按钮也是普通 Button，隐式样式会连
      标签页、浮出层和小图标键一起改。
    -->
    <Style x:Key="EgDialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource EgPrimaryButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="11,5,11,6" />
    </Style>

    <Style x:Key="EgDialogSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="11,5,11,6" />
    </Style>

    <Style x:Key="EgIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!--
      封面正中的播放键：海报卡悬停时那一颗，和详情页左上角封面上那一颗共用。

      48 见方的圆，静止是深色磨砂玻璃（EgPlayGlassBrush），指针移到这颗键上才换强调色玻璃 —— 整张封面
      悬停不替它换色。三态里的悬停与按下写在按钮自己的 Resources 里（PosterCard、DetailPage 的标记），
      因为 DefaultButtonStyle 的模板按键取色，样式只能给常态；这也是两颗键必须共用这一份的理由：
      尺寸、圆角、字色和焦点环各写一遍，迟早只改一处。

      高对比度下 EgPlayGlass* 在 Palette 里退回系统实色，前景的 EgTextBrush / EgTextOnAccentBrush
      也随之换成系统字色，焦点环两笔跟着走 —— 不另做一套模板。
    -->
    <Style x:Key="EgOverlayPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{ThemeResource EgPlayGlassBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource EgTextBrush}" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource EgTextBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource EgSurfaceBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 那颗键里的字形：48 的圆里 20 号的播放符号，左边多让 2 —— 三角形自带的重心偏左，补一点才看着居中。
         原来写在海报卡那一颗上；2026-11-08 详情页封面上的那颗要同一种字，两处合到这一份里。 -->
    <Style x:Key="EgPlayGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Margin" Value="2,0,0,0" />
    </Style>

    <!--
      搜索框的输入层。原生文本框的上下内边距会让 40 DIP 搜索框里的文字偏上；模板保留（光标、清除键、输入法
      和键盘都在里面），只把输入与占位文字居中。搜索页那一颗和「在 MoviePilot 搜索版本」窗口那一颗共用这一份
      —— 两处的框必须一样高、字站在同一条线上，各写一份就迟早只改一处。
    -->
    <Style x:Key="EgSearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
        <Setter Property="Padding" Value="10,0,6,0" />
    </Style>

    <!--
      「修改媒体封面图」那一格里摆图的位置（2026-09-13）。

      一个 Button 而不是 Border + 手势：这一格整块点下去就是「换这一种图」，用按钮才有焦点环、才有键盘能按到、
      才不必自己接 PointerPressed。默认模板会把内容居中并给它一圈内边距和底色，所以这里把它拆平 —— 这一格要的
      是「一个能点的画框」，不是一颗键。

      虚线框是「这儿本来该有张图、现在没有」：实线发丝框说的是「这是一张图」，虚线的意思是「这儿少一张」。
      ContentDialog 的描边比卡片上那根粗一档才看得出来，所以 DashStyle 用的是 3,2 而不是 1,1。
    -->
    <Style x:Key="EgArtworkTileStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{ThemeResource EgSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource EgHairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource EgPosterCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <!-- 空格子里那颗加号：比图小一圈、比读数淡一档 —— 它是「这儿少一张」而不是「按我」。 -->
    <Style x:Key="EgArtworkEmptyGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource EgTextFaintBrush}" />
    </Style>

    <!--
      评分那一排星（订阅详情「订阅信息」栏顶上）：实心/空心两种字形，字号取正文那一档。
      用字形而不是框架的 RatingControl —— 整套界面只有三种字体和一套角色色，这颗读数不该另起一套控件模板。
    -->
    <Style x:Key="EgRatingStarStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="{StaticResource EgBodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource EgWarningBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
