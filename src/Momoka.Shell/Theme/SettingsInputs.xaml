<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      设置页面保留局部样式入口，但圆角接全站搜索框的同一资源。
      保留 WinUI 2.3.9 generic.xaml 的模板与视觉状态；
      TextBox/PasswordBox 的 BorderElement 和 AutoSuggestBox 内层 TextBox 都吃 TemplateBinding。
      NumberBox 没有可引用的默认样式键，在页面上直接设圆角，由 InputBox 的 TemplateBinding 接收。
    -->
    <StaticResource x:Key="EgSettingsInputCornerRadius" ResourceKey="EgSearchCornerRadius" />

    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource EgSettingsInputCornerRadius}" />
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource EgSettingsInputCornerRadius}" />
    </Style>
    <Style TargetType="AutoSuggestBox" BasedOn="{StaticResource DefaultAutoSuggestBoxStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource EgSettingsInputCornerRadius}" />
    </Style>
    <!-- 设置主页另有列表项样式；让它继承同一闭合表面，不替换现有下拉交互。 -->
    <Style x:Key="EgSettingsComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource EgSettingsInputCornerRadius}" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource EgSettingsComboBoxStyle}" />
</ResourceDictionary>
