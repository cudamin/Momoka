<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <IsPackable>false</IsPackable>
        <FullscreenSource Condition="'$(FullscreenSource)' == ''">$(MSBuildProjectDirectory)\..\..\src\Momoka.Shell\Windowing\HostWindow.cs</FullscreenSource>
        <SelfCheckSource Condition="'$(SelfCheckSource)' == ''">$(MSBuildProjectDirectory)\..\..\src\Momoka.Shell\ShellSelfCheck.Fullscreen.cs</SelfCheckSource>
        <NativeSource Condition="'$(NativeSource)' == ''">$(MSBuildProjectDirectory)\..\..\src\Momoka.Shell\Interop\Native.cs</NativeSource>
        <GeometrySource Condition="'$(GeometrySource)' == ''">$(MSBuildProjectDirectory)\..\..\src\Momoka.Core\Playback\AspectLock.cs</GeometrySource>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="..\Momoka.Tests\TestHarness.cs" Link="TestHarness.cs" />
    </ItemGroup>

    <!-- No product edits or second fullscreen/region model. Every selected member is an unchanged
         substring of a production file; missing, duplicated or reversed boundaries stop the build. -->
    <UsingTask TaskName="ExtractFullscreenWindowSources" TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <HostSource ParameterType="System.String" Required="true" />
            <CheckSource ParameterType="System.String" Required="true" />
            <InteropSource ParameterType="System.String" Required="true" />
            <BoundsSource ParameterType="System.String" Required="true" />
            <OutputSource ParameterType="System.String" Required="true" />
            <EvidenceSource ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Text" />
            <Using Namespace="System.Security.Cryptography" />
            <Using Namespace="System.Collections.Generic" />
            <Code Type="Fragment" Language="cs"><![CDATA[
                var utf8 = new UTF8Encoding(false, true);
                Func<byte[], string> hash = bytes =>
                {
                    using (var sha = SHA256.Create())
                        return BitConverter.ToString(sha.ComputeHash(bytes)).Replace("-", "");
                };
                Func<string, string> literal = text => "\"" + text.Replace("\\", "\\\\")
                    .Replace("\"", "\\\"").Replace("\r", "\\r").Replace("\n", "\\n") + "\"";
                var paths = new Dictionary<string, string>
                {
                    { "HostWindow", Path.GetFullPath(HostSource) },
                    { "SelfCheck", Path.GetFullPath(CheckSource) },
                    { "Native", Path.GetFullPath(InteropSource) },
                    { "WindowBounds", Path.GetFullPath(BoundsSource) }
                };
                var texts = new Dictionary<string, string>();
                var hashes = new Dictionary<string, string>();
                var slices = new Dictionary<string, List<string>>();
                foreach (var pair in paths)
                {
                    var bytes = File.ReadAllBytes(pair.Value);
                    var text = utf8.GetString(bytes);
                    if (text.StartsWith("\uFEFF", StringComparison.Ordinal)) text = text.Substring(1);
                    texts.Add(pair.Key, text);
                    hashes.Add(pair.Key, hash(bytes));
                    slices.Add(pair.Key, new List<string>());
                }
                Func<string, string, string, string, string> between = (key, name, start, end) =>
                {
                    var source = texts[key];
                    var begin = source.IndexOf(start, StringComparison.Ordinal);
                    if (begin < 0 || source.IndexOf(start, begin + start.Length, StringComparison.Ordinal) >= 0)
                        throw new InvalidOperationException("Missing or ambiguous production start: " + key + "." + name);
                    var finish = source.IndexOf(end, StringComparison.Ordinal);
                    if (finish < 0 || source.IndexOf(end, finish + end.Length, StringComparison.Ordinal) >= 0)
                        throw new InvalidOperationException("Missing or ambiguous production end: " + key + "." + name);
                    if (finish <= begin)
                        throw new InvalidOperationException("Reversed production boundaries: " + key + "." + name);
                    var fragment = source.Substring(begin, finish - begin);
                    slices[key].Add("            new(" + literal(name) + ", " + literal(start) + ", " + literal(end)
                        + ", " + begin + ", " + fragment.Length + ", " + literal(hash(utf8.GetBytes(fragment))) + "),\n");
                    return fragment;
                };
                var host = between("HostWindow", "TitleBarFields",
                    "    private AppWindow? _appWindow;", "    private UIElement? _content;")
                    + between("HostWindow", "RestoreFields",
                        "    private (NativeRect Bounds, IntPtr Style, bool Maximized)? _restore;",
                        "\n    private NativeRect _lastClientRect;")
                    + between("HostWindow", "BandConstants", "    private const nuint BandTimer = 1;",
                        "\n    /// <summary>\n    /// 全屏期间盯任务栏 z 序的两枚 WinEvent hook")
                    + between("HostWindow", "RegionFields",
                        "    private List<(double X, double Y, double Width, double Height)> _holes = [];",
                        "\n    public IntPtr Handle { get; private set; }")
                    + between("HostWindow", "PresenterChrome",
                        "    internal bool UsesPresenterChrome =>",
                        "\n    /// <summary>\n    /// Changes only the interactive partition of the custom title bar")
                    + between("HostWindow", "PlaybackTitleBar", "    public bool PlaybackTitleBar\n",
                        "\n    /// <summary>\n    /// 隐藏标题栏的显示，不销毁它。")
                    + between("HostWindow", "ApplyTitleBarMode", "    private void ApplyTitleBarMode()\n",
                        "\n    /// <summary>\n    /// 播放时不设最小尺寸：")
                    + between("HostWindow", "FreeSizing", "    public bool FreeSizing { get; set; }",
                        "\n    /// <summary>\n    /// What the framework says its own title bar comes")
                    + between("HostWindow", "TitleBarMetrics", "    public (double Height, double RightInset) TitleBarMetrics =>\n",
                        "\n    /// <summary>\n    /// The rectangles of the browsing title bar the shell has claimed for itself, in logical pixels, or")
                    + between("HostWindow", "SetTitleBarHoles", "    internal void SetTitleBarHoles(params",
                        "\n    /// <summary>The client area in physical pixels")
                    + between("HostWindow", "ChangeClientRect",
                        "    private void ChangeClientRect(Action change, bool suppressIntermediateFrames = false)\n",
                        "\n    private void SetFrameTransitions(bool enabled)")
                    + between("HostWindow", "Fullscreen", "    public bool Fullscreen\n",
                        "\n    /// <summary>\n    /// 置顶. Set through a z-order change rather than")
                    + between("HostWindow", "IsMaximized", "    public bool IsMaximized =>",
                        "\n    /// <summary>\n    /// 这一扇窗口此刻的形态")
                    + between("HostWindow", "HasBrowseGeometry", "    internal bool HasBrowseGeometry =>",
                        "\n    /// <summary>\n    /// 自检用：播放前记住的那份几何")
                    + between("HostWindow", "EnterFullscreen", "    private void EnterFullscreen()\n",
                        "\n    /// <summary>\n    /// 退出全屏：把进全屏那一刻的样式和矩形原样放回来，")
                    + between("HostWindow", "LeaveFullscreen", "    private void LeaveFullscreen()\n",
                        "\n    /// <summary>\n    /// 让位给自家的一扇顶层窗")
                    + between("HostWindow", "ConfigureTitleBar", "    private void ConfigureTitleBar()\n",
                        "\n    /// <summary>\n    /// 主页那张大图有没有铺到窗口顶边底下")
                    + between("HostWindow", "UpdateTitleBarRegions", "    private void UpdateTitleBarRegions()\n",
                        "\n    /// <summary>\n    /// The three caption buttons as three equal columns")
                    + between("HostWindow", "SystemButtonRects",
                        "    private static (RectInt32 Minimise, RectInt32 Maximise, RectInt32 Close) SystemButtonRects(\n",
                        "\n    /// <summary>\n    /// The rectangles the shell claimed, in physical pixels")
                    + between("HostWindow", "HolePixels", "    private RectInt32[] HolePixels(int dpi, int dragRight, int height)\n",
                        "\n    /// <summary>\n    /// The caption stated as the pieces around the holes")
                    + between("HostWindow", "CaptionAround",
                        "    private static RectInt32[] CaptionAround(RectInt32[] holes, int dragRight, int height)\n",
                        "\n    // ---- 键盘兜底");
                var predicate = between("SelfCheck", "FullscreenFrameMatches",
                    "    internal static bool FullscreenFrameMatches(NativeRect frame, NativeRect client, NativeRect monitor,\n",
                    "\n    /// <summary>Every taskbar there is: the main screen's, and then one per secondary display.</summary>");
                var structs = between("Native", "NativeRect",
                    "[StructLayout(LayoutKind.Sequential)]\ninternal struct NativeRect\n",
                    "\n[StructLayout(LayoutKind.Sequential)]\ninternal struct NativePoint")
                    + between("Native", "MonitorInfo",
                        "[StructLayout(LayoutKind.Sequential)]\ninternal struct MonitorInfo\n",
                        "\n/// <summary>\n/// MONITORINFOEX");
                var constants = between("Native", "FrameStyleConstants", "    public const int WsCaption =",
                    "\n    // ---- messages")
                    + between("Native", "NoActivateConstant", "    public const uint SwpNoActivate =",
                        "\n    // ---- WinEvent hook")
                    + between("Native", "FrameChangeConstants", "    public const uint SwpNoCopyBits =",
                        "\n    /// <summary>\n    /// Posts the request to the owning thread")
                    + between("Native", "ZOrderConstants", "    public static readonly IntPtr HwndTopMost =",
                        "\n    /// <summary>\n    /// HWND_MESSAGE")
                    + between("Native", "ShowWindowConstants", "    public const int SwRestore =",
                        "\n    /// <summary>\n    /// WM_NCHITTEST")
                    + between("Native", "MonitorDefaultConstant", "    public const uint MonitorDefaultToNearest =",
                        "\n    // ---- 全屏时的任务栏");
                var geometry = between("WindowBounds", "WindowBounds",
                    "public readonly record struct WindowBounds(int Left, int Top, int Right, int Bottom)\n",
                    "\n/// <summary>\n/// Keeps the window the shape of the picture");
                var generated = "// Verbatim production substrings. Generated at every build; do not edit.\n#nullable enable\n"
                    + "using System.Runtime.InteropServices;\nusing Momoka.Diagnostics;\nusing Momoka.Infrastructure;\n"
                    + "using Momoka.Playback;\nusing Momoka.Shell.Interop;\nusing Microsoft.UI;\n"
                    + "using Microsoft.UI.Input;\nusing Microsoft.UI.Windowing;\nusing Windows.Graphics;\n"
                    + "namespace Momoka.Shell.Windowing\n{\ninternal sealed partial class HostWindow\n{\n" + host + "\n}\n}\n"
                    + "namespace Momoka.Shell\n{\ninternal static partial class ShellSelfCheck\n{\n" + predicate + "\n}\n}\n"
                    + "namespace Momoka.Shell.Interop\n{\n" + structs + "\ninternal static partial class Native\n{\n" + constants + "\n}\n}\n"
                    + "namespace Momoka.Playback\n{\n" + geometry + "\n}\n";
                var evidence = new StringBuilder("// Build-time raw-file and unchanged-slice SHA256 evidence.\n#nullable enable\nnamespace Momoka.Tests;\n"
                    + "internal static class FullscreenSourceEvidence\n{\n    internal static readonly SourceStamp[] Sources =\n    [\n");
                foreach (var pair in paths)
                {
                    evidence.Append("        new(" + literal(pair.Key) + ", " + literal(pair.Value) + ", " + literal(hashes[pair.Key]) + ",\n        [\n");
                    foreach (var row in slices[pair.Key]) evidence.Append(row);
                    evidence.Append("        ]),\n");
                    Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High,
                        "Fullscreen source SHA256 " + pair.Key + " " + hashes[pair.Key] + " " + pair.Value);
                }
                evidence.Append("    ];\n}\n");
                Directory.CreateDirectory(Path.GetDirectoryName(OutputSource));
                foreach (var file in new[] { Tuple.Create(OutputSource, generated), Tuple.Create(EvidenceSource, evidence.ToString()) })
                    if (!File.Exists(file.Item1) || File.ReadAllText(file.Item1) != file.Item2)
                        File.WriteAllText(file.Item1, file.Item2, new UTF8Encoding(false));
            ]]></Code>
        </Task>
    </UsingTask>
    <Target Name="GenerateFullscreenWindowSources" BeforeTargets="CoreCompile">
        <ExtractFullscreenWindowSources HostSource="$(FullscreenSource)" CheckSource="$(SelfCheckSource)"
            InteropSource="$(NativeSource)" BoundsSource="$(GeometrySource)"
            OutputSource="$(IntermediateOutputPath)FullscreenProduction.g.cs"
            EvidenceSource="$(IntermediateOutputPath)FullscreenSourceEvidence.g.cs" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)FullscreenProduction.g.cs" />
            <Compile Include="$(IntermediateOutputPath)FullscreenSourceEvidence.g.cs" />
        </ItemGroup>
    </Target>
</Project>
