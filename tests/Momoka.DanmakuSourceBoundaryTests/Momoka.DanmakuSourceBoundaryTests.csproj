<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Momoka.Core/Momoka.Core.csproj" />
    <Compile Include="../Momoka.Tests/TestHarness.cs" Link="TestHarness.cs" />
    <Compile Include="$(IntermediateOutputPath)Panel.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Host.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Settings.g.cs" />
  </ItemGroup>
  <Target Name="ExtractDanmakuBoundaries" BeforeTargets="BeforeCompile">
    <Exec Command="py &quot;$(MSBuildThisFileDirectory)extract.py&quot; --output &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath).&quot;" />
  </Target>
</Project>
