<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <PythonLauncher Condition="'$(PythonLauncher)' == ''">py</PythonLauncher>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Momoka.Core/Momoka.Core.csproj" />
    <Compile Include="../Momoka.Tests/TestHarness.cs" Link="TestHarness.cs" />
    <Compile Include="$(IntermediateOutputPath)Panel.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Host.g.cs" />
    <Compile Include="$(IntermediateOutputPath)Settings.g.cs" />
    <Compile Include="$(IntermediateOutputPath)SendProbe.g.cs" />
    <Compile Include="../../src/Momoka.Shell/ProbeReports.cs" Link="Production/ProbeReports.cs" />
  </ItemGroup>
  <Target Name="ExtractDanmakuBoundaries" BeforeTargets="BeforeCompile"
          Inputs="$(MSBuildThisFileDirectory)extract.py;$(MSBuildProjectDirectory)/../../src/Momoka.Shell/Views/DanmakuPanel.xaml.cs;$(MSBuildProjectDirectory)/../../src/Momoka.Shell/ViewModels/PlayerViewModel.Danmaku.cs;$(MSBuildProjectDirectory)/../../src/Momoka.Shell/ViewModels/PlayerViewModel.DanmakuSend.cs;$(MSBuildProjectDirectory)/../../src/Momoka.Shell/ViewModels/SettingsViewModel.Danmaku.cs;$(MSBuildProjectDirectory)/../../src/Momoka.Shell/ShellNavigationProbe.DanmakuSend.cs;$(MSBuildProjectDirectory)/../../src/Momoka.Shell/ShellNavigationProbe.cs"
          Outputs="$(IntermediateOutputPath)Panel.g.cs;$(IntermediateOutputPath)Host.g.cs;$(IntermediateOutputPath)Settings.g.cs;$(IntermediateOutputPath)SendProbe.g.cs">
    <Exec Command="&quot;$(PythonLauncher)&quot; &quot;$(MSBuildThisFileDirectory)extract.py&quot; --output &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath).&quot;" />
  </Target>
</Project>
