<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Momoka.PickerLifecycleTests</AssemblyName>
    <RootNamespace>Momoka.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <EgPickerSource Condition="'$(EgPickerSource)' == ''">$(MSBuildProjectDirectory)/../../src/Momoka.Shell/Views/EgPicker.cs</EgPickerSource>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Momoka.Core/Momoka.Core.csproj" />
    <Compile Include="../Momoka.Tests/TestHarness.cs" Link="TestHarness.cs" />
    <Compile Include="$(EgPickerSource)" Link="Production/EgPicker.cs" />
  </ItemGroup>
</Project>
