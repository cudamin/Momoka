<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Momoka.Core\Momoka.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <Compile Include="..\..\src\Momoka.Shell\ViewModels\PageViewModel.cs" Link="Production\PageViewModel.cs" />
    <Compile Include="..\..\src\Momoka.Shell\ViewModels\MoviePilotSitePickerViewModel.cs" Link="Production\MoviePilotSitePickerViewModel.cs" />
    <Compile Include="..\..\src\Momoka.Shell\Views\MoviePilotSitePicker.xaml.cs" Link="Production\MoviePilotSitePicker.xaml.cs" />
    <Compile Include="..\..\src\Momoka.Shell\Views\MoviePilotSiteDialog.xaml.cs" Link="Production\MoviePilotSiteDialog.xaml.cs" />
    <Compile Include="..\Momoka.Tests\TestHarness.cs" Link="TestHarness.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Source-linked UI code shares the production translator and embedded dictionaries. -->
    <Compile Include="../../src/Momoka.Shell/Localization/UiText.cs" Link="Production/UiText.cs" />
    <EmbeddedResource Include="../../src/Momoka.Shell/Localization/*English.json" Link="Production/%(Filename)%(Extension)" />
    <Using Include="Momoka.Shell.Localization" />
  </ItemGroup>
</Project>
