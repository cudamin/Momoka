<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><AssemblyName>Momoka.Tests</AssemblyName><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Momoka.Core/Momoka.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <Compile Include="../../src/Momoka.Shell/ViewModels/PageViewModel.cs" Link="Production/PageViewModel.cs" />
    <Compile Include="../../src/Momoka.Shell/ViewModels/MoviePilotSubscriptionsViewModel.cs" Link="Production/MoviePilotSubscriptionsViewModel.cs" />
    <Compile Include="../../src/Momoka.Shell/ViewModels/MoviePilotSubscriptionEpisodeRow.cs" Link="Production/MoviePilotSubscriptionEpisodeRow.cs" />
    <Compile Include="../../src/Momoka.Shell/Views/MoviePilotMediaSeasonsView.xaml.cs" Link="Production/MoviePilotMediaSeasonsView.xaml.cs" />
    <Compile Include="$(IntermediateOutputPath)MediaRows.g.cs" />
    <Compile Include="$(IntermediateOutputPath)SubscriptionSync.g.cs" />
  </ItemGroup>
  <Target Name="ExtractSeasonRows" BeforeTargets="BeforeCompile">
    <Exec Command="py &quot;$(MSBuildThisFileDirectory)extract.py&quot; --output &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath).&quot;" />
  </Target>
</Project>
