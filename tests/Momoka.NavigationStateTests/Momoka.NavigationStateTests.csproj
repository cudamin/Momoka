<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Momoka.NavigationStateTests</AssemblyName>
    <RootNamespace>Momoka.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <NavigationSourceRoot Condition="'$(NavigationSourceRoot)' == ''">$(MSBuildProjectDirectory)/../../src/Momoka.Shell/Views</NavigationSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Momoka.Core/Momoka.Core.csproj" />
    <Compile Include="../Momoka.Tests/TestHarness.cs" Link="TestHarness.cs" />
    <Compile Include="../../src/Momoka.Shell/Views/LibraryRequest.cs" Link="Production/LibraryRequest.cs" />
  </ItemGroup>
  <UsingTask TaskName="ExtractNavigationStateSources" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceRoot ParameterType="System.String" Required="true" />
      <OutputSource ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" /><Using Namespace="System.IO" /><Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Func<string, string> read = name => File.ReadAllText(Path.Combine(SourceRoot, name)).Replace("\r\n", "\n");
        Func<string, string, string, string> between = (source, start, end) =>
        {
            var first = source.IndexOf(start, StringComparison.Ordinal);
            if (first < 0 || source.IndexOf(start, first + start.Length, StringComparison.Ordinal) >= 0)
                throw new InvalidOperationException("Missing or ambiguous navigation start: " + start);
            var last = source.IndexOf(end, first + start.Length, StringComparison.Ordinal);
            if (last < 0 || source.IndexOf(end, last + end.Length, StringComparison.Ordinal) >= 0)
                throw new InvalidOperationException("Missing or ambiguous navigation end: " + end);
            return source.Substring(first, last - first);
        };
        var shell = read("ShellPage.xaml.cs");
        var music = read("MusicLibraryPage.xaml.cs");
        var musicNavigation = read("ShellPage.Music.cs");
        var generated = "// Extracted verbatim from this tree; HWND/Frame/ViewModel boundaries are substitutes.\n#nullable enable\n" +
            "using System.ComponentModel;\nusing Microsoft.Extensions.DependencyInjection;\nusing Microsoft.UI.Xaml;\nusing Microsoft.UI.Xaml.Controls;\nusing Microsoft.UI.Xaml.Navigation;\nusing Microsoft.UI.Xaml.Media.Animation;\n" +
            "using Momoka.Emby;\nusing Momoka.Diagnostics;\nusing Momoka.Infrastructure;\nusing Momoka.Music;\nusing Momoka.Services;\nusing Momoka.MoviePilot;\nusing Momoka.Shell.Services;\nusing Momoka.Shell.ViewModels;\nnamespace Momoka.Shell.Views;\n" +
            between(shell, "public sealed record Crumb(", "\n\n/// <summary>") +
            "\npublic sealed partial class MusicLibraryPage : Page\n{\n" +
            between(music, "    protected override async void OnNavigatedTo(NavigationEventArgs args)", "\n    /// <summary>\n    /// 搜索框的宽度") +
            "\n}\ninternal sealed partial class ShellPage\n{\n" +
            between(shell, "    public void GoTo(string tag, bool force = false)\n", "\n    /// <summary>\n    /// 设置 (需求 1") +
            between(shell, "    private static NavigationTransitionInfo BrowseTransition()", "\n    private void BeginNavigation(") +
            between(shell, "    private void Open(Type page, object parameter, string title, string tag)\n", "\n    /// <summary>\n    /// The one place the toolbar row") +
            between(shell, "    private void RememberTrail()\n", "\n    private void SyncChrome()") +
            between(shell, "    private void GoBack()\n", "\n    /// <summary>\n    /// One step forward:") +
            between(shell, "    private void GoForward()\n", "\n    private void OnBreadcrumbClicked(") +
            between(shell, "    private void AdoptContentTag()\n", "\n    /// <summary>\n    /// The search page:") +
            between(musicNavigation, "    internal void OpenMusicContainer(", "\n}\n") +
            "\n}\n";
        Directory.CreateDirectory(Path.GetDirectoryName(OutputSource));
        if (!File.Exists(OutputSource) || File.ReadAllText(OutputSource) != generated)
            File.WriteAllText(OutputSource, generated, new UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="GenerateNavigationStateSources" BeforeTargets="CoreCompile">
    <ExtractNavigationStateSources SourceRoot="$(NavigationSourceRoot)" OutputSource="$(IntermediateOutputPath)NavigationStateSources.g.cs" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)NavigationStateSources.g.cs" /></ItemGroup>
  </Target>
  <ItemGroup>
    <!-- Source-linked UI code shares the production translator and embedded dictionaries. -->
    <Compile Include="../../src/Momoka.Shell/Localization/UiText.cs" Link="Production/UiText.cs" />
    <EmbeddedResource Include="../../src/Momoka.Shell/Localization/*English.json" Link="Production/%(Filename)%(Extension)" />
    <Using Include="Momoka.Shell.Localization" />
  </ItemGroup>
</Project>
