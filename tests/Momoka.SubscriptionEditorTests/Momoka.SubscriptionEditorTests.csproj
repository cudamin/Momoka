<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Momoka.Tests</AssemblyName><RootNamespace>Momoka.Tests</RootNamespace><IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Native/**/*.cs" />
    <ProjectReference Include="..\..\src\Momoka.Core\Momoka.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <Compile Include="..\..\src\Momoka.Shell\ViewModels\PageViewModel.cs" Link="Production\PageViewModel.cs" />
    <Compile Include="..\..\src\Momoka.Shell\ViewModels\MoviePilotSubscriptionEditorViewModel.cs" Link="Production\MoviePilotSubscriptionEditorViewModel.cs" />
    <Compile Include="..\..\src\Momoka.Shell\ViewModels\MoviePilotSubscriptionActionsViewModel.cs" Link="Production\MoviePilotSubscriptionActionsViewModel.cs" />
    <Compile Include="..\Momoka.MoviePilotSubscribeSettingsTests\Fixture.cs" Link="Fixture.cs" />
    <EmbeddedResource Include="..\..\src\Momoka.Shell\Views\MoviePilotSubscriptionEditor.xaml" LogicalName="Editor.xaml" />
    <EmbeddedResource Include="..\..\src\Momoka.Shell\Views\MoviePilotSubscriptionEditor.xaml.cs" LogicalName="Editor.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Source-linked UI code shares the production translator and embedded dictionaries. -->
    <Compile Include="../../src/Momoka.Shell/Localization/UiText.cs" Link="Production/UiText.cs" />
    <EmbeddedResource Include="../../src/Momoka.Shell/Localization/*English.json" Link="Production/%(Filename)%(Extension)" />
    <Using Include="Momoka.Shell.Localization" />
  </ItemGroup>
</Project>
