<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Momoka.PageContractTests</AssemblyName>
    <RootNamespace>Momoka.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);DIAGNOSTICS_VM_FIXTURE;CARD_IMAGE_RESIZE_FIXTURE;PAGE_CONTRACT_FIXTURE</DefineConstants>
    <StartupObject>Momoka.Tests.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Momoka.Core\Momoka.Core.csproj" />
    <!-- Same pinned generator as the Shell; no package upgrade. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <Compile Include="..\..\src\Momoka.Shell\ViewModels\DiagnosticsViewModel.cs" Link="Production\DiagnosticsViewModel.cs" />
    <Compile Include="..\..\src\Momoka.Shell\ViewModels\PageViewModel.cs" Link="Production\PageViewModel.cs" />
    <Compile Include="..\Momoka.Tests\DiagnosticsTests.cs" Link="DiagnosticsTests.cs" />
    <Compile Include="..\..\src\Momoka.Shell\Views\CardItem.cs" Link="Production\CardItem.cs" />
    <Compile Include="..\..\src\Momoka.Shell\Media\PosterCache.cs" Link="Production\PosterCache.cs" />
    <Compile Include="..\Momoka.Tests\CardImageResizeTests*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="..\Momoka.Tests\ImageRecoveryTests.cs" Link="ImageRecoveryTests.cs" />
    <!-- Exact page control-flow source; fixtures replace XAML/framework boundaries, not Attach logic. -->
    <Compile Include="..\..\src\Momoka.Shell\Views\MoviePilotSubscriptionsPage.xaml.cs" Link="Production\MoviePilotSubscriptionsPage.xaml.cs" />
    <Compile Include="..\..\src\Momoka.Shell\Views\IShellContent.cs" Link="Production\IShellContent.cs" />
    <Compile Include="..\Momoka.Tests\TestHarness.cs" Link="TestHarness.cs" />
  </ItemGroup>
</Project>
