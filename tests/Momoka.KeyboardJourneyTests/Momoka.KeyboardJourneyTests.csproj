<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Momoka.Core/Momoka.Core.csproj" />
    <Compile Include="../Momoka.Tests/TestHarness.cs" Link="TestHarness.cs" />
    <Compile Include="../../src/Momoka.Shell/ShellNavigationProbe.KeyboardJourneyFixture.cs" Link="Production/KeyboardJourneyProbeServer.cs" />
    <Compile Include="../../src/Momoka.Shell/ShellNavigationProbe.InfoTableFixture.cs" Link="Production/InfoTableProbeFixture.cs" />
    <Compile Include="../../src/Momoka.Shell/PlaybackReturnTrace.cs" Link="Production/PlaybackReturnTrace.cs" />
    <Compile Include="../../src/Momoka.Shell/ShellSelfCheck.PlaybackReturn.cs" Link="Production/ShellSelfCheck.PlaybackReturn.cs" />
    <Compile Include="../../src/Momoka.Shell/ShellSelfCheck.InfoGeometry.cs" Link="Production/ShellSelfCheck.InfoGeometry.cs" />
    <Compile Include="../../src/Momoka.Shell/ShellSelfCheck.NotificationsLayout.cs" Link="Production/ShellSelfCheck.NotificationsLayout.cs" />
  </ItemGroup>
  <UsingTask TaskName="ExtractInfoScrollSource" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <OutputSource ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" /><Using Namespace="System.IO" /><Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var source = File.ReadAllText(Source).Replace("\r\n", "\n");
        var start = "    internal void ScrollToInfo()";
        var end = "\n    private double? _revealScrollTarget;";
        var first = source.IndexOf(start, StringComparison.Ordinal);
        if (first < 0 || source.IndexOf(start, first + start.Length, StringComparison.Ordinal) >= 0)
            throw new InvalidOperationException("Missing or ambiguous ScrollToInfo start.");
        var last = source.IndexOf(end, first + start.Length, StringComparison.Ordinal);
        if (last < 0 || source.IndexOf(end, last + end.Length, StringComparison.Ordinal) >= 0)
            throw new InvalidOperationException("Missing or ambiguous ScrollToInfo end.");
        var generated = "// Exact production ScrollToInfo; geometry and scroll endpoints are boundaries.\n#nullable enable\n" +
            "using Microsoft.UI.Xaml;\nusing Microsoft.UI.Xaml.Controls;\nusing Momoka.Emby;\nusing Windows.Foundation;\nnamespace Momoka.Shell.Views;\n" +
            "internal sealed partial class DetailPage\n{\n" + source.Substring(first, last - first) + "\n}\n";
        Func<string, string, string> between = (from, to) =>
        {
            var begin = source.IndexOf(from, StringComparison.Ordinal);
            if (begin < 0 || source.IndexOf(from, begin + from.Length, StringComparison.Ordinal) >= 0)
                throw new InvalidOperationException("Missing or ambiguous reveal source start: " + from);
            var finish = source.IndexOf(to, begin + from.Length, StringComparison.Ordinal);
            if (finish < 0 || source.IndexOf(to, finish + to.Length, StringComparison.Ordinal) >= 0)
                throw new InvalidOperationException("Missing or ambiguous reveal source end: " + to);
            return source.Substring(begin, finish - begin);
        };
        generated += "\ninternal sealed partial class DetailPage\n{\n" +
            between("    private double? _revealScrollTarget;", "\n    /// <summary>\n    /// 播放层收起") +
            between("    internal (bool Ok, string Detail) ReturnRead(double scrollBefore, double afterRefresh, double afterHide)",
                "\n    /// <summary>\n    /// 自检：集页上那行剧名") +
            between("    internal void KeepScrollThroughReveal(double offset)", "\n    /// <summary>\n    /// Every non-empty piece of text") + "\n}\n";
        generated = generated.Replace("using Microsoft.UI.Xaml;\n", "using Microsoft.UI.Xaml;\nusing Microsoft.UI.Dispatching;\nusing Microsoft.UI.Xaml.Input;\nusing System.ComponentModel;\n");
        Directory.CreateDirectory(Path.GetDirectoryName(OutputSource));
        if (!File.Exists(OutputSource) || File.ReadAllText(OutputSource) != generated)
            File.WriteAllText(OutputSource, generated, new UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="GenerateInfoScrollSource" BeforeTargets="CoreCompile">
    <ExtractInfoScrollSource Source="$(MSBuildProjectDirectory)/../../src/Momoka.Shell/Views/DetailPage.xaml.cs" OutputSource="$(IntermediateOutputPath)InfoScrollSource.g.cs" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)InfoScrollSource.g.cs" /></ItemGroup>
  </Target>
  <UsingTask TaskName="ExtractNotificationsVisit" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <OutputSource ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" /><Using Namespace="System.IO" /><Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var source = File.ReadAllText(Source).Replace("\r\n", "\n");
        var start = "    private static bool VisitNotifications(SettingsPage page)";
        var end = "\n    /// <summary>\n    /// 需求 8：";
        var first = source.IndexOf(start, StringComparison.Ordinal);
        if (first < 0 || source.IndexOf(start, first + start.Length, StringComparison.Ordinal) >= 0)
            throw new InvalidOperationException("Missing or ambiguous notifications visit start.");
        var last = source.IndexOf(end, first + start.Length, StringComparison.Ordinal);
        if (last < 0 || source.IndexOf(end, last + end.Length, StringComparison.Ordinal) >= 0)
            throw new InvalidOperationException("Missing or ambiguous notifications visit end.");
        var generated = "// Exact production VisitNotifications. UI and next-navigation endpoints are boundaries.\n#nullable enable\n" +
            "using Momoka.Shell.Views;\nnamespace Momoka.Shell;\ninternal static partial class ShellSelfCheck\n{\n" +
            source.Substring(first, last - first) + "\n}\n";
        Directory.CreateDirectory(Path.GetDirectoryName(OutputSource));
        if (!File.Exists(OutputSource) || File.ReadAllText(OutputSource) != generated)
            File.WriteAllText(OutputSource, generated, new UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="GenerateNotificationsVisit" BeforeTargets="CoreCompile">
    <ExtractNotificationsVisit Source="$(MSBuildProjectDirectory)/../../src/Momoka.Shell/ShellSelfCheck.cs" OutputSource="$(IntermediateOutputPath)NotificationsVisit.g.cs" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)NotificationsVisit.g.cs" /></ItemGroup>
  </Target>
  <UsingTask TaskName="ExtractSelfCheckReadiness" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <OutputSource ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" /><Using Namespace="System.IO" /><Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var source = File.ReadAllText(Source).Replace("\r\n", "\n");
        Func<string, string, string> between = (from, to) =>
        {
            var first = source.IndexOf(from, StringComparison.Ordinal);
            if (first < 0 || source.IndexOf(from, first + from.Length, StringComparison.Ordinal) >= 0)
                throw new InvalidOperationException("Missing or ambiguous readiness source start: " + from);
            var last = source.IndexOf(to, first + from.Length, StringComparison.Ordinal);
            if (last < 0 || source.IndexOf(to, last + to.Length, StringComparison.Ordinal) >= 0)
                throw new InvalidOperationException("Missing or ambiguous readiness source end: " + to);
            return source.Substring(first, last - first);
        };
        var generated = "// Exact production self-check read scheduling and settings walk; only UI endpoints are boundaries.\n#nullable enable\n" +
            "using Momoka.Shell.Views;\nusing Momoka.Shell.ViewModels;\nnamespace Momoka.Shell;\ninternal static partial class ShellSelfCheck\n{\n" +
            between("    private static readonly List<SettingsStop> _settings = [];", "\n    public static void ScheduleFor(") +
            between("    private static int Deadline =>", "\n    /// <summary>\n    /// Snapshots the page") +
            between("    private static bool ReadPlaybackReturn(DetailPage back)", "\n    /// <summary>\n    /// Whichever page") +
            between("    private static bool WalkSettings(ShellPage shell)", "\n    private static void OpenConsoleOrReturn(SettingsPage page)") +
            "\n}\n";
        Directory.CreateDirectory(Path.GetDirectoryName(OutputSource));
        if (!File.Exists(OutputSource) || File.ReadAllText(OutputSource) != generated)
            File.WriteAllText(OutputSource, generated, new UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="GenerateSelfCheckReadiness" BeforeTargets="CoreCompile">
    <ExtractSelfCheckReadiness Source="$(MSBuildProjectDirectory)/../../src/Momoka.Shell/ShellSelfCheck.cs" OutputSource="$(IntermediateOutputPath)SelfCheckReadiness.g.cs" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)SelfCheckReadiness.g.cs" /></ItemGroup>
  </Target>
</Project>
