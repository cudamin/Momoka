<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <IsPackable>false</IsPackable>
        <StartupObject>Momoka.Tests.Program</StartupObject>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\Momoka.Core\Momoka.Core.csproj" />
        <Compile Include="..\Momoka.Tests\TestHarness.cs" Link="TestHarness.cs" />
        <Compile Include="..\..\src\Momoka.Shell\Views\ImageArrivalFade.cs" Link="Production\ImageArrivalFade.cs" />
        <Compile Include="..\..\src\Momoka.Shell\Views\DetailPage.ArtworkArrival.cs" Link="Production\DetailPage.ArtworkArrival.cs" />
    </ItemGroup>
    <UsingTask TaskName="ExtractDetailArtworkSource" TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Source ParameterType="System.String" Required="true" />
            <OutputSource ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Text" />
            <Code Type="Fragment" Language="cs"><![CDATA[
                var source = File.ReadAllText(Source).Replace("\r\n", "\n");
                Func<string, string, string> between = (start, end) =>
                {
                    var begin = source.IndexOf(start, StringComparison.Ordinal);
                    if (begin < 0 || source.IndexOf(start, begin + start.Length, StringComparison.Ordinal) >= 0)
                        throw new InvalidOperationException("Missing or ambiguous production source: " + start);
                    var finish = source.IndexOf(end, begin + start.Length, StringComparison.Ordinal);
                    if (finish < 0 || source.IndexOf(end, finish + end.Length, StringComparison.Ordinal) >= 0)
                        throw new InvalidOperationException("Missing or ambiguous production end: " + end);
                    return source.Substring(begin, finish - begin);
                };
                var generated = "// Complete production method, extracted verbatim at build time.\n#nullable enable\n" +
                    "using Momoka.Emby;\nusing Momoka.Diagnostics;\nusing Microsoft.UI.Xaml.Media.Imaging;\nnamespace Momoka.Shell.ViewModels;\n" +
                    "internal sealed partial class DetailArtworkFixture\n{\n" +
                    between("    private Task _imagePresentation =", "\n\n    /// <summary>\n    /// 自检用的三个数") +
                    between("    internal void UseImagePresentation(Task ready)", "\n\n    /// <summary>\n    /// 解好的封面") +
                    between("    private async Task LoadArtworkAsync(EmbyItem item, CancellationTokenSource art)", "\n    /// <summary>\n    /// 封面到了") +
                    between("    public override void Cancel()", "\n    /// <inheritdoc />\n    public override void Dispose()") +
                    between("    private bool Fresh(CancellationTokenSource art, EmbyItem item) =>", "\n    private async Task<BitmapImage?> DecodeFirstAsync(\n        EmbyItem item,") + "\n}\n";
                Directory.CreateDirectory(Path.GetDirectoryName(OutputSource));
                if (!File.Exists(OutputSource) || File.ReadAllText(OutputSource) != generated)
                    File.WriteAllText(OutputSource, generated, new UTF8Encoding(false));
            ]]></Code>
        </Task>
    </UsingTask>
    <Target Name="GenerateDetailArtworkSource" BeforeTargets="CoreCompile">
        <ExtractDetailArtworkSource Source="$(MSBuildProjectDirectory)\..\..\src\Momoka.Shell\ViewModels\DetailViewModel.cs"
                                   OutputSource="$(IntermediateOutputPath)DetailArtwork.g.cs" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)DetailArtwork.g.cs" />
        </ItemGroup>
    </Target>
</Project>
