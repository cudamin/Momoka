<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- A read-only review can supply its fixed snapshot; a clean checkout uses the actual tree. -->
    <ServerListsSourceRoot Condition="'$(ServerListsSourceRoot)' == ''">$(MSBuildProjectDirectory)/../..</ServerListsSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ServerListsSourceRoot)/src/Momoka.Core/Momoka.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <Compile Include="$(ServerListsSourceRoot)/src/Momoka.Shell/Services/ServerListModels.cs" Link="Production/ServerListModels.cs" />
    <Compile Include="$(ServerListsSourceRoot)/src/Momoka.Shell/Services/ServerListsService.cs" Link="Production/ServerListsService.cs" />
    <Compile Include="$(ServerListsSourceRoot)/src/Momoka.Shell/ViewModels/ServerListsViewModel.cs" Link="Production/ServerListsViewModel.cs" />
    <Compile Include="$(ServerListsSourceRoot)/src/Momoka.Shell/ViewModels/PageViewModel.cs" Link="Production/PageViewModel.cs" />
  </ItemGroup>
</Project>
