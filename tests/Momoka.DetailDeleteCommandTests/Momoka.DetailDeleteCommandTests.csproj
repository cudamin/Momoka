<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Momoka.DetailDeleteCommandTests</AssemblyName>
    <RootNamespace>Momoka.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Momoka.Core\Momoka.Core.csproj" />
    <Compile Include="..\..\src\Momoka.Shell\Views\CardItem.cs" Link="Production\CardItem.cs" />
    <Compile Include="..\..\src\Momoka.Shell\Views\IShellActions.cs" Link="Production\IShellActions.cs" />
    <Compile Include="..\..\src\Momoka.Shell\Views\ConfirmDialog.cs" Link="Production\ConfirmDialog.cs" />
    <Compile Include="..\..\src\Momoka.Shell\Media\PosterCache.cs" Link="Production\PosterCache.cs" />
    <Compile Include="..\Momoka.Tests\TestHarness.cs" Link="TestHarness.cs" />
  </ItemGroup>
  <!-- Only the shared helpers, DeleteAsync and OnMoreClicked are extracted.
       Each start/end must be unique; bodies are copied verbatim on every compilation.
       The actual detail VM is loaded from the explicitly supplied fresh local Shell DLL. -->
  <UsingTask TaskName="ExtractDetailDeleteCommandSources" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceRoot ParameterType="System.String" Required="true" />
      <OutputSource ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" /><Using Namespace="System.IO" /><Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Func<string, string, string, string> between = (source, start, end) =>
        {
            var begin = source.IndexOf(start, StringComparison.Ordinal);
            if (begin < 0 || source.IndexOf(start, begin + start.Length, StringComparison.Ordinal) >= 0)
                throw new InvalidOperationException("Missing/ambiguous production start: " + start);
            var finish = source.IndexOf(end, begin + start.Length, StringComparison.Ordinal);
            if (finish < 0 || source.IndexOf(end, finish + end.Length, StringComparison.Ordinal) >= 0)
                throw new InvalidOperationException("Missing/ambiguous production end: " + end);
            return source.Substring(begin, finish - begin);
        };
        var server = File.ReadAllText(Path.Combine(SourceRoot, "ItemCommands.Server.cs")).Replace("\r\n", "\n");
        var page = File.ReadAllText(Path.Combine(SourceRoot, "DetailPage.xaml.cs")).Replace("\r\n", "\n");
        var fnnas = File.ReadAllText(Path.Combine(SourceRoot, "ItemCommands.FnNas.cs")).Replace("\r\n", "\n");
        var commands = File.ReadAllText(Path.Combine(SourceRoot, "ItemCommands.cs")).Replace("\r\n", "\n");
        var generated = "#nullable enable\n// Verbatim current-tree production bodies; never edit generated output.\n" +
            "using Momoka.Diagnostics;\nusing Momoka.Emby;\nusing Momoka.FnNas;\nusing Momoka.Infrastructure;\n" +
            "using Microsoft.UI.Xaml;\nusing Microsoft.UI.Xaml.Controls;\nnamespace Momoka.Shell.Views;\n" +
            "internal static partial class ItemCommands\n{\n" +
            between(commands, "    private const string Category", "    // Per DTO") +
            between(server, "    private static async Task GuardAsync(", "\n    /// <summary>\n    /// 一次请求。") +
            between(server, "    private static async Task<T> AskAsync<T>(", "\n    /// <inheritdoc cref=\"AskAsync{T}\"/>") +
            between(server, "    private static async Task TellAsync(", "\n    /// <summary>\n    /// 取一段字节，") +
            between(server, "    private static XamlRoot? Root(", "\n    /// <summary>打开所属剧集。") +
            between(server, "    private static Task DeleteAsync(", "\n}") +
            between(fnnas, "    private static Task FnNasVersionsAsync(", "\n    private static Task FnNasMatchAsync(") +
            between(fnnas, "    private static Task FnNasDeleteAsync(", "\n}") +
            between(commands, "    private static void Invoke(", "            case ItemCommand.Play:") +
            between(commands, "            case ItemCommand.ManageVersions:", "            case ItemCommand.FnNasMatch:") +
            "            default: throw new InvalidOperationException(\"Fixture rejects unrelated command\");\n" +
            between(commands, "            case ItemCommand.Delete:\n                _ = DeleteAsync(", "\n    /// <summary>\n    /// 已看，") + "\n}\n" +
            "\ninternal sealed partial class DetailPage\n{\n" +
            between(page, "    private void OnMoreClicked(", "\n    /// <summary>\n    /// An item in any of the four sections") + "\n}\n";
        Directory.CreateDirectory(Path.GetDirectoryName(OutputSource));
        if (!File.Exists(OutputSource) || File.ReadAllText(OutputSource) != generated)
            File.WriteAllText(OutputSource, generated, new UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="GenerateDetailDeleteCommandSources" BeforeTargets="CoreCompile">
    <ExtractDetailDeleteCommandSources SourceRoot="$(MSBuildProjectDirectory)\..\..\src\Momoka.Shell\Views"
                                       OutputSource="$(IntermediateOutputPath)DetailDeleteCommandSources.g.cs" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)DetailDeleteCommandSources.g.cs" /></ItemGroup>
  </Target>
</Project>
