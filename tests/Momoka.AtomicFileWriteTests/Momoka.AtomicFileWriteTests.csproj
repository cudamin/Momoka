<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <AssemblyName>Momoka.AtomicFileWriteTests</AssemblyName>
        <RootNamespace>Momoka.AtomicFileWriteTests</RootNamespace>
        <IsPackable>false</IsPackable>
        <AtomicFileSource>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\src\Momoka.Core\Infrastructure\AtomicFile.cs'))</AtomicFileSource>
    </PropertyGroup>
    <ItemGroup>
        <!-- The root props inject package analyzers into every project except Momoka.Tests.
             This independent, offline host uses only SDK/bundled analyzers, not external packages. -->
        <PackageReference Remove="@(PackageReference)" />
        <!-- Compile the ENTIRE current production file. No extraction, copy or substitute commit. -->
        <Compile Include="$(AtomicFileSource)" Link="Production\AtomicFile.cs" />
        <AssemblyMetadata Include="AtomicFileSourcePath" Value="$(AtomicFileSource)" />
        <AssemblyMetadata Include="FixtureProjectRoot" Value="$(MSBuildProjectDirectory)" />
        <AssemblyMetadata Include="BuildConfiguration" Value="$(Configuration)" />
    </ItemGroup>
    <Target Name="RequirePackageFreeAtomicFileTests" BeforeTargets="CollectPackageReferences;CoreCompile">
        <Error Condition="'@(PackageReference)' != ''" Text="AtomicFile contract tests must have no external packages." />
    </Target>
    <Target Name="StampAtomicFileSource" BeforeTargets="GetAssemblyAttributes">
        <GetFileHash Files="$(AtomicFileSource)" Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="AtomicFileHashedSource" />
        </GetFileHash>
        <ItemGroup>
            <AssemblyMetadata Include="AtomicFileSourceSha256" Value="%(AtomicFileHashedSource.FileHash)" />
        </ItemGroup>
    </Target>
</Project>
