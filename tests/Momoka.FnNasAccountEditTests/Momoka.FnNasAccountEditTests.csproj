<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Momoka.FnNasAccountEditTests</AssemblyName>
    <RootNamespace>Momoka.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <AccountEditSourceRoot Condition="'$(AccountEditSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..\src\Momoka.Shell\ViewModels</AccountEditSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <!-- Execute whole production VMs and their actual generated properties/commands. No Core
         reference: the password confirmation endpoint cannot enter authentication or secret IO. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <Compile Include="$(AccountEditSourceRoot)\FnNasPasswordViewModel.cs" Link="Production\FnNasPasswordViewModel.cs" />
    <Compile Include="$(AccountEditSourceRoot)\FnNasPreferencesViewModel.cs" Link="Production\FnNasPreferencesViewModel.cs" />
    <Compile Include="..\..\src\Momoka.Shell\ViewModels\FnNasSessionViewModel.cs" Link="Production\FnNasSessionViewModel.cs" />
    <Compile Include="..\..\src\Momoka.Shell\ViewModels\PageViewModel.cs" Link="Production\PageViewModel.cs" />
    <Compile Include="..\..\src\Momoka.Shell\ViewModels\FnNasAdminRows.cs" Link="Production\FnNasAdminRows.cs" />
    <Compile Include="..\..\src\Momoka.Core\Infrastructure\LoadGeneration.cs" Link="Production\LoadGeneration.cs" />
    <Compile Include="..\..\src\Momoka.Core\Diagnostics\Failure.cs" Link="Production\Failure.cs" />
    <Compile Include="..\..\src\Momoka.Core\Emby\EmbyApiException.cs" Link="Production\EmbyApiException.cs" />
    <Compile Include="..\Momoka.Tests\TestHarness.cs" Link="TestHarness.cs" />
    <Compile Include="..\Momoka.SubtitleDialogTests\UiQueue.cs" Link="UiQueue.cs" />
    <EmbeddedResource Include="..\..\src\Momoka.Shell\Views\FnNasPasswordPage.xaml" LogicalName="Production.FnNasPasswordPage.xaml" />
    <EmbeddedResource Include="..\..\src\Momoka.Shell\Views\FnNasPreferencesPage.xaml" LogicalName="Production.FnNasPreferencesPage.xaml" />
    <EmbeddedResource Include="..\..\src\Momoka.Shell\Views\FnNasPasswordPage.xaml.cs" LogicalName="Production.FnNasPasswordPage.xaml.cs" />
    <EmbeddedResource Include="..\..\src\Momoka.Shell\Views\FnNasPreferencesPage.xaml.cs" LogicalName="Production.FnNasPreferencesPage.xaml.cs" />
  </ItemGroup>
</Project>
