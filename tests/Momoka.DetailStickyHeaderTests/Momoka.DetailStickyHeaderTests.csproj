<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <IsPackable>false</IsPackable>
        <StartupObject>Momoka.Tests.Program</StartupObject>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="..\Momoka.Tests\TestHarness.cs" Link="TestHarness.cs" />
        <Compile Include="..\..\src\Momoka.Shell\Views\DetailPage.StickyHeader.cs" Link="Production\DetailPage.StickyHeader.cs" />
        <Compile Include="..\..\src\Momoka.Shell\Views\DetailPage.StickyPlayMotion.cs" Link="Production\DetailPage.StickyPlayMotion.cs" />
    </ItemGroup>
    <UsingTask TaskName="ExtractHeroColumnLayout" TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Source ParameterType="System.String" Required="true" />
            <ProbeSource ParameterType="System.String" Required="true" />
            <OutputSource ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Text" />
            <Using Namespace="System.Text.RegularExpressions" />
            <Code Type="Fragment" Language="cs"><![CDATA[
                var source = File.ReadAllText(Source).Replace("\r\n", "\n");
                var begin = source.IndexOf("    private void LayoutHeroColumn()", StringComparison.Ordinal);
                var endMarker = "\n    /// <summary>\n    /// 左侧封面的下沿量给视图模型";
                var end = source.IndexOf(endMarker, StringComparison.Ordinal);
                if (begin < 0 || source.IndexOf("    private void LayoutHeroColumn()", begin + 1, StringComparison.Ordinal) >= 0
                    || end <= begin || source.IndexOf(endMarker, end + 1, StringComparison.Ordinal) >= 0)
                    throw new InvalidOperationException("Missing or ambiguous production hero-column layout method");
                var constants = "";
                foreach (var name in new[] { "HeroStackSpacing", "StoreHeroStackSpacing" })
                {
                    var matches = Regex.Matches(source, @"    private const double " + name + @"\s*=\s*[^;]+;");
                    if (matches.Count != 1) throw new InvalidOperationException("Missing or ambiguous production spacing constant: " + name);
                    constants += matches[0].Value + "\n";
                }
                var probe = File.ReadAllText(ProbeSource).Replace("\r\n", "\n");
                var probeBegin = probe.IndexOf("    private const double HeroGapBase =", StringComparison.Ordinal);
                var probeEndMarker = "\n    /// <summary>够长、够跨四行的简介";
                var probeEnd = probe.IndexOf(probeEndMarker, StringComparison.Ordinal);
                if (probeBegin < 0 || probe.IndexOf("    private const double HeroGapBase =", probeBegin + 1, StringComparison.Ordinal) >= 0
                    || probeEnd <= probeBegin || probe.IndexOf(probeEndMarker, probeEnd + 1, StringComparison.Ordinal) >= 0)
                    throw new InvalidOperationException("Missing or ambiguous production hero-gap probe readings");
                var generated = "// Production layout and probe methods extracted verbatim; XAML value boundaries only.\n#nullable enable\n"
                    + "using Microsoft.UI.Xaml;\nusing Microsoft.UI.Xaml.Controls;\nusing Momoka.Shell.Views;\nusing Momoka.Emby;\nusing Windows.Foundation;\n"
                    + "namespace Momoka.Shell.Views\n{\npublic sealed partial class DetailPage\n{\n" + constants
                    + source.Substring(begin, end - begin) + "\n"
                    + ExtractUnique(source, "    private (FrameworkElement Panel, Thickness Padding, ComboBox Source, ComboBox Audio, ComboBox Subtitle) PickerSet =>", "\n    /// <summary>\n    /// Tooling: 把这一页的一颗下拉弹开留着")
                    + ExtractUnique(source, "    internal (bool Ok, string Detail) PickerFit()", "\n    /// <summary>\n    /// 自检：标题栏那一条") + "\n}\n}\n"
                    + "namespace Momoka.Shell\n{\ninternal sealed partial class ShellNavigationProbe\n{\n"
                    + probe.Substring(probeBegin, probeEnd - probeBegin) + "\n}\n}\n";
                Directory.CreateDirectory(Path.GetDirectoryName(OutputSource));
                if (!File.Exists(OutputSource) || File.ReadAllText(OutputSource) != generated)
                    File.WriteAllText(OutputSource, generated, new UTF8Encoding(false));

                string ExtractUnique(string text, string first, string last)
                {
                    var offset = text.IndexOf(first, StringComparison.Ordinal);
                    if (offset < 0 || text.IndexOf(first, offset + first.Length, StringComparison.Ordinal) >= 0)
                        throw new InvalidOperationException("Missing or ambiguous production picker start: " + first);
                    var finish = text.IndexOf(last, offset + first.Length, StringComparison.Ordinal);
                    if (finish < 0 || text.IndexOf(last, finish + last.Length, StringComparison.Ordinal) >= 0)
                        throw new InvalidOperationException("Missing or ambiguous production picker end: " + last);
                    return text.Substring(offset, finish - offset);
                }
            ]]></Code>
        </Task>
    </UsingTask>
    <Target Name="GenerateHeroColumnLayout" BeforeTargets="CoreCompile">
        <ExtractHeroColumnLayout Source="$(MSBuildProjectDirectory)\..\..\src\Momoka.Shell\Views\DetailPage.xaml.cs"
                                 ProbeSource="$(MSBuildProjectDirectory)\..\..\src\Momoka.Shell\ShellNavigationProbe.DetailResponsive.cs"
                                 OutputSource="$(IntermediateOutputPath)HeroColumnLayout.g.cs" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)HeroColumnLayout.g.cs" />
        </ItemGroup>
    </Target>
</Project>
