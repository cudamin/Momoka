<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <IsPackable>false</IsPackable>
        <StartupObject>Momoka.Tests.Program</StartupObject>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\Momoka.Core\Momoka.Core.csproj" />
        <None Include="..\..\src\Momoka.Shell\Views\HomePage.xaml" Link="HomePage.xaml" CopyToOutputDirectory="PreserveNewest" />
        <Compile Include="..\..\src\Momoka.Shell\Views\HomeFoldMotion.cs" Link="Production\HomeFoldMotion.cs" />
        <Compile Include="..\..\src\Momoka.Shell\Views\HomePage.Carousel.cs" Link="Production\HomePage.Carousel.cs" />
        <Compile Include="..\..\src\Momoka.Shell\Views\HomePage.Header.cs" Link="Production\HomePage.Header.cs" />
        <Compile Include="..\..\src\Momoka.Shell\Views\HomeHeaderScrollState.cs" Link="Production\HomeHeaderScrollState.cs" />
        <Compile Include="..\..\src\Momoka.Shell\Views\BannerCycleClock.cs" Link="Production\BannerCycleClock.cs" />
    </ItemGroup>
    <!-- Compile the actual page methods unchanged. Missing or ambiguous boundaries fail closed;
         only layout values, UI owners and Storyboard delivery are inert test boundaries. -->
    <UsingTask TaskName="ExtractHomeFoldSources" TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <PageSource ParameterType="System.String" Required="true" />
            <BannerSource ParameterType="System.String" Required="true" />
            <CountdownSource ParameterType="System.String" Required="true" />
            <PosterSource ParameterType="System.String" Required="true" />
            <EpisodeSource ParameterType="System.String" Required="true" />
            <OutputSource ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Text" />
            <Code Type="Fragment" Language="cs"><![CDATA[
                Func<string, string, string, string> between = (source, start, end) =>
                {
                    var begin = source.IndexOf(start, StringComparison.Ordinal);
                    if (begin < 0 || source.IndexOf(start, begin + start.Length, StringComparison.Ordinal) >= 0)
                        throw new InvalidOperationException("Missing or ambiguous production start: " + start);
                    var finish = source.IndexOf(end, begin + start.Length, StringComparison.Ordinal);
                    if (finish < 0 || source.IndexOf(end, finish + end.Length, StringComparison.Ordinal) >= 0)
                        throw new InvalidOperationException("Missing or ambiguous production end: " + end);
                    return source.Substring(begin, finish - begin);
                };
                var page = File.ReadAllText(PageSource).Replace("\r\n", "\n");
                var generated = "// Extracted verbatim from this tree's current production at build time; do not edit.\n#nullable enable\n" +
                    "using Momoka.Diagnostics;\nusing Momoka.Emby;\nusing Microsoft.UI.Dispatching;\nusing Microsoft.UI.Xaml;\n" +
                    "using Microsoft.UI.Xaml.Controls;\nusing Microsoft.UI.Xaml.Media;\nnamespace Momoka.Shell.Views;\n" +
                    "public sealed partial class HomePage : Page\n{\n" +
                    between(page, "    private bool _entranceSuppressed;", "\n    /// <summary>\n    /// Resolved on navigation") +
                    between(page, "    private bool _foldScheduled;", "\n    public HomePage()") +
                    between(page, "    internal void PreparePlaybackReturn()", "\n    /// <summary>\n    /// The rows the page actually drew") +
                    between(page, "    private static long Now =>", "\n    /// <summary>\n    /// 元素顶边在「滚回顶上」") +
                    between(page, "    private double ViewportTopAtScrollZero", "\n    /// <summary>\n    /// 自检：轮播这条带的高度") +
                    between(page, "    public void Release()", "\n    /// <summary>\n    /// 设置里主页那一组改了") +
                    "\n}\n";
                var banner = File.ReadAllText(BannerSource).Replace("\r\n", "\n");
                var countdown = File.ReadAllText(CountdownSource).Replace("\r\n", "\n");
                generated += "\ninternal sealed partial class BannerClockFixture\n{\n" +
                    between(banner, "    internal void Apply(IReadOnlyList<BannerSlide> slides)", "\n    /// <summary>\n    /// 把第") +
                    between(banner, "    private void SyncTimer()", "\n    /// <summary>\n    /// 带多高") +
                    between(countdown, "    private void UpdateCyclePause()", "\n    /// <summary>从 12 点") +
                    between(banner, "    private void OnTick(DispatcherQueueTimer sender, object args)", "\n    /// <summary>\n    /// 键盘翻页。") + "\n}\n";
                generated += "\ninternal sealed partial class BannerReturnFixture\n{\n" +
                    "    internal void PaintVisit()\n    {\n" +
                    between(banner, "        // 控件返回可视树时重新订阅当前图片", "\n        SyncTimer();\n\n        if (XamlRoot") + "\n    }\n" +
                    between(banner, "    private void Paint(BitmapImage? picture)", "\n    /// <summary>\n    /// 台上那层。") +
                    between(banner, "    private void PaintLogo(BannerSlide slide)", "\n    /// <summary>\n    /// 精选标识") + "\n}\n";
                generated += "\ninternal sealed partial class BannerDemandFixture\n{\n" +
                    between(banner, "    private void Prefetch()", "\n    /// <summary>\n    /// 箭头在不在屏上。") + "\n}\n";
                var poster = File.ReadAllText(PosterSource).Replace("\r\n", "\n");
                generated += "\ninternal sealed partial class PosterDemandFixture\n{\n" +
                    between(poster, "    private void Begin()", "\n    private void OnPointerEntered") + "\n}\n";
                var episode = File.ReadAllText(EpisodeSource).Replace("\r\n", "\n");
                generated += "\ninternal sealed partial class EpisodeDemandFixture\n{\n" +
                    between(episode, "    private void Begin()", "\n    private void OnPointerEntered") + "\n}\n";
                generated = generated.Replace("using Microsoft.UI.Xaml.Controls;\n", "using Microsoft.UI.Xaml.Controls;\nusing Microsoft.UI.Xaml.Media.Animation;\nusing Microsoft.UI.Xaml.Media.Imaging;\n");
                Directory.CreateDirectory(Path.GetDirectoryName(OutputSource));
                if (!File.Exists(OutputSource) || File.ReadAllText(OutputSource) != generated)
                    File.WriteAllText(OutputSource, generated, new UTF8Encoding(false));
            ]]></Code>
        </Task>
    </UsingTask>
    <Target Name="GenerateHomeFoldSources" BeforeTargets="CoreCompile">
        <ExtractHomeFoldSources
            PageSource="$(MSBuildProjectDirectory)\..\..\src\Momoka.Shell\Views\HomePage.xaml.cs"
            BannerSource="$(MSBuildProjectDirectory)\..\..\src\Momoka.Shell\Views\HomeBanner.xaml.cs"
            CountdownSource="$(MSBuildProjectDirectory)\..\..\src\Momoka.Shell\Views\HomeBanner.Countdown.cs"
            PosterSource="$(MSBuildProjectDirectory)\..\..\src\Momoka.Shell\Views\PosterCard.xaml.cs"
            EpisodeSource="$(MSBuildProjectDirectory)\..\..\src\Momoka.Shell\Views\EpisodeRow.xaml.cs"
            OutputSource="$(IntermediateOutputPath)HomeFoldPage.g.cs" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)HomeFoldPage.g.cs" />
        </ItemGroup>
    </Target>
</Project>
