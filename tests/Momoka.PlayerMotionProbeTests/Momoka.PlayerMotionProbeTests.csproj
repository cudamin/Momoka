<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <IsPackable>false</IsPackable>
        <MotionProbeSource Condition="'$(MotionProbeSource)' == ''">$(MSBuildProjectDirectory)\..\..\src\Momoka.Shell\PlayerMotionProbe.cs</MotionProbeSource>
    </PropertyGroup>

    <!-- Compile the actual final-stage caller and its actual Require/Until, not a second motion model.
         Only the page/window/timer/log endpoints are inert; ambiguous source boundaries fail closed. -->
    <UsingTask TaskName="ExtractPlayerMotionProbeStage" TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Source ParameterType="System.String" Required="true" />
            <SourceHash ParameterType="System.String" Required="true" />
            <OverlaySource ParameterType="System.String" Required="true" />
            <OverlayHash ParameterType="System.String" Required="true" />
            <Output ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Text" />
            <Code Type="Fragment" Language="cs"><![CDATA[
                var source = File.ReadAllText(Source).Replace("\r\n", "\n");
                Func<string, string, string> between = (start, end) =>
                {
                    var begin = source.IndexOf(start, StringComparison.Ordinal);
                    if (begin < 0 || source.IndexOf(start, begin + start.Length, StringComparison.Ordinal) >= 0)
                        throw new InvalidOperationException("Missing or ambiguous probe start: " + start);
                    var finish = source.IndexOf(end, begin + start.Length, StringComparison.Ordinal);
                    if (finish < 0 || source.IndexOf(end, finish + end.Length, StringComparison.Ordinal) >= 0)
                        throw new InvalidOperationException("Missing or ambiguous probe end: " + end);
                    return source.Substring(begin, finish - begin);
                };
                var stage = between("            Write(\"阶段：加载页直接进入全屏再退出\");",
                    "            Write(\"阶段：自动全屏起播，首帧与窗口交接同时到达\");");
                var stageSource = source;
                source = File.ReadAllText(OverlaySource).Replace("\r\n", "\n");
                var overlay = between("    private sealed record StopOverlaySample", "    private static async Task RunScoped");
                source = stageSource;
                var assertions = between("        void Write(string message)",
                    "        /// <summary>\n        /// 保留态那一帧摆到哪儿");
                var sourcePath = Path.GetFullPath(Source).Replace("\"", "\"\"");
                // The method-group reference only keeps the old stage's unused Until warning quiet;
                // it does not invoke or replace that actual helper in either source variant.
                var generated = "// Verbatim current probe caller/assertions; no WinUI/native/network execution.\n#nullable enable\n" +
                    "using System.Diagnostics;\nusing Momoka.Diagnostics;\nusing Momoka.Shell.Interop;\n" +
                    "using Momoka.Shell.Views;\nusing Momoka.Shell.Windowing;\nnamespace Momoka.Shell;\n" +
                    "internal static class PlayerMotionProbe\n{\n" + overlay +
                    "    internal static async Task<(string Text, bool Seen, bool Matched, bool LastFade, int Distinct, long Fade)> ObserveForFixture(PlayerPage page, HostWindow window, NativeRect before, string? screenshot, Action<string> write, CancellationToken token)\n" +
                    "    {\n" +
                    "        var evidence = await ObserveStopHandoffAsync(page, window, before, screenshot, write, token);\n" +
                    "        return (evidence.Describe(), evidence.OverlaySeen, evidence.RectsMatch, evidence.LastRectIsFade, evidence.DistinctLuma, evidence.FadeMilliseconds);\n" +
                    "    }\n" +
                    "    internal const string SourcePath = @\"" + sourcePath + "\";\n" +
                    "    internal const string SourceHash = \"" + SourceHash + "\";\n" +
                    "    internal const string OverlaySourcePath = @\"" + Path.GetFullPath(OverlaySource).Replace("\"", "\"\"") + "\";\n" +
                    "    internal const string OverlaySourceHash = \"" + OverlayHash + "\";\n" +
                    "    internal static async Task RunFullscreenStageAsync(PlayerPage page, HostWindow window,\n" +
                    "        ProbeTimer layoutSample, NativeRect browse, TextWriter report, CancellationToken token)\n    {\n" +
                    "        NativeRect restored;\n        _ = (Func<Func<bool>, string, Task>)Until;\n" + stage + assertions + "    }\n}\n";
                Directory.CreateDirectory(Path.GetDirectoryName(Output));
                if (!File.Exists(Output) || File.ReadAllText(Output) != generated)
                    File.WriteAllText(Output, generated, new UTF8Encoding(false));
            ]]></Code>
        </Task>
    </UsingTask>
    <Target Name="GeneratePlayerMotionProbeStage" BeforeTargets="CoreCompile">
        <GetFileHash Files="$(MotionProbeSource)" Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="MotionProbeSourceHash" />
        </GetFileHash>
        <GetFileHash Files="$(MSBuildProjectDirectory)\..\..\src\Momoka.Shell\PlayerMotionProbe.cs" Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="MotionOverlaySourceHash" />
        </GetFileHash>
        <ExtractPlayerMotionProbeStage Source="$(MotionProbeSource)"
            OverlaySource="$(MSBuildProjectDirectory)\..\..\src\Momoka.Shell\PlayerMotionProbe.cs"
            OverlayHash="@(MotionOverlaySourceHash->'%(FileHash)')"
            SourceHash="@(MotionProbeSourceHash->'%(FileHash)')"
            Output="$(IntermediateOutputPath)PlayerMotionProbeStage.g.cs" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)PlayerMotionProbeStage.g.cs" />
        </ItemGroup>
    </Target>
</Project>
