<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <AssemblyName>MomokaSystemNotificationProbe</AssemblyName>
        <Product>MomokaSystemNotificationProbe</Product>
        <WindowsPackageType>None</WindowsPackageType>
        <Platform>x64</Platform>
        <Platforms>x64</Platforms>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\Momoka.Core\Momoka.Core.csproj" />
        <Compile Include="..\..\src\Momoka.Shell\Platform\SystemNotification.cs" Link="Production\SystemNotification.cs" />
        <!-- Match the SDK versions used by Momoka.Shell. -->
        <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
        <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
        <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
        <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="[2.5.1]" />
    </ItemGroup>
</Project>
