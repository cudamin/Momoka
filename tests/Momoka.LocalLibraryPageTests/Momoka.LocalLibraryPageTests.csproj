<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Momoka.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Momoka.Core/Momoka.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <Compile Include="../../src/Momoka.Shell/ViewModels/PageViewModel.cs" Link="Production/PageViewModel.cs" />
    <Compile Include="../../src/Momoka.Shell/ViewModels/LocalLibraryViewModel.cs" Link="Production/LocalLibraryViewModel.cs" />
    <Compile Include="../../src/Momoka.Shell/ViewModels/LocalLibraryGroup.cs" Link="Production/LocalLibraryGroup.cs" />
    <Compile Include="../../src/Momoka.Shell/Media/LocalLibraryArtwork.cs" Link="Production/LocalLibraryArtwork.cs" />
    <Compile Include="../../src/Momoka.Shell/Views/LocalLibraryPage.xaml.cs" Link="Production/LocalLibraryPage.xaml.cs" />
    <Compile Include="../../src/Momoka.Shell/Views/IShellContent.cs" Link="Production/IShellContent.cs" />
    <Compile Include="../Momoka.Tests/TestHarness.cs" Link="TestHarness.cs" />
    <Compile Include="../Momoka.Tests/LocalLibraryHomeTests.cs" Link="LocalLibraryHomeTests.cs" />
    <Compile Include="../Momoka.Tests/LocalLibraryArtworkTests.cs" Link="LocalLibraryArtworkTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Source-linked UI code shares the production translator and embedded dictionaries. -->
    <Compile Include="../../src/Momoka.Shell/Localization/UiText.cs" Link="Production/UiText.cs" />
    <EmbeddedResource Include="../../src/Momoka.Shell/Localization/*English.json" Link="Production/%(Filename)%(Extension)" />
    <Using Include="Momoka.Shell.Localization" />
  </ItemGroup>
</Project>
