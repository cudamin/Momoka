<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Momoka.FnNasDefaultPermissionTests</AssemblyName>
    <RootNamespace>Momoka.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Momoka.Core\Momoka.Core.csproj" />
    <!-- Same generator as Shell; link the real VM, request lifetime and JSON/row types. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <Compile Include="..\..\src\Momoka.Shell\ViewModels\FnNasUsersViewModel.cs" Link="Production\FnNasUsersViewModel.cs" />
    <Compile Include="..\..\src\Momoka.Shell\ViewModels\FnNasSessionViewModel.cs" Link="Production\FnNasSessionViewModel.cs" />
    <Compile Include="..\..\src\Momoka.Shell\ViewModels\FnNasAdminViewModel.cs" Link="Production\FnNasAdminViewModel.cs" />
    <Compile Include="..\..\src\Momoka.Shell\ViewModels\FnNasAdminRows.cs" Link="Production\FnNasAdminRows.cs" />
    <Compile Include="..\..\src\Momoka.Shell\ViewModels\PageViewModel.cs" Link="Production\PageViewModel.cs" />
    <Compile Include="..\Momoka.Tests\TestHarness.cs" Link="TestHarness.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Source-linked UI code shares the production translator and embedded dictionaries. -->
    <Compile Include="../../src/Momoka.Shell/Localization/UiText.cs" Link="Production/UiText.cs" />
    <EmbeddedResource Include="../../src/Momoka.Shell/Localization/*English.json" Link="Production/%(Filename)%(Extension)" />
    <Using Include="Momoka.Shell.Localization" />
  </ItemGroup>
</Project>
