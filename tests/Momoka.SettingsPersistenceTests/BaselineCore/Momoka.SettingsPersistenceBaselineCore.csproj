<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Momoka.SettingsPersistenceBaselineCore</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- The baseline changes ONLY the two pinned old persistence files. Remaining current Core
         source is compile-linked verbatim; no UI/Auth execution or legacy binary is reused. -->
    <Compile Include="..\..\..\src\Momoka.Core\**\*.cs"
      Exclude="..\..\..\src\Momoka.Core\bin\**;..\..\..\src\Momoka.Core\obj\**;..\..\..\src\Momoka.Core\Configuration\SettingsStore.cs;..\..\..\src\Momoka.Core\Services\SettingsService.cs" />
    <Compile Include="$(PersistenceBaselineSourceRoot)\SettingsStore.cs" Link="Baseline\SettingsStore.cs" />
    <Compile Include="$(PersistenceBaselineSourceRoot)\SettingsService.cs" Link="Baseline\SettingsService.cs" />
  </ItemGroup>
  <Target Name="RejectUnspecifiedBaseline" BeforeTargets="CoreCompile">
    <Error Condition="'$(PersistenceBaselineSourceRoot)' == ''" Text="Baseline needs explicitly pinned old sources; never falls back to a current/foreign binary." />
  </Target>
</Project>
