<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Momoka.SettingsPersistenceBaselineCore</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- The pinned old service does not call the later deferred-save queue. Exclude that queue,
         which requires current Store APIs, while keeping all other Core source verbatim. -->
    <Compile Include="..\..\..\src\Momoka.Core\**\*.cs"
      Exclude="..\..\..\src\Momoka.Core\bin\**;..\..\..\src\Momoka.Core\obj\**;..\..\..\src\Momoka.Core\Configuration\SettingsStore.cs;..\..\..\src\Momoka.Core\Configuration\SettingsSaveQueue.cs;..\..\..\src\Momoka.Core\Services\SettingsService.cs" />
    <Compile Include="$(PersistenceBaselineSourceRoot)\SettingsStore.cs" Link="Baseline\SettingsStore.cs" />
    <Compile Include="$(PersistenceBaselineSourceRoot)\SettingsService.cs" Link="Baseline\SettingsService.cs" />
  </ItemGroup>
  <Target Name="RejectUnspecifiedBaseline" BeforeTargets="CoreCompile">
    <Error Condition="'$(PersistenceBaselineSourceRoot)' == ''" Text="Baseline needs explicitly pinned old sources; never falls back to a current/foreign binary." />
  </Target>
</Project>
