<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hand-rolled test host instead of xUnit/NUnit, so `dotnet run` is the test runner. This began as a
    necessity — the machine's NuGet cache was empty and the build had to work offline — and is kept as
    a preference: the test project takes no package references at all. It references Core and
    compile-links selected framework-free Shell sources so their real lifecycle code can be tested.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Momoka.Tests</AssemblyName>
    <RootNamespace>Momoka.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The listener has no WinUI dependency; exercise the exact production source, not a copied model. -->
    <Compile Include="..\..\src\Momoka.Shell\ActivationListener.cs" Link="Shell\ActivationListener.cs" />
    <!-- The entire production source; test-only namespace boundaries replace registry/package endpoints, never control flow. -->
    <Compile Include="..\..\src\Momoka.Shell\Platform\StartupRegistration.cs" Link="Shell\StartupRegistration.cs" />
    <Compile Include="..\..\src\Momoka.Shell\SelfCheckLayoutRules.cs" Link="Shell\SelfCheckLayoutRules.cs" />
    <Compile Include="..\..\src\Momoka.Shell\PerformanceProbeRules.cs" Link="Shell\PerformanceProbeRules.cs" />
    <Compile Include="..\..\src\Momoka.Shell\CompositionPositionReadiness.cs" Link="Shell\CompositionPositionReadiness.cs" />
    <Compile Include="..\..\src\Momoka.Shell\CompositionProbePixels.cs" Link="Shell\CompositionProbePixels.cs" />
    <!-- Actual Shell color policy, without a WinUI dependency or a copied test model. -->
    <Compile Include="..\..\src\Momoka.Shell\Theme\InputControlTheme.cs" Link="Shell\InputControlTheme.cs" />
    <ProjectReference Include="..\..\src\Momoka.Core\Momoka.Core.csproj" />
    <None Include="..\..\assets\shaders\**\*.glsl;..\..\assets\shaders\**\*.hook">
      <Link>shaders\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Execute the availability statement verbatim without constructing theme brushes or any other card.
       The StartupRow endpoint invokes this tree's actual SettingsViewModel/SettingToggleRow. -->
  <UsingTask TaskName="ExtractStartupAvailability" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <SelfCheck ParameterType="System.String" Required="true" />
      <Output ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var source = File.ReadAllText(Source).Replace("\r\n", "\n");
        var start = source.IndexOf("private SettingSection InterfaceCard()", StringComparison.Ordinal);
        var end = source.IndexOf("private SettingToggleRow StartupRow()", StringComparison.Ordinal);
        if (start < 0 || end <= start)
            throw new InvalidOperationException("Missing startup card/row production boundaries");
        var gates = Regex.Matches(source.Substring(start, end - start),
            @"^\s*if \(_startup is \{ Available: true \}\) rows\.Add\(StartupRow\(\)\);$", RegexOptions.Multiline);
        if (gates.Count != 1)
            throw new InvalidOperationException("Missing or ambiguous production startup availability gate");
        var selfcheck = File.ReadAllText(SelfCheck).Replace("\r\n", "\n");
        const string checkStart = "        var startupApplicable = startup.Available;";
        const string checkEnd = "        // 安全起播";
        var checkBegin = selfcheck.IndexOf(checkStart, StringComparison.Ordinal);
        var checkFinish = selfcheck.IndexOf(checkEnd, checkBegin < 0 ? 0 : checkBegin, StringComparison.Ordinal);
        if (checkBegin < 0 || checkFinish <= checkBegin
            || selfcheck.IndexOf(checkStart, checkBegin + checkStart.Length, StringComparison.Ordinal) >= 0)
            throw new InvalidOperationException("Missing or ambiguous production startup selfcheck block");
        var checkBlock = selfcheck.Substring(checkBegin, checkFinish - checkBegin);
        Func<string, string, string> between = (begin, finish) =>
        {
            var first = source.IndexOf(begin, StringComparison.Ordinal);
            if (first < 0 || source.IndexOf(begin, first + begin.Length, StringComparison.Ordinal) >= 0)
                throw new InvalidOperationException("Missing or ambiguous production start: " + begin);
            var last = source.IndexOf(finish, first + begin.Length, StringComparison.Ordinal);
            if (last < 0) throw new InvalidOperationException("Missing production end: " + finish);
            return source.Substring(first, last - first);
        };
        var reapply = between("    private async Task ReapplyAndReloadAsync(string notice)",
            "    /// <summary>恢复/导入共有的播放设置收尾；");
        var reload = between("    public override Task ReloadAsync()\n    {\n", "        // 精简模式是页级状态");
        reload = reload.Substring("    public override Task ReloadAsync()\n    {\n".Length);
        var generated = "// Verbatim current availability/selfcheck statements; anonymous endpoints, no UI/native.\n#nullable enable\n" +
            "using Momoka.Shell.Platform;\nusing Momoka.Diagnostics;\nusing Momoka.Configuration;\nusing Momoka.Services;\nnamespace Momoka.Tests;\n" +
            "internal sealed class StartupAvailabilityContract\n{\n" +
            "    private readonly IStartupRegistration? _startup;\n" +
            "    private readonly Func<object> _create;\n" +
            "    internal StartupAvailabilityContract(IStartupRegistration? startup, Func<object> create) " +
            "{ _startup = startup; _create = create; }\n" +
            "    private object StartupRow() => _create();\n" +
            "    internal List<object> Build()\n    {\n        var rows = new List<object>();\n" +
            gates[0].Value.Trim('\n') + "\n        return rows;\n    }\n}\n" +
            "internal sealed record StartupSelfCheckRow(bool IsOn, string Note);\n" +
            "internal static class StartupSelfCheckContract\n{\n" +
            "    internal static (bool Ok, string Detail) Report(StartupSelfCheckRow? startupRow, IStartupRegistration startup)\n    {\n" +
            "        (bool Ok, string Detail) result = (false, \"missing startup check\");\n" +
            "        void check(string name, bool ok, string detail) { Assert.Equal(\"开机自启那一行\", name); result = (ok, detail); }\n" +
            checkBlock + "\n        return result;\n    }\n}\n" +
            "internal sealed class StartupReapplyContract(StartupReapplyFixture fixture)\n{\n" +
            "    private AppSettings Settings => fixture.Settings.Settings;\n" +
            "    private ISettingsService? _settings => fixture.Settings;\n" +
            "    private string? _startupReloadReadFailure { get => fixture.StartupReloadFailure; set => fixture.StartupReloadFailure = value; }\n" +
            "    private void SyncSaveState() => fixture.SyncSaveState();\n" +
            "    private Task ReloadAsync()\n    {\n" + reload +
            "        fixture.ReloadRow();\n        return fixture.ReloadFinish;\n    }\n" +
            "    private Task ReapplyPlaybackPreferencesAsync(string notice, string? startupReadFailure = null) => fixture.Push(notice, startupReadFailure);\n" +
            "    private static class ThemeHost { internal static void Apply(string theme) { } }\n" +
            "    private static class ShellPrefs { internal static void Apply(UiSettings ui) { } internal static void ApplyShortcuts() { } internal static void ApplyDanmaku() { } internal static void ApplySubtitleTranslation() { } }\n" +
            reapply + "\n    internal Task Run(string notice) => ReapplyAndReloadAsync(notice);\n" +
            "    internal Task ReloadOnly() => ReloadAsync();\n}\n";
        Directory.CreateDirectory(Path.GetDirectoryName(Output));
        if (!File.Exists(Output) || File.ReadAllText(Output) != generated)
            File.WriteAllText(Output, generated, new UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="GenerateStartupAvailability" BeforeTargets="CoreCompile">
    <ExtractStartupAvailability Source="$(MSBuildProjectDirectory)\..\..\src\Momoka.Shell\ViewModels\SettingsViewModel.cs"
                               SelfCheck="$(MSBuildProjectDirectory)\..\..\src\Momoka.Shell\ShellSelfCheck.Settings.cs"
                               Output="$(IntermediateOutputPath)StartupAvailability.g.cs" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)StartupAvailability.g.cs" />
    </ItemGroup>
  </Target>

  <!-- Exercise the exact diagnostic input and frame-evidence control flow; only native/capture IO is inert. -->
  <UsingTask TaskName="ExtractProbeEvidence" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Root ParameterType="System.String" Required="true" />
      <Output ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Func<string, string, string, string> between = (source, begin, finish) =>
        {
            var start = source.IndexOf(begin, StringComparison.Ordinal);
            if (start < 0 || source.IndexOf(begin, start + begin.Length, StringComparison.Ordinal) >= 0)
                throw new InvalidOperationException("Missing or ambiguous probe evidence start: " + begin);
            var end = source.IndexOf(finish, start + begin.Length, StringComparison.Ordinal);
            if (end < 0) throw new InvalidOperationException("Missing probe evidence end: " + finish);
            return source.Substring(start, end - start);
        };
        Func<string, string> read = path => File.ReadAllText(Path.Combine(Root, path)).Replace("\r\n", "\n");
        var cursor = read("src/Momoka.Shell/CursorVisibilityProbe.cs");
        var pixels = read("src/Momoka.Shell/CompositionPlaybackProbe.Pixels.cs");
        var composition = read("src/Momoka.Shell/CompositionPlaybackProbe.cs");
        var motion = read("src/Momoka.Shell/PlayerMotionProbe.cs");
        if (pixels.Split(new[] { "return new ScreenPixels(width, height, bytes) { OriginX = x, OriginY = y };" }, StringSplitOptions.None).Length != 2)
            throw new InvalidOperationException("Screen capture lost its exact origin handoff");
        foreach (var wiring in new[] { "await PrepareInputAsync(window,", "Task Move(int x, int y) => MoveAsync(window!", "NudgeInput(window, Write, token);" })
            if (cursor.IndexOf(wiring, StringComparison.Ordinal) < 0)
                throw new InvalidOperationException("Cursor probe caller lost wiring: " + wiring);
        if (motion.IndexOf("await CompositionPlaybackProbe.ReadEdgeEvidenceAsync(window,", StringComparison.Ordinal) < 0)
            throw new InvalidOperationException("Motion caller lost same-frame evidence");
        var input = between(cursor, "    // Diagnostic input preparation and movement;", "    // End diagnostic input preparation and movement.");
        var evidence = between(pixels, "    // Retained-frame edge evidence;", "\n    /// <summary>");
        var save = between(pixels, "    internal static Task SaveScreenAsync(HostWindow window, string file)", "    // Retained-frame edge evidence;");
        var frame = between(pixels, "    private sealed record ScreenPixels(", "\n    [StructLayout(");
        var line = between(composition, "    internal static string Line(", "\n    /// <summary>");
        var edge = between(composition, "    internal static string EdgeRead(", "\n    /// <summary>");
        var blank = between(composition, "    internal static bool HasBlank(", "\n    /// <summary>");
        var colors = between(composition, "    private static char ColorLetter(uint color)", "\n    internal static Uri LocalFile(");
        var assertion = between(motion, "            var recognized = fixedRead.Count(", "            // 红/绿对照：");
        var require = between(motion, "        void Require(bool condition, string message)", "        async Task Until(");
        var generated = "// Verbatim current probe methods; native/capture/encoder endpoints are test-only.\n#nullable enable\n" +
            "using System.Diagnostics;\nusing Momoka.Tests;\nusing Native = Momoka.Tests.ProbeEvidenceNative;\n" +
            "using NativePoint = Momoka.Tests.ProbeEvidencePoint;\nusing HostWindow = Momoka.Tests.ProbeEvidenceWindow;\n" +
            "namespace Momoka.Shell;\ninternal static class CursorVisibilityProbe\n{\n" + input +
            "    internal static Task PrepareForFixture(HostWindow window, NativePoint[] targets, Action<string> write, CancellationToken token, int timeout) => PrepareInputAsync(window, targets, write, token, timeout);\n" +
            "    internal static Task MoveForFixture(HostWindow window, int x, int y, Action<string> write, CancellationToken token) => MoveAsync(window, x, y, write, token);\n}\n" +
            "internal static partial class CompositionPlaybackProbe\n{\n" + evidence + save + frame + line + edge + blank + colors +
            "    private static ScreenPixels CapturePixels(HostWindow window) => CapturePixels(window.Handle);\n" +
            "    private static ScreenPixels CapturePixels(IntPtr handle)\n    {\n        var frame = ProbeEvidenceNative.State.Capture(handle);\n        return new ScreenPixels(frame.Width, frame.Height, frame.Bytes) { OriginX = frame.OriginX, OriginY = frame.OriginY };\n    }\n" +
            "    private static Task EncodeAsync(ScreenPixels frame, string file) => ProbeEvidenceNative.State.Encode(frame.Bytes, file);\n}\n" +
            "internal static class RetainedEvidenceCaller\n{\n    internal static void Validate(string fixedRead, Action<string> Write)\n    {\n" +
            assertion + require + "    }\n}\n";
        var paths = new[] { "src/Momoka.Shell/CursorVisibilityProbe.cs", "src/Momoka.Shell/CompositionPlaybackProbe.Pixels.cs",
            "src/Momoka.Shell/CompositionPlaybackProbe.cs", "src/Momoka.Shell/PlayerMotionProbe.cs" };
        var hashes = new StringBuilder();
        foreach (var path in paths)
        {
            using (var sha = System.Security.Cryptography.SHA256.Create())
                hashes.Append("        (\"").Append(path).Append("\", \"")
                    .Append(BitConverter.ToString(sha.ComputeHash(File.ReadAllBytes(Path.Combine(Root, path)))).Replace("-", ""))
                    .Append("\"),\n");
        }
        generated += "internal static class ProbeEvidenceInputs\n{\n    internal static readonly (string Path, string Hash)[] Hashes =\n    [\n" + hashes + "    ];\n}\n";
        Directory.CreateDirectory(Path.GetDirectoryName(Output));
        if (!File.Exists(Output) || File.ReadAllText(Output) != generated)
            File.WriteAllText(Output, generated, new UTF8Encoding(false));
        var compactPath = "src/Momoka.Shell/ShellNavigationProbe.CompactSeasons.cs";
        var compact = read(compactPath);
        var sharedPath = "src/Momoka.Shell/ShellNavigationProbe.cs";
        var shared = read(sharedPath);
        foreach (var wiring in new[] { "await PrepareSubscriptionImagesAsync(seasons, rows, 0, 1);",
            "await PrepareSubscriptionImagesAsync(seasons, rows, 0);",
            "vm.Episodes[1].Artwork is not null && server.ImageRequests.Contains(server.FailedImageUrl)",
            "vm.Episodes[0].Artwork is not null" })
            if (compact.IndexOf(wiring, StringComparison.Ordinal) < 0)
                throw new InvalidOperationException("Compact episode image caller lost original preparation/assertion: " + wiring);
        var compactGenerated = "// Verbatim image-preparation probe; only framework layout and element endpoints are substitutes.\n#nullable enable\n" +
            "using FrameworkElement = Momoka.Tests.CompactProbeElement;\nusing DependencyObject = Momoka.Tests.CompactProbeElement;\n" +
            "using MoviePilotMediaSeasonsView = Momoka.Tests.CompactProbeSeasons;\nusing ItemsRepeater = Momoka.Tests.CompactProbeRepeater;\n" +
            "using ScrollViewer = Momoka.Tests.CompactProbeViewport;\nusing VisualTreeHelper = Momoka.Tests.CompactProbeVisualTree;\n" +
            "namespace Momoka.Shell;\ninternal sealed partial class ShellNavigationProbe\n{\n" +
            between(compact, "    private static async Task PrepareSubscriptionImagesAsync(", "\n}") +
            between(shared, "    private static void Require(bool condition, string message)", "\n    private static object? Call") +
            between(shared, "    private static async Task UntilAsync(Func<bool> ready)", "\n    private async Task InitializeProbeWindowAsync()") +
            between(shared, "    private static IEnumerable<DependencyObject> Descendants(", "\n    private sealed class Fixture") +
            "\n    internal static Task PrepareCompactImagesForFixture(MoviePilotMediaSeasonsView seasons, System.Collections.IEnumerable rows, params int[] indices) => PrepareSubscriptionImagesAsync(seasons, rows, indices);\n}\n";
        var compactHashes = new StringBuilder();
        foreach (var path in new[] { compactPath, sharedPath })
        {
            using (var sha = System.Security.Cryptography.SHA256.Create())
                compactHashes.Append("        (\"").Append(path).Append("\", \"")
                    .Append(BitConverter.ToString(sha.ComputeHash(File.ReadAllBytes(Path.Combine(Root, path)))).Replace("-", ""))
                    .Append("\"),\n");
        }
        compactGenerated += "internal static class CompactProbeInputs\n{\n    internal static readonly (string Path, string Hash)[] Hashes =\n    [\n" + compactHashes + "    ];\n}\n";
        var compactOutput = Path.Combine(Path.GetDirectoryName(Output), "CompactImagesProbe.g.cs");
        if (!File.Exists(compactOutput) || File.ReadAllText(compactOutput) != compactGenerated)
            File.WriteAllText(compactOutput, compactGenerated, new UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="GenerateProbeEvidence" BeforeTargets="CoreCompile">
    <ExtractProbeEvidence Root="$(MSBuildProjectDirectory)\..\.." Output="$(IntermediateOutputPath)ProbeEvidence.g.cs" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)ProbeEvidence.g.cs" />
      <Compile Include="$(IntermediateOutputPath)CompactImagesProbe.g.cs" />
    </ItemGroup>
  </Target>
</Project>
