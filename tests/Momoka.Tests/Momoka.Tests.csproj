<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hand-rolled test host instead of xUnit/NUnit, so `dotnet run` is the test runner. This began as a
    necessity — the machine's NuGet cache was empty and the build had to work offline — and is kept as
    a preference: the test project takes no package references at all. It references Core and
    compile-links selected framework-free Shell sources so their real lifecycle code can be tested.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Momoka.Tests</AssemblyName>
    <RootNamespace>Momoka.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The listener has no WinUI dependency; exercise the exact production source, not a copied model. -->
    <Compile Include="..\..\src\Momoka.Shell\ActivationListener.cs" Link="Shell\ActivationListener.cs" />
    <ProjectReference Include="..\..\src\Momoka.Core\Momoka.Core.csproj" />
    <None Include="..\..\assets\shaders\**\*.glsl;..\..\assets\shaders\**\*.hook">
      <Link>shaders\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
