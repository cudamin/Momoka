<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Momoka.DetailFilePickerTests</AssemblyName>
    <RootNamespace>Momoka.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <DetailFilePickerSource Condition="'$(DetailFilePickerSource)' == ''">$(MSBuildProjectDirectory)/../../src/Momoka.Shell/Views/DetailFilePicker.cs</DetailFilePickerSource>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Momoka.Core/Momoka.Core.csproj" />
    <Compile Include="../Momoka.Tests/TestHarness.cs" Link="TestHarness.cs" />
    <Compile Include="$(DetailFilePickerSource)" Link="Production/DetailFilePicker.cs" />
  </ItemGroup>
</Project>
