<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <FnNasCallerSource Condition="'$(FnNasCallerSource)' == ''">$(MSBuildProjectDirectory)/../../src/Momoka.Shell/Views/ItemCommands.FnNasSubtitles.cs</FnNasCallerSource>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Momoka.Core/Momoka.Core.csproj" />
    <Compile Include="../Momoka.Tests/TestHarness.cs" Link="TestHarness.cs" />
    <Compile Include="../Momoka.Tests/DialogChromeTests.cs" Link="DialogChromeTests.cs" />
    <Compile Include="../Momoka.Tests/StartupArgsTests.cs" Link="StartupArgsTests.cs" />
    <Compile Include="../Momoka.SubtitleDialogTests/UiQueue.cs" Link="UiQueue.cs" />
    <Compile Include="../../src/Momoka.Shell/Views/FnNasSubtitleDialog.xaml.cs" Link="Production/FnNasSubtitleDialog.xaml.cs" />
    <Compile Include="$(FnNasCallerSource)" Link="Production/ItemCommands.FnNasSubtitles.cs" />
  </ItemGroup>
  <UsingTask TaskName="ExtractFnNasSubtitleCallerHelpers" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <OutputSource ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" /><Using Namespace="System.IO" /><Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var source = File.ReadAllText(SourceFile).Replace("\r\n", "\n");
        Func<string, int> unique = marker =>
        {
            var at = source.IndexOf(marker, StringComparison.Ordinal);
            if (at < 0 || source.IndexOf(marker, at + marker.Length, StringComparison.Ordinal) >= 0)
                throw new InvalidOperationException("Missing/ambiguous caller helper: " + marker);
            return at;
        };
        Func<string, string, string> between = (start, end) =>
        {
            var first = unique(start);
            var last = unique(end);
            if (last <= first) throw new InvalidOperationException("Reversed helper boundary");
            return source.Substring(first, last - first);
        };
        var root = unique("    private static XamlRoot? Root(FrameworkElement owner)");
        var rootEnd = source.IndexOf('\n', root);
        var generated = "#nullable enable\nusing Momoka.Emby;\nusing Microsoft.UI.Xaml;\nnamespace Momoka.Shell.Views;\ninternal static partial class ItemCommands\n{\n"
            + between("    private static async Task<T> AskAsync<T>(", "\n    /// <inheritdoc cref=\"AskAsync{T}\"/>")
            + between("    private static void RequirePermission(", "\n    /// <summary>\n    /// 取一段字节，")
            + source.Substring(root, rootEnd - root + 1) + "\n}\n";
        Directory.CreateDirectory(Path.GetDirectoryName(OutputSource));
        if (!File.Exists(OutputSource) || File.ReadAllText(OutputSource) != generated)
            File.WriteAllText(OutputSource, generated, new UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="GenerateFnNasSubtitleCallerHelpers" BeforeTargets="CoreCompile">
    <ExtractFnNasSubtitleCallerHelpers SourceFile="$(MSBuildProjectDirectory)/../../src/Momoka.Shell/Views/ItemCommands.Server.cs"
        OutputSource="$(IntermediateOutputPath)FnNasSubtitleCallerHelpers.g.cs" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)FnNasSubtitleCallerHelpers.g.cs" /></ItemGroup>
  </Target>
</Project>
